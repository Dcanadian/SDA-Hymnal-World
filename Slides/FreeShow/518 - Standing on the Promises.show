            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Standing on the promises of Christ my King,",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Thru eternal ages let His praises ring;",
