  "slides": {
    "slide_0": {
      "group": "Verse 1",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Baptize us anew With power from on high,",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "With love, O refresh us! Dear Savior, draw nigh.",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "We humbly beseech Thee, Lord Jesus, we pray,",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "With love and the Spirit baptize us today.",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_1": {
      "group": "Refrain",
      "color": "#e11d48",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "We humbly beseech Thee, Lord Jesus, we pray,",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "With love and the Spirit baptize us today.",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "We praise Thee, we bless Thee, dear Lamb that was slain",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "We laud and adore Thee, Amen and Amen.",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_2": {
      "group": "Verse 2",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Unworthy we cry, Unholy, unclean,",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "O wash us and cleanse us From sin's guilty stain.",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_3": {
      "group": "Verse 3",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "O heavenly Dove, Descend from on high!",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "We plead Thy rich blessing; In mercy draw nigh.",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_4": {
      "group": "Verse 4",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "O list the glad voice! From heaven it came:",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Thou art My beloved, Well pleased I am.",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    }
  },
