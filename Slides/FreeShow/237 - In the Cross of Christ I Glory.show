      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "peace is there that knows no measure,",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "joys that through all time abide.",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
