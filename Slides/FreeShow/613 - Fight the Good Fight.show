  "slides": {
    "slide_0": {
      "group": "Verse 1",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Fight the good fight with all thy might;",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Christ is thy strength, and Christ thy right;",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Lay hold on life and it shall be",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Thy joy and crown eternally.",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_1": {
      "group": "Verse 2",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Run the straight race through God's good grace;",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Lift up thine eyes, and seek His face.",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Life with its path before us lies;",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Christ is the way, and Christ the prize.",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_2": {
      "group": "Verse 3",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Cast care aside, lean on thy guide,",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "His boundless mercy will provide;",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Trust, and the trusting soul shall prove",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Christ is its life, and Christ its love.",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_3": {
      "group": "Verse 4",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Faint not, nor fear, His arms are near;",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "He changeth not, and thou art dear.",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Only believe, and thou shalt see",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "That Christ is all in all to thee.",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    }
  },
