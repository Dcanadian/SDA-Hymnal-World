  "slides": {
    "slide_0_0": {
      "group": "Verse 1",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Soon shall the trump of God",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Give out the welcome sound,",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_0_1": {
      "group": "Verse 1",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "That shakes death's silent chamber walls,",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "And breaks the turf sealed ground.",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_1_0": {
      "group": "Verse 2",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "You dwellers in the dust,",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Awake, come forth, and sing;",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_1_1": {
      "group": "Verse 2",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Sharp has your frost of winter been,",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "But bright shall be your spring.",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_2_0": {
      "group": "Verse 3",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "'Twas sown in weakness here;",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "'Twill then be raised in power;",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_2_1": {
      "group": "Verse 3",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "That which was sown in earthly seed",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Shall rise a heav'nly flower.",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    }
  },
