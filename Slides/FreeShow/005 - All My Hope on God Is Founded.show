  "meta": {
    "number": "005",
    "title": "All My Hope on God Is Founded",
    "artist": "",
    "author": "Joachim Neander",
    "composer": "Herbert Howells",
    "publisher": "Review and Herald Publishing Association",
    "copyright": "Public Domain",
