  },
  "slides": {
    "slide_0_0": {
      "group": "Verse 1",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Immortal Love, forever full,",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Forever flowing free,",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_0_1": {
      "group": "Verse 1",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Forever shared, forever whole,",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "A never ebbing sea!",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_1_0": {
      "group": "Verse 2",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "We nay not climb the heavenly steeps",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "To bring the Lord Christ down;",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_1_1": {
      "group": "Verse 2",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "In vain we search the lowest deeps,",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "For him no depths can drown.",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_2_0": {
      "group": "Verse 3",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "But warm, so tender, even yet",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "A present help is He;",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_2_1": {
      "group": "Verse 3",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "And faith has still its Olivet,",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "And love its Galilee.",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_3_0": {
      "group": "Verse 4",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "The healing of His seamless dress",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Is by our beds of pain;",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_3_1": {
      "group": "Verse 4",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "We touch Him in life's throng and press,",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "And we are whole again.",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_4_0": {
      "group": "Verse 5",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Through Him the first fond prayers are said,",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Our lips of childhood frame;",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_4_1": {
      "group": "Verse 5",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "The last low whispers of our dead",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Are burdened with His name.",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_5_0": {
      "group": "Verse 6",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "O Lord and Master of us all:",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Whate'er our names or sign,",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_5_1": {
      "group": "Verse 6",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "We own Thy sway, we hear Thy call,",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "We test our lives by Thine!",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    }
  },
