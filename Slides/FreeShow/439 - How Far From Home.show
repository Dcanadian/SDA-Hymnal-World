  "meta": {
    "number": "439",
    "title": "How Far From Home?",
    "artist": "",
    "author": "Annie R. Smith",
    "composer": "Arranged",
    "publisher": "Review and Herald Publishing Association",
    "copyright": "Public Domain",
    "CCLI": "",
