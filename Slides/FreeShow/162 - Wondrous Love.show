                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "I'll sing and joyful be, And through eternity",
                  "style": "font-size:60px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "I'll sing on, I'll sing on! And through eternity, I'll sing on",
