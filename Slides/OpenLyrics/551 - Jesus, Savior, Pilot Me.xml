  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Ab"/>Jesus, Savior, <chord name="Db"/>pilot <chord name="Ab"/>me<br/>
      Over <chord name="Db"/>life’s tem<chord name="Eb7"/>pestuous <chord name="Ab"/>sea;<br/>
      <chord name="Eb7"/>Unknown waves before me <chord name="Ab"/>roll,<br/>
      <chord name="Eb7"/>Hiding rock and treacherous <chord name="Ab"/>shoal.<br/>
      <chord name="Ab"/>Chart and compass <chord name="Db"/>come from <chord name="Ab"/>Thee;<br/>
      Jesus, <chord name="Db"/>Savior, <chord name="Eb7"/>pilot <chord name="Ab"/>me.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Ab"/>As a <chord name="Db"/>mother stills <chord name="Ab"/>her child,<br/>
      <chord name="Db"/>thou canst <chord name="Eb7"/>hush the <chord name="Ab"/>ocean wild;<br/>
      <chord name="Eb7"/>boisterous waves <chord name="Ab"/>obey thy will,<br/>
      <chord name="Eb7"/>when thou sayest <chord name="Ab"/>to them, &quot;Be still!&quot;<br/>
      <chord name="Ab"/>Wondrous <chord name="Db"/>sovreign of <chord name="Ab"/>the sea,<br/>
      <chord name="Db"/>Jesus, <chord name="Eb7"/>Savior, <chord name="Ab"/>pilot me.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Ab"/>When at <chord name="Db"/>last I <chord name="Ab"/>near the shore,<br/>
      <chord name="Db"/>and <chord name="Eb7"/>the fearful <chord name="Ab"/>breakers roar<br/>
      <chord name="Eb7"/>&#x27;twixt me and <chord name="Ab"/>the peaceful rest,<br/>
      <chord name="Eb7"/>then, while leaning <chord name="Ab"/>on thy breast,<br/>
      <chord name="Ab"/>may I <chord name="Db"/>hear thee <chord name="Ab"/>say to me,<br/>
      <chord name="Db"/>&quot;Fear not, <chord name="Eb7"/>I will <chord name="Ab"/>pilot thee.
      </lines>
    </verse>
  </lyrics>
</song>
