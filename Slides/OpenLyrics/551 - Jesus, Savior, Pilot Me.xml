      <title>551 - Jesus, Savior, Pilot Me</title>
      <title>Jesus, Savior, Pilot Me</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="551"/>
    </songbooks>
    <key>Ab</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
