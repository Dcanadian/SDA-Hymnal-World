<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>405 - O God, Unseen, Yet Ever Near</title>
      <title>O God, Unseen, Yet Ever Near</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="405"/>
    </songbooks>
    <key>Eb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Doctrines</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb/Bb"/>O God, unseen, yet ever near,<br/>
      <chord name="Eb/G"/>Reveal <chord name="Fm/C"/>Thy <chord name="Eb/Bb"/>presence <chord name="Bb"/>now<br/>
      <chord name="Bb7/Ab"/>While <chord name="Gm"/>we in <chord name="Cm/G"/>love that hath <chord name="Fm/C"/>no <chord name="Eb/Bb"/>fear,<br/>
      <chord name="Fm/Ab"/>Before <chord name="Eb/G"/>Thy <chord name="Ab"/>glory <chord name="Cm/G"/>bow.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Eb/Bb"/>Here may Thy faithful people know<br/>
      <chord name="Eb/G"/>The <chord name="Fm"/>blessings <chord name="Eb/Bb"/>of <chord name="Bb"/>Thy love,<br/>
      <chord name="Bb7/Ab"/>The <chord name="Gm"/>streams that <chord name="Cm/G"/>thro&#x27; the dessert <chord name="Eb/Bb"/>flow,<br/>
      <chord name="Fm/Ab"/>The <chord name="Eb"/>manna <chord name="Ab"/>from <chord name="Bb7/Ab"/>above.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Eb/Bb"/>We come, obedient to Thy Word<br/>
      <chord name="Eb/G"/>To <chord name="Fm"/>feast on <chord name="Eb/Bb"/>heav&#x27;nly <chord name="Bb"/>food,<br/>
      <chord name="Bb7/Ab"/>Our <chord name="Gm"/>meat, the <chord name="Cm/G"/>body of <chord name="Fm/C"/>our <chord name="Eb/Bb"/>Lord,<br/>
      <chord name="Fm/Ab"/>Our <chord name="Eb"/>drink, His <chord name="Ab"/>precious <chord name="Cm/G"/>blood.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Eb/Bb"/>Thus may we all Thy words obey,<br/>
      <chord name="Eb/G"/>For <chord name="Fm"/>we, O <chord name="Eb/Bb"/>God, <chord name="Bb"/>are Thine,<br/>
      <chord name="Bb7/Ab"/>And <chord name="Gm"/>go rejoicing <chord name="Cm"/>on <chord name="Fm/C"/>our <chord name="Eb/Bb"/>way,<br/>
      <chord name="Fm/Ab"/>Renewed <chord name="Eb/G"/>by <chord name="Ab"/>strength <chord name="Bb7/Ab"/>divine.
      </lines>
    </verse>
  </lyrics>
</song>
