    <verse name="v5">
      <lines>
      <chord name="Eb"/>Watch, as <chord name="Ab/Eb"/>if <chord name="Eb"/>on <chord name="Ab/Eb"/>that alone <chord name="Eb"/>Hung <chord name="Gm/D"/>the <chord name="Cm"/>issue <chord name="G7/B"/>of <chord name="Cm"/>teh <chord name="Ab"/>day;<br/>
      <chord name="Eb"/>Pray that <chord name="Ab/C"/>help <chord name="Eb/Bb"/>may <chord name="Ab"/>be <chord name="Bb7"/>send <chord name="Eb"/>down; <chord name="Fm"/>Watch <chord name="Bb7"/>and <chord name="Eb"/>pray!
