      <lines>
      <chord name="Eb"/>Christian, <chord name="Ab/Eb"/>seek <chord name="Eb"/>not <chord name="Ab/Eb"/>yet repose, <chord name="Eb"/>Cast <chord name="Gm/D"/>thy <chord name="Cm"/>dreams <chord name="G7/B"/>of <chord name="Cm"/>ease <chord name="Ab"/>away;<br/>
      <chord name="Eb"/>Thou aret <chord name="Ab/C"/>in <chord name="Eb/Bb"/>teh <chord name="Ab"/>midst <chord name="Bb7"/>of <chord name="Eb"/>foes; <chord name="Fm"/>Watch <chord name="Bb7"/>and <chord name="Eb"/>pray!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Eb"/>Gird thy heavenly <chord name="Ab/Eb"/>armor <chord name="Eb"/>on, Wear <chord name="Gm/D"/>it <chord name="Cm"/>ever, night <chord name="Ab"/>and <chord name="Bb"/>day;<br/>
