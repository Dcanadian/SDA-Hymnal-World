    <verse name="v3">
      <lines>
      <chord name="Eb"/>Hear the <chord name="Ab/Eb"/>victors who o&#x27;ercame; <chord name="Eb"/>Still <chord name="Gm/D"/>they <chord name="Cm"/>mark <chord name="G7/B"/>each <chord name="Cm"/>warrior&#x27;s <chord name="Bb"/>way;<br/>
      <chord name="Eb"/>All with <chord name="Ab/C"/>one <chord name="Eb/Bb"/>sweet <chord name="Ab"/>voice <chord name="Bb7"/>exclaim: <chord name="Fm"/>&quot;Watch <chord name="Bb7"/>and <chord name="Eb"/>pray!&quot;
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Eb"/>Hear, above all, <chord name="Ab/Eb"/>hear thy <chord name="Eb"/>Lord, Him <chord name="Gm/D"/>thou <chord name="Cm"/>lovest to <chord name="Ab"/>obey;<br/>
      <chord name="Eb"/>Hide within thy <chord name="Ab"/>heart <chord name="Bb7"/>His <chord name="Eb"/>word; <chord name="Fm"/>&quot;Watch <chord name="Bb7"/>and <chord name="Eb"/>pray!&quot;
