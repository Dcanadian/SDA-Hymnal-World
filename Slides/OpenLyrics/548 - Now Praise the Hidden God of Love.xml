  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C"/>Now <chord name="F"/>praise <chord name="Edim"/>the <chord name="Dm"/>hidden <chord name="C7"/>God of love<br/>
      <chord name="F/A"/>In <chord name="Bb"/>whom <chord name="C7/G"/>we <chord name="F/A"/>all <chord name="G/B"/>must <chord name="C"/>live <chord name="Gm"/>and <chord name="C"/>move,<br/>
      <chord name="C"/>Who <chord name="F"/>shepherds <chord name="Dm"/>us, <chord name="Gm"/>at every <chord name="C7"/>stage<br/>
      <chord name="F/A"/>Thro&#x27; <chord name="Bb"/>youth, <chord name="C7/G"/>maturity, <chord name="F/C"/>and <chord name="C7"/>age.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="C"/>Who <chord name="F"/>challenged <chord name="Gm"/>us, when <chord name="C7"/>were young<br/>
      <chord name="F/A"/>To <chord name="Bb"/>storm <chord name="C7/G"/>the <chord name="F/A"/>citadels <chord name="Gm"/>of <chord name="C"/>wrong;<br/>
      <chord name="C"/>In <chord name="F"/>care <chord name="Am"/>for <chord name="Dm"/>others <chord name="C7"/>taught us how<br/>
      <chord name="F/A"/>God&#x27;s <chord name="Bb"/>true <chord name="C7/G"/>community <chord name="F/C"/>must <chord name="C7"/>grow.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="C"/>Who <chord name="F"/>bids <chord name="Edim"/>us <chord name="Dm"/>never <chord name="C7"/>lose our zest,<br/>
      <chord name="F/A"/>Tho&#x27; <chord name="Bb"/>age <chord name="C7/G"/>is <chord name="F/A"/>urging <chord name="C"/>us <chord name="Gm"/>to <chord name="C"/>rest,<br/>
      <chord name="C"/>But <chord name="F"/>proves <chord name="Dm"/>to <chord name="Gm"/>us that <chord name="C7"/>we have still<br/>
      <chord name="F/A"/>A <chord name="Bb"/>work <chord name="C7/G"/>to <chord name="F/A"/>do, <chord name="Bb"/>a place <chord name="F/C"/>to <chord name="C7"/>fill.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="C"/>Then <chord name="F"/>talk <chord name="Edim"/>no <chord name="Dm"/>more <chord name="Gm"/>of <chord name="C7"/>wasted time,<br/>
      <chord name="F/A"/>But <chord name="Bb"/>Godward <chord name="F/A"/>look, <chord name="G/B"/>and <chord name="C"/>upward climb,<br/>
      <chord name="C"/>Content <chord name="Am"/>to <chord name="Dm"/>sleep, <chord name="Gm"/>when <chord name="C7"/>day is done,<br/>
      <chord name="F/A"/>And <chord name="Bb"/>rise <chord name="C7/G"/>refreshed, <chord name="Bb"/>and travel <chord name="C7"/>on.
      </lines>
    </verse>
