<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>060 - Blessed Jesus at Thy Word</title>
      <title>Blessed Jesus at Thy Word</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="60"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Worship</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>Blessed Jesus, <chord name="Am"/>at Thy word,<br/>
      <chord name="Em/B"/>We <chord name="Bm"/>are <chord name="G"/>gathered <chord name="D7/C"/>all to <chord name="D"/>hear <chord name="D7/C"/>Thee;<br/>
      <chord name="G"/>Let our <chord name="Am"/>hearts and <chord name="G"/>souls <chord name="Am"/>be stirred,<br/>
      <chord name="Em/B"/>Now <chord name="Bm"/>to seek <chord name="G"/>and love <chord name="D7/C"/>and <chord name="G/D"/>fear <chord name="D"/>Thee.<br/>
      <chord name="Em/B"/>By <chord name="Bm"/>Thy <chord name="D/A"/>teachings sweet <chord name="Em/B"/>and <chord name="Am"/>holy,<br/>
      <chord name="G"/>Drawn <chord name="Em"/>from earth <chord name="D7/C"/>to <chord name="G"/>love <chord name="C"/>Thee <chord name="G"/>sole <chord name="D7/C"/>ly.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>All our <chord name="Am"/>knowledge, <chord name="G"/>sense, <chord name="Am"/>and sight,<br/>
      <chord name="Em/B"/>Lie <chord name="Bm"/>in <chord name="G"/>deepest <chord name="D7/C"/>darkness <chord name="D"/>shrouded;<br/>
      <chord name="G"/>Till Thy <chord name="Am"/>Spirit <chord name="G"/>breaks <chord name="Am"/>our night,<br/>
      <chord name="Em/B"/>With <chord name="Bm"/>His beams <chord name="G"/>of truth <chord name="D7/C"/>unclouded.<br/>
      <chord name="Em/B"/>He <chord name="Bm"/>alone <chord name="C/G"/>to <chord name="D/A"/>God <chord name="Em/B"/>canst <chord name="Am"/>win <chord name="D/A"/>us,<br/>
      <chord name="G"/>He <chord name="Em"/>who works <chord name="G"/>all <chord name="C"/>good within <chord name="D7/C"/>us.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>Glorious <chord name="Am"/>Lord, Thy <chord name="G"/>self <chord name="Am"/>impart!<br/>
      <chord name="Em/B"/>Light <chord name="Bm"/>of <chord name="G"/>light, from <chord name="D7/C"/>God proceeding.<br/>
      <chord name="G"/>Open <chord name="Am"/>Thou our <chord name="G"/>ears <chord name="Am"/>and heart<br/>
      <chord name="Em/B"/>Help <chord name="Bm"/>us, by <chord name="G"/>Thy Spirit&#x27;s pleading.<br/>
      <chord name="Em/B"/>Hear <chord name="Bm"/>the <chord name="D/A"/>cry <chord name="C/G"/>Thy <chord name="D/A"/>people <chord name="Am"/>raises!<br/>
      <chord name="G"/>Hear, <chord name="Em"/>and bless <chord name="G"/>our <chord name="C"/>prayer and <chord name="Am/E"/>praises!
      </lines>
    </verse>
  </lyrics>
</song>
