<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>078 - For God So Loved Us</title>
      <title>For God So Loved Us</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="78"/>
    </songbooks>
    <key>D</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3 v4</verseOrder>
    <themes>
      <theme>God the Father</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>For God so loved us,<br/>
      <chord name="D"/>He <chord name="Bm"/>sent the <chord name="G"/>Savior:<br/>
      <chord name="D"/>For God so <chord name="A7/E"/>loved us,<br/>
      <chord name="A7"/>and loves me too.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="D"/>Love so <chord name="A7/E"/>unending!<br/>
      <chord name="A7"/>I&#x27;ll sing His <chord name="D"/>praises,<br/>
      <chord name="A7/E"/>God loves His children,<br/>
      <chord name="D"/>loves even me.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>He sent the Savior,<br/>
      <chord name="D"/>the <chord name="Bm"/>blest Redeemer;<br/>
      <chord name="D"/>He sent the <chord name="A7/E"/>Savior<br/>
      <chord name="A7"/>to set me free.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D"/>He bade me welcome,<br/>
      <chord name="D"/>O <chord name="Bm"/>word of <chord name="G"/>mercy;<br/>
      <chord name="D"/>He bade me <chord name="A7/E"/>welcome,<br/>
      <chord name="A7"/>O voice divine.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="D"/>Glory and honor,<br/>
      <chord name="D"/>O <chord name="Bm"/>Love eternal,<br/>
      <chord name="D"/>To Him be <chord name="A7/E"/>given<br/>
      <chord name="A7"/>while life shall last.
      </lines>
    </verse>
  </lyrics>
</song>
