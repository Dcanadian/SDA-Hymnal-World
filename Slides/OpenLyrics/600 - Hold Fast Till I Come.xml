<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>600 - Hold Fast Till I Come</title>
      <title>Hold Fast Till I Come</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="600"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Bb"/>Sweet promise <chord name="C"/>is <chord name="C7"/>given to <chord name="F"/>all who believe—<br/>
      <chord name="F"/>“Behold I come quickly, Mine own to receive;<br/>
      <chord name="F"/>Hold fast till <chord name="Bb/F"/>Icome; <chord name="F"/>the danger is great;<br/>
      <chord name="C"/>Sleep not <chord name="F/C"/>as do <chord name="C7"/>others; <chord name="F/C"/>be <chord name="C"/>watchful, <chord name="F"/>and wait.”
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="F"/>&quot;Hold fast <chord name="C"/>till I <chord name="C7"/>come,&quot; <chord name="F/C"/>sweet promise <chord name="C7"/>of heaven--<br/>
      <chord name="F/A"/>&quot;The kingdom restored, <chord name="C"/>to you shall <chord name="F"/>be given.&quot;<br/>
      <chord name="F"/>&quot;Come, enter <chord name="Bb/F"/>My joy, <chord name="F"/>sit down on the throne;<br/>
      <chord name="C"/>Bright crowns <chord name="F/C"/>are in <chord name="C7"/>waiting; <chord name="F/C"/>hold <chord name="C7"/>fast <chord name="Gm/D"/>till I <chord name="Dm"/>come.&quot;
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Bb"/>We&#x27;ll &quot;watch <chord name="C"/>unto <chord name="C7"/>prayer&quot; with <chord name="F"/>lamps burning bright;<br/>
      <chord name="F"/>He comes to all others a &quot;thief in the night.&quot;<br/>
      <chord name="F"/>We know He <chord name="Bb/F"/>is near, <chord name="F"/>but know not the day--<br/>
      <chord name="C"/>As spring <chord name="F/C"/>shows that <chord name="C7"/>summer <chord name="F/C"/>is <chord name="C"/>not <chord name="F"/>far away.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Bb"/>Yes! this <chord name="C"/>is <chord name="C7"/>our hope, &#x27;tis <chord name="F"/>built on His word--<br/>
      <chord name="F"/>The glorious appearing of Jesus, our Lord;<br/>
      <chord name="F"/>Of promises <chord name="Bb/F"/>all, <chord name="F"/>it stands as the sum:<br/>
      <chord name="C"/>&quot;Behold <chord name="F/C"/>I come <chord name="C7"/>quickly; <chord name="F/C"/>hold <chord name="C"/>fast <chord name="F"/>till I come.&quot;
      </lines>
    </verse>
  </lyrics>
</song>
