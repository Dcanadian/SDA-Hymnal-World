      <title>690 - Dismiss Us, Lord With Blessing</title>
      <title>Dismiss Us, Lord With Blessing</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="690"/>
    </songbooks>
    <key>C</key>
    <tempo type="bpm">Moderato</tempo>
