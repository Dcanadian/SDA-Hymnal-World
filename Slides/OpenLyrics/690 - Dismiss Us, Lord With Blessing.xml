  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C"/>Dismiss us, <chord name="F/C"/>Lord, <chord name="C"/>with <chord name="G"/>blessing, <chord name="G7"/>we pray;<br/>
      <chord name="G7"/>As from Thy worship <chord name="C"/>we go our ways;<br/>
      <chord name="C"/>Guide in life’s conflicts, <chord name="Dm/F"/>all <chord name="F"/>through <chord name="G7/F"/>the <chord name="F"/>day;<br/>
      <chord name="F/A"/>Save in <chord name="G#7"/>Thy <chord name="C/G"/>kingdom, Thine <chord name="G7/D"/>be the <chord name="C"/>praise.<br/>
      <chord name="F"/>Amen.
      </lines>
    </verse>
  </lyrics>
