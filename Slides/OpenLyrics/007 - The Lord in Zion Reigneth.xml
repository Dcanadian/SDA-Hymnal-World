    <verse name="v1">
      <lines>
      <chord name="A7"/>The <chord name="D"/>Lord in <chord name="A7"/>Zion <chord name="D"/>reigneth, Let all the <chord name="F#7"/>world re<chord name="Bm"/>joice,<br/>
      <chord name="A7"/>And <chord name="D"/>come be<chord name="G"/>fore His <chord name="D"/>throne of grace <chord name="G7"/>With <chord name="A"/>tuneful <chord name="E7"/>heart and <chord name="A"/>voice;<br/>
