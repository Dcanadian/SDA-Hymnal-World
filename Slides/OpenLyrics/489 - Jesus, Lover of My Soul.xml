<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>489 - Jesus, Lover of My Soul</title>
      <title>Jesus, Lover of My Soul</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="489"/>
    </songbooks>
    <key>Eb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb/Bb"/>Jesus, lover <chord name="Bb"/>of my soul,<br/>
      <chord name="Bb"/>Let me <chord name="Bb7"/>to thy bosom <chord name="Cm/G"/>fly,<br/>
      <chord name="Gm"/>While the billows <chord name="Bb"/>near me roll,<br/>
      <chord name="Bb"/>While <chord name="Bb7"/>the tempest <chord name="Gm"/>still is high;<br/>
      <chord name="Ab"/>Hide me, <chord name="Gm"/>O my Savior, hide!<br/>
      <chord name="Gm"/>Till the storm of life is past;<br/>
      <chord name="Bb"/>Safe into the haven <chord name="Eb/Bb"/>guide,<br/>
      <chord name="Bb"/>O receive <chord name="Bb7"/>my soul at <chord name="Cm/G"/>last!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Eb/Bb"/>Other refuge <chord name="Bb"/>has I none,<br/>
      <chord name="Bb"/>Hangs my <chord name="Bb7"/>helpless soul on <chord name="Cm/G"/>thee;<br/>
      <chord name="Gm"/>Leave O leave me <chord name="Bb"/>not alone!<br/>
      <chord name="Bb"/>Still <chord name="Bb7"/>support <chord name="Cm/G"/>and <chord name="Gm"/>comfort me;<br/>
      <chord name="Ab"/>All my <chord name="Gm"/>trust on Thee is stayed,<br/>
      <chord name="Gm"/>All my help from Thee I bring;<br/>
      <chord name="Bb"/>Cover my defenseless <chord name="Eb/Bb"/>head<br/>
      <chord name="Bb"/>With the <chord name="Bb7"/>shadow of Thy <chord name="Cm/G"/>wing.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Eb/Bb"/>Thou, O Christ, all <chord name="Bb"/>I want,<br/>
      <chord name="Bb"/>More than <chord name="Bb7"/>all in Thee I <chord name="Cm/G"/>find;<br/>
      <chord name="Gm"/>Raise the fallen, <chord name="Bb"/>cheer the faint,<br/>
      <chord name="Bb"/>Heal <chord name="Bb7"/>the sick, <chord name="Cm/G"/>and <chord name="Gm"/>lead the blind.<br/>
      <chord name="Ab"/>Just and <chord name="Gm"/>holy is Thy name,<br/>
      <chord name="Gm"/>I am all unrighteousness;<br/>
      <chord name="Bb"/>Vile and full of sin <chord name="Eb/Bb"/>I am;<br/>
      <chord name="Bb"/>Thou art <chord name="Bb7"/>full of truth and <chord name="Cm/G"/>grace.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Eb/Bb"/>Plenteous grace with <chord name="Bb"/>Thee is found-<br/>
      <chord name="Bb"/>Grace to <chord name="Bb7"/>pardon all my <chord name="Cm/G"/>sin;<br/>
      <chord name="Gm"/>Let the healing <chord name="Bb"/>streams abound,<br/>
      <chord name="Bb"/>Make <chord name="Bb7"/>and keep <chord name="Cm/G"/>me <chord name="Gm"/>pure within;<br/>
      <chord name="Ab"/>Thou of <chord name="Gm"/>life the Fountain art,<br/>
      <chord name="Gm"/>Freely let me take of Thee;<br/>
      <chord name="Bb"/>Spring Thou up within my <chord name="Eb/Bb"/>heart,<br/>
      <chord name="Bb"/>Rise to <chord name="Bb7"/>all eternity.
      </lines>
    </verse>
  </lyrics>
</song>
