  <properties>
    <titles>
      <title>358 - Far and Near the Fields Are Teeming</title>
      <title>Far and Near the Fields Are Teeming</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="358"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
