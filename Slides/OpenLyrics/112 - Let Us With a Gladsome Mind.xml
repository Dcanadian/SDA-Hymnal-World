  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Gm/D"/>Let us <chord name="Dm/A"/>with agladsome <chord name="Eb"/>mind<br/>
      <chord name="Bb"/>Praise <chord name="Eb"/>the <chord name="Adim"/>Lord, <chord name="Bb"/>for <chord name="F/C"/>He <chord name="Cm"/>is <chord name="Dm/A"/>kind:<br/>
      <chord name="Adim"/>For <chord name="Gm"/>His mercies <chord name="F7/Eb"/>shall <chord name="Bb"/>endure,<br/>
      <chord name="Bb"/>Ever faithful, ever <chord name="F"/>sure.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Gm/D"/>He, with <chord name="Dm/A"/>all commanding <chord name="Eb"/>might,<br/>
      <chord name="Bb"/>Filled <chord name="Eb"/>the <chord name="Adim"/>new <chord name="Bb"/>made <chord name="F/C"/>world <chord name="Cm"/>with <chord name="Dm/A"/>light:<br/>
      <chord name="Adim"/>For <chord name="Gm"/>His mercies <chord name="F7/Eb"/>shall <chord name="Bb"/>endure,<br/>
      <chord name="Bb"/>Ever faithful, ever <chord name="F"/>sure.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Gm/D"/>All things <chord name="Dm/A"/>living <chord name="Gm"/>He <chord name="Eb"/>does feed;<br/>
      <chord name="Bb"/>His <chord name="Eb"/>full <chord name="Adim"/>hand <chord name="Bb"/>supplies <chord name="Cm"/>their <chord name="Dm/A"/>need:<br/>
      <chord name="Adim"/>For <chord name="Gm"/>His mercies <chord name="F7/Eb"/>shall <chord name="Bb"/>endure,<br/>
      <chord name="Bb"/>Ever faithful, ever <chord name="F"/>sure.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Gm/D"/>Let us <chord name="Dm/A"/>then with <chord name="Gm"/>gladsome <chord name="Eb"/>mind<br/>
      <chord name="Bb"/>Praise <chord name="Eb"/>the <chord name="Adim"/>Lord, <chord name="Bb"/>for <chord name="F/C"/>He <chord name="Cm"/>is <chord name="Dm/A"/>kind:<br/>
      <chord name="Adim"/>For <chord name="Gm"/>His mercies <chord name="F7/Eb"/>shall <chord name="Bb"/>endure,<br/>
      <chord name="Bb"/>Ever faithful, ever <chord name="F"/>sure.
      </lines>
    </verse>
