      <lines>
      <chord name="C"/>Drop <chord name="B"/>thy still <chord name="C"/>dews <chord name="D7"/>of quietness,<br/>
      <chord name="G7"/>till <chord name="C"/>all <chord name="Am"/>our <chord name="D7"/>strivings <chord name="G"/>cease;<br/>
