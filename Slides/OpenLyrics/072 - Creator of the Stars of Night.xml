  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Gm"/>Creator <chord name="Eb/G"/>of the <chord name="Cm"/>stars of night,<br/>
      <chord name="Eb"/>Thy people&#x27;s <chord name="Ab"/>ever <chord name="Bb7"/>lasting light,<br/>
      <chord name="Eb"/>O Christ, <chord name="Fm"/>Thou Savior <chord name="Eb/Bb"/>of <chord name="Bb"/>us <chord name="Cm"/>all,<br/>
      <chord name="Cm"/>We <chord name="Ab/C"/>pray <chord name="Bb/F"/>Thee, <chord name="Fm"/>hear <chord name="Ab"/>us <chord name="Fm/Ab"/>when <chord name="Gm"/>we call.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Gm"/>At <chord name="Eb/G"/>the great name <chord name="Cm"/>of Jesus, <chord name="Eb"/>now<br/>
      <chord name="Eb"/>All knees <chord name="Ab"/>must bend, <chord name="Bb7/Ab"/>all hearts <chord name="Eb/Bb"/>must <chord name="Bb7"/>bow;<br/>
      <chord name="Eb"/>And things <chord name="Fm"/>celestial <chord name="Eb/Bb"/>Thee <chord name="Bb"/>shall <chord name="Cm"/>own,<br/>
      <chord name="Cm"/>And <chord name="Ab/C"/>things <chord name="Bb/F"/>terrestial, <chord name="Fm/Ab"/>Lord <chord name="Gm"/>alone.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Gm"/>To <chord name="Eb/G"/>God the Father, <chord name="Cm"/>God the <chord name="Eb"/>Son,<br/>
      <chord name="Eb"/>And God <chord name="Ab"/>the Spirit, <chord name="Bb7"/>Three <chord name="Eb/Bb"/>in <chord name="Bb7"/>one,<br/>
      <chord name="Eb"/>Laud, honor, <chord name="Fm"/>might, <chord name="Bb7"/>and <chord name="Eb/Bb"/>glory <chord name="Cm"/>be<br/>
      <chord name="Cm"/>From age <chord name="Ab/C"/>to <chord name="Bb/F"/>age <chord name="Fm"/>eternally. <chord name="Gm"/>Amen.
      </lines>
    </verse>
  </lyrics>
