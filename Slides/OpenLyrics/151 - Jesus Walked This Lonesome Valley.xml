      <title>Jesus Walked This Lonesome Valley</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="151"/>
    </songbooks>
