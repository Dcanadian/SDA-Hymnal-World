  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Db"/>O perfect <chord name="Ab7/Eb"/>Love, all <chord name="Fm"/>human <chord name="Ebm"/>thought <chord name="Fm"/>transcending,<br/>
      <chord name="Gb"/>Lowly <chord name="Ab7/Gb"/>we <chord name="Fm"/>kneel in <chord name="Bbm"/>prayer before <chord name="Ebm"/>Thy <chord name="Ab"/>throne,<br/>
      <chord name="Db"/>That theirs may <chord name="Ab7/Eb"/>be the <chord name="Fm"/>love which knows no <chord name="Ab7/Gb"/>end <chord name="Gb"/>ing,<br/>
      <chord name="Gb"/>Whom <chord name="Ab"/>Thou <chord name="Ab7"/>forever <chord name="Gb"/>more dost <chord name="Ab7"/>join inone.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Db"/>O perfect <chord name="Ab7/Eb"/>Life, be <chord name="Fm"/>thou <chord name="Db"/>their <chord name="Ebm"/>full <chord name="Fm"/>assurance<br/>
      <chord name="Gb"/>of <chord name="Ab7/Gb"/>tender <chord name="Fm"/>charity <chord name="Bbm"/>and <chord name="Ebm"/>steadfast <chord name="Ab"/>faith,<br/>
      <chord name="Db"/>of patient <chord name="Ab7/Eb"/>hope and <chord name="Fm"/>quiet, brave endurance,<br/>
      <chord name="Gb"/>with <chord name="Ab"/>childlike <chord name="Bbm"/>trust <chord name="Fm"/>that <chord name="Gb"/>fears nor <chord name="Ab7"/>pain nor <chord name="Db"/>death.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Db"/>Grant them the <chord name="Ab7/Eb"/>joy which <chord name="Fm"/>brightens <chord name="Ebm"/>earthly <chord name="Gb"/>sorrow;<br/>
      <chord name="Gb"/>grant <chord name="Ab7/Gb"/>them the <chord name="Fm"/>peace which <chord name="Bbm"/>calms all <chord name="Ebm"/>earthly <chord name="Ab"/>strife,<br/>
      <chord name="Db"/>and to life&#x27;s <chord name="Ab7/Eb"/>day the <chord name="Fm"/>glorious unknown <chord name="Ab7/Gb"/>morrow<br/>
      <chord name="Gb"/>that <chord name="Ab"/>dawns <chord name="Ab7"/>upon <chord name="Fm"/>eternal <chord name="Ab7"/>love and <chord name="Db"/>life.
