    <verse name="v4">
      <lines>
      <chord name="C"/>O <chord name="F"/>that <chord name="C"/>with <chord name="Dm"/>yonder <chord name="C"/>angel <chord name="F"/>throng <chord name="C7"/>we <chord name="Dm"/>at <chord name="F"/>His <chord name="C7"/>feet <chord name="F"/>may fall!<br/>
