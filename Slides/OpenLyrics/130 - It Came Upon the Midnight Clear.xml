<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>130 - It Came Upon the Midnight Clear</title>
      <title>It Came Upon the Midnight Clear</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="130"/>
    </songbooks>
    <key>Ab</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Jesus Christ</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Ab"/>It came upon the midnight clear,<br/>
      <chord name="Db"/>That glorious <chord name="Bb7"/>song of <chord name="Eb/Bb"/>old,<br/>
      <chord name="Ab"/>From angels <chord name="Db/Ab"/>bending <chord name="Ab"/>near the earth<br/>
      <chord name="Bbm"/>To touch their <chord name="Eb7"/>harps of <chord name="Ab"/>gold:<br/>
      <chord name="Ab"/>“Peace <chord name="Cm"/>on the earth, <chord name="Fm/Ab"/>goodwill to <chord name="Ab"/>men,<br/>
      <chord name="Bbm"/>From heaven’s <chord name="Eb/Bb"/>all <chord name="Ab"/>gracious <chord name="Db/Ab"/>King;”<br/>
      <chord name="Ab"/>The world in solemn <chord name="Bbm"/>stillness <chord name="Eb7"/>lay,<br/>
      <chord name="Ab"/>To hear the angels sing.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Ab"/>Still through the <chord name="Db/Ab"/>cloven <chord name="Ab"/>skies they come,<br/>
      <chord name="Db"/>With peaceful <chord name="Bb7"/>wings unfurled;<br/>
      <chord name="Ab"/>And still their heavenly music floats<br/>
      <chord name="Bbm"/>O&#x27;er all the <chord name="Eb7"/>weary <chord name="Ab"/>world:<br/>
      <chord name="Ab"/>Above <chord name="Cm"/>its sad <chord name="Fm/Ab"/>and lowly <chord name="Ab"/>plains<br/>
      <chord name="Bbm"/>They bend on <chord name="Eb/Bb"/>hovering <chord name="Db/Ab"/>wing,<br/>
      <chord name="Ab"/>And ever o&#x27;er <chord name="Bbm"/>its Babel <chord name="Eb7"/>sounds<br/>
      <chord name="Ab"/>The blessed angels sing.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Ab"/>O ye beneath <chord name="Db/Ab"/>life&#x27;s <chord name="Ab"/>crushing load,<br/>
      <chord name="Db"/>Whose forms are <chord name="Bb7"/>bending <chord name="Eb/Bb"/>low,<br/>
      <chord name="Ab"/>Who toil along <chord name="Db/Ab"/>the <chord name="Ab"/>climbing way<br/>
      <chord name="Bbm"/>With painful <chord name="Eb7"/>steps and <chord name="Ab"/>slow;<br/>
      <chord name="Ab"/>Look <chord name="Cm"/>now, for glad <chord name="Fm/Ab"/>and golden <chord name="Ab"/>hours<br/>
      <chord name="Bbm"/>Come swiftly <chord name="Eb"/>on <chord name="Ab"/>the <chord name="Db/Ab"/>wing;<br/>
      <chord name="Ab"/>Oh rest beside <chord name="Bbm"/>the weary <chord name="Eb7"/>road<br/>
      <chord name="Ab"/>And hear the angels sing.
      </lines>
    </verse>
  </lyrics>
</song>
