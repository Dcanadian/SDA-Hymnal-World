  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Ab"/>It came up<chord name="Db"/>on the <chord name="Ab"/>mid<chord name="Db"/>night <chord name="Ab"/>clear,<br/>
      That <chord name="Db"/>glorious <chord name="Bb7"/>song of <chord name="Eb"/>old,<br/>
      <chord name="Ab"/>From angels <chord name="Db"/>bending <chord name="Ab"/>near <chord name="Db"/>the <chord name="Ab"/>earth<br/>
      To <chord name="Db"/>touch <chord name="Bbm7"/>their <chord name="Eb7"/>harps of <chord name="Ab"/>gold:<br/>
      <chord name="C"/>“Peace on the earth, <chord name="C7"/>good<chord name="Fm"/>will <chord name="C"/>to <chord name="Fm"/>men,<br/>
      From <chord name="Eb"/>heaven’s all <chord name="Bb7"/>gracious <chord name="Eb"/>King;”<br/>
      <chord name="Eb7"/>The <chord name="Ab"/>world in <chord name="Db"/>solemn <chord name="Ab"/>still<chord name="Db"/>ness<chord name="Ab"/> lay,<br/>
      To <chord name="Db"/>hear <chord name="Bb7"/>the <chord name="Eb"/>angels <chord name="Ab"/>sing.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Ab"/>Still <chord name="Db"/>through <chord name="Ab"/>the cloven <chord name="Db"/>skies <chord name="Ab"/>they come,<br/>
      <chord name="Db"/>With <chord name="Bb7"/>peaceful <chord name="Eb"/>wings unfurled;<br/>
      <chord name="Ab"/>And <chord name="Db"/>still <chord name="Ab"/>their <chord name="Db"/>heavenly <chord name="Ab"/>music floats<br/>
      <chord name="Db"/>O&#x27;er <chord name="Bbm7"/>all <chord name="Eb7"/>the <chord name="Ab"/>weary world:<br/>
      <chord name="C"/>Above <chord name="C7"/>its <chord name="Fm"/>sad <chord name="C"/>and <chord name="Fm"/>lowly plains<br/>
      <chord name="Eb"/>They <chord name="Bb7"/>bend on <chord name="Eb"/>hovering wing,<br/>
      <chord name="Eb7"/>And <chord name="Ab"/>ever <chord name="Db"/>o&#x27;er <chord name="Ab"/>its <chord name="Db"/>Babel <chord name="Ab"/>sounds<br/>
      <chord name="Db"/>The <chord name="Bb7"/>blessed <chord name="Eb"/>angels <chord name="Ab"/>sing.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Ab"/>O <chord name="Db"/>ye <chord name="Ab"/>beneath <chord name="Db"/>life&#x27;s <chord name="Ab"/>crushing load,<br/>
      <chord name="Db"/>Whose <chord name="Bb7"/>forms are <chord name="Eb"/>bending low,<br/>
      <chord name="Ab"/>Who <chord name="Db"/>toil <chord name="Ab"/>along <chord name="Db"/>the <chord name="Ab"/>climbing way<br/>
      <chord name="Db"/>With <chord name="Bbm7"/>painful <chord name="Eb7"/>steps <chord name="Ab"/>and slow;<br/>
      <chord name="C"/>Look <chord name="C7"/>now, <chord name="Fm"/>for glad <chord name="C"/>and <chord name="Fm"/>golden hours<br/>
      <chord name="Eb"/>Come <chord name="Bb7"/>swiftly on <chord name="Eb"/>the wing;<br/>
      <chord name="Eb7"/>Oh <chord name="Ab"/>rest <chord name="Db"/>beside <chord name="Ab"/>the <chord name="Db"/>weary <chord name="Ab"/>road<br/>
      <chord name="Db"/>And <chord name="Bb7"/>hear <chord name="Eb"/>the <chord name="Ab"/>angels sing.
      </lines>
    </verse>
