<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>624 - I Want Jesus to Walk With Me</title>
      <title>I Want Jesus to Walk With Me</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="624"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Dm"/>I want Jesus <chord name="Gm"/>to <chord name="Dm/A"/>walk <chord name="Am"/>with <chord name="Dm"/>me.<br/>
      <chord name="C7"/>I want <chord name="F"/>Jesus to <chord name="Dm"/>walk with me.<br/>
      <chord name="Am"/>All along <chord name="Dm"/>my <chord name="Gm"/>pilgrim <chord name="C7"/>journey,<br/>
      <chord name="Gm"/>I want Jesus <chord name="Dm/A"/>to <chord name="Gm"/>walk <chord name="Dm/A"/>with <chord name="Am"/>me.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Dm"/>In my trials Lord, <chord name="Gm"/>walk <chord name="Dm/A"/>with <chord name="Am"/>me.<br/>
      <chord name="C7"/>In my <chord name="F"/>trials <chord name="C7/G"/>Lord, <chord name="Dm"/>walk with me.<br/>
      <chord name="Am"/>When the <chord name="Dm"/>shades <chord name="Gm"/>of life <chord name="C7"/>are <chord name="Dm"/>falling,<br/>
      <chord name="Gm"/>I want Jesus <chord name="Dm/A"/>to <chord name="Gm"/>walk <chord name="Dm/A"/>with <chord name="Am"/>me.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Dm"/>In my sorrows, <chord name="Gm"/>Lord, <chord name="Dm/A"/>walk <chord name="Am"/>with <chord name="Dm"/>me.<br/>
      <chord name="C7"/>In my <chord name="F"/>sorrows, Lord, <chord name="Dm"/>walk with me.<br/>
      <chord name="Am"/>When my <chord name="Dm"/>heart within <chord name="Gm"/>is <chord name="C7"/>aching,<br/>
      <chord name="Gm"/>I want Jesus <chord name="Dm/A"/>to <chord name="Gm"/>walk <chord name="Dm/A"/>with <chord name="Am"/>me.
      </lines>
    </verse>
  </lyrics>
</song>
