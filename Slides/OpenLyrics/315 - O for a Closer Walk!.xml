      <title>O for a Closer Walk!</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="315"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
