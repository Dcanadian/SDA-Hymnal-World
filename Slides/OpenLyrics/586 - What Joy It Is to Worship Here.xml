<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>586 - What Joy It Is to Worship Here</title>
      <title>What Joy It Is to Worship Here</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="586"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>What <chord name="G"/>joy it is to <chord name="D"/>worship here,<br/>
      <chord name="Am"/>And find ourselves <chord name="G"/>at home,<br/>
      <chord name="D7/C"/>Where <chord name="Am"/>God, who uses <chord name="D7"/>every gift,<br/>
      <chord name="G"/>Has room for all who come!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>Yet <chord name="G"/>are no two of <chord name="D"/>us alike<br/>
      <chord name="Am"/>Of all the <chord name="G/D"/>human race,<br/>
      <chord name="D7/C"/>And <chord name="Am"/>we must seek <chord name="D7"/>a common ground<br/>
      <chord name="G"/>If we would share His grace.
      </lines>
    </verse>
  </lyrics>
</song>
