    <verse name="v2">
      <lines>
      <chord name="Cm"/>To <chord name="Gm"/>this <chord name="Fm"/>temple <chord name="Cm"/>where <chord name="Gm"/>we call <chord name="Cm"/>You,<br/>
      <chord name="Ab"/>Come, <chord name="Gm"/>O <chord name="Fm"/>Lord of <chord name="Cm/G"/>hosts, <chord name="Gm"/>and <chord name="Cm"/>stay;<br/>
      <chord name="Cm"/>Come, <chord name="Bb"/>with <chord name="Cm/G"/>all <chord name="Bb/F"/>Your <chord name="Eb"/>loving <chord name="G7/B"/>kindness,<br/>
      <chord name="Cm"/>Hear <chord name="Bb7"/>Your <chord name="Eb"/>people <chord name="Cm/G"/>as <chord name="Gm"/>they <chord name="Cm"/>pray;<br/>
      <chord name="Cm"/>And Your fullest <chord name="Ab"/>benediction<br/>
      <chord name="Db"/>Shed within <chord name="Gm"/>these <chord name="Ab"/>walls <chord name="Gm"/>today.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Cm"/>Grant, <chord name="Gm"/>we <chord name="Fm"/>pray <chord name="Gm"/>to <chord name="Cm"/>all <chord name="Gm"/>Your faithful<br/>
