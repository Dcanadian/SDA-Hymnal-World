<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>475 - Balm in Gilead</title>
      <title>Balm in Gilead</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="475"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C7/Bb"/>There is a balm in <chord name="F/C"/>Gilead<br/>
      <chord name="Gm/D"/>To make <chord name="F/C"/>the wounded <chord name="C7/Bb"/>whole;<br/>
      <chord name="C7/Bb"/>There is a balm in <chord name="F/C"/>Gilead<br/>
      <chord name="F/C"/>To heal <chord name="C7/Bb"/>the sin-sick <chord name="Dm/A"/>soul.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="C7/Bb"/>Sometimes I feel <chord name="F/C"/>discouraged,<br/>
      <chord name="Gm/D"/>And think <chord name="F/C"/>my <chord name="C7/Bb"/>work&#x27;s in <chord name="Gm/D"/>vain,<br/>
      <chord name="C7/Bb"/>But then the Holy <chord name="F/C"/>Spirit<br/>
      <chord name="F/C"/>Revives <chord name="C7/Bb"/>my soul <chord name="Dm/A"/>again.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="C7/Bb"/>If you can <chord name="Dm/A"/>not <chord name="C7"/>preach like <chord name="F/A"/>Peter,<br/>
      <chord name="Gm/D"/>If you <chord name="F/C"/>can not <chord name="C7/Bb"/>pray like <chord name="Gm/D"/>Paul,<br/>
      <chord name="C7/Bb"/>You can tell <chord name="Dm/A"/>the <chord name="C7"/>love of <chord name="F/A"/>Jesus,<br/>
      <chord name="F/C"/>And say <chord name="C7/Bb"/>He died <chord name="Dm/A"/>for all.
      </lines>
    </verse>
  </lyrics>
</song>
