  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Let all things <chord name="C"/>now <chord name="F"/>living <chord name="Dm"/>a<chord name="Gm"/>song of thanks<chord name="C"/>giving<br/>
      <chord name="C7"/>To <chord name="F"/>God the Cre<chord name="Bb"/>ator tri<chord name="F"/>umphant<chord name="C7"/>ly <chord name="F"/>raise,<br/>
      <chord name="C"/>Who <chord name="F"/>fashioned <chord name="C"/>and <chord name="F"/>made us, <chord name="Dm"/>pro<chord name="Gm"/>tected and <chord name="C"/>stayed <chord name="Dm"/>us,<br/>
      <chord name="C"/>Who <chord name="F"/>guideth us <chord name="Bb"/>on to the <chord name="F"/>end of <chord name="C7"/>our <chord name="F"/>days.<br/>
      His banners are o’er <chord name="C7"/>us, <chord name="F"/>His <chord name="C7"/>light goes before <chord name="F"/>us,<br/>
      <chord name="C7"/>A<chord name="F"/>pillar of fire <chord name="C#dim6"/>shin <chord name="Dm"/>ing <chord name="C"/>forth in <chord name="G7"/>the <chord name="C"/>night,<br/>
      ‘Til <chord name="F"/>shadows <chord name="C"/>have <chord name="F"/>vanished <chord name="Dm"/>and <chord name="Gm"/>darkness is <chord name="C"/>ban<chord name="Dm"/>ished,<br/>
      <chord name="C"/>As <chord name="F"/>forward we <chord name="Bb"/>travel <chord name="Gm7"/>from <chord name="F"/>light <chord name="Gm7"/>in<chord name="C7"/>to <chord name="F"/>light.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>His <chord name="C"/>law He <chord name="F"/>enforces: <chord name="Dm"/>the stars <chord name="Gm"/>in <chord name="C"/>their courses,<br/>
      <chord name="C7"/>The <chord name="F"/>sun <chord name="Bb"/>in <chord name="F"/>His <chord name="C7"/>orbit, <chord name="F"/>obediently shine;<br/>
      <chord name="C"/>The <chord name="F"/>hills <chord name="C"/>and <chord name="F"/>the <chord name="Dm"/>mountains, <chord name="Gm"/>the <chord name="C"/>rivers <chord name="Dm"/>and fountains,<br/>
      <chord name="C"/>The <chord name="F"/>deeps <chord name="Bb"/>of the <chord name="F"/>ocean <chord name="C7"/>proclaim <chord name="F"/>Him divine,<br/>
      <chord name="C7"/>We too <chord name="F"/>should be <chord name="C7"/>voicing our <chord name="F"/>love and rejoicing,<br/>
      <chord name="C7"/>With <chord name="F"/>glad <chord name="C#dim6"/>adoration <chord name="Dm"/>a <chord name="C"/>song <chord name="G7"/>let <chord name="C"/>us raise,<br/>
      <chord name="F"/>&#x27;Til <chord name="C"/>all <chord name="F"/>things <chord name="Dm"/>now <chord name="Gm"/>living <chord name="C"/>unite <chord name="Dm"/>in thanksgiving<br/>
      <chord name="C"/>To <chord name="F"/>God <chord name="Bb"/>in <chord name="Gm7"/>the <chord name="F"/>highest, <chord name="Gm7"/>hosanna <chord name="C7"/>and <chord name="F"/>praise.
      </lines>
