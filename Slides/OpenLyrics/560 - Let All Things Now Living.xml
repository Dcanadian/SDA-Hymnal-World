<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>560 - Let All Things Now Living</title>
      <title>Let All Things Now Living</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="560"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Am"/>Let all <chord name="Dm/A"/>things <chord name="F/C"/>now <chord name="C7"/>living asong <chord name="F/A"/>of thanksgiving<br/>
      <chord name="Gm"/>To God the <chord name="C/G"/>Creator triumphantly <chord name="F"/>raise,<br/>
      <chord name="Dm/F"/>Who <chord name="Bb/F"/>fashioned <chord name="F"/>and made <chord name="C7/G"/>us, <chord name="Dm/A"/>protected <chord name="F/C"/>and <chord name="C7"/>stayed us,<br/>
      <chord name="F/C"/>Who guideth us <chord name="Gm"/>on to the end of <chord name="C/G"/>our <chord name="F"/>days.<br/>
      <chord name="C/G"/>His banners <chord name="F"/>are o’er us, His light <chord name="Dm/F"/>goes <chord name="Bb/F"/>before <chord name="F"/>us,<br/>
      <chord name="F/A"/>Apillar <chord name="Dm/A"/>of <chord name="C7"/>fire shin ing forth in the night,<br/>
      <chord name="C7"/>‘Til shadows have vanished and <chord name="F/C"/>darkness is banished,<br/>
      <chord name="F/C"/>As forward <chord name="C7/Bb"/>we <chord name="Dm/A"/>travel <chord name="C/G"/>from light <chord name="G"/>into <chord name="C/G"/>light.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Am"/>His law <chord name="Dm/A"/>He <chord name="F/C"/>enforces: <chord name="C7"/>the <chord name="F/C"/>stars in their courses,<br/>
      <chord name="Gm"/>The sun in His <chord name="C/G"/>orbit, obediently <chord name="F"/>shine;<br/>
      <chord name="Dm/F"/>The <chord name="Bb/F"/>hills and <chord name="F"/>the mountains, <chord name="Dm/A"/>the <chord name="C/G"/>rivers <chord name="F/C"/>and <chord name="C7"/>fountains,<br/>
      <chord name="F/C"/>The deeps of the <chord name="Gm"/>ocean proclaim Him <chord name="C/G"/>divine,<br/>
      <chord name="C/G"/>We too <chord name="Dm/A"/>should <chord name="F"/>be voicing our love <chord name="Dm/F"/>and <chord name="Bb/F"/>rejoicing,<br/>
      <chord name="F/A"/>With glad <chord name="C7/Bb"/>adoration a song let us raise,<br/>
      <chord name="C7"/>&#x27;Til all <chord name="F/C"/>things <chord name="C7"/>now living unite <chord name="C"/>in <chord name="F/A"/>thanksgiving<br/>
      <chord name="F/C"/>To God <chord name="C7/Bb"/>in the <chord name="Dm/A"/>highest, <chord name="C/G"/>hosanna <chord name="G"/>and <chord name="C/G"/>praise.
      </lines>
    </verse>
  </lyrics>
</song>
