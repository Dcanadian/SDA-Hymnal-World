<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>166 - Christ the Lord Is Risen Today</title>
      <title>Christ the Lord Is Risen Today</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="166"/>
    </songbooks>
    <key>C</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Jesus Christ</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C"/>Christ the Lord <chord name="F/A"/>is risen <chord name="C"/>today, <chord name="Am"/>Al leluia!<br/>
      <chord name="F/A"/>Sons <chord name="C"/>of <chord name="Em"/>men <chord name="C"/>and <chord name="G"/>angels <chord name="C/E"/>say, <chord name="Dm"/>Al <chord name="Am"/>leluia!<br/>
      <chord name="G"/>Raise <chord name="Am"/>your <chord name="G7/F"/>joys <chord name="C/E"/>and triumphs <chord name="G"/>high, Al leluia!<br/>
      <chord name="G/D"/>Sing, ye heavens, <chord name="C"/>and <chord name="F"/>earth <chord name="C"/>reply, Allelu <chord name="G7"/>ia!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="C"/>Lives again <chord name="F/C"/>our <chord name="C"/>glorious King, <chord name="Am"/>Alleluia!<br/>
      <chord name="F/A"/>Where, <chord name="C"/>O <chord name="Em"/>death, <chord name="C"/>is <chord name="G"/>now <chord name="C"/>thy sting? <chord name="Dm"/>Alleluia!<br/>
      <chord name="G"/>Once <chord name="Am"/>he <chord name="G/B"/>died <chord name="C/E"/>our <chord name="Dm"/>souls <chord name="G"/>to save, Alleluia!<br/>
      <chord name="G/D"/>Where&#x27;s thy <chord name="G7/F"/>victory, <chord name="C"/>boasting grave? <chord name="Dm"/>Alleluia!
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="C"/>Love&#x27;s redeeming work is done, <chord name="Am"/>Alleluia!<br/>
      <chord name="F/A"/>Fought <chord name="C"/>the <chord name="Em"/>fight, <chord name="C"/>the <chord name="G"/>battle <chord name="C/E"/>won, <chord name="Dm"/>Alleluia!<br/>
      <chord name="G"/>Death <chord name="Am"/>in <chord name="G/B"/>vain <chord name="C/E"/>forbids <chord name="G"/>him rise, Alleluia!<br/>
      <chord name="G/D"/>Christ has opened <chord name="F/A"/>paradise, <chord name="C"/>Alleluia!
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="C"/>Soar we now <chord name="F"/>where <chord name="C"/>Christ has led, <chord name="Dm"/>Alleluia!<br/>
      <chord name="F/A"/>Following <chord name="Dm"/>our <chord name="C/G"/>exalted Head, <chord name="Am"/>Alleluia!<br/>
      <chord name="G"/>Made <chord name="Am"/>like <chord name="G/B"/>him, <chord name="C/E"/>like <chord name="Dm"/>him <chord name="G"/>we rise, Alleluia!<br/>
      <chord name="G/D"/>Ours the cross, <chord name="C/E"/>the <chord name="F/A"/>grave, <chord name="C"/>the skies, Alleluia!
      </lines>
    </verse>
  </lyrics>
</song>
