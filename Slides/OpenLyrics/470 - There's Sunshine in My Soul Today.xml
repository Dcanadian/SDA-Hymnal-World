<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>470 - There&#x27;s Sunshine in My Soul Today</title>
      <title>There&#x27;s Sunshine in My Soul Today</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="470"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>There’s sunshine <chord name="C"/>in my soul tod<chord name="G"/>ay,<br/>
      More <chord name="D7"/>glorious and <chord name="G"/>br<chord name="C"/>ig<chord name="G"/>ht<br/>
      Than glows in <chord name="C"/>any earthly <chord name="G"/>sky,<br/>
      For <chord name="D"/>Jesus <chord name="A7"/>is my <chord name="D"/>light.<br/>
      <chord name="D7"/>O there’s <chord name="G"/>sunshine, <chord name="C"/>blessed <chord name="G"/>sunshine,<br/>
      When the peaceful, happy moments <chord name="D"/>roll<br/>
      <chord name="D7"/>When <chord name="G"/>Jesus <chord name="C"/>shows <chord name="G"/>His <chord name="C"/>smiling <chord name="G"/>face<br/>
      There <chord name="C"/>is <chord name="G"/>sunshine <chord name="D7"/>in the <chord name="G"/>soul.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="G"/>O <chord name="C"/>there&#x27;s sunshine, <chord name="G"/>blessed sunshine,<br/>
      <chord name="D7"/>When <chord name="G"/>the peaceful, <chord name="C"/>happy <chord name="G"/>moments roll<br/>
      <chord name="C"/>When Jesus shows <chord name="G"/>His smiling face<br/>
      <chord name="D"/>There is <chord name="A7"/>sunshine in <chord name="D"/>the soul.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>There&#x27;s music <chord name="C"/>in my <chord name="G"/>soul today,<br/>
      <chord name="D7"/>A <chord name="G"/>carol <chord name="C"/>to <chord name="G"/>my King,<br/>
      <chord name="C"/>And Jesus, <chord name="G"/>listening, can hear<br/>
      <chord name="D"/>The <chord name="A7"/>songs I <chord name="D"/>cannot sing.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>There&#x27;s springtime <chord name="C"/>in my <chord name="G"/>soul today,<br/>
      <chord name="D7"/>For <chord name="G"/>when the <chord name="C"/>Lord <chord name="G"/>is near,<br/>
      <chord name="C"/>The dove of peace <chord name="G"/>sings in my heart,<br/>
      <chord name="D"/>The <chord name="A7"/>flowers of <chord name="D"/>grace appear.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="G"/>Theres gladness <chord name="C"/>in my <chord name="G"/>soul today,<br/>
      <chord name="D7"/>And <chord name="G"/>hope, and <chord name="C"/>praise, <chord name="G"/>and love,<br/>
      <chord name="C"/>For blessings which <chord name="G"/>He gives me now,<br/>
      <chord name="D"/>For <chord name="A7"/>joys &quot;laid <chord name="D"/>up&quot; above.
      </lines>
    </verse>
  </lyrics>
</song>
