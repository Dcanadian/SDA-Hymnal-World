<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>209 - That Glorious Day Is Coming</title>
      <title>That Glorious Day Is Coming</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="209"/>
    </songbooks>
    <key>C</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Jesus Christ</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C"/>That glorious day <chord name="Am/C"/>is <chord name="C"/>coming,<br/>
      <chord name="C"/>The hour <chord name="F"/>is hastening <chord name="Em"/>on;<br/>
      <chord name="E7/G#"/>Its <chord name="Am"/>radiant light is <chord name="Bm"/>nearing,<br/>
      <chord name="Am/C"/>Far <chord name="G/D"/>brighter than the <chord name="Dm"/>sun;<br/>
      <chord name="G7/F"/>In <chord name="C/E"/>yonder <chord name="Am"/>clouds of <chord name="Em/B"/>heaven,<br/>
      <chord name="Dm"/>The <chord name="A/C#"/>Savior <chord name="C"/>will appear,<br/>
      <chord name="C7/A#"/>And <chord name="F/A"/>gather <chord name="Am"/>all His <chord name="C/G"/>chosen,<br/>
      <chord name="C/G"/>To <chord name="G7"/>meet Him in the <chord name="C"/>air.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="C"/>The saints, then all <chord name="Am/C"/>victorious<br/>
      <chord name="C"/>Will <chord name="F"/>go to meet <chord name="Dm/F"/>their <chord name="Em"/>Lord;<br/>
      <chord name="E7/G#"/>An <chord name="Am"/>earth both bright and <chord name="Bm"/>glorious,<br/>
      <chord name="Am/C"/>Will <chord name="G/D"/>then be their reward;<br/>
      <chord name="G7/F"/>And <chord name="C/E"/>God <chord name="Em"/>Himself <chord name="Am"/>there <chord name="Em/B"/>reigning,<br/>
      <chord name="Dm"/>Will <chord name="A/C#"/>wipe all <chord name="C"/>tears away;<br/>
      <chord name="C7/A#"/>Nor <chord name="F/A"/>clouds nor <chord name="Am"/>night remaining,<br/>
      <chord name="C/G"/>But <chord name="G7"/>one eternal <chord name="C"/>day.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="C"/>O Christian, keep <chord name="Am/C"/>from <chord name="C"/>sleeping,<br/>
      <chord name="C"/>And <chord name="F"/>let your love <chord name="Dm/F"/>abound;<br/>
      <chord name="E7/G#"/>Be <chord name="Am"/>watchful, prayerful, <chord name="Bm"/>faithful,<br/>
      <chord name="Am/C"/>The <chord name="G/D"/>trumpet soon will <chord name="Dm"/>sound!<br/>
      <chord name="G7/F"/>O <chord name="C/E"/>sinner, <chord name="Am"/>hear the <chord name="Em/B"/>warning!<br/>
      <chord name="Dm"/>To <chord name="A/C#"/>Jesus <chord name="C"/>quickly!<br/>
      <chord name="C7/A#"/>Then <chord name="F/A"/>you, in <chord name="Am"/>that blest <chord name="C/G"/>morning,<br/>
      <chord name="C/G"/>May <chord name="G7"/>meet Him in the <chord name="C"/>sky!
      </lines>
    </verse>
  </lyrics>
</song>
