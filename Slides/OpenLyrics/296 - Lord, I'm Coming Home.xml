  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb7"/>I&#x27;ve <chord name="Ab"/>wandered far a<chord name="Db"/>way from <chord name="Ab"/>God, Now I&#x27;m coming <chord name="Eb"/>home;<br/>
      <chord name="Eb7"/>The <chord name="Ab"/>paths of sin too <chord name="Db"/>long I&#x27;ve <chord name="Ab"/>trod; <chord name="Fm"/>Lord, <chord name="Eb7"/>I&#x27;m coming <chord name="Ab"/>home.<br/>
      <chord name="Ab"/>Coming home, <chord name="Db"/>coming home <chord name="Ab"/>Never more to <chord name="Eb"/>roam;<br/>
      <chord name="Ab"/>Open wide Thine <chord name="Db"/>arms of <chord name="Ab"/>love; <chord name="Fm"/>Lord I&#x27;m <chord name="Eb7"/>coming <chord name="Ab"/>home.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Eb7"/><chord name="Ab"/>Coming <chord name="Db"/>home, <chord name="Ab"/>coming <chord name="Eb"/>home<br/>
      <chord name="Eb7"/><chord name="Ab"/>Never <chord name="Db"/><chord name="Ab"/>more <chord name="Fm"/><chord name="Eb7"/>to <chord name="Ab"/>roam;<br/>
      <chord name="Ab"/>Open <chord name="Db"/>wide Thine <chord name="Ab"/>arms <chord name="Eb"/>of love;<br/>
      <chord name="Ab"/><chord name="Db"/>Lord <chord name="Ab"/>I&#x27;m <chord name="Fm"/><chord name="Eb7"/>coming <chord name="Ab"/>home.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Eb7"/>I&#x27;ve <chord name="Ab"/>wasted <chord name="Db"/>many <chord name="Ab"/>precious <chord name="Eb"/>years,<br/>
      <chord name="Eb7"/><chord name="Ab"/>Now <chord name="Db"/><chord name="Ab"/>I&#x27;m <chord name="Fm"/><chord name="Eb7"/>coming <chord name="Ab"/>home;<br/>
      <chord name="Ab"/>I <chord name="Db"/>now repent <chord name="Ab"/>with <chord name="Eb"/>bitter tears;<br/>
      <chord name="Ab"/><chord name="Db"/>Lord, <chord name="Ab"/>I&#x27;m <chord name="Fm"/><chord name="Eb7"/>coming <chord name="Ab"/>home.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Eb7"/>I&#x27;m <chord name="Ab"/>tired <chord name="Db"/>of sin <chord name="Ab"/>and <chord name="Eb"/>straying Lord,<br/>
      <chord name="Eb7"/><chord name="Ab"/>Now <chord name="Db"/><chord name="Ab"/>I&#x27;m <chord name="Fm"/><chord name="Eb7"/>coming <chord name="Ab"/>home;<br/>
      <chord name="Ab"/>I&#x27;ll <chord name="Db"/>trust thy <chord name="Ab"/>love belive <chord name="Eb"/>thy word;<br/>
      <chord name="Ab"/><chord name="Db"/>Lord <chord name="Ab"/>I&#x27;m <chord name="Fm"/><chord name="Eb7"/>coming <chord name="Ab"/>home.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Eb7"/>My <chord name="Ab"/>only <chord name="Db"/>hope, <chord name="Ab"/>my <chord name="Eb"/>only plea,<br/>
      <chord name="Eb7"/><chord name="Ab"/>Now <chord name="Db"/><chord name="Ab"/>I&#x27;m <chord name="Fm"/><chord name="Eb7"/>coming <chord name="Ab"/>home;<br/>
      <chord name="Ab"/>That <chord name="Db"/>Jesus died, <chord name="Ab"/>and died <chord name="Eb"/>for me;<br/>
      <chord name="Ab"/><chord name="Db"/>Lord <chord name="Ab"/>I&#x27;m <chord name="Fm"/><chord name="Eb7"/>coming <chord name="Ab"/>home.
      </lines>
    </verse>
    <verse name="v5">
      <lines>
      <chord name="Eb7"/>I <chord name="Ab"/>need <chord name="Db"/>His cleansing <chord name="Ab"/>blood <chord name="Eb"/>I know,<br/>
      <chord name="Eb7"/><chord name="Ab"/>Now <chord name="Db"/><chord name="Ab"/>I&#x27;m <chord name="Fm"/><chord name="Eb7"/>coming <chord name="Ab"/>home;<br/>
      <chord name="Ab"/>O <chord name="Db"/>wash me <chord name="Ab"/>whiter than <chord name="Eb"/>the snow;<br/>
      <chord name="Ab"/><chord name="Db"/>Lord <chord name="Ab"/>I&#x27;m <chord name="Fm"/><chord name="Eb7"/>coming <chord name="Ab"/>home.
      </lines>
    </verse>
