  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Praise the <chord name="Dm"/>Lord, His <chord name="Am"/>glories <chord name="C"/>show, <chord name="Am"/>Allelu <chord name="F/C"/>ia!<br/>
      <chord name="Bb"/>Saints within <chord name="F"/>His courts <chord name="Dm"/>below, <chord name="Am"/>Allelu <chord name="C"/>ia!<br/>
      <chord name="Am"/>Angles <chord name="F"/>&#x27;round His throne <chord name="Bb"/>above, <chord name="F"/>Allelu-ia!<br/>
      <chord name="Bb"/>All that <chord name="Gm"/>see and <chord name="C"/>share <chord name="F"/>His love. Allelu <chord name="C"/>ia!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>Earth to <chord name="Dm"/>heaven <chord name="Am"/>and <chord name="Bb"/>heaven <chord name="C"/>to <chord name="Am"/>earth, <chord name="Gm"/>Alleluia!<br/>
      <chord name="Bb"/>Tell <chord name="F"/>His wonders, <chord name="Dm"/>sing His <chord name="Am"/>worth, <chord name="Bb"/>Alleluia!<br/>
      <chord name="Am"/>Age <chord name="Gm"/>to <chord name="F"/>age and shore <chord name="Bb"/>to <chord name="F"/>shore, Alleluia!<br/>
      <chord name="Bb"/>Praise Him, <chord name="Gm"/>praise Him <chord name="C"/>evermore! <chord name="F"/>Alleluia!
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>Praise the <chord name="Dm"/>Lord, His <chord name="Bb"/>mercies <chord name="C"/>trace, <chord name="Gm"/>Alleluia!<br/>
      <chord name="Bb"/>Praise <chord name="F"/>His providence <chord name="Dm"/>and <chord name="Am"/>grace, <chord name="Bb"/>Alleluia!<br/>
      <chord name="Am"/>All <chord name="Gm"/>that <chord name="F"/>He for man <chord name="Bb"/>hath <chord name="F"/>done, Alleluia!<br/>
      <chord name="Bb"/>All He <chord name="Gm"/>sends us <chord name="C"/>through <chord name="F"/>His Son. Alleluia!
      </lines>
    </verse>
  </lyrics>
