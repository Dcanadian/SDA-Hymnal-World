      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="32"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
