    <themes>
      <theme>Worship</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>When <chord name="G"/>in <chord name="Bm"/>our <chord name="Am"/>music <chord name="Em"/>God <chord name="F#dim"/>is <chord name="G"/>glorified,<br/>
      <chord name="D"/>And adoration <chord name="F#dim"/>leaves <chord name="Bm"/>no <chord name="Am"/>room <chord name="Em"/>for <chord name="D"/>pride,<br/>
      <chord name="D/A"/>It <chord name="Bm"/>is as <chord name="D"/>though <chord name="G"/>the <chord name="Am"/>whole <chord name="Bm"/>creation cried:<br/>
      <chord name="Bm"/>Alleluia!<br/>
      
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>How <chord name="G"/>oft, <chord name="Bm"/>in <chord name="Am"/>making <chord name="Em"/>music, <chord name="G"/>we <chord name="Em"/>have <chord name="D"/>found<br/>
      <chord name="D"/>A new <chord name="D7"/>dimension <chord name="G"/>in <chord name="Bm"/>the <chord name="Am"/>world <chord name="Em"/>of <chord name="D"/>sound,<br/>
      <chord name="Bm"/>As worship moved us to a more <chord name="Am"/>profound<br/>
      <chord name="Bm"/>Alleluia! <chord name="C"/>Alleluia!
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D"/>And <chord name="G"/>did <chord name="Bm"/>not <chord name="Am"/>Jesus <chord name="Em"/>sing <chord name="F#dim"/>a <chord name="G"/>psalm <chord name="Em"/>that <chord name="D"/>night<br/>
      <chord name="D"/>When utmost <chord name="Bm"/>evil <chord name="G"/>strove <chord name="Bm"/>against <chord name="Em"/>the <chord name="D"/>light?<br/>
      <chord name="Bm"/>Then let us sing for whom He won <chord name="Am"/>the fight:<br/>
      <chord name="Bm"/>Alleluia! <chord name="C"/>Alleluia!
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="D"/>Let every <chord name="Am"/>instrument <chord name="F#dim"/>be <chord name="G"/>used <chord name="Em"/>for <chord name="D"/>praise;<br/>
      <chord name="D"/>Let all <chord name="D7"/>rejoice <chord name="F#dim"/>who <chord name="G"/>have <chord name="Bm"/>a <chord name="Am"/>voice <chord name="Em"/>to <chord name="D"/>raise;<br/>
      <chord name="Bm"/>And may God give us faith to sing <chord name="Am"/>always:<br/>
      <chord name="Bm"/>Alleluia! <chord name="C"/>Alleluia!
      </lines>
    </verse>
  </lyrics>
</song>
