    <titles>
      <title>208 - There&#x27;ll Be No Dark Valley</title>
      <title>There&#x27;ll Be No Dark Valley</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="208"/>
    </songbooks>
    <key>Eb</key>
