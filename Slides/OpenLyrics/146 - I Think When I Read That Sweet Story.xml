  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Bm"/>I <chord name="G"/>think when I <chord name="C/G"/>read <chord name="G"/>that sweet <chord name="Am/E"/>story <chord name="Em"/>of <chord name="D/A"/>old,<br/>
      <chord name="D7/C"/>When <chord name="G"/>Jesus was <chord name="F#dim"/>here <chord name="Em"/>among <chord name="G"/>men,<br/>
      <chord name="G"/>How <chord name="Bm"/>He called little <chord name="Em/B"/>children <chord name="G"/>as lambs to <chord name="C/G"/>His fold,<br/>
      <chord name="Em/B"/>I should <chord name="G"/>like to have <chord name="D/F#"/>been <chord name="C/G"/>with <chord name="D/A"/>Him <chord name="Em/B"/>then.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Bm"/>I <chord name="G"/>wish that His <chord name="C/G"/>hands <chord name="G"/>had been <chord name="Am/E"/>placed <chord name="Em"/>on my <chord name="D/A"/>head,<br/>
      <chord name="D7/C"/>That <chord name="G"/>His arm had <chord name="F#dim"/>been <chord name="Em"/>thrown <chord name="F#dim"/>around <chord name="G"/>me,<br/>
      <chord name="G"/>And <chord name="Bm"/>that I might have <chord name="Em/B"/>seen <chord name="B7"/>His <chord name="G"/>kind look when <chord name="C/G"/>He said,<br/>
      <chord name="Em/B"/>&quot;Let the <chord name="G"/>little ones <chord name="D/F#"/>come <chord name="C/G"/>unto <chord name="Em/B"/>Me.&quot;
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Bm"/>I <chord name="G"/>long for the <chord name="C/G"/>joy <chord name="G"/>of that <chord name="Am/E"/>glorious <chord name="Em"/>time,<br/>
      <chord name="D7/C"/>The <chord name="G"/>sweetest and <chord name="F#dim"/>brightest and <chord name="G"/>best,<br/>
      <chord name="G"/>When <chord name="Bm"/>the dear little <chord name="Em/B"/>children <chord name="G"/>of every <chord name="C/G"/>clime<br/>
      <chord name="Em/B"/>Shall <chord name="G"/>crowd to His <chord name="D/F#"/>arms <chord name="C/G"/>and <chord name="D/A"/>be <chord name="Em/B"/>blest.
