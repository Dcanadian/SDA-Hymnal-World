<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>146 - I Think When I Read That Sweet Story</title>
      <title>I Think When I Read That Sweet Story</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="146"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Jesus Christ</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>I think when I <chord name="C"/>read that <chord name="G"/>sweet <chord name="Am"/>story of <chord name="D"/>old,<br/>
      <chord name="D7"/>When <chord name="G"/>Jesus was <chord name="D"/>here among <chord name="G"/>men,<br/>
      How He <chord name="Bm"/>called little <chord name="Em"/>children as <chord name="G"/>lambs to His <chord name="C"/>fold,<br/>
      I <chord name="G"/>should <chord name="Am7"/>like to have <chord name="D"/>been with Him <chord name="G"/>then.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>I wish <chord name="C"/>that His <chord name="G"/>hands had <chord name="Am"/>been placed <chord name="D"/>on my head,<br/>
      <chord name="D7"/>That His <chord name="G"/>arm had <chord name="D"/>been thrown <chord name="G"/>around me,<br/>
      <chord name="Bm"/>And that I <chord name="Em"/>might have seen <chord name="G"/>His kind look <chord name="C"/>when He said,<br/>
      <chord name="G"/>&quot;Let <chord name="Am7"/>the little <chord name="D"/>ones come <chord name="G"/>unto Me.&quot;
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>I <chord name="C"/>long for <chord name="G"/>the joy <chord name="Am"/>of that <chord name="D"/>glorious time,<br/>
      <chord name="D7"/>The <chord name="G"/>sweetest and <chord name="D"/>brightest <chord name="G"/>and best,<br/>
      <chord name="Bm"/>When the <chord name="Em"/>dear little <chord name="G"/>children of <chord name="C"/>every clime<br/>
      <chord name="G"/>Shall crowd <chord name="Am7"/>to His <chord name="D"/>arms and <chord name="G"/>be blest.
      </lines>
    </verse>
  </lyrics>
</song>
