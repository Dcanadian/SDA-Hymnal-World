  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Gm"/>Hark! <chord name="Ab"/>the <chord name="Gm"/>vesper hymn <chord name="Fm"/>is <chord name="Eb"/>stealing<br/>
      <chord name="Gm"/>O&#x27;er <chord name="Bb"/>the waters <chord name="Ab"/>soft <chord name="Fm"/>and <chord name="Ddim"/>clear;<br/>
      <chord name="Eb"/>Jubilate, <chord name="Bb7/Ab"/>Jubilate, <chord name="Eb"/>Jubilate, <chord name="Bb7/Ab"/>Amen.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Gm"/>Nearer yet, <chord name="Bb7"/>and <chord name="Gm/Bb"/>nearer <chord name="Eb"/>pealing,<br/>
      <chord name="Gm"/>Soft <chord name="Bb"/>it breaks <chord name="Gm"/>upon <chord name="Fm"/>the <chord name="Ddim"/>ear.<br/>
      <chord name="Eb"/>Jubilate, <chord name="Bb7/Ab"/>Jubilate, <chord name="Eb"/>Jubilate, <chord name="Bb7/Ab"/>Amen.
      </lines>
    </verse>
