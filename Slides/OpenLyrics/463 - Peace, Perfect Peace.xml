<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>463 - Peace, Perfect Peace</title>
      <title>Peace, Perfect Peace</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="463"/>
    </songbooks>
    <key>Bb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Bb"/>Peace, perfect peace,<br/>
      <chord name="Eb/Bb"/>in this <chord name="Cm"/>dark <chord name="F/C"/>world <chord name="Bb"/>of <chord name="Dm/A"/>sin?<br/>
      <chord name="Bb"/>The blood ofJesus<br/>
      <chord name="Bb"/>whispers <chord name="Dm/A"/>peace <chord name="Adim"/>within.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Bb"/>Peace, perfect peace, <chord name="F/C"/>by thronging <chord name="Bb"/>duties pressed?<br/>
      <chord name="Bb"/>To do the <chord name="Dm/A"/>will of <chord name="Adim"/>Jesus: this <chord name="Dm/F"/>is rest.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Bb"/>Peace, perfect peace, with <chord name="F/C"/>loved ones <chord name="Bb"/>far away?<br/>
      <chord name="Bb"/>In Jesus&#x27; <chord name="Dm/A"/>keeping <chord name="Adim"/>we are safe, <chord name="Dm/F"/>and they.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Bb"/>Peace, perfect peace, <chord name="F/C"/>our future <chord name="Bb"/>all unknown?<br/>
      <chord name="Bb"/>Jesus we <chord name="Dm/A"/>know, and <chord name="Adim"/>He is on <chord name="Dm/F"/>the throne.
      </lines>
    </verse>
  </lyrics>
</song>
