  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D/A"/>Just <chord name="Em/G"/>as <chord name="D/F#"/>I <chord name="A"/>am, <chord name="D/A"/>without <chord name="C#dim"/>one <chord name="G/D"/>plea,<br/>
