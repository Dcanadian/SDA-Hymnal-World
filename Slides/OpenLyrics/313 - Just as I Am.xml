    <verse name="v5">
      <lines>
      <chord name="D/A"/>Just <chord name="Em/G"/>as <chord name="D/F#"/>I <chord name="A"/>am, <chord name="D/A"/>Thou <chord name="Bm"/>wilt <chord name="C#dim"/>receive,<br/>
