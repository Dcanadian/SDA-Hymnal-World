    <verse name="v3">
      <lines>
      <chord name="D/A"/>Just <chord name="Em/G"/>as <chord name="D/F#"/>I <chord name="A"/>am, <chord name="D/A"/>though <chord name="Bm"/>tossed <chord name="C#dim"/>about<br/>
      <chord name="A/C#"/>With many <chord name="F#m/A"/>a <chord name="Em/G"/>conflict, <chord name="D/A"/>many <chord name="A7/G"/>a <chord name="D/A"/>doubt,<br/>
