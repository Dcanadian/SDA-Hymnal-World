  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Dm/A"/>Lord, while <chord name="Gm"/>for <chord name="F"/>all <chord name="Bb/F"/>mankind <chord name="C"/>we <chord name="F/C"/>pray, Of <chord name="Bb"/>every <chord name="G"/>clime <chord name="C/G"/>and coast,<br/>
      <chord name="F/C"/>Oh, <chord name="C"/>hear <chord name="Bb"/>us <chord name="Am"/>for <chord name="Bb"/>our native <chord name="C"/>land, <chord name="F/C"/>The <chord name="C7/Bb"/>land <chord name="F"/>we <chord name="G7"/>love <chord name="C/G"/>the <chord name="Dm/A"/>most!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Dm/A"/>O guard <chord name="F"/>our <chord name="Bb/F"/>shores <chord name="F/C"/>from <chord name="Bb"/>every <chord name="C/G"/>foe,<br/>
      <chord name="Dm/A"/>With <chord name="Gm"/>peace <chord name="C/G"/>our <chord name="F/C"/>borders <chord name="G"/>bless;<br/>
      <chord name="F/C"/>With <chord name="C"/>prosperous <chord name="Bb"/>times <chord name="F/C"/>our <chord name="C7/Bb"/>cities <chord name="C/G"/>crown,<br/>
      <chord name="F/C"/>Our <chord name="Bb"/>fields with <chord name="C"/>plenteousness!
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Dm/A"/>Unite <chord name="Bb/F"/>us <chord name="C"/>in <chord name="F/C"/>the <chord name="C/G"/>sacred <chord name="G"/>love<br/>
      <chord name="Dm/A"/>Of <chord name="Gm"/>knowledge, <chord name="F/C"/>truth, <chord name="C/G"/>and <chord name="G"/>Thee;<br/>
      <chord name="F/C"/>And <chord name="C"/>let <chord name="Am"/>our <chord name="Bb"/>hills <chord name="C"/>and <chord name="F/C"/>valleys <chord name="C/G"/>shout<br/>
      <chord name="F/C"/>The <chord name="Bb"/>songs of <chord name="C"/>liberty.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Dm/A"/>Lord of <chord name="F"/>the <chord name="C/G"/>nations, <chord name="Bb"/>thus <chord name="C/G"/>to Thee<br/>
      <chord name="Dm/A"/>Our <chord name="Gm"/>country <chord name="F/C"/>we <chord name="C/G"/>commend;<br/>
      <chord name="F/C"/>Be <chord name="C"/>Thou <chord name="Am"/>her <chord name="Bb"/>Refuge <chord name="F/C"/>and her <chord name="C/G"/>trust,<br/>
      <chord name="F/C"/>Her <chord name="Bb"/>everlasting <chord name="G7"/>friend.
      </lines>
    </verse>
