  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C"/>Morning <chord name="Em/B"/>has <chord name="Am"/>broken Like <chord name="G/B"/>the <chord name="Am/C"/>first <chord name="G/B"/>morning,<br/>
      <chord name="C/G"/>Blackbird <chord name="G7/F"/>has <chord name="Dm"/>spoken <chord name="C"/>Like the first <chord name="G"/>bird.<br/>
      <chord name="G"/>Praise <chord name="C/G"/>for <chord name="G"/>the <chord name="C/E"/>singing! Praise for the <chord name="D7/F#"/>morning!<br/>
      <chord name="Em/G"/>Praise for <chord name="G"/>them <chord name="Am/E"/>springing Fresh <chord name="C/G"/>from <chord name="G7/F"/>the <chord name="C/E"/>Word!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="C"/>Sweet the <chord name="Em/B"/>rain&#x27;s <chord name="Am"/>new <chord name="Dm/A"/>fall <chord name="Am"/>sunlit from <chord name="G/B"/>heaven,<br/>
      <chord name="C/G"/>Like the <chord name="G7/F"/>first <chord name="Dm"/>dewfall <chord name="C"/>on the first <chord name="G"/>grass.<br/>
      <chord name="G"/>Praise <chord name="C/G"/>for <chord name="G"/>the <chord name="C/E"/>sweetness of the wet <chord name="D7/F#"/>garden,<br/>
      <chord name="Em/G"/>Sprung in <chord name="G"/>completeness <chord name="C/G"/>where His <chord name="G7/F"/>feet <chord name="C/E"/>pass.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="C"/>Mine is <chord name="Em/B"/>the <chord name="Am"/>sunlight! Mine <chord name="G/B"/>is <chord name="Am/C"/>the <chord name="G/B"/>morning<br/>
      <chord name="C/G"/>Born of <chord name="G7/F"/>the <chord name="Dm"/>one <chord name="C"/>light Eden saw <chord name="G"/>play!<br/>
      <chord name="G"/>Praise <chord name="C/G"/>with <chord name="G"/>elation, <chord name="C"/>Praise every <chord name="D7/F#"/>morning,<br/>
      <chord name="Em/G"/>God&#x27;s recreation <chord name="Am"/>of <chord name="C/G"/>the <chord name="G7/F"/>new <chord name="C/E"/>day!
      </lines>
    </verse>
