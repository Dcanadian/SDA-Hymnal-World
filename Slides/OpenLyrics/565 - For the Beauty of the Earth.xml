  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>For the beauty of <chord name="C/E"/>the <chord name="D7/F#"/>earth,<br/>
      <chord name="C"/>For <chord name="D7/C"/>the <chord name="G/B"/>glory of <chord name="D"/>the <chord name="G"/>skies,<br/>
      <chord name="G"/>For the love <chord name="D/F#"/>which <chord name="G"/>from <chord name="C/E"/>our <chord name="D7/F#"/>birth<br/>
      <chord name="C"/>Over <chord name="G/B"/>and <chord name="C"/>around <chord name="D"/>us <chord name="G"/>lies;<br/>
      <chord name="G"/>Lord <chord name="D7/F#"/>of <chord name="G"/>all, to <chord name="D/F#"/>Thee we <chord name="G"/>raise<br/>
      <chord name="C"/>This our <chord name="D7/C"/>grateful <chord name="G/D"/>song <chord name="D7"/>of <chord name="G"/>praise.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>For the joy <chord name="D/F#"/>of <chord name="G"/>human <chord name="D7/F#"/>love,<br/>
      <chord name="C"/>brother, <chord name="G/B"/>sister, parent, child,<br/>
      <chord name="G"/>friends on earth <chord name="D/F#"/>and <chord name="G"/>friends <chord name="C/E"/>above,<br/>
      <chord name="C"/>Pleasures <chord name="G/B"/>pure <chord name="C"/>and <chord name="G/D"/>undefiled,<br/>
      <chord name="G"/>Lord <chord name="D7/F#"/>of <chord name="G"/>all, to <chord name="D/F#"/>Thee we <chord name="G"/>raise<br/>
      <chord name="C"/>this our <chord name="D7/C"/>grateful <chord name="G/D"/>song <chord name="D7"/>of <chord name="G"/>praise.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>For the gift <chord name="D/F#"/>of <chord name="G"/>Thy <chord name="C/E"/>dear <chord name="D7/F#"/>Son,<br/>
      <chord name="C"/>for the <chord name="D7/C"/>hope <chord name="G/B"/>of <chord name="C"/>heaven <chord name="D"/>at <chord name="G"/>last,<br/>
      <chord name="G"/>for the Spirit&#x27;s victory won,<br/>
      <chord name="C"/>For <chord name="D7/C"/>the <chord name="G/B"/>crown <chord name="C"/>when <chord name="G/D"/>life <chord name="D"/>is <chord name="G"/>past,<br/>
      <chord name="G"/>Lord <chord name="D7/F#"/>of <chord name="G"/>all, to <chord name="D/F#"/>Thee we <chord name="G"/>raise<br/>
      <chord name="C"/>Songs <chord name="D7/C"/>of <chord name="G/B"/>gratitude <chord name="D7"/>and <chord name="G"/>praise.
      </lines>
    </verse>
  </lyrics>
