    <themes>
      <theme>Doctrines</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Dm/A"/>Safely <chord name="F/C"/>through another <chord name="C7"/>week God has brought <chord name="Gm"/>us <chord name="C7/Bb"/>on our <chord name="Dm/A"/>way;<br/>
      <chord name="Dm/A"/>Let us <chord name="F/C"/>now a <chord name="C7"/>blessing seek, Waiting <chord name="Am"/>in His <chord name="C/G"/>courts <chord name="Dm/F"/>today;<br/>
      <chord name="C"/>Day of <chord name="F/C"/>all the <chord name="C7"/>week the best, <chord name="F"/>Emblem <chord name="Am"/>of eternal <chord name="C7"/>rest:<br/>
      <chord name="Am"/>Day of <chord name="F"/>all the <chord name="C7"/>week the best, <chord name="F"/>Emblem <chord name="Am"/>of eternal <chord name="C7/Bb"/>rest.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Dm/A"/>While <chord name="F/C"/>we <chord name="C7"/>seek supplies <chord name="Gm"/>of <chord name="C7/Bb"/>grace,<br/>
      <chord name="Dm/A"/>Thro&#x27; <chord name="F/C"/>the <chord name="C7"/>dear Redeemer&#x27;s name,<br/>
      <chord name="Dm/A"/>Show <chord name="F/C"/>Thy <chord name="C7"/>reconciling <chord name="Dm/F"/>face;<br/>
      <chord name="Dm/A"/>Take <chord name="F/C"/>away <chord name="C7"/>the sin <chord name="Am"/>and <chord name="Dm/F"/>shame:<br/>
      <chord name="C"/>From our <chord name="F/C"/>worldly cares <chord name="Am"/>set <chord name="C7"/>free,<br/>
      <chord name="C"/>May <chord name="F/C"/>we <chord name="C7"/>rest this <chord name="F"/>day <chord name="Am"/>in <chord name="C7"/>Thee:<br/>
      <chord name="Am"/>From our <chord name="F"/>worldly cares <chord name="Am"/>set <chord name="C7/Bb"/>free,<br/>
      <chord name="Am"/>May <chord name="F"/>we <chord name="C7"/>rest this <chord name="F"/>day <chord name="Am"/>in Thee.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Dm/A"/>When <chord name="F/C"/>the <chord name="C7"/>more shall bid <chord name="Gm"/>us <chord name="C7/Bb"/>rise,<br/>
      <chord name="Dm/A"/>May <chord name="F/C"/>we <chord name="C7"/>feel Thy presence near;<br/>
      <chord name="Dm/A"/>May <chord name="F/C"/>Thy <chord name="C7"/>glory meet <chord name="Am"/>our <chord name="Dm/F"/>eyes,<br/>
      <chord name="Dm/A"/>While <chord name="F/C"/>we <chord name="C7"/>in Thy house <chord name="Am"/>appear:<br/>
      <chord name="C"/>Here <chord name="F/C"/>afford <chord name="C7"/>us, <chord name="F"/>Lord, <chord name="Am"/>a <chord name="C7"/>taste<br/>
      <chord name="C"/>Of <chord name="F/C"/>our <chord name="C7"/>everlasting feast:<br/>
      <chord name="Am"/>Here <chord name="F"/>afford <chord name="C7"/>us, <chord name="F"/>Lord, <chord name="Am"/>a taste<br/>
      <chord name="Am"/>Of <chord name="F"/>our <chord name="C7"/>everlasting <chord name="Am/C"/>feast.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Dm/A"/>May <chord name="F/C"/>the <chord name="C7"/>gospel&#x27;s joyful sound<br/>
      <chord name="Dm/A"/>Conquer <chord name="C7"/>sinners, comfort saints;<br/>
      <chord name="Dm/A"/>Make <chord name="F/C"/>the <chord name="C7"/>fruits of grace <chord name="Am"/>abound,<br/>
      <chord name="Dm/A"/>Bring <chord name="F/C"/>relief <chord name="C7"/>to all <chord name="Am"/>complaints:<br/>
      <chord name="C"/>Thus <chord name="F/C"/>may <chord name="C7"/>all our <chord name="F"/>Sabbaths <chord name="C7"/>be,<br/>
      <chord name="C"/>Till we <chord name="F/C"/>we <chord name="C7"/>rise <chord name="F"/>to reign <chord name="Am"/>with <chord name="C7"/>Thee.<br/>
      <chord name="Am"/>Thus <chord name="F"/>may <chord name="C7"/>all our <chord name="F"/>Sabbaths <chord name="Am/C"/>be,<br/>
      <chord name="Am"/>Till we <chord name="F"/>we <chord name="C7"/>rise <chord name="F"/>to <chord name="Am"/>reign with <chord name="C7/Bb"/>Thee.
      </lines>
    </verse>
  </lyrics>
</song>
