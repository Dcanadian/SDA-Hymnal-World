      <title>384 - Safely Through Another Week</title>
      <title>Safely Through Another Week</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="384"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
