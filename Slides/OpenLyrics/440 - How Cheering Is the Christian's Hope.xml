  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>How cheer <chord name="A"/>ing <chord name="D"/>is the Chris tian’s <chord name="G"/>hope,<br/>
      <chord name="A7"/>While <chord name="D"/>toil <chord name="A"/>ing <chord name="D"/>herebelow!<br/>
      <chord name="D/F#"/>(It <chord name="G"/>bouys <chord name="D/F#"/>us <chord name="G"/>up)<br/>
      <chord name="A7/E"/>It bouys <chord name="D"/>us <chord name="A"/>up while <chord name="Em"/>passing through<br/>
      <chord name="D"/>This <chord name="F#m"/>wilderness <chord name="D"/>of woe,<br/>
      <chord name="D"/>It buoys <chord name="Em"/>us <chord name="A"/>up while <chord name="A7"/>passing <chord name="D"/>through<br/>
      <chord name="D"/>This <chord name="Bm"/>wilderness <chord name="G"/>of <chord name="A7"/>woe.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>It bouys <chord name="A"/>us <chord name="D"/>up <chord name="A/C#"/>while <chord name="D"/>this passing through<br/>
      <chord name="D/F#"/>This wilderness of <chord name="G"/>woe,<br/>
      <chord name="D"/>It bouys <chord name="F#m"/>us <chord name="D"/>up while passing through<br/>
      <chord name="D"/>This <chord name="Bm"/>wilderness <chord name="G"/>of <chord name="A7"/>woe.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D"/>It points <chord name="A"/>us <chord name="D"/>to a land of <chord name="G"/>rest,<br/>
      <chord name="D/F#"/>Where saints <chord name="G"/>with <chord name="D/F#"/>Christ will <chord name="G"/>reign;<br/>
      <chord name="D"/>Where <chord name="F#m"/>we <chord name="D"/>shall meet the loved of earth,<br/>
      <chord name="D"/>And <chord name="Bm"/>never <chord name="G"/>part again.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="D"/>Fly, lingering <chord name="A/C#"/>moments, <chord name="D"/>fly, O, <chord name="G"/>fly,<br/>
      <chord name="D/F#"/>Dear Savior, quickly <chord name="G"/>come!<br/>
      <chord name="D"/>We <chord name="F#m"/>long <chord name="D"/>to see Thee as Thou art,<br/>
      <chord name="D"/>And <chord name="Bm"/>reach <chord name="D"/>that <chord name="G"/>blissful <chord name="A7"/>home.
      </lines>
    </verse>
  </lyrics>
