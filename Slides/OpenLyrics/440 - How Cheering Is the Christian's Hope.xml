      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="440"/>
    </songbooks>
    <key>D</key>
    <tempo type="bpm">Moderato</tempo>
