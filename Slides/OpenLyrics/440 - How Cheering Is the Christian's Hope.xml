  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>How cheer <chord name="A"/><chord name="D"/> ing <chord name="A"/>is <chord name="D"/>the Chris <chord name="G"/><chord name="D"/><chord name="A7"/>tian’s <chord name="D"/>hope,<br/>
      <chord name="A"/>While <chord name="D"/>to<chord name="A"/>il<chord name="D"/> ing <chord name="G"/>he<chord name="D"/>re<chord name="G"/><chord name="A7"/>be<chord name="D"/>low!<br/>
      (<chord name="A"/>It <chord name="D"/>bouys us <chord name="G"/>up)<br/>
      <chord name="A"/>It <chord name="Em"/>bouys us up <chord name="D"/>while passing through<br/>
      <chord name="D"/>This wilderness <chord name="G"/>of <chord name="D"/>woe,<br/>
      <chord name="Em"/>It <chord name="A"/>buoys <chord name="D"/>us <chord name="A"/>up <chord name="G"/>while <chord name="D"/>passing through<br/>
      This <chord name="G"/>wil<chord name="D"/>der<chord name="G"/>ness <chord name="A7"/>of <chord name="D"/>woe.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/><chord name="A"/>It <chord name="D"/>bouys <chord name="A"/>us <chord name="D"/>up <chord name="G"/>while <chord name="D"/>this <chord name="A7"/>passing <chord name="D"/>through<br/>
      <chord name="A"/><chord name="D"/><chord name="A"/>This <chord name="D"/><chord name="G"/>wilderness <chord name="D"/><chord name="G"/>of <chord name="A7"/><chord name="D"/>woe,<br/>
      <chord name="A"/>It bouys <chord name="D"/>us up <chord name="G"/>while passing through<br/>
      <chord name="A"/>This <chord name="Em"/>wilderness <chord name="D"/>of woe.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D"/><chord name="A"/>It <chord name="D"/>points <chord name="A"/>us <chord name="D"/>to <chord name="G"/>a <chord name="D"/>land <chord name="A7"/>of <chord name="D"/>rest,<br/>
      <chord name="A"/><chord name="D"/>Where <chord name="A"/>saints <chord name="D"/><chord name="G"/>with <chord name="D"/>Christ <chord name="G"/><chord name="A7"/>will <chord name="D"/>reign;<br/>
      <chord name="A"/>Where we <chord name="D"/>shall meet the <chord name="G"/>loved of earth,<br/>
      <chord name="A"/>And <chord name="Em"/>never <chord name="D"/>part again.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="D"/><chord name="A"/>Fly, <chord name="D"/>lingering <chord name="A"/><chord name="D"/>moments, <chord name="G"/>fly, <chord name="D"/><chord name="A7"/>O, <chord name="D"/>fly,<br/>
      <chord name="A"/><chord name="D"/><chord name="A"/>Dear <chord name="D"/><chord name="G"/>Savior, <chord name="D"/><chord name="G"/>quickly <chord name="A7"/><chord name="D"/>come!<br/>
      <chord name="A"/>We long <chord name="D"/>to see Thee <chord name="G"/>as Thou art,<br/>
      <chord name="A"/>And <chord name="Em"/>reach that <chord name="D"/>blissful home.
      </lines>
    </verse>
