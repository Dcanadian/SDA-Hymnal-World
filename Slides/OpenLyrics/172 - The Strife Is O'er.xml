<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>172 - The Strife Is O&#x27;er</title>
      <title>The Strife Is O&#x27;er</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="172"/>
    </songbooks>
    <key>D</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Jesus Christ</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D/A"/>The strife is o&#x27;er, <chord name="Em/B"/>the <chord name="D/A"/>battle <chord name="F#m"/>done;<br/>
      <chord name="A"/>Now is the victor&#x27;s <chord name="G/D"/>triumph won!<br/>
      <chord name="F#m/C#"/>Now be the <chord name="A"/>song of <chord name="D"/>praise begun. <chord name="A/E"/>Alleluia!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D/A"/>The pow&#x27;rs of death <chord name="Em/B"/>have <chord name="D/A"/>done their <chord name="F#m"/>worst,<br/>
      <chord name="A"/>But Christ their legions <chord name="G/D"/>has dispersed.<br/>
      <chord name="F#m/C#"/>Let shouts of <chord name="A"/>holy <chord name="D"/>joy outburst. <chord name="A/E"/>Alleluia!
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D/A"/>The three sad days <chord name="Em/B"/>have <chord name="D/A"/>quickly <chord name="F#m"/>sped,<br/>
      <chord name="A"/>He rises glorious <chord name="G/D"/>from the dead.<br/>
      <chord name="F#m/C#"/>All glory <chord name="A"/>to our <chord name="D"/>risen <chord name="A/E"/>head! Alleluia!
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="D/A"/>Lord, by the stripes <chord name="Em/B"/>which <chord name="D/A"/>wounded <chord name="F#m"/>You,<br/>
      <chord name="A"/>From death&#x27;s sting free <chord name="G/D"/>Your servants too,<br/>
      <chord name="F#m/C#"/>That we may <chord name="A"/>live and <chord name="D"/>sing to <chord name="A/E"/>You. Alleluia!
      </lines>
    </verse>
  </lyrics>
</song>
