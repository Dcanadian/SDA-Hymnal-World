  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F/C"/>Jesus, <chord name="Gm/D"/>keep <chord name="F/C"/>me <chord name="C7/Bb"/>near the <chord name="Dm/A"/>cross; <chord name="Bb"/>there a precious <chord name="Dm/A"/>fountain,<br/>
      <chord name="F/C"/>Free to all, ahealing stream, <chord name="Gm/D"/>flows from <chord name="F/C"/>Calvary&#x27;s <chord name="C7/Bb"/>mountain.<br/>
      <chord name="Bb"/>In the cross, <chord name="F"/>in the cross, be my <chord name="C/G"/>glory <chord name="C7/Bb"/>ever,<br/>
      <chord name="F/C"/>Till my <chord name="Am"/>raptured <chord name="Gm/D"/>soul shall <chord name="Dm/F"/>find rest <chord name="F"/>beyond the <chord name="Dm/F"/>river.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="F/C"/>In the cross, in <chord name="C"/>the cross,<br/>
      <chord name="F"/>be my <chord name="Bb/F"/>glory <chord name="Edim"/>ever,<br/>
      <chord name="Dm/F"/>till my raptured <chord name="F"/>soul shall find<br/>
      <chord name="C/G"/>rest beyond <chord name="C7/Bb"/>the river.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F/C"/>Near <chord name="Gm/D"/>the <chord name="F/C"/>cross, <chord name="Dm/A"/>a <chord name="Bb"/>trembling <chord name="Dm/A"/>soul,<br/>
      <chord name="F/C"/>love and <chord name="C"/>mercy <chord name="F/C"/>found <chord name="C7/Bb"/>me;<br/>
      <chord name="Bb"/>there the <chord name="F"/>bright and morning <chord name="C7/Bb"/>star<br/>
      <chord name="F/C"/>sheds <chord name="Am"/>its <chord name="Gm/D"/>beams <chord name="Dm/F"/>around me.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F/C"/>Near <chord name="Gm/D"/>the <chord name="F/C"/>cross! <chord name="Dm/A"/>O <chord name="Bb"/>Lamb <chord name="Am"/>of <chord name="Dm/A"/>God,<br/>
      <chord name="F/C"/>bring its <chord name="C"/>scenes <chord name="Gm/D"/>before <chord name="C7/Bb"/>me;<br/>
      <chord name="Bb"/>help me <chord name="F"/>walk from day <chord name="C/G"/>to <chord name="C7/Bb"/>day<br/>
      <chord name="F/C"/>with <chord name="Am"/>its <chord name="Gm/D"/>shadow <chord name="F"/>o&#x27;er <chord name="Dm/F"/>me.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F/C"/>Near <chord name="Gm/D"/>the <chord name="F/C"/>cross <chord name="Dm/A"/>I&#x27;ll <chord name="Bb"/>watch <chord name="Am"/>and <chord name="Dm/A"/>wait,<br/>
      <chord name="F/C"/>hoping, <chord name="C"/>trusting <chord name="F/C"/>ever,<br/>
      <chord name="Bb"/>till I <chord name="F"/>reach the golden <chord name="C7/Bb"/>strand<br/>
      <chord name="F/C"/>just <chord name="Am"/>beyond <chord name="Gm/D"/>the <chord name="Dm/F"/>river.
      </lines>
    </verse>
  </lyrics>
