  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C"/>Joy <chord name="F"/>to the <chord name="C"/>world, <chord name="F"/>the <chord name="C"/>Lord <chord name="G"/>is <chord name="C"/>come!<br/>
      Let <chord name="F"/>earth re<chord name="G"/>ceive her <chord name="C"/>Ki<chord name="F"/>ng<chord name="C"/>;<br/>
      <chord name="C"/>Let ev<chord name="F"/>ery <chord name="C"/>heart prepare <chord name="F"/>Him <chord name="C"/>room,<br/>
      <chord name="C"/>And heaven and nature sing,<br/>
      And <chord name="G"/>heaven and nature <chord name="G7"/>sing,<br/>
      And <chord name="C"/>heaven, <chord name="F"/>and <chord name="C"/>heaven <chord name="F"/>and <chord name="C"/>na<chord name="G"/>ture <chord name="C"/>sing.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="C"/>Joy <chord name="F"/>to <chord name="C"/>the <chord name="F"/>earth, <chord name="C"/>the <chord name="G"/>Savior <chord name="C"/>reigns!<br/>
      <chord name="F"/>Let <chord name="G"/>men <chord name="C"/>their <chord name="F"/>songs <chord name="C"/>employ;<br/>
      <chord name="C"/>While <chord name="F"/>fields and <chord name="C"/>floods, <chord name="F"/>rocks, hills, <chord name="C"/>and plains,<br/>
      <chord name="C"/>Repeat the sounding joy, Repeat the sounding joy,<br/>
      <chord name="G"/>Repeat, repeat <chord name="G7"/>the sounding joy.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="C"/>No <chord name="F"/>more <chord name="C"/>let <chord name="F"/>sin <chord name="C"/>and <chord name="G"/>sorrow <chord name="C"/>grow,<br/>
      <chord name="F"/>Nor <chord name="G"/>thorns <chord name="C"/>infest <chord name="F"/>the <chord name="C"/>ground;<br/>
      <chord name="C"/>He <chord name="F"/>comes <chord name="C"/>to make <chord name="F"/>His <chord name="C"/>blessings flow<br/>
      <chord name="C"/>Far as the curse is found, Far as the curse is found,<br/>
      <chord name="G"/>Far as, far as <chord name="G7"/>the curse is found.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="C"/>He <chord name="F"/>rules <chord name="C"/>the <chord name="F"/>world <chord name="C"/>with <chord name="G"/>truth <chord name="C"/>and grace,<br/>
      <chord name="F"/>And <chord name="G"/>makes <chord name="C"/>the <chord name="F"/>nations <chord name="C"/>prove<br/>
      <chord name="C"/>The <chord name="F"/>glories <chord name="C"/>of <chord name="F"/>His <chord name="C"/>righteousness,<br/>
      <chord name="C"/>And wonders of His love, And wonders of His love,<br/>
      <chord name="G"/>And wonders, and <chord name="G7"/>wonders of His love.
      </lines>
    </verse>
