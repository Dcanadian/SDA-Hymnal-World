  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Eternal <chord name="C7/G"/>Love, we <chord name="Am"/>have no <chord name="Abdim"/>good to <chord name="C7/G"/>bring Thee,<br/>
      <chord name="F"/>No <chord name="Dm"/>single <chord name="C/E"/>good <chord name="F"/>of <chord name="C/E"/>all <chord name="Dm"/>our hands <chord name="C/G"/>have <chord name="Gm"/>wrought,<br/>
      <chord name="F"/>No <chord name="C7/G"/>worthy music <chord name="Am"/>have <chord name="F/A"/>we found to <chord name="C7/Bb"/>sing <chord name="Bb"/>Thee,<br/>
      <chord name="Gm"/>No <chord name="Am/C"/>jewelled word, no <chord name="Bb"/>quick up <chord name="F/C"/>soaring thought.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>And <chord name="C7/G"/>yet <chord name="F/A"/>we <chord name="C7/G"/>come; and <chord name="Am"/>when our <chord name="Abdim"/>faith would <chord name="C7/G"/>falter<br/>
      <chord name="F"/>Show <chord name="Dm"/>us, O <chord name="C/E"/>Love, <chord name="F"/>the <chord name="Dm"/>quiet place <chord name="C/G"/>of <chord name="Gm"/>prayer,<br/>
      <chord name="F"/>The <chord name="C7/G"/>golden censer <chord name="Am"/>and <chord name="F/A"/>the golden <chord name="C7/Bb"/>altar,<br/>
      <chord name="Gm"/>And <chord name="Am/C"/>the <chord name="C7/Bb"/>great <chord name="Am"/>angel <chord name="Bb"/>waiting <chord name="F/C"/>for <chord name="C7"/>us <chord name="F"/>there.
      </lines>
    </verse>
  </lyrics>
