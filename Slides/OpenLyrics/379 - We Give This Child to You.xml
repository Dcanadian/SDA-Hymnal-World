<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>379 - We Give This Child to You</title>
      <title>We Give This Child to You</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="379"/>
    </songbooks>
    <key>Eb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Christian Church</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb"/>We give <chord name="Ab/Eb"/>this child <chord name="Eb"/>toYou,<br/>
      <chord name="Eb"/>Our precious <chord name="Ab"/>gift <chord name="Gm"/>of love.<br/>
      <chord name="Cm"/>Help us <chord name="Bb"/>to <chord name="Bb7/Ab"/>lead <chord name="Eb/G"/>each step <chord name="Bb/F"/>aright<br/>
      <chord name="Ab/C"/>With <chord name="Eb/Bb"/>guidance <chord name="Bb7"/>froma bove.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Eb"/>O bless each <chord name="Ab/Eb"/>child of <chord name="Eb"/>Yours,<br/>
      <chord name="Eb"/>And grant <chord name="Ab"/>when they <chord name="Gm"/>are grown,<br/>
      <chord name="Cm"/>They will <chord name="Bb"/>have <chord name="Bb7/Ab"/>learned <chord name="Eb/G"/>to love <chord name="Bb/F"/>Your <chord name="Eb"/>way,<br/>
      <chord name="Ab/C"/>And <chord name="Eb/Bb"/>choose <chord name="Ab"/>it <chord name="Bb7"/>for their own.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Eb"/>We give ourselves <chord name="Ab/Eb"/>to <chord name="Eb"/>You,<br/>
      <chord name="Eb"/>And may <chord name="Ab"/>Your Spirit <chord name="Gm"/>fill<br/>
      <chord name="Cm"/>Our hearts <chord name="Bb"/>and <chord name="Bb7/Ab"/>home, <chord name="Eb/G"/>that all <chord name="Bb/F"/>we <chord name="Eb"/>do<br/>
      <chord name="Ab/C"/>Be <chord name="Eb/Bb"/>subject <chord name="Bb7"/>to Your will.
      </lines>
    </verse>
  </lyrics>
</song>
