<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>304 - Faith of Our Fathers</title>
      <title>Faith of Our Fathers</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="304"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Gospel</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>Faith of our fathers, <chord name="Am"/>liv<chord name="D7"/>ing <chord name="G"/>still,<br/>
      <chord name="C"/>In spite of <chord name="G"/>dungeon, <chord name="A7"/>fire and <chord name="D"/>sword;<br/>
      <chord name="G"/>O how our hearts beat <chord name="Am"/>high <chord name="D7"/>with <chord name="G"/>joy<br/>
      <chord name="C"/>Whenever we <chord name="G"/>hear that <chord name="A7"/>glo<chord name="D7"/>rious <chord name="G"/>Word!<br/>
      <chord name="C"/>Faith of our <chord name="G"/>fathers, <chord name="D7"/>holy <chord name="G"/>faith!<br/>
      <chord name="G"/>We will be <chord name="C"/>true <chord name="Em"/>to <chord name="D"/>thee <chord name="D7"/>till <chord name="G"/>death.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>Our <chord name="Am"/>fathers, chained <chord name="D7"/>in <chord name="G"/>prisons dark,<br/>
      <chord name="C"/>Were <chord name="G"/>still in <chord name="A7"/>heart and <chord name="D"/>conscience free:<br/>
      <chord name="G"/>How <chord name="Am"/>sweet would <chord name="D7"/>be their <chord name="G"/>children&#x27;s fate.<br/>
      <chord name="C"/>If <chord name="G"/>they, like <chord name="A7"/>them, <chord name="D7"/>could die <chord name="G"/>for thee!<br/>
      <chord name="C"/>Faith <chord name="G"/>of our <chord name="D7"/>fathers, <chord name="G"/>holy faith!<br/>
      <chord name="G"/>We <chord name="C"/>will <chord name="Em"/>be true <chord name="D"/>to <chord name="D7"/>thee <chord name="G"/>till death.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>Faith <chord name="Am"/>of our <chord name="D7"/>fathers, we <chord name="G"/>will love<br/>
      <chord name="C"/>Both friend <chord name="G"/>and foe <chord name="A7"/>in all <chord name="D"/>our strife;<br/>
      <chord name="G"/>And preach <chord name="Am"/>Thee, too, <chord name="D7"/>as love <chord name="G"/>knows how<br/>
      <chord name="C"/>By <chord name="G"/>kindly <chord name="A7"/>words <chord name="D7"/>and <chord name="G"/>virtuous life.<br/>
      <chord name="C"/>Faith <chord name="G"/>of our <chord name="D7"/>fathers, <chord name="G"/>holy faith!<br/>
      <chord name="G"/>We <chord name="C"/>will <chord name="Em"/>be true <chord name="D"/>to <chord name="D7"/>thee <chord name="G"/>till death.
      </lines>
    </verse>
  </lyrics>
</song>
