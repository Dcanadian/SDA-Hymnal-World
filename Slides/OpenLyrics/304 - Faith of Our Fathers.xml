<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>304 - Faith of Our Fathers</title>
      <title>Faith of Our Fathers</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="304"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Gospel</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G/D"/>Faith <chord name="D7/C"/>of <chord name="Em/B"/>our fathers, <chord name="Am"/>living <chord name="D7/C"/>still,<br/>
      <chord name="G"/>In spite <chord name="C/G"/>of <chord name="G"/>dungeon, <chord name="Em"/>fire and <chord name="A7"/>sword;<br/>
      <chord name="G/D"/>O <chord name="D7/C"/>how <chord name="Em/B"/>our hearts <chord name="G"/>beat <chord name="D7/C"/>high <chord name="C"/>with <chord name="D/A"/>joy<br/>
      <chord name="G"/>Whenever we hear that glorious Word!<br/>
      <chord name="C/E"/>Faith of our <chord name="G/D"/>fathers, <chord name="D"/>holy <chord name="G/D"/>faith!<br/>
      <chord name="G"/>We <chord name="F#dim"/>will <chord name="G"/>be <chord name="C/G"/>true <chord name="G"/>to thee <chord name="F#dim"/>till <chord name="G"/>death.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G/D"/>Our <chord name="D7/C"/>fathers, <chord name="Em/B"/>chained in <chord name="Am"/>prisons <chord name="D7/C"/>dark,<br/>
      <chord name="G"/>Were still <chord name="C/G"/>in <chord name="G"/>heart and <chord name="Em"/>conscience <chord name="A7"/>free:<br/>
      <chord name="G/D"/>How <chord name="D7/C"/>sweet <chord name="Em/B"/>would be <chord name="G"/>their <chord name="D7/C"/>children&#x27;s <chord name="D/A"/>fate.<br/>
      <chord name="G"/>If they, <chord name="C/G"/>like <chord name="G"/>them, could die for <chord name="F#dim"/>thee!<br/>
      <chord name="C/E"/>Faith of our <chord name="G/D"/>fathers, <chord name="D"/>holy <chord name="G/D"/>faith!<br/>
      <chord name="G"/>We <chord name="F#dim"/>will <chord name="G"/>be <chord name="C/G"/>true <chord name="G"/>to thee <chord name="F#dim"/>till <chord name="G"/>death.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G/D"/>Faith <chord name="D7/C"/>of <chord name="Em/B"/>our fathers, <chord name="Am"/>we will <chord name="D7/C"/>love<br/>
      <chord name="G"/>Both friend <chord name="C/G"/>and <chord name="G"/>foe in <chord name="Em"/>all our <chord name="A7"/>strife;<br/>
      <chord name="G/D"/>And <chord name="D7/C"/>preach <chord name="Em/B"/>Thee, too, <chord name="G"/>as <chord name="D7/C"/>love <chord name="C"/>knows <chord name="D/A"/>how<br/>
      <chord name="G"/>By kindly words and virtuous <chord name="F#dim"/>life.<br/>
      <chord name="C/E"/>Faith of our <chord name="G/D"/>fathers, <chord name="D"/>holy <chord name="G/D"/>faith!<br/>
      <chord name="G"/>We <chord name="F#dim"/>will <chord name="G"/>be <chord name="C/G"/>true <chord name="G"/>to thee <chord name="F#dim"/>till <chord name="G"/>death.
      </lines>
    </verse>
  </lyrics>
</song>
