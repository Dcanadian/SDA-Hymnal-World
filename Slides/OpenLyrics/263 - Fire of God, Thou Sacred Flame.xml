<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>263 - Fire of God, Thou Sacred Flame</title>
      <title>Fire of God, Thou Sacred Flame</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="263"/>
    </songbooks>
    <key>D</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4 v5</verseOrder>
    <themes>
      <theme>Holy Spirit</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D/A"/>Fire <chord name="Em/B"/>of <chord name="A"/>God, <chord name="Bm/F#"/>Thou <chord name="Em"/>sacred <chord name="A"/>flame,<br/>
      <chord name="A"/>Spirit who <chord name="D/A"/>in <chord name="A"/>splendor <chord name="G#m"/>came,<br/>
      <chord name="D/A"/>Let <chord name="Em/B"/>Thy <chord name="A"/>heat <chord name="Bm/F#"/>my <chord name="G"/>soul refine<br/>
      <chord name="A"/>Till <chord name="A7"/>it glows with <chord name="D/F#"/>love <chord name="Em/B"/>divine.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D/A"/>Breath of <chord name="Em/B"/>God, <chord name="A"/>that <chord name="Bm/F#"/>swept <chord name="Em"/>in <chord name="A"/>power<br/>
      <chord name="A"/>In <chord name="G#m"/>the <chord name="A"/>pentecostal <chord name="G#m"/>hour,<br/>
      <chord name="D/A"/>Holy <chord name="A"/>Breath, <chord name="Bm/F#"/>be <chord name="G"/>Thou in <chord name="D"/>me<br/>
      <chord name="A"/>Source <chord name="A7"/>of vital <chord name="D/F#"/>energy.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D/A"/>Strength <chord name="Em/B"/>of <chord name="A"/>God, <chord name="Bm/F#"/>Thy <chord name="Em"/>might <chord name="A"/>within<br/>
      <chord name="A"/>Conquers sorrow, pain, <chord name="G#m"/>and sin:<br/>
      <chord name="D/A"/>Fortify <chord name="Bm/F#"/>from <chord name="G"/>evil&#x27;s <chord name="D"/>art<br/>
      <chord name="A"/>All <chord name="A7"/>the gateways <chord name="Em/B"/>of <chord name="A7/G"/>my <chord name="D/F#"/>heart.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="D/A"/>Truth <chord name="Em/B"/>of <chord name="A"/>God, <chord name="Bm/F#"/>Thy <chord name="Em"/>piercing <chord name="D/A"/>rays<br/>
      <chord name="A"/>Penetrate <chord name="D/A"/>my <chord name="A"/>secret <chord name="G#m"/>ways.<br/>
      <chord name="D/A"/>May <chord name="Em/B"/>the <chord name="A"/>light <chord name="Bm/F#"/>that <chord name="G"/>shames <chord name="D"/>my <chord name="A"/>sin<br/>
      <chord name="A"/>Guide <chord name="A7"/>me holier <chord name="D/F#"/>paths <chord name="Em/B"/>to <chord name="A7/G"/>win.
      </lines>
    </verse>
    <verse name="v5">
      <lines>
      <chord name="D/A"/>Love <chord name="Em/B"/>of <chord name="A"/>God, <chord name="Bm/F#"/>Thy <chord name="Em"/>grace <chord name="A"/>profound<br/>
      <chord name="A"/>Knoweth neither age <chord name="G#m"/>nor bound:<br/>
      <chord name="D/A"/>Come, <chord name="Em/B"/>my <chord name="A"/>heart&#x27;s <chord name="Bm/F#"/>own <chord name="G"/>guest to <chord name="D"/>be,<br/>
      <chord name="A"/>Dwell <chord name="A7"/>forevermore <chord name="Em/B"/>in <chord name="A7/G"/>me.
      </lines>
    </verse>
  </lyrics>
</song>
