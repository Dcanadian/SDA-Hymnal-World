<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>445 - I&#x27;m But a Stranger Here</title>
      <title>I&#x27;m But a Stranger Here</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="445"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Early Advent</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>I’m but <chord name="C7"/>a<chord name="F"/>stranger here,<br/>
      <chord name="Gm"/>Heav’n <chord name="F"/>is <chord name="C"/>my <chord name="F"/>home;<br/>
      <chord name="F"/>Earth is <chord name="C7"/>a<chord name="F"/>desert drear,<br/>
      <chord name="Gm"/>Heav’n <chord name="F"/>is <chord name="C"/>my <chord name="F"/>home.<br/>
      <chord name="F"/>Dan<chord name="Bb"/>ger <chord name="F"/>and sorrow <chord name="C7"/>stand<br/>
      Round <chord name="F"/>me <chord name="C7"/>on every <chord name="F"/>hand;<br/>
      <chord name="Bb"/>Heav’n is my <chord name="F"/>Fatherland,<br/>
      <chord name="Dm"/>Heav’n <chord name="Gm"/>is <chord name="C7"/>my <chord name="F"/>home.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>What <chord name="C7"/>though the <chord name="F"/>tempest rage,<br/>
      <chord name="Gm"/>Heav&#x27;n <chord name="F"/>is <chord name="C"/>my <chord name="F"/>home;<br/>
      <chord name="F"/>Short <chord name="C7"/>is <chord name="F"/>my pilgrimage,<br/>
      <chord name="Gm"/>Heav&#x27;n <chord name="F"/>is <chord name="C"/>my <chord name="F"/>home;<br/>
      <chord name="F"/>And <chord name="Bb"/>time&#x27;s <chord name="F"/>wild <chord name="C7"/>wintry blast<br/>
      <chord name="F"/>Soon <chord name="C7"/>shall be <chord name="F"/>over past;<br/>
      <chord name="Bb"/>I shall reach <chord name="F"/>home at last,<br/>
      <chord name="Dm"/>Heav&#x27;n <chord name="Gm"/>is <chord name="C7"/>my <chord name="F"/>home.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>There <chord name="C7"/>at my <chord name="F"/>Savior&#x27;s side<br/>
      <chord name="Gm"/>Heav&#x27;n <chord name="F"/>is <chord name="C"/>my <chord name="F"/>home;<br/>
      <chord name="F"/>I <chord name="C7"/>shall <chord name="F"/>be glorified,<br/>
      <chord name="Gm"/>Heav&#x27;n <chord name="F"/>is <chord name="C"/>my <chord name="F"/>home;<br/>
      <chord name="F"/>There <chord name="Bb"/>are the <chord name="F"/>good <chord name="C7"/>and blest,<br/>
      <chord name="F"/>Those I <chord name="C7"/>love most <chord name="F"/>and best;<br/>
      <chord name="Bb"/>And there I, <chord name="F"/>too, shall rest,<br/>
      <chord name="Dm"/>Heav&#x27;n <chord name="Gm"/>is <chord name="C7"/>my <chord name="F"/>home.
      </lines>
    </verse>
  </lyrics>
</song>
