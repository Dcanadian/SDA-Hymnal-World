<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>445 - I&#x27;m But a Stranger Here</title>
      <title>I&#x27;m But a Stranger Here</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="445"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Early Advent</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>I’m but astranger here,<br/>
      <chord name="Gm/Bb"/>Heav’n <chord name="F/C"/>is <chord name="C"/>my <chord name="F"/>home;<br/>
      <chord name="F"/>Earth is adesert drear,<br/>
      <chord name="Gm/Bb"/>Heav’n is <chord name="F/C"/>my <chord name="C"/>home.<br/>
      <chord name="F"/>Danger <chord name="Bb/F"/>and <chord name="F"/>sorrow stand<br/>
      <chord name="C7"/>Round me on every <chord name="F"/>hand;<br/>
      <chord name="Bb"/>Heav’n is <chord name="F"/>my Fatherland,<br/>
      <chord name="F"/>Heav’n is my home.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>What though the tempest rage,<br/>
      <chord name="Gm/Bb"/>Heav&#x27;n <chord name="F/C"/>is <chord name="C"/>my <chord name="F"/>home;<br/>
      <chord name="F"/>Short is my pilgrimage,<br/>
      <chord name="Gm/Bb"/>Heav&#x27;n is <chord name="F/C"/>my <chord name="C"/>home;<br/>
      <chord name="F"/>And time&#x27;s wild wintry blast<br/>
      <chord name="C7"/>Soon shall be over past;<br/>
      <chord name="Bb"/>I shall <chord name="F"/>reach home <chord name="Dm"/>at <chord name="Gm/Bb"/>last,<br/>
      <chord name="F"/>Heav&#x27;n is my home.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>There at my Savior&#x27;s side<br/>
      <chord name="Gm/Bb"/>Heav&#x27;n <chord name="F/C"/>is <chord name="C"/>my <chord name="F"/>home;<br/>
      <chord name="F"/>I shall be glorified,<br/>
      <chord name="Gm/Bb"/>Heav&#x27;n is <chord name="F/C"/>my <chord name="C"/>home;<br/>
      <chord name="F"/>There are <chord name="Bb/F"/>the <chord name="F"/>good and blest,<br/>
      <chord name="C7"/>Those I love most and best;<br/>
      <chord name="Bb"/>And there <chord name="F"/>I, too, <chord name="Dm"/>shall <chord name="Gm/Bb"/>rest,<br/>
      <chord name="F"/>Heav&#x27;n is my home.
      </lines>
    </verse>
  </lyrics>
</song>
