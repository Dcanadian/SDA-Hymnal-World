<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>549 - Loving Shepherd of Thy Sheep</title>
      <title>Loving Shepherd of Thy Sheep</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="549"/>
    </songbooks>
    <key>Eb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb"/>Loving Shepherd <chord name="Fm/Ab"/>of <chord name="Bb"/>Thy <chord name="Eb"/>sheep,<br/>
      <chord name="Eb"/>Keep Thy <chord name="Ab"/>lamb, <chord name="Cm"/>in safety <chord name="Eb"/>keep;<br/>
      <chord name="Eb"/>Nothing <chord name="Ab/C"/>can <chord name="Gm/Bb"/>Thy <chord name="Fm/Ab"/>power <chord name="Ab"/>withstand;<br/>
      <chord name="Gm"/>None can pluck <chord name="Cm"/>me <chord name="Fm/Ab"/>from <chord name="Bb"/>Thy <chord name="Eb"/>hand.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Eb"/>Loving Shepherd, <chord name="Fm/Ab"/>ever <chord name="Eb"/>near,<br/>
      <chord name="Eb"/>Teach Thy <chord name="Ab"/>lamb <chord name="Cm"/>Thy voice <chord name="Bb"/>to hear;<br/>
      <chord name="Eb"/>Suffer <chord name="Ab/C"/>not <chord name="Gm/Bb"/>my <chord name="Fm/Ab"/>steps <chord name="Ab"/>to stray<br/>
      <chord name="Gm"/>From the straight <chord name="Cm"/>and <chord name="Fm/Ab"/>narrow <chord name="Eb"/>way.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Eb"/>Where Thou leadest <chord name="Fm/Ab"/>I <chord name="Bb"/>would <chord name="Eb"/>go,<br/>
      <chord name="Eb"/>Walking <chord name="Ab"/>in <chord name="Cm"/>Thy steps <chord name="Bb"/>below,<br/>
      <chord name="Eb"/>Till <chord name="Bb/D"/>within <chord name="Gm/Bb"/>the <chord name="Fm/Ab"/>heavenly <chord name="Gm"/>fold<br/>
      <chord name="Gm"/>I my Shepherd <chord name="Fm/Ab"/>shall <chord name="Bb"/>behold.
      </lines>
    </verse>
  </lyrics>
</song>
