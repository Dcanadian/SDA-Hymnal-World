<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>514 - Lord of Our Life</title>
      <title>Lord of Our Life</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="514"/>
    </songbooks>
    <key>Db</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Db"/>Lord of our <chord name="Bbm"/>life, and God of <chord name="Db/Ab"/>our <chord name="Ab7"/>salvation,<br/>
      <chord name="Cdim"/>Star of our <chord name="Bbm"/>night, <chord name="C7"/>and hope of every <chord name="Db"/>nation,<br/>
      <chord name="Gb"/>Hear <chord name="Fm"/>and receive Thy <chord name="Bbm"/>church&#x27;s supplication,<br/>
      <chord name="Db"/>Lord God Almighty.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Db"/>Lord, Thou canst <chord name="Bbm"/>help when earthly <chord name="Db/Ab"/>armor <chord name="Ab7"/>faileth;<br/>
      <chord name="Cdim"/>Lord, Thou canst <chord name="Bbm"/>save <chord name="C7"/>when deadly <chord name="Fm"/>sin assaileth;<br/>
      <chord name="Gb"/>Lord, <chord name="Fm"/>o&#x27;er Thy rock nor <chord name="Bbm"/>death nor <chord name="Gb"/>hell prevaileth;<br/>
      <chord name="Db"/>Grant us Thy peace, Lord
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Db"/>Peace in our <chord name="Bbm"/>hearts our evil <chord name="Db/Ab"/>thoughts <chord name="Ab7"/>assuaging;<br/>
      <chord name="Cdim"/>Peace in Thy <chord name="Bbm"/>church, <chord name="C7"/>where brothers <chord name="Fm"/>are engaging;<br/>
      <chord name="Gb"/>Peace, <chord name="Fm"/>when the world its <chord name="Bbm"/>busy <chord name="Gb"/>war is waging;<br/>
      <chord name="Db"/>Send us, O Savior.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Db"/>Grant us Thy <chord name="Bbm"/>help till foes are <chord name="Db/Ab"/>backward <chord name="Ab7"/>driven;<br/>
      <chord name="Cdim"/>Grant them Thy <chord name="Bbm"/>truth <chord name="C7"/>that they may <chord name="Fm"/>be forgiven;<br/>
      <chord name="Gb"/>Grant <chord name="Fm"/>peace on earth, and, <chord name="Bbm"/>after <chord name="Gb"/>we have striven,<br/>
      <chord name="Db"/>Peace in Thy heaven.
      </lines>
    </verse>
  </lyrics>
</song>
