      <title>019 - O Sing a New Song to the Lord</title>
      <title>O Sing a New Song to the Lord</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="19"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
