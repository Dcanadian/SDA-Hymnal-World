<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>523 - My Faith Has Found a Resting Place</title>
      <title>My Faith Has Found a Resting Place</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="523"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>My faith has found a resting place,<br/>
      <chord name="G"/>Not in <chord name="C/G"/>a <chord name="C#m/G#"/>manmade <chord name="Am"/>creed;<br/>
      <chord name="Em/B"/>I trust the <chord name="D/A"/>Everliving <chord name="Em/B"/>One,<br/>
      <chord name="G"/>That He for me will plead.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="G"/>I need no <chord name="C/G"/>other <chord name="C#m/G#"/>evidence,<br/>
      <chord name="Em/B"/>I need <chord name="D/A"/>no other <chord name="Em/B"/>plea;<br/>
      <chord name="Bm"/>It is enough <chord name="G"/>that Jesus died,<br/>
      <chord name="C/G"/>And rose <chord name="D7/C"/>again <chord name="Em/B"/>for <chord name="D/A"/>me.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>Enough for me that Jesus saves,<br/>
      <chord name="G"/>This ends <chord name="C/G"/>my <chord name="C#m/G#"/>fear <chord name="Am"/>and doubt;<br/>
      <chord name="Em/B"/>A sinful <chord name="D/A"/>soul, I come <chord name="Em/B"/>to Him,<br/>
      <chord name="G"/>He will not cast me out.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>My soul is resting on the Word,<br/>
      <chord name="G"/>The living <chord name="C#m/G#"/>Word <chord name="Am"/>of God,<br/>
      <chord name="Em/B"/>Salvation <chord name="D/A"/>in my Savior&#x27;s <chord name="Em/B"/>name,<br/>
      <chord name="G"/>Salvation through His blood.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="G"/>My great Physician heals the sick,<br/>
      <chord name="G"/>The lost <chord name="C/G"/>He <chord name="C#m/G#"/>came <chord name="Am"/>to save;<br/>
      <chord name="Em/B"/>For me His <chord name="D/A"/>precious blood <chord name="Em/B"/>He shed,<br/>
      <chord name="G"/>For me His life He gave.
      </lines>
    </verse>
  </lyrics>
</song>
