  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>My faith has found a <chord name="C"/>resting place,<br/>
      <chord name="E7"/>Not <chord name="Am"/>in a <chord name="G"/>man<chord name="D"/>made <chord name="G"/>creed;<br/>
      I trust the Ever<chord name="C"/>living One,<br/>
      <chord name="E7"/>That <chord name="Am"/>He for <chord name="G"/>me <chord name="D"/>will <chord name="G"/>plead.<br/>
      I need no other <chord name="D"/>evidence,<br/>
      <chord name="G"/>I need no <chord name="C"/>oth<chord name="Am"/>er <chord name="G"/>pl<chord name="D"/>ea;<br/>
      <chord name="D7"/>It <chord name="G"/>is enough that <chord name="C"/>Jesus died,<br/>
      <chord name="E7"/>And <chord name="Am"/>rose a<chord name="G"/>gain <chord name="D"/>for <chord name="G"/>me.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="G"/>I need <chord name="C"/>no other evidence,<br/>
      <chord name="E7"/>I <chord name="Am"/>need <chord name="G"/>no <chord name="D"/>other <chord name="G"/>plea;<br/>
      <chord name="C"/>It is enough that Jesus died,<br/>
      <chord name="E7"/>And <chord name="Am"/>rose <chord name="G"/>again <chord name="D"/>for <chord name="G"/>me.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>Enough for me <chord name="C"/>that Jesus saves,<br/>
      <chord name="E7"/>This <chord name="Am"/>ends <chord name="G"/>my <chord name="D"/>fear <chord name="G"/>and doubt;<br/>
      <chord name="C"/>A sinful soul, I come to Him,<br/>
      <chord name="E7"/>He <chord name="Am"/>will <chord name="G"/>not <chord name="D"/>cast <chord name="G"/>me out.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>My soul is <chord name="C"/>resting on the Word,<br/>
      <chord name="E7"/>The <chord name="Am"/>living <chord name="G"/>Word <chord name="D"/>of <chord name="G"/>God,<br/>
      <chord name="C"/>Salvation in my Savior&#x27;s name,<br/>
      <chord name="E7"/><chord name="Am"/>Salvation <chord name="G"/>through <chord name="D"/>His <chord name="G"/>blood.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="G"/>My great Physician <chord name="C"/>heals the sick,<br/>
      <chord name="E7"/>The <chord name="Am"/>lost <chord name="G"/>He <chord name="D"/>came <chord name="G"/>to save;<br/>
      <chord name="C"/>For me His precious blood He shed,<br/>
      <chord name="E7"/>For <chord name="Am"/>me <chord name="G"/>His <chord name="D"/>life <chord name="G"/>He gave.
      </lines>
    </verse>
  </lyrics>
