      <title>525 - Hiding in Thee</title>
      <title>Hiding in Thee</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="525"/>
    </songbooks>
    <key>Eb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Gm"/>O safe <chord name="Fm/C"/>to <chord name="Eb/Bb"/>the Rock <chord name="Fm/Ab"/>that <chord name="Cm/G"/>is <chord name="F7"/>higher <chord name="Ab"/>than <chord name="Bb7/Ab"/>I,<br/>
      <chord name="Cm/G"/>My <chord name="Eb"/>soul in <chord name="Ab"/>its <chord name="Gm"/>conflicts <chord name="Eb/Bb"/>and <chord name="Bb"/>sorrows <chord name="F"/>would <chord name="Bb/F"/>fly;<br/>
      <chord name="Bb7/Ab"/>Sosinful, <chord name="Eb/Bb"/>so <chord name="Fm/Ab"/>weary, <chord name="Bb/F"/>Thine, <chord name="Ab"/>Thine, <chord name="Bb7/Ab"/>would <chord name="Cm/G"/>I <chord name="Ab/Eb"/>be;<br/>
      <chord name="Ab"/>Thou blest <chord name="Gm"/>“Rock <chord name="Eb"/>of Ages,” I’m <chord name="Bb7/Ab"/>hiding <chord name="Bb"/>inThee.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Bb"/>Hiding <chord name="Bb7"/>in <chord name="Eb/Bb"/>Thee, hiding <chord name="Bb7/F"/>in <chord name="Gm"/>Thee,<br/>
      <chord name="Bb"/>Thou <chord name="Eb/Bb"/>blest <chord name="Bb"/>&quot;Rock of <chord name="Eb"/>Ages,&quot;<br/>
      <chord name="Eb/G"/>I&#x27;m hiding <chord name="Bb7/Ab"/>in <chord name="Eb"/>Thee.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Gm"/>In the <chord name="Fm/C"/>calm <chord name="Eb/Bb"/>of the <chord name="Fm/Ab"/>noontide, <chord name="F7"/>in <chord name="Bb/F"/>sorrow&#x27;s <chord name="Bb7/Ab"/>lone <chord name="Cm/G"/>hour,<br/>
      <chord name="Cm/G"/>In times <chord name="Eb/Bb"/>when <chord name="Ab"/>temptation <chord name="Gm/Bb"/>casts <chord name="Eb/Bb"/>over <chord name="Bb"/>me <chord name="Eb/Bb"/>its <chord name="F"/>power;<br/>
      <chord name="Bb7/Ab"/>In <chord name="Gm"/>the <chord name="Fm/C"/>tempests of <chord name="Cm/G"/>life, <chord name="F7"/>on <chord name="Bb/F"/>its <chord name="Bb7/Ab"/>wide, <chord name="Cm/G"/>heaving <chord name="Ab/Eb"/>sea,<br/>
      <chord name="Ab"/>Thou blest <chord name="Gm"/>&quot;Rock <chord name="Eb"/>of Ages,&quot; I&#x27;m <chord name="Bb7/Ab"/>hiding <chord name="Bb"/>in Thee.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Gm"/>How oft <chord name="Fm/C"/>in <chord name="Eb/Bb"/>the conflict, <chord name="Cm/G"/>when <chord name="F7"/>pressed <chord name="Bb/F"/>by <chord name="Ab"/>the <chord name="Bb7/Ab"/>foe,<br/>
      <chord name="Cm/G"/>I have <chord name="Eb"/>fled to <chord name="Ab"/>my <chord name="Gm"/>refuge <chord name="Eb/Bb"/>and <chord name="Bb"/>breathed <chord name="Eb/Bb"/>out <chord name="F"/>my <chord name="Bb/F"/>woe;<br/>
      <chord name="Bb7/Ab"/>How <chord name="Gm"/>often, <chord name="Eb/Bb"/>when <chord name="Cm/G"/>trials <chord name="F7"/>like <chord name="Ab"/>sea <chord name="Bb7/Ab"/>billows <chord name="Ab/Eb"/>roll,<br/>
      <chord name="Ab"/>Have I <chord name="Gm"/>hidden <chord name="Eb/G"/>in Thee, O Thou <chord name="Bb7/Ab"/>Rock <chord name="Cm/G"/>of <chord name="Bb"/>my soul.
      </lines>
    </verse>
  </lyrics>
</song>
