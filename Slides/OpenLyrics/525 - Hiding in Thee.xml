  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb"/>O safe <chord name="Ab"/>to <chord name="Eb"/>the Rock <chord name="Bb"/>that <chord name="Eb"/>is <chord name="Bb"/>high<chord name="Bb7"/>er than <chord name="Eb"/>I,<br/>
      My <chord name="Ab"/>soul <chord name="Eb"/>in <chord name="Ab"/>its <chord name="Eb"/>conflicts and <chord name="Bb7"/>sor<chord name="Eb"/>rows <chord name="F7"/>would <chord name="Bb"/>fly;<br/>
      <chord name="Bb7"/>So<chord name="Eb"/>sin<chord name="Ab"/>ful, <chord name="Eb"/>so wea<chord name="Bb"/>ry, <chord name="Eb"/>Thine, <chord name="Bb7"/>Thine, would I <chord name="Eb"/>be;<br/>
