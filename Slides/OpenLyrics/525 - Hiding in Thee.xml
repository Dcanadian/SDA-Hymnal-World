    <verse name="v3">
      <lines>
      <chord name="Eb"/>How <chord name="Ab"/>oft <chord name="Eb"/>in <chord name="Bb"/>the conflict, <chord name="Eb"/>when <chord name="Bb"/>pressed <chord name="Bb7"/>by <chord name="Eb"/>the foe,<br/>
      <chord name="Ab"/>I <chord name="Eb"/>have <chord name="Ab"/>fled to <chord name="Eb"/>my <chord name="Bb7"/>refuge <chord name="Eb"/>and breathed <chord name="F7"/>out <chord name="Bb"/>my woe;<br/>
      <chord name="Bb7"/>How <chord name="Eb"/>often, <chord name="Ab"/>when <chord name="Eb"/>trials <chord name="Bb"/>like <chord name="Eb"/>sea <chord name="Bb7"/>billows <chord name="Eb"/>roll,<br/>
      <chord name="Ab"/>Have <chord name="Eb"/>I <chord name="Ab"/>hidden <chord name="Eb"/>in <chord name="Cm"/>Thee, O <chord name="Eb"/>Thou <chord name="Gm"/>Rock <chord name="Bb7"/>of <chord name="Eb"/>my soul.
