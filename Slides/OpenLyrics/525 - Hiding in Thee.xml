    <verse name="v2">
      <lines>
      <chord name="Eb"/>In <chord name="Ab"/>the <chord name="Eb"/>calm <chord name="Bb"/>of the <chord name="Eb"/>noontide, <chord name="Bb"/>in <chord name="Bb7"/>sorrow&#x27;s <chord name="Eb"/>lone hour,<br/>
      <chord name="Ab"/>In <chord name="Eb"/>times <chord name="Ab"/>when <chord name="Eb"/>temptation <chord name="Bb7"/>casts <chord name="Eb"/>over <chord name="F7"/>me <chord name="Bb"/>its power;<br/>
      <chord name="Bb7"/>In <chord name="Eb"/>the <chord name="Ab"/>tempests <chord name="Eb"/>of life, <chord name="Bb"/>on <chord name="Eb"/>its <chord name="Bb7"/>wide, <chord name="Eb"/>heaving sea,<br/>
      <chord name="Ab"/>Thou <chord name="Eb"/>blest <chord name="Ab"/>&quot;Rock <chord name="Eb"/>of <chord name="Cm"/>Ages,&quot; <chord name="Eb"/>I&#x27;m <chord name="Gm"/>hiding <chord name="Bb7"/>in <chord name="Eb"/>Thee.
      </lines>
