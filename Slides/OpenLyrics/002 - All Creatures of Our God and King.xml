  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D/F#"/>All creatures <chord name="Bm"/>of <chord name="A"/>our <chord name="D/A"/>God <chord name="A7"/>and King,<br/>
      <chord name="Bm"/>Lift up <chord name="A"/>your <chord name="A7"/>voice <chord name="D"/>with us <chord name="G/D"/>and sing:<br/>
      <chord name="F#m"/>Alleluia! <chord name="D"/>Alleluia!<br/>
      <chord name="A7"/>O burning sun <chord name="D"/>with <chord name="C#dim"/>golden <chord name="D"/>beam,<br/>
      <chord name="Bm"/>And silver <chord name="A"/>moon <chord name="Bm"/>with softer <chord name="Em/B"/>gleam:
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="F#m"/>Oh, praise <chord name="A"/>Him! Oh, <chord name="Em"/>praise Him!<br/>
      <chord name="A7/G"/>Alleluia! <chord name="Em/B"/>alleluia!<br/>
      <chord name="D/F#"/>Alleluia!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D/F#"/>O rushing <chord name="Bm"/>wind <chord name="A"/>and <chord name="A7"/>breezes soft,<br/>
      <chord name="Bm"/>O clouds <chord name="A"/>that <chord name="A7"/>ride <chord name="D"/>the winds <chord name="G/D"/>aloft,<br/>
      <chord name="F#m"/>Oh, praise <chord name="A"/>Him! <chord name="D"/>Alleluia!<br/>
      <chord name="A7"/>O rising morn, <chord name="D"/>in <chord name="C#dim"/>praise <chord name="A"/>rejoice,<br/>
      <chord name="Bm"/>O lights <chord name="A"/>of evening, <chord name="Bm"/>find <chord name="Em/B"/>a voice:
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D/F#"/>O flowing <chord name="Bm"/>waters, <chord name="A7"/>pure and clear,<br/>
      <chord name="Bm"/>Make music <chord name="A7"/>for <chord name="D"/>your Lord <chord name="G/D"/>to hear,<br/>
      <chord name="F#m"/>Oh, praise <chord name="A"/>Him! <chord name="D"/>Alleluia!<br/>
      <chord name="A7"/>O fire so masterful <chord name="A"/>and <chord name="D"/>bright,<br/>
      <chord name="Bm"/>Providing <chord name="A"/>us <chord name="Bm"/>with warmth <chord name="Em/B"/>and light:
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="D/F#"/>Let all things <chord name="Bm"/>their <chord name="A7"/>Creator bless,<br/>
      <chord name="Bm"/>And worship <chord name="A7"/>Him <chord name="D"/>in humbleness,<br/>
      <chord name="F#m"/>Oh, praise <chord name="A"/>Him! <chord name="D"/>Alleluia!<br/>
      <chord name="A7"/>Oh, praise the Father, <chord name="C#dim"/>praise <chord name="A"/>the <chord name="D"/>Son,<br/>
      <chord name="Bm"/>And praise <chord name="A"/>the Spirit, <chord name="Bm"/>three <chord name="Em/B"/>in One!
      </lines>
    </verse>
