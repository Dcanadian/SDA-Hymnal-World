<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>287 - Softly and Tenderly</title>
      <title>Softly and Tenderly</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="287"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3</verseOrder>
    <themes>
      <theme>Gospel</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>Softly and tenderly <chord name="C"/>Jesus is <chord name="G"/>calling,<br/>
      <chord name="G"/>Calling for <chord name="A7"/>you and for <chord name="D"/>me;<br/>
      <chord name="G"/>At the heart&#x27;s portals He&#x27;s <chord name="C"/>waiting and watching,<br/>
      <chord name="G"/>Watching <chord name="C"/>for <chord name="G"/>you and <chord name="D7"/>for <chord name="G"/>me.<br/>
      <chord name="G"/>Come <chord name="D7"/>home, come <chord name="G"/>ho<chord name="D7"/>me;<chord name="G"/><br/>
      <chord name="D"/>Ye who are <chord name="E"/>weary <chord name="A7"/>come <chord name="D"/>ho<chord name="A7"/>me;<chord name="D7"/><br/>
      <chord name="G"/>Earnestly, tenderly, <chord name="C"/>Jesus is <chord name="G"/>calling,<br/>
      <chord name="G"/>Calling, <chord name="C"/>O <chord name="G"/>sinner, <chord name="D7"/>come <chord name="G"/>home!
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="G"/>Come <chord name="C"/>home, <chord name="G"/>come home;<br/>
      <chord name="G"/>ye who <chord name="A7"/>are weary <chord name="D"/>come home;<br/>
      <chord name="G"/>earnestly, tenderly, <chord name="C"/>Jesus is calling,<br/>
      <chord name="G"/>calling, <chord name="C"/>O <chord name="G"/>sinner, <chord name="D7"/>come <chord name="G"/>home!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>Why should <chord name="C"/>we tary when <chord name="G"/>Jesus is pleading,<br/>
      <chord name="G"/>pleading for <chord name="A7"/>you and <chord name="D"/>for me?<br/>
      <chord name="G"/>Why should we linger <chord name="C"/>and heed not his mercies,<br/>
      <chord name="G"/>mercies <chord name="C"/>for <chord name="G"/>you <chord name="D7"/>and <chord name="G"/>for me?
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>Think of <chord name="C"/>the wonderful love <chord name="G"/>he has promised,<br/>
      <chord name="G"/>promised for <chord name="A7"/>you and <chord name="D"/>for me!<br/>
      <chord name="G"/>Though we have sinned, <chord name="C"/>he has mercy and pardon,<br/>
      <chord name="G"/>pardon <chord name="C"/>for <chord name="G"/>you <chord name="D7"/>and <chord name="G"/>for me.
      </lines>
    </verse>
  </lyrics>
</song>
