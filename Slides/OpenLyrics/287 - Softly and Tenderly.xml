<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>287 - Softly and Tenderly</title>
      <title>Softly and Tenderly</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="287"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3</verseOrder>
    <themes>
      <theme>Gospel</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G/D"/>Softly and tenderly Jesus is <chord name="C/G"/>calling,<br/>
      <chord name="C"/>Calling <chord name="G"/>for you and for me;<br/>
      <chord name="Em"/>At the <chord name="D"/>heart&#x27;s <chord name="G"/>portals He&#x27;s waiting and <chord name="C/G"/>watching,<br/>
      <chord name="C"/>Watching <chord name="G"/>for you and for me.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="G/D"/>Come home, come home;<br/>
      <chord name="D"/>ye who are <chord name="D7"/>weary <chord name="G"/>come home;<br/>
      <chord name="G/D"/>earnestly, tenderly, Jesus <chord name="D/F#"/>is calling,<br/>
      <chord name="Em"/>calling, O sinner, <chord name="D"/>come home!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G/D"/>Why should we tary when Jesus is <chord name="C/G"/>pleading,<br/>
      <chord name="C"/>pleading <chord name="G"/>for you and for me?<br/>
      <chord name="Em"/>Why should <chord name="D"/>we <chord name="G"/>linger and heed not his <chord name="C/G"/>mercies,<br/>
      <chord name="C"/>mercies <chord name="G"/>for you and for me?
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G/D"/>Think of the wonderful love he has <chord name="C/G"/>promised,<br/>
      <chord name="C"/>promised <chord name="G"/>for you and for me!<br/>
      <chord name="Em"/>Though we <chord name="D"/>have <chord name="G"/>sinned, he has mercy and <chord name="C/G"/>pardon,<br/>
      <chord name="C"/>pardon <chord name="G"/>for you and for me.
      </lines>
    </verse>
  </lyrics>
</song>
