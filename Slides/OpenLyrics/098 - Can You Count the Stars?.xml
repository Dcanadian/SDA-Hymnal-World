<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>098 - Can You Count the Stars?</title>
      <title>Can You Count the Stars?</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="98"/>
    </songbooks>
    <key>Eb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>God the Father</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Bb"/>Can you count <chord name="Eb"/>the stars that <chord name="Bb7/D"/>brightly<br/>
      <chord name="Eb"/>Twinkle in the midnight <chord name="Bb7/D"/>sky?<br/>
      <chord name="Bb7/D"/>Can you count the clouds, so <chord name="Eb"/>lightly<br/>
      <chord name="Eb/Bb"/>O&#x27;er the meadows floating <chord name="Bb7/D"/>by?<br/>
      <chord name="Eb"/>God, the Lord, doth <chord name="Bb7/D"/>mark their number<br/>
      <chord name="Eb"/>With His eyes <chord name="Bb"/>that never <chord name="Bb7"/>slumber;<br/>
      <chord name="Eb"/>He hath made every <chord name="Bb"/>one,<br/>
      <chord name="Bb"/>He hath <chord name="Bb7"/>made them <chord name="Eb"/>every one.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Bb"/>Can you count <chord name="Eb"/>the wings now <chord name="Bb7/D"/>flashing<br/>
      <chord name="Eb"/>In the sunshine&#x27;s golden <chord name="Bb7/D"/>light?<br/>
      <chord name="Bb7/D"/>Can you count the fishes <chord name="Eb"/>splashing<br/>
      <chord name="Eb/Bb"/>In the cooling waters <chord name="Bb7/D"/>bright?<br/>
      <chord name="Eb"/>God, the Lord, a <chord name="Bb7/D"/>name hath given,<br/>
      <chord name="Eb"/>To all creatures <chord name="Bb"/>under <chord name="Bb7"/>heaven;<br/>
      <chord name="Eb"/>He hath named them every <chord name="Bb"/>one,<br/>
      <chord name="Bb"/>He hath <chord name="Bb7"/>named them <chord name="Eb"/>every one.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Bb"/>Do you know <chord name="Eb"/>how many <chord name="Bb7/D"/>children<br/>
      <chord name="Eb"/>Rise each morning blithe <chord name="Bb7/D"/>and gay?<br/>
      <chord name="Bb7/D"/>Can you count their jolly <chord name="Eb"/>voices,<br/>
      <chord name="Eb/Bb"/>Singing sweetly day <chord name="Bb7/D"/>by day?<br/>
      <chord name="Eb"/>God hears all the <chord name="Bb7/D"/>happy voices,<br/>
      <chord name="Eb"/>In their merry <chord name="Bb"/>songs rejoices;<br/>
      <chord name="Eb"/>And He loves them, every <chord name="Bb"/>one,<br/>
      <chord name="Bb"/>And He <chord name="Bb7"/>loves them, <chord name="Eb"/>every one.
      </lines>
    </verse>
  </lyrics>
</song>
