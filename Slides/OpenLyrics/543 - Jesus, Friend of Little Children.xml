<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>543 - Jesus, Friend of Little Children</title>
      <title>Jesus, Friend of Little Children</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="543"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Jesus, Friend <chord name="Bb/F"/>of little <chord name="F/A"/>children,<br/>
      <chord name="C"/>Be a friend to me;<br/>
      <chord name="C"/>Take <chord name="C7"/>my hand <chord name="Dm"/>and <chord name="Gm/Bb"/>ever <chord name="Bb"/>keep <chord name="C7"/>me<br/>
      <chord name="F"/>Close to Thee.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>Teach <chord name="C"/>me <chord name="F"/>how <chord name="Bb/F"/>to grow <chord name="F"/>in goodness,<br/>
      <chord name="C"/>Daily as I grow;<br/>
      <chord name="C"/>Thou <chord name="C7"/>hast been a <chord name="Dm"/>child, <chord name="F/C"/>and surely<br/>
      <chord name="F"/>Thou dost know.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>Step <chord name="C"/>by <chord name="F"/>step, <chord name="Bb/F"/>O, lead <chord name="F"/>me onward,<br/>
      <chord name="C"/>Upward into youth;<br/>
      <chord name="C"/>Wiser, <chord name="C7"/>stronger, <chord name="Gm/Bb"/>still <chord name="F/C"/>becoming<br/>
      <chord name="F"/>In Thy truth.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F"/>Never leave <chord name="Bb/F"/>me, nor <chord name="F"/>forsake <chord name="Bb"/>me;<br/>
      <chord name="C"/>Ever be my friend;<br/>
      <chord name="C"/>For <chord name="C7"/>I need Thee <chord name="Dm"/>from <chord name="F/C"/>life&#x27;s <chord name="Bb"/>dawning<br/>
      <chord name="F"/>To its end.
      </lines>
    </verse>
  </lyrics>
</song>
