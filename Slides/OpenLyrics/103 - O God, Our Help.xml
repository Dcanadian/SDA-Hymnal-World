  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C"/>O God, <chord name="F"/>our <chord name="C/E"/>help <chord name="Am"/>in <chord name="F"/>a <chord name="G"/>ges <chord name="C"/>past, Our <chord name="Am"/>hope <chord name="Em"/>for <chord name="Am/C"/>years <chord name="Dm"/>to <chord name="G"/>come,<br/>
      <chord name="G"/>Our <chord name="C"/>shelter <chord name="Dm"/>from <chord name="G"/>the <chord name="C"/>stormy <chord name="Em"/>blast, And <chord name="Dm"/>our <chord name="C"/>eternal home!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="C"/>Under the <chord name="F"/>shadow <chord name="C"/>of <chord name="Em"/>thy <chord name="Dm"/>throne,<br/>
      <chord name="C"/>still <chord name="F"/>may <chord name="Am"/>we <chord name="C"/>dwell <chord name="Am"/>secure;<br/>
      <chord name="G"/>sufficient <chord name="C"/>is <chord name="Em"/>thine arm <chord name="C"/>alone,<br/>
      <chord name="G"/>and <chord name="F"/>our <chord name="G"/>defense <chord name="Dm"/>is sure.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="C"/>Before the <chord name="F"/>hills <chord name="C"/>in order <chord name="Dm"/>stood,<br/>
      <chord name="C"/>or <chord name="F"/>earth <chord name="Am"/>received her frame,<br/>
      <chord name="G"/>from <chord name="C"/>everlasting, <chord name="Em"/>thou <chord name="C"/>art <chord name="G"/>God,<br/>
      <chord name="G"/>to <chord name="F"/>endless <chord name="Em"/>years <chord name="Dm"/>the same.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="C"/>A thousand <chord name="F"/>ages, <chord name="C"/>in <chord name="Em"/>thy <chord name="Dm"/>sight,<br/>
      <chord name="C"/>are <chord name="F"/>like <chord name="Am"/>an <chord name="G"/>evening <chord name="Dm"/>gone;<br/>
      <chord name="G"/>short <chord name="C"/>as <chord name="Dm"/>the <chord name="C"/>watch <chord name="Em"/>that ends <chord name="C"/>the <chord name="G"/>night,<br/>
      <chord name="G"/>before the <chord name="Em"/>rising <chord name="Dm/F"/>sun.
      </lines>
    </verse>
    <verse name="v5">
      <lines>
      <chord name="C"/>O God, our <chord name="F"/>help <chord name="C"/>in ages <chord name="Dm"/>past,<br/>
      <chord name="C"/>our <chord name="F"/>hope <chord name="Am"/>for <chord name="C"/>years <chord name="Am"/>to come;<br/>
      <chord name="G"/>be <chord name="C"/>thou <chord name="Dm"/>our <chord name="G"/>guide <chord name="F"/>while <chord name="Dm"/>life <chord name="C"/>shall <chord name="G"/>last,<br/>
      <chord name="G"/>and <chord name="F"/>our <chord name="G"/>eternal <chord name="Dm/F"/>home!
      </lines>
    </verse>
  </lyrics>
