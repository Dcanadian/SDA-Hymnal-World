  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>The <chord name="G"/>day Thou gavest, <chord name="D7"/>Lord, <chord name="Em"/>is <chord name="Am"/>ended, <chord name="D7"/>The <chord name="Em"/>darkness <chord name="D/F#"/>falls <chord name="Em"/>at Thy <chord name="Am"/>behest;<br/>
      <chord name="D/F#"/>To <chord name="G"/>Thee our <chord name="D"/>morning <chord name="D7"/>hymns <chord name="Am"/>ascended, <chord name="D7/C"/>Thy <chord name="Bm"/>praise shall <chord name="Em"/>hallow <chord name="Am/C"/>now our <chord name="D7"/>rest.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>We <chord name="G"/>thank <chord name="D"/>Thee <chord name="Em"/>that <chord name="Am/C"/>Thy <chord name="D7"/>church, <chord name="D/F#"/>unsleeping<br/>
      <chord name="D"/>while earth <chord name="Em"/>rolls <chord name="Am/C"/>onward <chord name="D/F#"/>into <chord name="Am"/>light,<br/>
      <chord name="D/F#"/>through <chord name="G"/>all <chord name="D"/>the <chord name="Em"/>world <chord name="D7"/>her watch is <chord name="Bm"/>keeping,<br/>
      <chord name="D/F#"/>and <chord name="G"/>rests <chord name="D"/>not <chord name="Am"/>now <chord name="D7"/>by <chord name="Bm"/>day or <chord name="Am"/>night.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D"/>As <chord name="G"/>o&#x27;er <chord name="D"/>each <chord name="Em"/>continent <chord name="D/F#"/>and <chord name="Em"/>island<br/>
      <chord name="D"/>the <chord name="G"/>dawn <chord name="D"/>leads <chord name="Em"/>on <chord name="D7"/>another <chord name="Am"/>day,<br/>
      <chord name="D/F#"/>the <chord name="G"/>voice <chord name="D"/>of <chord name="Em"/>prayer <chord name="D7"/>is never <chord name="Bm"/>silent,<br/>
      <chord name="D/F#"/>nor <chord name="G"/>die <chord name="D"/>the <chord name="Am"/>strains <chord name="D7"/>of <chord name="Bm"/>praise away.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="D"/>So <chord name="G"/>be <chord name="D"/>it, <chord name="Em"/>Lord; <chord name="Am/C"/>Thy <chord name="D7"/>throne <chord name="D/F#"/>shall <chord name="Em"/>never,<br/>
      <chord name="D"/>like <chord name="G"/>earth&#x27;s <chord name="D"/>proud <chord name="Em"/>empires, <chord name="D/F#"/>pass <chord name="Em"/>away.<br/>
      <chord name="D/F#"/>Thy <chord name="G"/>kingdom <chord name="Em"/>stands, <chord name="D7"/>and grows forever,<br/>
      <chord name="D/F#"/>till <chord name="G"/>all <chord name="D"/>Thy <chord name="Em"/>creatures <chord name="D7"/>own <chord name="Bm"/>Thy <chord name="Am"/>sway.
      </lines>
    </verse>
  </lyrics>
