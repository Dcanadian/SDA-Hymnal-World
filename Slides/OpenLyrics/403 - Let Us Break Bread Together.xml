<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>403 - Let Us Break Bread Together</title>
      <title>Let Us Break Bread Together</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="403"/>
    </songbooks>
    <key>Eb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Doctrines</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Gm"/>Let <chord name="Cm/G"/>us break bread together <chord name="Fm/Ab"/>on <chord name="Cm/G"/>our <chord name="Ab"/>knees,<br/>
      <chord name="Eb/Bb"/>Let <chord name="Fm"/>us <chord name="Gm"/>break bread together <chord name="Am"/>on <chord name="Bb"/>our <chord name="Cm"/>knees.<br/>
      <chord name="Cm/G"/>When <chord name="Gm"/>I fall on <chord name="C/E"/>my <chord name="Edim"/>knees <chord name="Fm"/>with my face <chord name="Bb7"/>to <chord name="Bb"/>the rising <chord name="Ab"/>sun,<br/>
      <chord name="Fm/Ab"/>OLord, <chord name="Ab"/>have <chord name="Fm"/>mercy <chord name="Eb/G"/>onme.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Gm"/>Let <chord name="Cm/G"/>us drink wine together <chord name="Fm/Ab"/>on <chord name="Cm/G"/>our <chord name="Ab"/>knees,<br/>
      <chord name="Eb/Bb"/>let <chord name="Fm"/>us <chord name="Gm"/>drink wine together <chord name="Am"/>on <chord name="Bb"/>our <chord name="Cm"/>knees.<br/>
      <chord name="Cm/G"/>When <chord name="Gm"/>I fall on <chord name="C/E"/>my <chord name="Edim"/>knees <chord name="Fm"/>with my face <chord name="Bb7"/>to <chord name="Bb"/>the rising <chord name="Ab"/>sun,<br/>
      <chord name="Fm/Ab"/>O Lord, <chord name="Ab"/>have <chord name="Fm"/>mercy <chord name="Ab"/>on <chord name="Eb/G"/>me.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Gm"/>Let <chord name="Cm/G"/>us praise God together <chord name="Fm/Ab"/>on <chord name="Cm/G"/>our <chord name="Ab"/>knees,<br/>
      <chord name="Eb/Bb"/>let <chord name="Fm"/>us <chord name="Gm"/>praise God together <chord name="Am"/>on <chord name="Bb"/>our <chord name="Cm"/>knees.<br/>
      <chord name="Cm/G"/>When <chord name="Gm"/>I fall on <chord name="C/E"/>my <chord name="Edim"/>knees <chord name="Fm"/>with my face <chord name="Bb7"/>to <chord name="Bb"/>the rising <chord name="Ab"/>sun,<br/>
      <chord name="Fm/Ab"/>O Lord, <chord name="Ab"/>have <chord name="Fm"/>mercy <chord name="Ab"/>on <chord name="Eb/G"/>me.
      </lines>
    </verse>
  </lyrics>
</song>
