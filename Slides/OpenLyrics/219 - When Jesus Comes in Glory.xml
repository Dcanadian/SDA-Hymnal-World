  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb"/>When Jesus <chord name="Ab"/>comes <chord name="Bbm"/>in <chord name="Gdim"/>glory,<br/>
      <chord name="Ab"/>As <chord name="Fm"/>Lord <chord name="Gdim"/>and <chord name="Eb"/>King <chord name="Cm"/>of <chord name="Db"/>kings,<br/>
