  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F/C"/>Depth <chord name="Am"/>of <chord name="Dm/A"/>mercy!—can <chord name="F/C"/>there <chord name="C"/>be<br/>
      <chord name="F/C"/>Mercy <chord name="Dm/A"/>still <chord name="C"/>reserved <chord name="F/C"/>for <chord name="Gm/Bb"/>me?<br/>
      <chord name="Gm/D"/>Can my <chord name="F/C"/>God His <chord name="C"/>wrath <chord name="Bdim"/>forbear?<br/>
      <chord name="Am"/>Me, the <chord name="Dm/A"/>chief <chord name="Gm/Bb"/>of sinners, spare?
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F/C"/>I <chord name="Am"/>have <chord name="Dm/A"/>long <chord name="C"/>withstood <chord name="F/C"/>His <chord name="C"/>grace,<br/>
      <chord name="F/C"/>Long <chord name="Am"/>provoked <chord name="C"/>Him <chord name="Gm/Bb"/>to <chord name="F/C"/>His <chord name="Gm/Bb"/>face,<br/>
      <chord name="Gm/D"/>Would not <chord name="F/C"/>hearken <chord name="C"/>to <chord name="Bdim"/>His <chord name="C"/>calls,<br/>
      <chord name="Am"/>Grieved Him <chord name="Dm/A"/>by <chord name="Gm/Bb"/>a thousand falls.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F/C"/>Now <chord name="Am"/>incline <chord name="C"/>me to <chord name="F/C"/>repent;<br/>
      <chord name="F/C"/>Let <chord name="Am"/>me <chord name="Dm/A"/>now <chord name="C"/>my <chord name="Gm/Bb"/>sins <chord name="F/C"/>lament;<br/>
      <chord name="Gm/D"/>Now my <chord name="F/C"/>foul revolt <chord name="Bdim"/>deplore,<br/>
      <chord name="Am"/>Weep, believe, <chord name="Gm/Bb"/>and sin <chord name="F/C"/>no <chord name="Gm/Bb"/>more.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F/C"/>There <chord name="Am"/>for <chord name="Dm/A"/>me <chord name="C"/>the Savior stands,<br/>
      <chord name="F/C"/>Shows <chord name="Am"/>His <chord name="Dm/A"/>wounds <chord name="C"/>and <chord name="Gm/Bb"/>spreads <chord name="F/C"/>His <chord name="Gm/Bb"/>hands;<br/>
      <chord name="Gm/D"/>God is <chord name="F/C"/>love! I <chord name="C"/>know, <chord name="Bdim"/>I <chord name="C"/>feel;<br/>
      <chord name="Am"/>Jesus <chord name="Dm/A"/>weeps, <chord name="Gm/Bb"/>and loves <chord name="F/C"/>me <chord name="Gm/Bb"/>still.
      </lines>
    </verse>
  </lyrics>
