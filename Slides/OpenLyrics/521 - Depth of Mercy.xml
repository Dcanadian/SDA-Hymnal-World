<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>521 - Depth of Mercy</title>
      <title>Depth of Mercy</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="521"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Depth of <chord name="C"/>mercy!—can there <chord name="F"/>be<br/>
      Mercy <chord name="C"/>still re<chord name="C7"/>served for <chord name="F"/>me?<br/>
      <chord name="Bb"/>Can my <chord name="F"/>God His <chord name="C"/>wrath <chord name="G7"/>for<chord name="C"/>bear?<br/>
      <chord name="F"/>Me, the <chord name="C"/>chief of sinners, <chord name="F"/>spare?
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>I have <chord name="C"/>long withstood <chord name="F"/>His grace,<br/>
      <chord name="C"/>Long provoked <chord name="C7"/>Him to <chord name="F"/>His face,<br/>
      <chord name="Bb"/>Would <chord name="F"/>not <chord name="C"/>hearken <chord name="G7"/>to <chord name="C"/>His calls,<br/>
      <chord name="F"/>Grieved Him <chord name="C"/>by a <chord name="F"/>thousand falls.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>Now <chord name="C"/>incline me <chord name="F"/>to repent;<br/>
      <chord name="C"/>Let me <chord name="C7"/>now my <chord name="F"/>sins lament;<br/>
      <chord name="Bb"/>Now <chord name="F"/>my <chord name="C"/>foul <chord name="G7"/>revolt <chord name="C"/>deplore,<br/>
      <chord name="F"/>Weep, believe, <chord name="C"/>and sin <chord name="F"/>no more.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F"/>There for <chord name="C"/>me the <chord name="F"/>Savior stands,<br/>
      <chord name="C"/>Shows His <chord name="C7"/>wounds and <chord name="F"/>spreads His hands;<br/>
      <chord name="Bb"/>God <chord name="F"/>is <chord name="C"/>love! I <chord name="G7"/>know, <chord name="C"/>I feel;<br/>
      <chord name="F"/>Jesus weeps, <chord name="C"/>and loves <chord name="F"/>me still.
      </lines>
    </verse>
  </lyrics>
</song>
