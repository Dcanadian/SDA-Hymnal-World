      <chord name="C"/>The poor, <chord name="C7"/>and <chord name="F"/>them that mourn, <chord name="C"/>The faint <chord name="C7"/>and <chord name="F"/>overborne,<br/>
      <chord name="F"/>Sin-sick and sorrow-worn, <chord name="Gm"/>Whom <chord name="C"/>Christ <chord name="C7"/>doth <chord name="F"/>heal.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
