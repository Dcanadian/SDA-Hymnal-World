  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Christ for the <chord name="Gm/Bb"/>world <chord name="C"/>we <chord name="F"/>sing, The <chord name="C/E"/>world <chord name="C7/G"/>to Christ we <chord name="F"/>bring,<br/>
      <chord name="C"/>With loving <chord name="Am"/>zeal;<br/>
      <chord name="F"/>The <chord name="C"/>poor, and <chord name="F/C"/>them <chord name="C7"/>that <chord name="F"/>mourn, The <chord name="C"/>faint <chord name="F/C"/>and <chord name="C7"/>overborne,<br/>
      <chord name="F"/>Sin-sick <chord name="C"/>and <chord name="F"/>sorrow-worn, <chord name="Bb"/>Whom <chord name="F/C"/>Christ <chord name="C7"/>doth <chord name="F"/>heal.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>Christ for <chord name="C"/>the <chord name="F"/>world <chord name="C7/G"/>we sing,<br/>
      <chord name="F"/>the world <chord name="C"/>to <chord name="F"/>Christ <chord name="C7/G"/>we bring,<br/>
      <chord name="C"/>with fervent <chord name="Am"/>prayer;<br/>
      <chord name="F"/>the <chord name="C"/>wayward <chord name="F"/>and the lost,<br/>
      <chord name="F"/>by <chord name="C"/>restless <chord name="F"/>passions tossed,<br/>
      <chord name="F"/>redeemed <chord name="C7"/>at <chord name="F"/>countless cost,<br/>
      <chord name="F"/>from <chord name="C"/>dark <chord name="F"/>despair.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>Christ for <chord name="C"/>the <chord name="F"/>world <chord name="C7/G"/>we sing,<br/>
      <chord name="F"/>the world <chord name="C"/>to <chord name="F"/>Christ <chord name="C7/G"/>we bring,<br/>
      <chord name="C"/>with joyful <chord name="Am"/>song;<br/>
      <chord name="F"/>the <chord name="C"/>newborn <chord name="F"/>souls, whose days,<br/>
      <chord name="F"/>reclaimed <chord name="C7"/>from <chord name="F"/>error&#x27;s ways,<br/>
      <chord name="F"/>inspired <chord name="C7"/>with <chord name="F"/>hope and praise,<br/>
      <chord name="F"/>to <chord name="C"/>Christ <chord name="F"/>belong.
      </lines>
