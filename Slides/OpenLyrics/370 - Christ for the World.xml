      <chord name="F"/>redeemed at <chord name="C"/>countless cost,<br/>
      <chord name="C"/><chord name="C7"/>from <chord name="F"/><chord name="C"/>dark <chord name="C7"/><chord name="F"/>despair.
      </lines>
    </verse>
    <verse name="v3">
