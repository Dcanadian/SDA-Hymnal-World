<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>666 - Cast Thy Burden Upon the Lord</title>
      <title>Cast Thy Burden Upon the Lord</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="666"/>
    </songbooks>
    <key>Eb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1</verseOrder>
    <themes>
      <theme>Sentences and Responses</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Ab"/>Cast thy burden upon the Lord,<br/>
      <chord name="Bb"/>And He shall sustain thee;<br/>
      <chord name="Eb"/>He never will suffer the righteous to fall;<br/>
      <chord name="Fm"/>He is at thy right hand.<br/>
      <chord name="Eb"/>Thy mercy, <chord name="Ab"/>Lord, is great, and far <chord name="Bb"/>above the <chord name="Bb7/D"/>heavens;<br/>
      <chord name="Bb7/D"/>Let none be made ashamed, that wait upon Thee.
      </lines>
    </verse>
  </lyrics>
</song>
