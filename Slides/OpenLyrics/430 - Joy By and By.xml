<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>430 - Joy By and By</title>
      <title>Joy By and By</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="430"/>
    </songbooks>
    <key>Bb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3</verseOrder>
    <themes>
      <theme>Doctrines</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Bb"/>O there&#x27;ll be joy when the <chord name="F"/>work <chord name="F7"/>is done,<br/>
      <chord name="F7"/>Joy when the reapers <chord name="Eb/Bb"/>gather <chord name="Bb"/>home,<br/>
      <chord name="Bb"/>Bringing the sheaves <chord name="Eb"/>at set of sun<br/>
      <chord name="Bb"/>To the New <chord name="Gm"/>Jerusalem.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Bb"/>Joy, joy, joy, there&#x27;ll be <chord name="F"/>joy <chord name="Bb/F"/>by and <chord name="F7"/>by,<br/>
      <chord name="F7"/>Joy, joy, joy, <chord name="Cm"/>where the <chord name="Bb"/>joys <chord name="F7"/>never <chord name="Bb"/>die;<br/>
      <chord name="Bb"/>Joy, <chord name="Gm"/>joy, joy, <chord name="Bb/F"/>for the <chord name="Eb"/>day draweth nigh<br/>
      <chord name="Bb/F"/>When the workers <chord name="F7"/>gather <chord name="Bb"/>home.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Bb"/>Sweet are the songs that we <chord name="F"/>hope <chord name="F7"/>to sing,<br/>
      <chord name="F7"/>Grateful the thanks our <chord name="Eb/Bb"/>hearts <chord name="Bb"/>shall bring,<br/>
      <chord name="Bb"/>Praising forever <chord name="Eb"/>Christ our King<br/>
      <chord name="Bb"/>In the New <chord name="Gm"/>Jerusalem.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Bb"/>Pure are the joys that await <chord name="F7"/>us there,<br/>
      <chord name="F7"/>Many the golden <chord name="Eb/Bb"/>mansions <chord name="Bb"/>fair;<br/>
      <chord name="Bb"/>Jesus Himself <chord name="Eb"/>doth them prepare,<br/>
      <chord name="Bb"/>In the New <chord name="Gm"/>Jerusalem.
      </lines>
    </verse>
  </lyrics>
</song>
