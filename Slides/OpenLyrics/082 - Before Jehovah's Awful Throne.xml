      <lines>
      <chord name="D"/>Before <chord name="A7/E"/>Jehovah&#x27;s <chord name="D"/>awfulthrone <chord name="A"/>Ye <chord name="D"/>nations, <chord name="G"/>bow <chord name="F#m"/>with <chord name="Em"/>sacred <chord name="D"/>joy;<br/>
