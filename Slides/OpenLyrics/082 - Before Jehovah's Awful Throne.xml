    <verse name="v3">
      <lines>
      <chord name="D"/>We&#x27;ll <chord name="A7/E"/>crowd <chord name="G"/>His <chord name="D"/>gates with thankful songs,<br/>
      <chord name="D"/>High <chord name="A7/E"/>as <chord name="G"/>the <chord name="D"/>heavens our voices raise;<br/>
      <chord name="D"/>And <chord name="A7/C#"/>earth, <chord name="D"/>with her ten <chord name="A"/>thousand <chord name="D"/>tongues,<br/>
      <chord name="D"/>Shall <chord name="A7/C#"/>fill <chord name="D/F#"/>His <chord name="G"/>courts <chord name="D"/>with <chord name="F#m"/>sounding <chord name="D/A"/>praise.
