      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>His sovereign <chord name="A/E"/>power, <chord name="D"/>without <chord name="F#m"/>our <chord name="D"/>aid,<br/>
      <chord name="D"/>Made <chord name="A7/E"/>us <chord name="G"/>of <chord name="D"/>clay, <chord name="A"/>and <chord name="D"/>formed <chord name="G"/>us <chord name="Em"/>men;<br/>
      <chord name="D"/>and <chord name="A7/C#"/>when <chord name="D"/>like wandering <chord name="G"/>sheep <chord name="D"/>we strayed,<br/>
