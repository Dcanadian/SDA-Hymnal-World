    <verse name="v3">
      <lines>
      <chord name="D"/>You saints <chord name="A"/>who here in <chord name="Bm"/>patience your cross <chord name="D"/>and suff&#x27;rings bore,<br/>
      <chord name="Em7"/>Shall live and <chord name="A7"/>reign forever, when <chord name="D"/>sorrow is no more.<br/>
