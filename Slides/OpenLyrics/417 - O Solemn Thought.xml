<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>417 - O Solemn Thought</title>
      <title>O Solemn Thought</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="417"/>
    </songbooks>
    <key>D</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Doctrines</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>O solemn thought and can it <chord name="A7/C#"/>be<br/>
      <chord name="A7/C#"/>The <chord name="D7/C"/>hour o <chord name="Bm"/>judgment now <chord name="A7/C#"/>is <chord name="D"/>come<br/>
      <chord name="D"/>Which soon must fix our destiny,<br/>
      <chord name="A7/C#"/>And <chord name="D7/C"/>seal the <chord name="Bm"/>sinner&#x27;s fearful <chord name="F#7/A#"/>down?<br/>
      <chord name="F#m"/>Yes, it is <chord name="Bm"/>so; <chord name="A"/>the <chord name="G"/>judgment <chord name="Em"/>hour<br/>
      <chord name="G/D"/>Is swiftly <chord name="A7/C#"/>hastening <chord name="Bm"/>to its <chord name="F#/A#"/>close;<br/>
      <chord name="F#"/>Then will <chord name="A"/>the Judge, <chord name="Bm"/>in <chord name="A"/>mighty <chord name="G"/>power,<br/>
      <chord name="G/D"/>Descend <chord name="A7/C#"/>in <chord name="D"/>vengeance <chord name="G"/>on <chord name="A7"/>His <chord name="D"/>foes.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>He who came down to earth to <chord name="A7/C#"/>die<br/>
      <chord name="A7/C#"/>An offering <chord name="Bm"/>for the sins <chord name="A7/C#"/>of <chord name="D"/>men,<br/>
      <chord name="D"/>And then ascended upon on <chord name="A7/C#"/>high,<br/>
      <chord name="A7/C#"/>And <chord name="D7/C"/>will e&#x27;er <chord name="Bm"/>long return <chord name="Em/B"/>again,<br/>
      <chord name="F#m"/>Is standing <chord name="Bm"/>now <chord name="A"/>before <chord name="G"/>the <chord name="Em"/>ark,<br/>
      <chord name="G/D"/>And <chord name="A/C#"/>mercy <chord name="D"/>seat <chord name="A/C#"/>and <chord name="Bm"/>cherubim,<br/>
      <chord name="F#"/>To <chord name="A"/>plead His <chord name="Bm"/>blood <chord name="A"/>for <chord name="G"/>saints, and <chord name="Em"/>make<br/>
      <chord name="G/D"/>The <chord name="A/C#"/>last <chord name="A7/C#"/>remembrance <chord name="G"/>of <chord name="A7"/>their <chord name="D"/>sin.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D"/>The solemn moment is at <chord name="A7/C#"/>hand<br/>
      <chord name="A7/C#"/>When <chord name="D7/C"/>we who <chord name="Bm"/>have His name <chord name="A7/C#"/>confessed,<br/>
      <chord name="D"/>Each in his lot must singly <chord name="A7/C#"/>stand<br/>
      <chord name="A7/C#"/>And <chord name="D7/C"/>pass the <chord name="Bm"/>final, searching <chord name="F#7/A#"/>test.<br/>
      <chord name="F#m"/>Jesus! we <chord name="Bm"/>hope <chord name="A"/>in <chord name="G"/>Thee alone;<br/>
      <chord name="G/D"/>In <chord name="A/C#"/>mercy <chord name="D"/>now <chord name="A/C#"/>upon <chord name="Bm"/>us <chord name="F#/A#"/>look,<br/>
      <chord name="F#"/>Confess <chord name="A"/>our names before <chord name="G"/>the <chord name="Em"/>throne,<br/>
      <chord name="G/D"/>And <chord name="A/C#"/>blot <chord name="A7/C#"/>our <chord name="D"/>sins <chord name="F#m"/>fromout <chord name="A7"/>Thy <chord name="D"/>book.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="D"/>O blessed Savior! may we feel<br/>
      <chord name="A7/C#"/>The <chord name="D7/C"/>full importance <chord name="Bm"/>of <chord name="A7/C#"/>this <chord name="D"/>hour.<br/>
      <chord name="D"/>Inspire our hearts with holy <chord name="A7/C#"/>zeal,<br/>
      <chord name="A7/C#"/>And aid <chord name="D7/C"/>us by <chord name="Bm"/>Thy Spirit&#x27;s <chord name="Em/B"/>power,<br/>
      <chord name="F#m"/>That we may <chord name="Bm"/>in <chord name="A"/>Thy <chord name="G"/>strength be <chord name="Em"/>strong,<br/>
      <chord name="G/D"/>And <chord name="A/C#"/>brave <chord name="A7/C#"/>the <chord name="D"/>conflict <chord name="Bm"/>valiantly;<br/>
      <chord name="F#"/>Then, <chord name="A"/>on Mount <chord name="Bm"/>Zion, <chord name="A"/>join <chord name="G"/>the song,<br/>
      <chord name="G/D"/>And swell <chord name="A/C#"/>the <chord name="A7/C#"/>notes <chord name="F#m"/>of <chord name="G"/>victory.
      </lines>
    </verse>
  </lyrics>
</song>
