    <themes>
      <theme>Jesus Christ</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Jesus! <chord name="Dm/A"/>what <chord name="F"/>a <chord name="Am"/>Friend for <chord name="Bb"/>sinners!<br/>
      <chord name="F"/>Jesus! Lover ofmy soul;<br/>
      <chord name="F"/>Friends may fail <chord name="Gm/Bb"/>me, foes assail <chord name="Dm/A"/>me,<br/>
      <chord name="Am"/>He, <chord name="Gm"/>my Savior, <chord name="F"/>makes me whole.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="F"/>Hallelujah! what a <chord name="Gm/Bb"/>Savior!<br/>
      <chord name="F/C"/>Hallelujah! <chord name="C7"/>what a <chord name="D7"/>Friend!<br/>
      <chord name="F/C"/>Saving, helping, <chord name="Dm/A"/>keeping, <chord name="C"/>loving,<br/>
      <chord name="Am"/>He is <chord name="F"/>with me to the <chord name="C/E"/>end.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>Jesus! <chord name="Dm/A"/>what <chord name="F"/>a <chord name="Am"/>Strength in <chord name="Bb"/>weakness!<br/>
      <chord name="F"/>Let me hide myself in Him.<br/>
      <chord name="F"/>Tempted, tried, and <chord name="Gm/Bb"/>sometimes <chord name="Dm/A"/>failing,<br/>
      <chord name="Am"/>He, <chord name="Gm"/>my <chord name="Dm/A"/>Strength, my <chord name="F"/>victory wins.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>Jesus! <chord name="Dm/A"/>what <chord name="F"/>a <chord name="Am"/>Help in <chord name="Bb"/>sorrow!<br/>
      <chord name="F"/>While the billows over me roll,<br/>
      <chord name="F"/>Even when <chord name="Gm/Bb"/>my heart is <chord name="Dm/A"/>breaking,<br/>
      <chord name="Am"/>He, <chord name="Gm"/>my <chord name="Dm/A"/>Comfort, <chord name="F"/>helps my soul.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F"/>Jesus! <chord name="Dm/A"/>I <chord name="F"/>do <chord name="Am"/>now receive <chord name="Bb"/>Him,<br/>
      <chord name="F"/>Jesus! I do now adore Him,]<br/>
      <chord name="F"/>More than all <chord name="Gm/Bb"/>in Him <chord name="Dm/A"/>I find.<br/>
      <chord name="F"/>He hath granted <chord name="Gm/Bb"/>me forgiveness,<br/>
      <chord name="Am"/>I <chord name="Gm"/>am <chord name="Dm/A"/>His, <chord name="F"/>and He is mine.
      </lines>
    </verse>
  </lyrics>
