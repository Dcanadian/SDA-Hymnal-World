  <properties>
    <titles>
      <title>187 - Jesus, What a Friend for Sinners</title>
      <title>Jesus, What a Friend for Sinners</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="187"/>
    </songbooks>
