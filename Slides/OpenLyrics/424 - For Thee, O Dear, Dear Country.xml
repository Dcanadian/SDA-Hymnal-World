      <title>For Thee, O Dear, Dear Country</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="424"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
