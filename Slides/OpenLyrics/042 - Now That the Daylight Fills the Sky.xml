<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>042 - Now That the Daylight Fills the Sky</title>
      <title>Now That the Daylight Fills the Sky</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="42"/>
    </songbooks>
    <key>D</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Worship</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>Now that the daylight <chord name="G"/>fills <chord name="F#m"/>the <chord name="Bm"/>sky,<br/>
      <chord name="F#m"/>We lift <chord name="Bm"/>our <chord name="D"/>hearts <chord name="A/E"/>to God <chord name="D"/>on <chord name="Bm"/>high,<br/>
      <chord name="F#m/C#"/>That <chord name="Bm"/>He, <chord name="G"/>in <chord name="A"/>all we <chord name="G"/>do or <chord name="Em"/>say,<br/>
      <chord name="A7"/>Would keep <chord name="Bm"/>us free <chord name="G"/>from harm <chord name="D/F#"/>today;
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>Would guard our hearts <chord name="Bm"/>and <chord name="G"/>tongues <chord name="F#m"/>from <chord name="Bm"/>strife;<br/>
      <chord name="F#m"/>From anger&#x27;s <chord name="D"/>din <chord name="A/E"/>would shield <chord name="D"/>our <chord name="Bm"/>life;<br/>
      <chord name="F#m/C#"/>From <chord name="Bm"/>evil <chord name="A"/>sights would <chord name="G"/>turn our <chord name="Em"/>eyes,<br/>
      <chord name="A7"/>And close <chord name="Bm"/>our ears <chord name="G"/>to vanities;
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D"/>So we, when this <chord name="G"/>new day <chord name="F#m"/>is <chord name="Bm"/>gone<br/>
      <chord name="F#m"/>And night <chord name="Bm"/>in <chord name="D"/>turn <chord name="A/E"/>is drawing <chord name="Bm"/>on,<br/>
      <chord name="F#m/C#"/>With <chord name="Bm"/>conscience <chord name="A"/>by the <chord name="G"/>world unstained<br/>
      <chord name="A7"/>Shall praise <chord name="Bm"/>His name <chord name="G"/>for vict&#x27;ry <chord name="D/F#"/>gained.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="D"/>&quot;All praise to <chord name="Bm"/>You, <chord name="G"/>creator <chord name="Bm"/>Lord!<br/>
      <chord name="F#m"/>All praise <chord name="Bm"/>to <chord name="D"/>You, <chord name="A/E"/>eternal <chord name="Bm"/>Word!<br/>
      <chord name="F#m/C#"/>All <chord name="Bm"/>praise <chord name="G"/>to <chord name="A"/>You, O <chord name="G"/>Spirit <chord name="Em"/>wise!&quot;<br/>
      <chord name="A7"/>We sing <chord name="Bm"/>as daylight <chord name="G"/>fills <chord name="D/F#"/>the skies.
      </lines>
    </verse>
  </lyrics>
</song>
