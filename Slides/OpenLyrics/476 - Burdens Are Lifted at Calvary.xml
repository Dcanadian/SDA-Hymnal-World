  <properties>
    <titles>
      <title>476 - Burdens Are Lifted at Calvary</title>
      <title>Burdens Are Lifted at Calvary</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="476"/>
    </songbooks>
