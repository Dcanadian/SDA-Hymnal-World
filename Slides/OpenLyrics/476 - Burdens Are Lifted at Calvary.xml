  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Days are filled with sor-row and <chord name="C7"/>care,<br/>
      <chord name="C7"/>Hearts are lonely and <chord name="F"/>drear;<br/>
      <chord name="Bb"/>Burdens are lifted <chord name="F"/>at Calvary,<br/>
      <chord name="C7"/>Jesus is <chord name="F"/>very near.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Bb"/>Burdens are lifted <chord name="F"/>at Calvary,<br/>
      <chord name="F"/>Calvary, Calvary,<br/>
      <chord name="Bb"/>Burdens are lifted <chord name="F"/>at Calvary,<br/>
      <chord name="C7"/>Jesus is <chord name="F"/>very near.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>Cast your care on Jesus today,<br/>
      <chord name="C7"/>Leave your worry and <chord name="F"/>fear;<br/>
      <chord name="Bb"/>Burdens are lifted <chord name="F"/>at Calvary,<br/>
      <chord name="C7"/>Jesus is <chord name="F"/>very near.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>Troubled soul, the Saviour <chord name="Bb/F"/>can <chord name="F"/>see,<br/>
      <chord name="C7"/>Ev&#x27;ry heartache and <chord name="F"/>tear;<br/>
      <chord name="Bb"/>Burdens are lifted <chord name="F"/>at Calvary<br/>
      <chord name="C7"/>Jesus is <chord name="F"/>very near.
      </lines>
    </verse>
  </lyrics>
