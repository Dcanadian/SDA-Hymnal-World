<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>616 - Soldiers of Christ, Arise</title>
      <title>Soldiers of Christ, Arise</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="616"/>
    </songbooks>
    <key>D</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>Soldiers of Christ, arise,<br/>
      <chord name="D"/>And put <chord name="G/B"/>your armor <chord name="A/C#"/>on,<br/>
      <chord name="D"/>Strong in <chord name="Bm"/>the <chord name="D"/>strength <chord name="Em"/>which <chord name="D"/>God supplies<br/>
      <chord name="A/E"/>Through His <chord name="Em"/>eternal <chord name="A7"/>Son<br/>
      <chord name="D"/>Strong in <chord name="A7"/>the <chord name="D"/>Lord <chord name="G"/>of <chord name="F7"/>hosts,<br/>
      <chord name="Em"/>And in His <chord name="Bm"/>mighty <chord name="A7"/>power,<br/>
      <chord name="Bm"/>Who in <chord name="G"/>the <chord name="F#m"/>strength <chord name="Em"/>of <chord name="A"/>Jesus <chord name="B7"/>trusts<br/>
      <chord name="Em"/>Is more <chord name="F#m"/>than <chord name="A"/>con-queror.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>Stand then in His great <chord name="G/D"/>might,<br/>
      <chord name="D"/>With all <chord name="G/B"/>His strength <chord name="A"/>endued,<br/>
      <chord name="D"/>But take, <chord name="Bm"/>to <chord name="D"/>arm <chord name="Em"/>you <chord name="D"/>for the <chord name="A/C#"/>fight,<br/>
      <chord name="A/E"/>The panoply of <chord name="A7"/>God;<br/>
      <chord name="D"/>That, having all <chord name="G"/>things <chord name="F7"/>done,<br/>
      <chord name="Em"/>And all <chord name="Bm"/>your <chord name="Em"/>conflicts <chord name="F#m"/>passed,<br/>
      <chord name="Bm"/>Ye may <chord name="G"/>o&#x27;ercome <chord name="Em"/>through <chord name="A"/>Christ <chord name="F#/A#"/>alone,<br/>
      <chord name="Em"/>And stand <chord name="F#m"/>entire <chord name="A7"/>at <chord name="D"/>last.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D"/>From strength to strength go <chord name="G/D"/>on,<br/>
      <chord name="D"/>Wrestle <chord name="G/B"/>and fight <chord name="A"/>and pray,<br/>
      <chord name="D"/>Tread all <chord name="Bm"/>the <chord name="D"/>powers of darkness <chord name="Bm"/>down<br/>
      <chord name="A/E"/>And win <chord name="Em"/>the well-fought <chord name="A7"/>day.<br/>
      <chord name="D"/>Still let <chord name="A7"/>the <chord name="D"/>Spirit <chord name="F7"/>cry<br/>
      <chord name="Em"/>In all <chord name="Bm"/>His <chord name="Em"/>soldiers, <chord name="F#m"/>&quot;Come!&quot;<br/>
      <chord name="Bm"/>Till Christ <chord name="G"/>the <chord name="F#m"/>Lord <chord name="Em"/>who <chord name="A"/>reigns <chord name="F#/A#"/>on <chord name="B7"/>high<br/>
      <chord name="Em"/>Shall take <chord name="F#m"/>the <chord name="A"/>conquerors <chord name="D"/>home.
      </lines>
    </verse>
  </lyrics>
</song>
