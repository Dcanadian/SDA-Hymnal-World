<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>203 - This Is the Threefold Truth</title>
      <title>This Is the Threefold Truth</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="203"/>
    </songbooks>
    <key>C</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3</verseOrder>
    <themes>
      <theme>Jesus Christ</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C"/>This is the threefold <chord name="Am"/>truth<br/>
      <chord name="C/G"/>On which <chord name="G"/>our faith <chord name="G7"/>depends;<br/>
      <chord name="Em/B"/>And with this joyful <chord name="Am"/>cry<br/>
      <chord name="G/D"/>Worship begins and <chord name="C"/>ends.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="F"/>Christ had died! Christ has <chord name="Em"/>risen!<br/>
      <chord name="Dm"/>Christ will <chord name="G7"/>come again!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="C"/>By this we are <chord name="G/B"/>upheld<br/>
      <chord name="C/G"/>When doubt <chord name="G"/>and grief <chord name="G7"/>assail<br/>
      <chord name="Em/B"/>Our Christian fortitude<br/>
      <chord name="G/D"/>And only <chord name="Dm"/>grace <chord name="G"/>avails
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="C"/>This is the threefold <chord name="Am"/>truth<br/>
      <chord name="C/G"/>Which, if <chord name="G"/>we hold <chord name="G7"/>it <chord name="C"/>fast,<br/>
      <chord name="Em/B"/>Changes the world and <chord name="Am"/>us<br/>
      <chord name="G/D"/>And brings us <chord name="Dm"/>home <chord name="G"/>at <chord name="C"/>last.
      </lines>
    </verse>
  </lyrics>
</song>
