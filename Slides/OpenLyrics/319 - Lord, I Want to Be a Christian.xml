  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb"/>Lord, I want to be a <chord name="Bb"/>Chris<chord name="Eb"/>tian in my heart, in <chord name="Ab"/>my <chord name="Eb"/>heart,<br/>
      <chord name="Eb"/>Lord, I want to be a <chord name="Bb"/>Chris<chord name="Cm"/>tian <chord name="Ab"/>in my <chord name="Eb"/>hea<chord name="Ab"/>rt.<chord name="Eb"/><br/>
      <chord name="Eb"/>In my <chord name="Ab"/>heart, in my <chord name="Eb"/>hea<chord name="Cm"/>rt,<br/>
      <chord name="Eb"/>Lord, I want to be a <chord name="Bb"/>Chris<chord name="Cm"/>tian <chord name="Ab"/>in my <chord name="Eb"/>heart.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Eb"/>Lord, I <chord name="Bb"/>want to be <chord name="Eb"/>more loving <chord name="Ab"/>in my heart, <chord name="Eb"/>in my heart,<br/>
      <chord name="Eb"/>Lord, <chord name="Bb"/>I want <chord name="Cm"/>to be <chord name="Ab"/>more loving <chord name="Eb"/>in my <chord name="Ab"/>heart, in <chord name="Eb"/>my heart.<br/>
      <chord name="Eb"/>In <chord name="Ab"/>my heart, <chord name="Eb"/>in <chord name="Cm"/>my heart,<br/>
      <chord name="Eb"/>Lord, I <chord name="Bb"/>want to be <chord name="Cm"/>more loving <chord name="Ab"/>in my heart, <chord name="Eb"/>in my heart.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Eb"/>Lord, I <chord name="Bb"/>want to be <chord name="Eb"/>more holy <chord name="Ab"/>in my heart, <chord name="Eb"/>in my heart,<br/>
      <chord name="Eb"/>Lord, <chord name="Bb"/>I want <chord name="Cm"/>to be <chord name="Ab"/>more holy <chord name="Eb"/>in my <chord name="Ab"/>heart, in <chord name="Eb"/>my heart.<br/>
      <chord name="Eb"/>In <chord name="Ab"/>my heart, <chord name="Eb"/>in <chord name="Cm"/>my heart,<br/>
      <chord name="Eb"/>Lord, I <chord name="Bb"/>want to be <chord name="Cm"/>more holy <chord name="Ab"/>in my heart, <chord name="Eb"/>in my heart.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Eb"/>Lord, I <chord name="Bb"/>want to be <chord name="Eb"/>more like Jesus <chord name="Ab"/>in my heart, <chord name="Eb"/>in my heart,<br/>
      <chord name="Eb"/>Lord, I <chord name="Bb"/>want to <chord name="Cm"/>be more <chord name="Ab"/>like Jesus <chord name="Eb"/>in my <chord name="Ab"/>heart, in <chord name="Eb"/>my heart.<br/>
      <chord name="Eb"/>In <chord name="Ab"/>my heart, <chord name="Eb"/>in <chord name="Cm"/>my heart,<br/>
      <chord name="Eb"/>Lord, I <chord name="Bb"/>want to be <chord name="Cm"/>more like Jesus <chord name="Ab"/>in my heart, <chord name="Eb"/>in my heart.
