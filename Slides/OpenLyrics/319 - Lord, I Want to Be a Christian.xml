<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>319 - Lord, I Want to Be a Christian</title>
      <title>Lord, I Want to Be a Christian</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="319"/>
    </songbooks>
    <key>Eb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Gospel</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb"/>Lord, I <chord name="Gm"/>want to <chord name="Bb"/>be <chord name="Gm"/>a <chord name="Fm"/>Christian <chord name="Eb/G"/>in my heart, <chord name="Gm"/>in <chord name="Ab"/>my <chord name="Gm"/>heart,<br/>
      <chord name="Cm/G"/>Lord, I <chord name="Eb/Bb"/>want to be a <chord name="Fm/Ab"/>Christian <chord name="Ab"/>in my <chord name="Cm/G"/>heart.<br/>
      <chord name="Ab"/>In my <chord name="Eb/G"/>heart, in my <chord name="Ab"/>heart,<br/>
      <chord name="Ab/Eb"/>Lord, I want to be <chord name="Cm"/>a Christian <chord name="Gm"/>in my <chord name="Cm"/>heart.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Eb"/>Lord, I <chord name="Gm"/>want to <chord name="Bb"/>be <chord name="Gm"/>more <chord name="Fm"/>loving <chord name="Eb/G"/>in my heart, <chord name="Gm"/>in <chord name="Ab"/>my <chord name="Gm"/>heart,<br/>
      <chord name="Cm/G"/>Lord, I want <chord name="Eb/Bb"/>to be more loving <chord name="Fm/Ab"/>in <chord name="Cm/G"/>my heart, <chord name="Ab"/>in my <chord name="Cm/G"/>heart.<br/>
      <chord name="Ab"/>In my <chord name="Eb/G"/>heart, in my <chord name="Ab"/>heart,<br/>
      <chord name="Ab/Eb"/>Lord, I want to be more <chord name="Cm"/>loving <chord name="Ab"/>in my <chord name="Gm"/>heart, in <chord name="Cm"/>my heart.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Eb"/>Lord, I <chord name="Gm"/>want to <chord name="Bb"/>be <chord name="Gm"/>more <chord name="Fm"/>holy <chord name="Eb/G"/>in my heart, <chord name="Gm"/>in <chord name="Ab"/>my <chord name="Gm"/>heart,<br/>
      <chord name="Cm/G"/>Lord, I want <chord name="Eb/Bb"/>to be more holy <chord name="Fm/Ab"/>in <chord name="Cm/G"/>my heart, <chord name="Ab"/>in my <chord name="Cm/G"/>heart.<br/>
      <chord name="Ab"/>In my <chord name="Eb/G"/>heart, in my <chord name="Ab"/>heart,<br/>
      <chord name="Ab/Eb"/>Lord, I want to be more <chord name="Cm"/>holy <chord name="Ab"/>in my <chord name="Gm"/>heart, in <chord name="Cm"/>my heart.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Eb"/>Lord, I <chord name="Gm"/>want to <chord name="Bb"/>be <chord name="Gm"/>more <chord name="Fm"/>like <chord name="Eb"/>Jesus in my <chord name="Gm"/>heart, <chord name="Ab"/>in <chord name="Gm"/>my heart,<br/>
      <chord name="Cm/G"/>Lord, I want <chord name="Eb/Bb"/>to be more like Jesus <chord name="Fm/Ab"/>in <chord name="Cm/G"/>my <chord name="Ab"/>heart, in my <chord name="Cm/G"/>heart.<br/>
      <chord name="Ab"/>In my <chord name="Eb/G"/>heart, in my <chord name="Ab"/>heart,<br/>
      <chord name="Ab/Eb"/>Lord, I want to be more like <chord name="Cm"/>Jesus <chord name="Ab"/>in my <chord name="Gm"/>heart, in <chord name="Cm"/>my heart.
      </lines>
    </verse>
  </lyrics>
</song>
