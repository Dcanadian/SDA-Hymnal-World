    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Spirit divine, <chord name="C7/Bb"/>attend <chord name="Am/C"/>our <chord name="C"/>prayers,<br/>
      <chord name="F/C"/>And <chord name="C"/>make <chord name="Gm/D"/>this <chord name="F/C"/>house <chord name="C"/>Thy <chord name="Dm/A"/>home;<br/>
      <chord name="Am"/>Descend <chord name="C"/>with <chord name="Gm"/>all <chord name="Am"/>Thy <chord name="Bb"/>gracious <chord name="C"/>powers,<br/>
      <chord name="F/C"/>O come, <chord name="C"/>great Spirit, <chord name="Dm/A"/>come!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>Come <chord name="E7"/>as <chord name="F"/>the light; <chord name="C7/Bb"/>to <chord name="Am"/>us reveal<br/>
      <chord name="F/C"/>Our <chord name="C"/>emptiness and <chord name="Dm/A"/>woe,<br/>
      <chord name="Am"/>And lead <chord name="Dm/F"/>us <chord name="Gm"/>in <chord name="Bb"/>those <chord name="F/C"/>paths <chord name="C"/>of <chord name="Dm/A"/>life<br/>
      <chord name="F/C"/>Where-on <chord name="C"/>the righteous <chord name="Dm/A"/>go.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>Come <chord name="E7"/>as <chord name="F"/>the fire, <chord name="C7/Bb"/>and <chord name="Am"/>purge our <chord name="C"/>hearts<br/>
      <chord name="F/C"/>Like <chord name="C"/>sacrificial <chord name="Dm/A"/>flame;<br/>
      <chord name="Am"/>Let our <chord name="C"/>whole <chord name="Am"/>soul <chord name="Bb"/>an <chord name="C"/>of - f&#x27;ring <chord name="Dm/A"/>be<br/>
      <chord name="F/C"/>To our <chord name="C"/>Redeemer&#x27;s <chord name="Dm/A"/>name.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F"/>Come <chord name="E7"/>as <chord name="F"/>the dove, <chord name="C7/Bb"/>and <chord name="Am"/>spread Thy <chord name="C"/>wings,<br/>
      <chord name="F/C"/>The wings <chord name="C"/>of <chord name="Gm/D"/>peaceful <chord name="Dm/A"/>love;<br/>
      <chord name="Am"/>And let <chord name="Dm/F"/>Thy <chord name="Gm"/>church <chord name="Bb"/>on <chord name="F/C"/>earth <chord name="C"/>become<br/>
      <chord name="F/C"/>Blest as <chord name="C"/>the church <chord name="Dm/A"/>above.
      </lines>
    </verse>
    <verse name="v5">
      <lines>
      <chord name="F"/>Spirit divine, <chord name="C7/Bb"/>attend <chord name="Am/C"/>our <chord name="C"/>prayers,<br/>
      <chord name="F/C"/>Make <chord name="C"/>a <chord name="Gm/D"/>lost <chord name="F/C"/>world <chord name="C"/>Thy <chord name="Dm/A"/>home;<br/>
      <chord name="Am"/>Descend <chord name="C"/>with <chord name="Gm"/>all <chord name="Am"/>Thy <chord name="Bb"/>gracious <chord name="C"/>powers,<br/>
      <chord name="F/C"/>O come, <chord name="C"/>great Spirit, <chord name="Dm/A"/>come!
      </lines>
    </verse>
  </lyrics>
</song>
