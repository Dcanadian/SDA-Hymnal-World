      <title>O Come, Let Us Sing to the Lord</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="63"/>
    </songbooks>
    <key>Eb</key>
    <tempo type="bpm">Moderato</tempo>
