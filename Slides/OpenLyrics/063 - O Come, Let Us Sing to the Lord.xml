    <themes>
      <theme>Worship</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Cm/G"/>O come, <chord name="Bb/F"/>let <chord name="Cm/G"/>us <chord name="Eb/Bb"/>sing <chord name="Fm/C"/>to <chord name="Eb/Bb"/>the <chord name="Bb"/>Lord,<br/>
      <chord name="Bb"/>Come <chord name="Eb/Bb"/>let <chord name="Bb"/>us <chord name="Cm/G"/>every <chord name="Eb/Bb"/>one<br/>
      <chord name="Bb"/>A joyful <chord name="Bb7/Ab"/>noise <chord name="Eb"/>make to <chord name="Bb7/Ab"/>the <chord name="Gm"/>Rock<br/>
      <chord name="Bb"/>Of <chord name="Fm/C"/>our <chord name="Eb/Bb"/>salvation.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Cm/G"/>Let us <chord name="Bb/F"/>before <chord name="Eb/Bb"/>His <chord name="Fm/C"/>presence <chord name="Bb"/>come<br/>
      <chord name="Bb"/>With <chord name="Eb/Bb"/>glad <chord name="Bb"/>and <chord name="Fm/Ab"/>thankful <chord name="Eb/Bb"/>voice;<br/>
      <chord name="Bb"/>Let us <chord name="Eb/Bb"/>sing <chord name="Bb7/Ab"/>psalms <chord name="Eb"/>of praise <chord name="Bb7/Ab"/>to <chord name="Gm"/>Him,<br/>
      <chord name="Bb"/>And make <chord name="Fm/C"/>a <chord name="Eb/Bb"/>joyful <chord name="Cm/G"/>noise.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Cm/G"/>For God, <chord name="Bb/F"/>a <chord name="Cm/G"/>great <chord name="Eb/Bb"/>God <chord name="Fm/C"/>and <chord name="Eb/Bb"/>great <chord name="Bb"/>King,<br/>
      <chord name="Bb"/>Above all <chord name="Fm/Ab"/>gods, <chord name="Cm/G"/>He <chord name="Eb/Bb"/>is;<br/>
      <chord name="Bb"/>The depths <chord name="Eb/Bb"/>of <chord name="Bb7/Ab"/>earth <chord name="Eb"/>are in <chord name="Bb7/Ab"/>His <chord name="Gm"/>hand,<br/>
      <chord name="Bb"/>The strength <chord name="Fm/C"/>of <chord name="Eb/Bb"/>hills <chord name="Fm/Ab"/>is <chord name="Cm/G"/>His.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Cm/G"/>To Him <chord name="Bb/F"/>the <chord name="Cm/G"/>ocean <chord name="Fm/C"/>vast <chord name="Eb/Bb"/>belongs,<br/>
      <chord name="Bb"/>For <chord name="Eb/Bb"/>He <chord name="Bb"/>the <chord name="Fm/Ab"/>sea <chord name="Cm/G"/>did <chord name="Eb/Bb"/>make;<br/>
      <chord name="Bb"/>The dry <chord name="Eb/Bb"/>land <chord name="Bb7/Ab"/>also <chord name="Eb"/>from <chord name="Bb7/Ab"/>His <chord name="Gm"/>hands,<br/>
      <chord name="Bb"/>Its form <chord name="Fm/C"/>at <chord name="Eb/Bb"/>first <chord name="Fm/Ab"/>did <chord name="Cm/G"/>take.
      </lines>
    </verse>
    <verse name="v5">
      <lines>
      <chord name="Cm/G"/>O come, <chord name="Bb/F"/>bow <chord name="Cm/G"/>down <chord name="Eb/Bb"/>and <chord name="Fm/C"/>worship <chord name="Bb"/>Him,<br/>
      <chord name="Bb"/>And <chord name="Eb/Bb"/>kneeling, <chord name="Fm/Ab"/>humbly <chord name="Eb/Bb"/>pray,<br/>
      <chord name="Bb"/>Come to <chord name="Eb/Bb"/>our <chord name="Bb7/Ab"/>Maker <chord name="Eb"/>and <chord name="Bb7/Ab"/>our <chord name="Gm"/>God,<br/>
      <chord name="Bb"/>And hear <chord name="Fm/C"/>His <chord name="Eb/Bb"/>voice <chord name="Fm/Ab"/>today.
      </lines>
    </verse>
  </lyrics>
</song>
