  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Cm"/>A <chord name="Db/Ab"/>wake, <chord name="Eb7/Bb"/>awake <chord name="Ab/C"/>tolove and work!<br/>
      <chord name="Ab/Eb"/>The <chord name="Db/Ab"/>lark <chord name="Eb/Bb"/>isin <chord name="Eb7/Db"/>the sky;<br/>
      <chord name="Cm"/>The fields <chord name="Ab"/>are wet <chord name="Gdim"/>with <chord name="Ab"/>dia- <chord name="Fm"/>mond dew;<br/>
      <chord name="Ab"/>The worlds a <chord name="Bbm"/>wake tocry<br/>
      <chord name="Fm"/>Their <chord name="Cm/G"/>blessings <chord name="Fm/C"/>on <chord name="Ab"/>the <chord name="Cm/G"/>Lord <chord name="Db/Ab"/>of <chord name="Fm"/>life,<br/>
      <chord name="Eb/Bb"/>AsHe goes meekly <chord name="Bbm"/>by.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Cm"/>Come, <chord name="Db/Ab"/>let <chord name="Eb7/Bb"/>thy <chord name="Ab"/>voice be one with theirs,<br/>
      <chord name="Ab/Eb"/>Shout <chord name="Db/Ab"/>with <chord name="Eb/Bb"/>their <chord name="Fm/C"/>shout <chord name="Eb7/Db"/>of praise;<br/>
      <chord name="Cm"/>See how <chord name="Ab"/>the giant sun <chord name="Eb/Bb"/>soars <chord name="Fm"/>up,<br/>
      <chord name="Ab"/>Great lord of <chord name="Bbm"/>years and <chord name="Eb/Bb"/>days!<br/>
      <chord name="Fm"/>So <chord name="Cm/G"/>let <chord name="Ab"/>the <chord name="Fm/C"/>love <chord name="Ab"/>of <chord name="Cm/G"/>Jesus <chord name="Fm"/>come<br/>
      <chord name="Eb/Bb"/>And set thy <chord name="Bbm"/>soul ablaze.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Cm"/>To <chord name="Db/Ab"/>give <chord name="Eb7/Bb"/>and <chord name="Ab"/>give, and give again,<br/>
      <chord name="Ab/Eb"/>What <chord name="Db/Ab"/>God <chord name="Eb/Bb"/>hath <chord name="Fm/C"/>given <chord name="Eb7/Db"/>thee;<br/>
      <chord name="Cm"/>To spend <chord name="Ab"/>thyself <chord name="Gdim"/>nor <chord name="Ab"/>count <chord name="Fm"/>the cost;<br/>
      <chord name="Ab"/>To serve right <chord name="Bbm"/>gloriously<br/>
