  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F/C"/>Gentle <chord name="C7"/>Jesus, meek <chord name="F/C"/>and <chord name="C"/>mild,<br/>
      <chord name="F/C"/>Look <chord name="C7"/>upon <chord name="Bdim"/>alittle <chord name="Dm/A"/>child;<br/>
      <chord name="Dm/A"/>Pity my simplicity,<br/>
      <chord name="F/C"/>Suffer <chord name="Am"/>me <chord name="Dm"/>to <chord name="F/C"/>come <chord name="Gm"/>to <chord name="Dm/A"/>Thee.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F/C"/>Lamb <chord name="C7"/>of God, <chord name="F/C"/>I <chord name="C7"/>look <chord name="F/C"/>to <chord name="C"/>Thee;<br/>
      <chord name="F/C"/>Thou <chord name="C7"/>shalt my <chord name="Bdim"/>example <chord name="Dm/A"/>be;<br/>
      <chord name="Dm/A"/>Thou <chord name="Am"/>art <chord name="Dm/F"/>gentle, <chord name="Gm"/>meek, <chord name="F"/>and <chord name="Edim"/>mild,<br/>
      <chord name="F/C"/>Thou <chord name="Bb"/>wast <chord name="Am"/>once <chord name="Dm"/>a <chord name="F/C"/>little <chord name="Dm/A"/>child.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F/C"/>Fain <chord name="C7"/>I would <chord name="F/C"/>be <chord name="C7"/>as <chord name="F/C"/>Thou <chord name="C"/>art;<br/>
      <chord name="F/C"/>Give <chord name="C7"/>me Thy <chord name="Bdim"/>obedient <chord name="Dm/A"/>heart;<br/>
      <chord name="Dm/A"/>Thou <chord name="Am"/>art <chord name="Dm/F"/>pitiful <chord name="F"/>and <chord name="Edim"/>kind,<br/>
      <chord name="F/C"/>Let <chord name="Bb"/>me <chord name="Am"/>have <chord name="Dm"/>Thy <chord name="F/C"/>loving <chord name="Dm/A"/>mind.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F/C"/>I <chord name="C7"/>shall then <chord name="F/C"/>show <chord name="C7"/>forth <chord name="F/C"/>Thy <chord name="C"/>praise,<br/>
      <chord name="F/C"/>Serve <chord name="C7"/>Thee all <chord name="Bdim"/>my <chord name="F/C"/>happy <chord name="Dm/A"/>days;<br/>
      <chord name="Dm/A"/>Then <chord name="Am"/>the <chord name="Dm/F"/>world shall <chord name="Gm"/>always <chord name="Edim"/>see<br/>
      <chord name="F/C"/>Christ, <chord name="Bb"/>the <chord name="Am"/>Holy <chord name="F/C"/>Child, <chord name="Gm"/>in <chord name="Dm/A"/>me.
