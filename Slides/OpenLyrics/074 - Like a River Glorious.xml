  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Dm/A"/>Like a <chord name="Gm"/>river <chord name="F"/>glorious <chord name="Bb/F"/>Is God&#x27;s <chord name="Edim"/>perfect <chord name="F"/>peace,<br/>
      <chord name="F/A"/>Over <chord name="Gm"/>all victorious <chord name="C/G"/>In its <chord name="Dm/F"/>bright increase;<br/>
      <chord name="Am"/>Perfect, yet <chord name="C7/Bb"/>it floweth <chord name="C"/>Fuller <chord name="C7"/>every <chord name="C"/>day,<br/>
      <chord name="F/C"/>Perfect, <chord name="Gm/Bb"/>yet it <chord name="Dm/A"/>groweth <chord name="F/C"/>Deeper <chord name="Gm/Bb"/>all the <chord name="Dm/A"/>way.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Am"/>Stayed upon <chord name="C7"/>Jehovah, <chord name="Gm/D"/>hearts <chord name="C7"/>are <chord name="F/C"/>fully <chord name="C"/>blessed<br/>
      <chord name="F/C"/>Finding, <chord name="Gm/Bb"/>as <chord name="A7"/>He <chord name="Dm/A"/>promised, <chord name="F"/>perfect <chord name="Gm/Bb"/>peace and <chord name="F"/>rest.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Dm/A"/>Hidden <chord name="Gm"/>in the <chord name="F"/>hollow <chord name="Bb/F"/>of His <chord name="Edim"/>blessed hand,<br/>
      <chord name="F/A"/>Never <chord name="Gm"/>foe can <chord name="F"/>follow, <chord name="C/G"/>never <chord name="Dm/F"/>traitor <chord name="C/E"/>stand;<br/>
      <chord name="Am"/>Not a <chord name="C7/Bb"/>surge of <chord name="Bb"/>worry, <chord name="Gm/D"/>not <chord name="C7"/>a <chord name="F/C"/>shade of <chord name="C"/>care,<br/>
      <chord name="F/C"/>Not a <chord name="Gm/Bb"/>blast of <chord name="Dm/A"/>hurry <chord name="F/C"/>touch <chord name="Am"/>the <chord name="Gm/Bb"/>spirit <chord name="Dm/A"/>there.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Dm/A"/>Every <chord name="Gm"/>joy <chord name="F"/>or trial <chord name="Bb/F"/>falleth <chord name="Edim"/>from above,<br/>
      <chord name="F/A"/>Traced upon <chord name="Gm"/>our <chord name="F"/>dial by <chord name="C/G"/>the Sun <chord name="Dm/F"/>of Love;<br/>
      <chord name="Am"/>We may <chord name="C7/Bb"/>trust Him <chord name="Bb"/>fully <chord name="Gm/D"/>all <chord name="C7"/>for <chord name="F/C"/>us to <chord name="C"/>do.<br/>
      <chord name="F/C"/>They who <chord name="Gm/Bb"/>trust Him <chord name="Dm/A"/>wholly <chord name="F/C"/>find <chord name="Am"/>Him <chord name="Gm/Bb"/>wholly <chord name="Dm/A"/>true.
      </lines>
    </verse>
  </lyrics>
