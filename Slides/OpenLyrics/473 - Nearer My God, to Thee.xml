<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>473 - Nearer My God, to Thee</title>
      <title>Nearer My God, to Thee</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="473"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4 v5</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Nearer, <chord name="C7"/>my <chord name="Dm"/>God, <chord name="Bb"/>to Thee, Nearer <chord name="F/A"/>to Thee!<br/>
      <chord name="C"/>E’en though <chord name="F"/>it <chord name="C7"/>be a <chord name="Dm"/>cross <chord name="Bb"/>That raiseth me,<br/>
      <chord name="F/C"/>Still all my <chord name="C"/>song shall <chord name="C7"/>be,<br/>
      <chord name="F"/>Nearer, my <chord name="Bb/F"/>God, to <chord name="F"/>Thee;<br/>
      <chord name="F"/>Nearer, my God, to <chord name="Bb"/>Thee, <chord name="F"/>Nearer <chord name="C/E"/>to Thee!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>Though like <chord name="C7"/>the <chord name="Dm"/>wanderer, <chord name="Bb"/>the <chord name="F"/>sun gone down,<br/>
      <chord name="C"/>darkness <chord name="F"/>be <chord name="C7"/>over <chord name="Dm"/>me, <chord name="Bb"/>my rest a stone;<br/>
      <chord name="F/C"/>yet in my <chord name="C"/>dreams I&#x27;d <chord name="C7"/>be<br/>
      <chord name="F"/>nearer, my <chord name="Bb/F"/>God, to <chord name="F"/>thee;<br/>
      <chord name="F"/>nearer, my God, to <chord name="Bb"/>thee, <chord name="F"/>nearer <chord name="C/E"/>to thee!
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>There let <chord name="C7"/>the <chord name="Dm"/>way <chord name="Bb"/>appear, steps unto <chord name="F/A"/>heaven;<br/>
      <chord name="C"/>all that <chord name="F"/>thou sendest <chord name="Dm"/>me, in <chord name="Bb"/>mercy given;<br/>
      <chord name="F/C"/>angels to <chord name="C"/>beckon <chord name="C7"/>me<br/>
      <chord name="F"/>nearer, my <chord name="Bb/F"/>God, to <chord name="F"/>thee;<br/>
      <chord name="F"/>nearer, my God, to <chord name="Bb"/>thee, <chord name="F"/>nearer <chord name="C/E"/>to thee!
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F"/>Then, with <chord name="C7"/>my <chord name="Dm"/>waking <chord name="Bb"/>thoughts bright <chord name="F"/>with thy praise,<br/>
      <chord name="C"/>out of <chord name="F"/>my <chord name="C7"/>stony <chord name="Dm"/>griefs <chord name="Bb"/>Bethel I&#x27;ll raise;<br/>
      <chord name="F/C"/>so by my <chord name="C"/>woes to <chord name="C7"/>be<br/>
      <chord name="F"/>nearer, my <chord name="Bb/F"/>God, to <chord name="F"/>thee;<br/>
      <chord name="F"/>nearer, my God, to <chord name="Bb"/>thee, <chord name="F"/>nearer <chord name="C/E"/>to thee!
      </lines>
    </verse>
    <verse name="v5">
      <lines>
      <chord name="F"/>Or if, <chord name="C7"/>on <chord name="Dm"/>joyful <chord name="Bb"/>wing cleaving <chord name="F/A"/>the sky,<br/>
      <chord name="C"/>sun, moon, <chord name="F"/>and <chord name="C7"/>stars forgot, <chord name="Bb"/>upward I fly,<br/>
      <chord name="F/C"/>still all my <chord name="C"/>song shall <chord name="C7"/>be,<br/>
      <chord name="F"/>nearer, my <chord name="Bb/F"/>God, to <chord name="F"/>thee;<br/>
      <chord name="F"/>nearer, my God, to <chord name="Bb"/>thee, <chord name="F"/>nearer <chord name="C/E"/>to thee!
      </lines>
    </verse>
  </lyrics>
</song>
