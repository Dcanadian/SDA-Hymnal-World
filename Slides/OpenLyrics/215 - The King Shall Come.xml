  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Cm"/>The <chord name="Fm"/>King <chord name="Cm/G"/>shall <chord name="Ab"/>come when <chord name="Gdim"/>morning <chord name="Eb"/>dawns<br/>
      <chord name="Cm"/>And <chord name="Fm"/>light <chord name="Gdim"/>triumphant <chord name="Bbm"/>breaks,<br/>
      <chord name="Ab"/>When beauty <chord name="Cm"/>gilds <chord name="Bbm"/>the <chord name="Ab"/>eastern <chord name="Eb"/>hills<br/>
      <chord name="Cm"/>And <chord name="Fm"/>life <chord name="Gdim"/>to <chord name="Fm"/>joy awakes.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Cm"/>Not <chord name="Fm"/>as <chord name="Cm/G"/>of <chord name="Ab"/>old a <chord name="Gdim"/>little <chord name="Eb"/>child,<br/>
      <chord name="Cm"/>To <chord name="Fm"/>bear <chord name="Gdim"/>and <chord name="Ab"/>fight <chord name="Bbm"/>and <chord name="Cm"/>die,<br/>
      <chord name="Ab"/>But crowned with <chord name="Cm"/>glory <chord name="Ab"/>like <chord name="Eb"/>the sun<br/>
      <chord name="Cm"/>That <chord name="Fm"/>lights <chord name="Gdim"/>the <chord name="Fm"/>morning <chord name="Gdim"/>sky.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Cm"/>O, <chord name="Fm"/>brighter <chord name="Ab"/>than the <chord name="Gdim"/>rising <chord name="Eb"/>morn<br/>
      <chord name="Cm"/>When <chord name="Fm"/>Christ, <chord name="Gdim"/>victorious, <chord name="Cm"/>rose<br/>
      <chord name="Ab"/>And left the <chord name="Cm"/>lonesome <chord name="Gdim"/>place <chord name="Eb"/>of death,<br/>
      <chord name="Cm"/>Despite <chord name="Gdim"/>the <chord name="Fm"/>rage of <chord name="Gdim"/>foes.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Cm"/>O, <chord name="Fm"/>brighter <chord name="Ab"/>than that <chord name="Gdim"/>glorious <chord name="Eb"/>morn<br/>
      <chord name="Cm"/>Shall <chord name="Fm"/>dawn <chord name="Gdim"/>upon <chord name="Bbm"/>our <chord name="Cm"/>race<br/>
      <chord name="Ab"/>The day when <chord name="Cm"/>Christ in <chord name="Ab"/>splendor <chord name="Eb"/>comes,<br/>
