<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>054 - O Gladsome Light</title>
      <title>O Gladsome Light</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="54"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Worship</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>O gladsome <chord name="Bb"/>light, <chord name="Am"/>O <chord name="F"/>grace<br/>
      <chord name="Dm"/>Of God <chord name="C"/>the Father&#x27;s <chord name="Dm"/>face,<br/>
      <chord name="C/G"/>The eternal splendor <chord name="Am"/>wearing;<br/>
      <chord name="Dm"/>Celestial, <chord name="F"/>holy, blest,<br/>
      <chord name="Gm"/>Our <chord name="F"/>Savior, Jesus Christ,<br/>
      <chord name="Dm"/>Joyful <chord name="F"/>in Thine <chord name="Am"/>appearing.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>Now e&#x27;er day <chord name="Bb"/>fadeth <chord name="F"/>quite,<br/>
      <chord name="Dm"/>We see <chord name="C"/>the ev&#x27;ning <chord name="Dm"/>light,<br/>
      <chord name="C/G"/>Our <chord name="Dm"/>wonted <chord name="Gm"/>hymn <chord name="C"/>ourpouring;<br/>
      <chord name="Dm"/>Father <chord name="F"/>of might unknown,<br/>
      <chord name="Gm"/>Thee <chord name="F"/>His <chord name="C"/>incarnate <chord name="F"/>Son,<br/>
      <chord name="Dm"/>And Holy <chord name="F"/>Spirit <chord name="Am"/>adoring.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>To Thee of <chord name="Bb"/>right <chord name="Am"/>belongs<br/>
      <chord name="Dm"/>All praise <chord name="C"/>of holy <chord name="Dm"/>songs,<br/>
      <chord name="C/G"/>O <chord name="Dm"/>Son <chord name="F"/>of <chord name="Gm"/>God, <chord name="C"/>life <chord name="Am"/>giver;<br/>
      <chord name="Dm"/>Thee therefore, <chord name="F"/>O most high,<br/>
      <chord name="Gm"/>The <chord name="F"/>world <chord name="C"/>doth <chord name="F/A"/>glorify<br/>
      <chord name="Dm"/>And shall <chord name="F"/>exalt <chord name="Am"/>for ever.
      </lines>
    </verse>
  </lyrics>
</song>
