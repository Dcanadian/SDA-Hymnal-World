  <properties>
    <titles>
      <title>627 - Jacob&#x27;s Ladder</title>
      <title>Jacob&#x27;s Ladder</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="627"/>
    </songbooks>
    <key>D</key>
    <tempo type="bpm">Moderato</tempo>
