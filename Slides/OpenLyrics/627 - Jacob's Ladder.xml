    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D/A"/>We are <chord name="Bm"/>climbing <chord name="A"/>Jacob’s <chord name="F#m"/>ladder,<br/>
      <chord name="Em/G"/>We are <chord name="A"/>climbing <chord name="G"/>Jacob’s <chord name="Bm"/>ladder,<br/>
      <chord name="D7/C"/>We <chord name="Bm"/>are climbing <chord name="F#m"/>Jacob’s ladder,<br/>
      <chord name="Em/G"/>Soldiers <chord name="D/F#"/>ofthe cross.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D/A"/>Every <chord name="Bm"/>round goes <chord name="A"/>higher, <chord name="F#m"/>higher,<br/>
      <chord name="Em/G"/>Every <chord name="A"/>round <chord name="G"/>goes <chord name="Em"/>higher, <chord name="Bm"/>higher,<br/>
      <chord name="D7/C"/>Every <chord name="Bm"/>round goes <chord name="F#m"/>higher, higher,<br/>
      <chord name="Em/G"/>Soldiers of <chord name="D/F#"/>the cross.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D/A"/>Sinner, <chord name="Bm"/>do you <chord name="A"/>love my <chord name="F#m"/>Jesus?<br/>
      <chord name="Em/G"/>Sinner, <chord name="A"/>do <chord name="G"/>you love <chord name="Em"/>my <chord name="Bm"/>Jesus?<br/>
      <chord name="D7/C"/>Sinner, <chord name="Bm"/>do you <chord name="F#m"/>love my Jesus?<br/>
      <chord name="Em/G"/>Soldiers of <chord name="D/F#"/>the cross.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="D/A"/>If you <chord name="Bm"/>love him, <chord name="A"/>why not <chord name="F#m"/>serve him?<br/>
      <chord name="Em/G"/>If you <chord name="A"/>love <chord name="G"/>him, why <chord name="Em"/>not <chord name="Bm"/>serve him?<br/>
      <chord name="D7/C"/>If <chord name="Bm"/>you love him, <chord name="F#m"/>why not serve <chord name="Em/B"/>him?<br/>
      <chord name="Em/G"/>Soldiers of <chord name="D/F#"/>the cross.
      </lines>
    </verse>
  </lyrics>
