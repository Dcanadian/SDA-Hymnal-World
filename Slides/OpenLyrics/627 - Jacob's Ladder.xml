  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>We are <chord name="Bm"/>climbing <chord name="F#m"/>Jacob’s <chord name="Bm7"/>ladder,<br/>
      <chord name="Em7"/>We are <chord name="A"/>climbing <chord name="G"/>Ja<chord name="A7"/>cob’s <chord name="Em7"/>lad<chord name="D"/>der,<br/>
      <chord name="Bm"/>We are <chord name="D7"/>climbing <chord name="G"/>Jacob’s <chord name="G"/>lad<chord name="D"/>der,<br/>
      <chord name="B"/>Soldiers <chord name="Em7"/>of<chord name="A7"/>the <chord name="D"/>cross.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>Every <chord name="Bm"/>round <chord name="F#m"/>goes <chord name="Bm7"/>higher, higher,<br/>
      <chord name="Em7"/><chord name="A"/>Every <chord name="G"/>round <chord name="A7"/>goes <chord name="Em7"/>higher, <chord name="D"/>higher,<br/>
      <chord name="Bm"/>Every <chord name="D7"/>round <chord name="G"/>goes <chord name="G"/>higher, <chord name="D"/>higher,<br/>
      <chord name="B"/>Soldiers <chord name="Em7"/>of <chord name="A7"/>the <chord name="D"/>cross.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D"/>Sinner, <chord name="Bm"/>do you <chord name="F#m"/>love <chord name="Bm7"/>my Jesus?<br/>
      <chord name="Em7"/>Sinner, <chord name="A"/>do <chord name="G"/>you <chord name="A7"/>love <chord name="Em7"/>my <chord name="D"/>Jesus?<br/>
      <chord name="Bm"/>Sinner, <chord name="D7"/>do <chord name="G"/>you <chord name="G"/>love <chord name="D"/>my Jesus?<br/>
      <chord name="B"/>Soldiers <chord name="Em7"/>of <chord name="A7"/>the <chord name="D"/>cross.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="D"/>If you <chord name="Bm"/>love him, <chord name="F#m"/>why not <chord name="Bm7"/>serve him?<br/>
      <chord name="Em7"/>If <chord name="A"/>you <chord name="G"/>love him, <chord name="A7"/>why <chord name="Em7"/>not <chord name="D"/>serve him?<br/>
      <chord name="Bm"/>If <chord name="D7"/>you love <chord name="G"/>him, <chord name="G"/>why not <chord name="D"/>serve him?<br/>
      <chord name="B"/>Soldiers <chord name="Em7"/>of <chord name="A7"/>the <chord name="D"/>cross.
      </lines>
    </verse>
