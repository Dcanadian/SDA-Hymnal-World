<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>086 - How Great Thou Art</title>
      <title>How Great Thou Art</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="86"/>
    </songbooks>
    <key>Bb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3 v4</verseOrder>
    <themes>
      <theme>God the Father</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Cm"/>O Lord my <chord name="Bb"/>God! when I in awesome <chord name="F7"/>wonder<br/>
      <chord name="Eb/Bb"/>Consider all the works Thy <chord name="Bb"/>hands have <chord name="Dm/A"/>made,<br/>
      <chord name="F7"/>I see the <chord name="Bb/F"/>stars, I hear the mighty <chord name="F7"/>thunder,<br/>
      <chord name="Eb/Bb"/>Thy pow&#x27;r thro&#x27;out the universe <chord name="Dm/A"/>displayed.<br/>
      <chord name="F7"/>Then sings <chord name="Dm/F"/>my <chord name="Bb/F"/>soul, my Saviour God <chord name="Eb"/>to Thee;<br/>
      <chord name="Eb/Bb"/>How great Thou art, <chord name="Bb"/>how great Thou art!
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="F"/>Then sings my soul<br/>
      <chord name="F7"/>My Saviour God to <chord name="Dm/F"/>Thee<br/>
      <chord name="Bb/F"/>How great Thou art<br/>
      <chord name="Bb"/>How great <chord name="Eb"/>Thou art<br/>
      <chord name="Eb/Bb"/>Then sings my <chord name="Bb"/>soul<br/>
      <chord name="Bb"/>My Saviour God to Thee<br/>
      <chord name="Bb"/>How great <chord name="Cm"/>Thou art<br/>
      <chord name="Cm"/>How great Thou art
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Cm"/>When <chord name="Bb"/>through the woods<br/>
      <chord name="Eb/Bb"/>And forest glades I <chord name="Bb/F"/>wander<br/>
      <chord name="F7"/>And hear <chord name="Bb/F"/>the birds sing sweetly in <chord name="F7"/>the trees<br/>
      <chord name="Eb/Bb"/>When I look <chord name="Bb/F"/>down<br/>
      <chord name="F7"/>From lofty <chord name="Bb"/>mountain grandeur<br/>
      <chord name="Eb/Bb"/>And see the brook and <chord name="Bb"/>feel the gentle breeze
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Cm"/>And <chord name="Bb"/>when I think<br/>
      <chord name="Eb/Bb"/>That God His Son not <chord name="Bb"/>sparing<br/>
      <chord name="F7"/>Sent Him <chord name="Bb/F"/>to die I scarce can take <chord name="F7"/>it in<br/>
      <chord name="Eb/Bb"/>That on the <chord name="Bb/F"/>Cross<br/>
      <chord name="F7"/>My burden <chord name="Bb"/>gladly bearing<br/>
      <chord name="Eb/Bb"/>He bled and died to <chord name="Bb"/>take away my sin.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Cm"/>When <chord name="Bb"/>Christ shall come<br/>
      <chord name="Eb/Bb"/>With shouts of acclamation<br/>
      <chord name="Eb/Bb"/>And take me <chord name="Bb/F"/>home<br/>
      <chord name="F7"/>What joy <chord name="Bb/F"/>shall fill my <chord name="F7"/>heart<br/>
      <chord name="Eb/Bb"/>Then I shall <chord name="Bb/F"/>bow<br/>
      <chord name="F7"/>In humble <chord name="Bb"/>adoration<br/>
      <chord name="F7"/>And <chord name="Dm/F"/>then <chord name="Bb"/>proclaim<br/>
      <chord name="Eb/Bb"/>&quot;My God, how <chord name="Bb"/>great Thou art!&quot;
      </lines>
    </verse>
  </lyrics>
</song>
