  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F#m/C#"/>Come, <chord name="E/B"/>Christians, <chord name="D/A"/>join <chord name="A"/>to sing, Alleluia! <chord name="F#m/C#"/>A <chord name="E/B"/>men!<br/>
      <chord name="A/C#"/>Loud <chord name="E/B"/>praise <chord name="A"/>to <chord name="D/A"/>Christ <chord name="A"/>our King; Alleluia! <chord name="F#m/C#"/>A <chord name="E/B"/>men!<br/>
      <chord name="A"/>Let <chord name="Bm/D"/>all, <chord name="C#m"/>with <chord name="D/A"/>heart <chord name="A"/>and <chord name="G#dim"/>voice, <chord name="A"/>Before His <chord name="D/F#"/>throne rejoice;<br/>
      <chord name="F#m/C#"/>Praise <chord name="A/E"/>is <chord name="E7/D"/>His <chord name="F#m/C#"/>gracious <chord name="E/B"/>choice; <chord name="A"/>Alleluia! <chord name="F#m/C#"/>A <chord name="E/B"/>men!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F#m/C#"/>Come, <chord name="A"/>lift your hearts <chord name="Bm"/>on <chord name="F#m/C#"/>high;<br/>
      <chord name="F#m/C#"/>Alleluia! <chord name="A/C#"/>Amen!<br/>
      <chord name="A/C#"/>Let praises fill <chord name="Bm"/>the <chord name="F#m/C#"/>sky;<br/>
      <chord name="A/C#"/>Alleluia! Amen!<br/>
      <chord name="A"/>He <chord name="C#m"/>is <chord name="A"/>our Guide and <chord name="D"/>Friend;<br/>
      <chord name="A"/>To <chord name="C#m"/>us <chord name="A"/>He&#x27;ll condescend;<br/>
      <chord name="F#m/C#"/>His <chord name="E7/D"/>love <chord name="F#m/A"/>shall <chord name="A"/>never <chord name="F#m/C#"/>end:<br/>
      <chord name="F#m/C#"/>Alleluia! <chord name="A/C#"/>Amen!
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F#m/C#"/>Praise <chord name="A"/>yet our Christ <chord name="Bm"/>again;<br/>
      <chord name="F#m/C#"/>Alleluia! <chord name="A/C#"/>Amen!<br/>
      <chord name="A/C#"/>Life shall not end <chord name="Bm"/>the <chord name="F#m/C#"/>strain;<br/>
      <chord name="A/C#"/>Alleluia! Amen!<br/>
      <chord name="A"/>On <chord name="C#m"/>heaven&#x27;s <chord name="A"/>blissful <chord name="D"/>shore<br/>
      <chord name="A"/>His <chord name="C#m"/>goodness <chord name="A"/>we&#x27;ll adore,<br/>
      <chord name="F#m/C#"/>Singing forevermore,<br/>
      <chord name="F#m/C#"/>Alleluia! <chord name="A/C#"/>Amen!
      </lines>
    </verse>
  </lyrics>
</song>
