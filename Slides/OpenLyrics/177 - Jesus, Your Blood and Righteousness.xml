  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>Jesus, <chord name="D/A"/>your <chord name="G"/>blood <chord name="D/F#"/>and <chord name="C/G"/>righteousness <chord name="D/A"/>My <chord name="Am"/>beauty <chord name="D"/>are, <chord name="G"/>my <chord name="D/F#"/>glo <chord name="Em"/>rious <chord name="D/F#"/>dress;<br/>
      <chord name="G"/>Mid flaming <chord name="D"/>worlds, <chord name="G"/>in these arrayed, <chord name="Am/C"/>With <chord name="D/A"/>joy <chord name="Am"/>shall <chord name="C/G"/>Ilift <chord name="Em/B"/>up <chord name="Am/C"/>my <chord name="D/A"/>head.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>Bold <chord name="D/A"/>shall I stand in <chord name="Am"/>that <chord name="G"/>great <chord name="Em"/>day,<br/>
      <chord name="G"/>Cleansed <chord name="D/A"/>and redeemed, no <chord name="Am"/>debt <chord name="G"/>to <chord name="Em"/>pay;<br/>
      <chord name="G"/>For by <chord name="F#7"/>your <chord name="G"/>cross <chord name="D#/A#"/>absolved <chord name="Am/C"/>I am<br/>
      <chord name="G"/>From sin <chord name="F#7"/>and <chord name="G"/>guilt, <chord name="D#/A#"/>from <chord name="Am"/>fear and shame.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>Lord, <chord name="D/A"/>I believe your <chord name="Am"/>precious <chord name="Em"/>blood,<br/>
      <chord name="G"/>Which <chord name="D/A"/>at the mercy <chord name="Am"/>seat <chord name="G"/>of <chord name="Em"/>God<br/>
      <chord name="G"/>Pleads for <chord name="F#7"/>the <chord name="G"/>captives&#x27; <chord name="C/G"/>liberty,<br/>
      <chord name="G"/>Was also shed <chord name="D#/A#"/>in <chord name="Am"/>love for me.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="G"/>When <chord name="D/A"/>from the dust of <chord name="Am"/>death <chord name="G"/>I <chord name="Em"/>rise<br/>
      <chord name="G"/>To <chord name="D/A"/>claim my mansion <chord name="Am"/>in <chord name="G"/>the <chord name="Em"/>skies,<br/>
      <chord name="G"/>This then <chord name="F#7"/>shall <chord name="G"/>be <chord name="D#/A#"/>my <chord name="Am"/>only plea:<br/>
      <chord name="G"/>Christ Jesus lived <chord name="D#/A#"/>and <chord name="Am"/>died for me.
      </lines>
