  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D/F#"/>Let all <chord name="A"/>the <chord name="D/A"/>earth their voices <chord name="F#m/C#"/>raise,<br/>
      <chord name="Em/B"/>To <chord name="D/A"/>sing <chord name="A"/>the <chord name="D/A"/>great <chord name="E"/>Jehovah&#x27;s <chord name="A"/>praise,<br/>
      <chord name="D/A"/>And bless His <chord name="Em/B"/>holy <chord name="D/F#"/>name:<br/>
      <chord name="D/A"/>His glory <chord name="A"/>let the people know,<br/>
      <chord name="D/A"/>His <chord name="Bm"/>wonders <chord name="A"/>to <chord name="G#m"/>the <chord name="A"/>nations <chord name="Em/G"/>show,<br/>
      <chord name="G"/>His saving <chord name="Em/B"/>grace <chord name="A"/>proclaim.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D/F#"/>He framed <chord name="A"/>the <chord name="D/A"/>globe; He built <chord name="Em/B"/>the <chord name="F#m/C#"/>sky;<br/>
      <chord name="Em/B"/>He <chord name="D/A"/>made <chord name="A"/>the <chord name="D/A"/>shining <chord name="A/E"/>worlds <chord name="G"/>on <chord name="A"/>high,<br/>
      <chord name="D/A"/>And reigns in <chord name="Em/B"/>glory <chord name="D/F#"/>there:<br/>
      <chord name="D/A"/>His beams are <chord name="A"/>majesty <chord name="G#m"/>and <chord name="A"/>light;<br/>
      <chord name="D/A"/>His <chord name="Bm"/>beauties, <chord name="A"/>how divinely <chord name="Em/G"/>bright!<br/>
      <chord name="G"/>His dwelling <chord name="Em/B"/>place, <chord name="A"/>how <chord name="D/F#"/>fair!
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D/F#"/>Come, the <chord name="A"/>great <chord name="D/A"/>day, the glorious <chord name="F#m/C#"/>hour,<br/>
      <chord name="Em/B"/>When <chord name="D/A"/>earth <chord name="A"/>shall <chord name="D/A"/>feel His <chord name="A/E"/>saving <chord name="G"/>power,<br/>
      <chord name="D/A"/>All nations <chord name="Em/B"/>fear <chord name="A"/>His <chord name="D/F#"/>name;<br/>
      <chord name="D/A"/>Then shall the <chord name="A"/>race of men <chord name="G#m"/>confess<br/>
