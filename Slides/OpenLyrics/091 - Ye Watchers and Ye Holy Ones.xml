<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>091 - Ye Watchers and Ye Holy Ones</title>
      <title>Ye Watchers and Ye Holy Ones</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="91"/>
    </songbooks>
    <key>Eb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3</verseOrder>
    <themes>
      <theme>God the Father</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Cm/G"/>Ye watchers <chord name="Eb"/>and <chord name="Cm"/>ye <chord name="Fm"/>holy <chord name="Eb/Bb"/>ones,<br/>
      <chord name="Eb/Bb"/>Bright seraphs, <chord name="Bb"/>cherubim <chord name="Cm/Eb"/>and <chord name="Eb"/>thrones,<br/>
      <chord name="Bb"/>Raise <chord name="F/A"/>the <chord name="Bb"/>glad <chord name="Eb"/>strain, <chord name="Fm"/>Alleluia!<br/>
      <chord name="Cm"/>Cry <chord name="Bb7"/>out, <chord name="Ab"/>dominions, <chord name="Bb/F"/>princedoms, powers,<br/>
      <chord name="Fm/C"/>Virtues, archangels, <chord name="Eb/Bb"/>angels&#x27; <chord name="Bb7/Ab"/>choirs:
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Cm/G"/>Alleluia! <chord name="F/A"/>Alleluia!<br/>
      <chord name="Cm/G"/>Alleluia! <chord name="Ab"/>Alleluia!<br/>
      <chord name="Cm/G"/>Alleluia!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Cm/G"/>O higher <chord name="Eb"/>than <chord name="Fm"/>the <chord name="Bb"/>cherubim,<br/>
      <chord name="Eb/Bb"/>More glorious <chord name="Bb"/>than <chord name="Eb"/>the <chord name="Cm/Eb"/>seraphim,<br/>
      <chord name="Bb"/>Lead <chord name="F/A"/>their <chord name="Bb"/>praises, <chord name="Fm"/>Alleluia!<br/>
      <chord name="Cm"/>Thou <chord name="Eb/Bb"/>bearer of <chord name="Bb/F"/>th&#x27;eternal Word,<br/>
      <chord name="Fm/C"/>Most <chord name="Cm"/>gracious, <chord name="Bb"/>magnify <chord name="Fm/C"/>the <chord name="Bb7/Ab"/>Lord.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Cm/G"/>O friends, <chord name="Eb/Bb"/>in gladness <chord name="Bb"/>let <chord name="Eb/Bb"/>us sing,<br/>
      <chord name="Eb/Bb"/>Supernal <chord name="Bb"/>anthems <chord name="Ab/Eb"/>echoing,<br/>
      <chord name="Bb"/>Alleluia! <chord name="Eb"/>Alleluia!<br/>
      <chord name="Cm"/>To <chord name="Eb/Bb"/>God <chord name="Bb/F"/>the <chord name="Eb/Bb"/>Father, <chord name="Ab/Eb"/>God <chord name="Fm/C"/>the <chord name="Bb/F"/>Son,<br/>
      <chord name="Fm/C"/>And <chord name="Cm"/>God <chord name="Fm/C"/>the <chord name="Bb"/>Spirit, <chord name="Eb/Bb"/>Three <chord name="Fm/C"/>in <chord name="Bb7/Ab"/>One.
      </lines>
    </verse>
  </lyrics>
</song>
