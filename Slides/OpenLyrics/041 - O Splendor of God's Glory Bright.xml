      <title>041 - O Splendor of God&#x27;s Glory Bright</title>
      <title>O Splendor of God&#x27;s Glory Bright</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="41"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
