    <themes>
      <theme>Worship</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G/D"/>O <chord name="Em"/>splendor <chord name="C"/>of <chord name="Am"/>God&#x27;s glory <chord name="G"/>bright,<br/>
      <chord name="Em"/>From <chord name="C"/>light <chord name="D7/C"/>eternal <chord name="G/B"/>bringing light;<br/>
      <chord name="Am"/>O <chord name="D7"/>Light <chord name="G"/>of <chord name="C"/>life, <chord name="Bm/F#"/>light&#x27;s <chord name="Em"/>living <chord name="Am"/>spring,<br/>
      <chord name="Am/C"/>True day, <chord name="Bm"/>all days <chord name="Am"/>illumining.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G/D"/>O <chord name="Em"/>Thou true <chord name="C"/>Sun, <chord name="Am"/>on us <chord name="Bm"/>Thy <chord name="G"/>glance<br/>
      <chord name="Em"/>Let <chord name="C"/>fall <chord name="D7/F#"/>in <chord name="G"/>royal radiance;<br/>
      <chord name="Am"/>The <chord name="Bm"/>Spirit&#x27;s <chord name="Am"/>sanctifying beam<br/>
      <chord name="Am/C"/>Upon <chord name="Bm"/>our earthly <chord name="G"/>senses stream.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G/D"/>O <chord name="Em"/>joyful <chord name="C"/>be <chord name="Am"/>the passing <chord name="G"/>day<br/>
      <chord name="Em"/>With <chord name="C"/>thoughts <chord name="D7/C"/>as clear <chord name="G"/>as morning&#x27;s ray,<br/>
      <chord name="Am"/>With <chord name="D7"/>faith <chord name="G"/>like <chord name="C"/>noontide <chord name="Em"/>shining <chord name="Am"/>bright,<br/>
      <chord name="Am/C"/>Our souls <chord name="Bm"/>unshadowed <chord name="G"/>by the night.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="G/D"/>Dawn&#x27;s <chord name="Em"/>glory <chord name="C"/>gilds <chord name="Am"/>the earth <chord name="Bm"/>and <chord name="G"/>skies;<br/>
      <chord name="Em"/>Let <chord name="C"/>Him, <chord name="D7/C"/>our perfect <chord name="G/B"/>morn, arise;<br/>
      <chord name="Am"/>The <chord name="D7"/>Father&#x27;s <chord name="C"/>help <chord name="Bm/F#"/>His <chord name="Em"/>children <chord name="Am"/>claim,<br/>
      <chord name="Am/C"/>And sing <chord name="Bm"/>the Father&#x27;s <chord name="Am"/>glorious <chord name="G"/>name. Amen.
      </lines>
    </verse>
  </lyrics>
</song>
