<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>482 - Father, Lead Me Day by Day</title>
      <title>Father, Lead Me Day by Day</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="482"/>
    </songbooks>
    <key>D</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D/F#"/>Father, lead me <chord name="Em"/>day by <chord name="A7"/>day, <chord name="A"/>Ever <chord name="D"/>in <chord name="A"/>thine own sweet <chord name="G#dim"/>way;<br/>
      <chord name="D/A"/>Teach <chord name="F#m"/>me <chord name="G"/>to <chord name="F#m"/>be <chord name="G"/>pure <chord name="D/A"/>and <chord name="A"/>true, Show <chord name="D/A"/>me <chord name="Bm"/>what I <chord name="G"/>ought <chord name="D/A"/>to <chord name="A7/G"/>do.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D/F#"/>When in <chord name="Em"/>danger, <chord name="A/C#"/>make me brave;<br/>
      <chord name="D/F#"/>Make me <chord name="Em"/>know <chord name="A7"/>that <chord name="A/C#"/>Thou canst save;<br/>
      <chord name="D/A"/>Keep <chord name="G"/>me safe <chord name="A"/>by <chord name="D/A"/>Thy <chord name="Bm"/>dear <chord name="D/A"/>side;<br/>
      <chord name="D/A"/>Let <chord name="G"/>me in <chord name="A"/>Thy <chord name="D/A"/>love <chord name="Bm"/>abide.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D/F#"/>When tempted <chord name="A"/>to <chord name="D"/>do <chord name="A"/>wrong,<br/>
      <chord name="D/F#"/>Make me <chord name="Em"/>steadfast, <chord name="A/C#"/>wise, and strong;<br/>
      <chord name="D/A"/>And <chord name="G"/>when all <chord name="A"/>alone <chord name="Bm"/>I <chord name="D/A"/>stand,<br/>
      <chord name="D/A"/>Shield <chord name="G"/>me with <chord name="A"/>Thy <chord name="D/A"/>mighty hand.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="D/F#"/>May I <chord name="Em"/>do <chord name="A7"/>the <chord name="A/C#"/>good I know,<br/>
      <chord name="D/F#"/>Be Thy <chord name="Em"/>loving <chord name="A/C#"/>child below,<br/>
      <chord name="D/A"/>Then <chord name="G"/>at last <chord name="A"/>go <chord name="D/A"/>home <chord name="Bm"/>to <chord name="D/A"/>Thee,<br/>
      <chord name="D/A"/>Evermore <chord name="A"/>Thy <chord name="D/A"/>child <chord name="Bm"/>to <chord name="D/A"/>be.
      </lines>
    </verse>
  </lyrics>
</song>
