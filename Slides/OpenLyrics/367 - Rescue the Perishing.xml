<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>367 - Rescue the Perishing</title>
      <title>Rescue the Perishing</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="367"/>
    </songbooks>
    <key>Bb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3</verseOrder>
    <themes>
      <theme>Christian Church</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Bb"/>Rescue the perishing,<br/>
      Care <chord name="Eb"/>for the dy<chord name="Bb"/>ing;<br/>
      <chord name="F"/>Snatch them in <chord name="Bb"/>pity from <chord name="F"/>sin <chord name="C7"/>and the <chord name="F"/>grave;<br/>
      <chord name="Bb"/>Weep o’er the erring one,<br/>
      Lift <chord name="F"/>up the fal<chord name="Bb"/>len,<br/>
      <chord name="F"/>Tell them of <chord name="Bb"/>Jesus, the <chord name="Eb"/>might<chord name="F7"/>y to <chord name="Bb"/>save.<br/>
      <chord name="F"/>Rescue the <chord name="Bb"/>perishing,<br/>
      <chord name="F"/>Care for the <chord name="Bb"/>dying;<br/>
      <chord name="Eb"/>Jesus is <chord name="Bb"/>merciful,<br/>
      <chord name="Eb"/>Jesus <chord name="F7"/>will <chord name="Bb"/>save.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Bb"/>Rescue the perishing, care for the dying;<br/>
      <chord name="Eb"/>Jesus is merciful, <chord name="Bb"/>Jesus will save.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Bb"/>Though they are slighting him, still he is waiting,<br/>
      <chord name="Eb"/>waiting the penitent <chord name="Bb"/>child to receive;<br/>
      <chord name="F"/>plead <chord name="Bb"/>with them <chord name="F"/>earnestly, <chord name="C7"/>plead with <chord name="F"/>them gently;<br/>
      <chord name="Bb"/>he will forgive if they only believe.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Bb"/>Rescue the perishing, duty demands it;<br/>
      <chord name="Eb"/>strength for thy labor <chord name="Bb"/>the Lord will provide;<br/>
      <chord name="F"/>back <chord name="Bb"/>to the <chord name="F"/>narrow <chord name="C7"/>way patiently <chord name="F"/>win them;<br/>
      <chord name="Bb"/>tell the poor wanderer a Savior has died.
      </lines>
    </verse>
  </lyrics>
</song>
