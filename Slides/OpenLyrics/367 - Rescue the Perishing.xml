<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>367 - Rescue the Perishing</title>
      <title>Rescue the Perishing</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="367"/>
    </songbooks>
    <key>Bb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3</verseOrder>
    <themes>
      <theme>Christian Church</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Bb"/>Rescue the perishing,<br/>
      <chord name="Bb"/>Care <chord name="Eb"/>for <chord name="F"/>the <chord name="Bb/F"/>dying;<br/>
      <chord name="F/C"/>Snatch <chord name="C7"/>them in <chord name="F7"/>pity <chord name="Bb"/>from sin and the grave;<br/>
      <chord name="Bb"/>Weep <chord name="Eb"/>o’er the <chord name="F"/>erring <chord name="Bb"/>one,
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Eb"/>Rescue <chord name="F"/>the perishing, care for <chord name="Bb"/>the dying;<br/>
      <chord name="F"/>Jesus <chord name="Bb"/>is merciful, Jesus <chord name="F7"/>will save.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Bb"/>Though they are slighting him, still he is waiting,<br/>
      <chord name="Bb"/>waiting <chord name="Eb"/>the penitent <chord name="F"/>child to <chord name="Bb/F"/>receive;<br/>
      <chord name="F/C"/>plead with <chord name="C7"/>them earnestly, <chord name="Bb"/>plead with them gently;<br/>
      <chord name="Bb"/>he <chord name="Eb"/>will forgive <chord name="Bb"/>if <chord name="F"/>they only <chord name="Bb/F"/>believe.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Bb"/>Rescue the perishing, duty demands it;<br/>
      <chord name="Bb"/>strength <chord name="Eb"/>for thy labor <chord name="F"/>the Lord will <chord name="Bb/F"/>provide;<br/>
      <chord name="F/C"/>back to <chord name="C7"/>the narrow <chord name="Bb"/>way patiently win them;<br/>
      <chord name="Bb"/>tell <chord name="Eb"/>the poor wanderer <chord name="F"/>a Savior <chord name="Bb"/>has died.
      </lines>
    </verse>
  </lyrics>
</song>
