  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>How beauteous are their <chord name="C"/>feet Who <chord name="F"/>stand on <chord name="Bb"/>Zi<chord name="F"/>on&#x27;s <chord name="C"/>hill;<br/>
      <chord name="C"/>Who <chord name="F"/>bring sal<chord name="C"/>vation <chord name="F"/>on <chord name="Dm"/>their <chord name="C"/>tongues, <chord name="F"/>And <chord name="Bb"/>words <chord name="F"/>of peace <chord name="C7"/>re<chord name="F"/>veal!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/><chord name="C"/>How <chord name="F"/>charming <chord name="Bb"/>is <chord name="F"/>their <chord name="C"/>voice,<br/>
      <chord name="C"/><chord name="F"/><chord name="C"/>So <chord name="F"/><chord name="Dm"/>sweet <chord name="C"/><chord name="F"/>the <chord name="Bb"/><chord name="F"/>tidings <chord name="C7"/><chord name="F"/>are:<br/>
      <chord name="F"/><chord name="C"/>&quot;Zion, <chord name="F"/>behold <chord name="Bb"/>thy <chord name="F"/>Savior <chord name="C"/>King;<br/>
      <chord name="C"/><chord name="F"/><chord name="C"/>He <chord name="F"/><chord name="Dm"/>reigns <chord name="C"/><chord name="F"/>and <chord name="Bb"/><chord name="F"/>triumphs <chord name="C7"/><chord name="F"/>here!&quot;
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/><chord name="C"/>How <chord name="F"/>happy <chord name="Bb"/>are <chord name="F"/>our <chord name="C"/>ears,<br/>
      <chord name="C"/><chord name="F"/><chord name="C"/>That <chord name="F"/><chord name="Dm"/>hear <chord name="C"/><chord name="F"/>the <chord name="Bb"/><chord name="F"/>joyful <chord name="C7"/><chord name="F"/>sound<br/>
      <chord name="F"/>Which <chord name="C"/>kings <chord name="F"/>and <chord name="Bb"/>prophets <chord name="F"/>waited <chord name="C"/>for,<br/>
      <chord name="C"/><chord name="F"/><chord name="C"/>And <chord name="F"/><chord name="Dm"/>sought, <chord name="C"/><chord name="F"/>but <chord name="Bb"/><chord name="F"/>never <chord name="C7"/><chord name="F"/>found!
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F"/><chord name="C"/>How <chord name="F"/>blessed <chord name="Bb"/>are <chord name="F"/>our <chord name="C"/>eyes,<br/>
      <chord name="C"/><chord name="F"/><chord name="C"/>That <chord name="F"/><chord name="Dm"/>see <chord name="C"/><chord name="F"/>this <chord name="Bb"/><chord name="F"/>heavenly <chord name="C7"/><chord name="F"/>light;<br/>
      <chord name="F"/>Prophets <chord name="C"/>and <chord name="F"/>kings <chord name="Bb"/>desired <chord name="F"/>it <chord name="C"/>long,<br/>
      <chord name="C"/><chord name="F"/><chord name="C"/>But <chord name="F"/><chord name="Dm"/>died <chord name="C"/><chord name="F"/>without <chord name="Bb"/><chord name="F"/>the <chord name="C7"/><chord name="F"/>sight!
      </lines>
    </verse>
    <verse name="v5">
      <lines>
      <chord name="F"/><chord name="C"/>The <chord name="F"/>watchmen <chord name="Bb"/>join <chord name="F"/>their <chord name="C"/>voice,<br/>
      <chord name="C"/><chord name="F"/><chord name="C"/>And <chord name="F"/><chord name="Dm"/><chord name="C"/>tuneful <chord name="F"/><chord name="Bb"/><chord name="F"/>notes <chord name="C7"/><chord name="F"/>employ;<br/>
      <chord name="F"/><chord name="C"/>Jerusalem <chord name="F"/>breaks <chord name="Bb"/>forth <chord name="F"/>in <chord name="C"/>songs,<br/>
      <chord name="C"/><chord name="F"/><chord name="C"/>And <chord name="F"/><chord name="Dm"/>deserts <chord name="C"/><chord name="F"/>learn <chord name="Bb"/><chord name="F"/>the <chord name="C7"/><chord name="F"/>joy.
      </lines>
    </verse>
  </lyrics>
</song>
