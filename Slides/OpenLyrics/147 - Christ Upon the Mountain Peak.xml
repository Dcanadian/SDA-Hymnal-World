  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Christ <chord name="Bb"/>upon <chord name="F"/>the <chord name="Am"/>mountain peak<br/>
      <chord name="Gm"/>Stands alone <chord name="Bb"/>in <chord name="C"/>glory <chord name="Dm"/>blazing;<br/>
      <chord name="F"/>Let <chord name="Gm/Bb"/>us, <chord name="F"/>if <chord name="Gm"/>we <chord name="F"/>dare to <chord name="C/G"/>speak,<br/>
      <chord name="Gm"/>With <chord name="C"/>the saints and <chord name="Bb"/>angels <chord name="F"/>praise <chord name="Bb"/>Him:<br/>
      <chord name="Eb"/>Alleluia, <chord name="F"/>Alleluia, <chord name="Am"/>Alleluia.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>Trembling <chord name="Gm"/>at <chord name="F"/>His <chord name="Am"/>feet <chord name="Bb"/>we <chord name="Am/C"/>saw<br/>
      <chord name="Gm"/>Moses <chord name="F/A"/>and <chord name="Bb"/>Elijah <chord name="Dm"/>speaking;<br/>
      <chord name="F"/>All <chord name="Gm/Bb"/>the <chord name="F"/>prophets and the <chord name="C/G"/>law<br/>
      <chord name="Gm"/>Shout <chord name="C"/>thro&#x27;them their <chord name="Bb"/>joyful <chord name="F"/>greeting:<br/>
      <chord name="Eb"/>Alleluia, <chord name="F"/>Alleluia, <chord name="Am"/>Alleluia.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>Swift <chord name="Bb"/>the <chord name="Gm"/>cloud <chord name="F"/>of <chord name="Am"/>glory came,<br/>
      <chord name="Gm"/>God proclaiming <chord name="C"/>in the <chord name="Dm"/>thunder<br/>
      <chord name="F"/>Jesus as <chord name="Gm"/>His <chord name="F"/>Son by <chord name="C/G"/>name;<br/>
      <chord name="Gm"/>Nations <chord name="C"/>cry aloud in <chord name="F"/>wonder!<br/>
      <chord name="Eb"/>Alleluia, <chord name="F"/>Alleluia, <chord name="Am"/>Alleluia.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F"/>This <chord name="Bb"/>is <chord name="Gm"/>God&#x27;s <chord name="C7/G"/>beloved <chord name="Am/C"/>Son:<br/>
      <chord name="Gm"/>Law and <chord name="F/A"/>prophets <chord name="C"/>fade before <chord name="Gm"/>Him;<br/>
      <chord name="F"/>First <chord name="Gm/Bb"/>and <chord name="F"/>last, <chord name="Gm"/>the <chord name="F"/>only <chord name="C/G"/>One,<br/>
      <chord name="Gm"/>Let <chord name="C"/>creation now <chord name="Bb"/>adore <chord name="F"/>Him.<br/>
      <chord name="Eb"/>Alleluia, <chord name="F"/>Alleluia, <chord name="Am"/>Alleluia.
      </lines>
    </verse>
  </lyrics>
