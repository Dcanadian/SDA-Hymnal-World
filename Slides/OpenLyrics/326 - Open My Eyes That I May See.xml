<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>326 - Open My Eyes That I May See</title>
      <title>Open My Eyes That I May See</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="326"/>
    </songbooks>
    <key>Ab</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Gospel</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Fm/C"/>Open <chord name="Cm"/>my eyes, that I <chord name="Db"/>may see Glimpses <chord name="Cm/G"/>of truth <chord name="Eb/G"/>Thou hast for me;<br/>
      <chord name="Eb/G"/>Place in my hands the <chord name="Ab"/>wonderful key That <chord name="Bbm"/>shall unclasp <chord name="Db/Ab"/>and set me free.<br/>
      <chord name="Db/Ab"/>Silently <chord name="Ab"/>now I wait <chord name="Fm"/>for Thee, Ready, <chord name="Bbm/F"/>my <chord name="Eb/Bb"/>God, Thy will to see;<br/>
      <chord name="Cm/G"/>Open my eyes, illumine me, Spirit Divine!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Fm/C"/>Open <chord name="Cm"/>my <chord name="Db"/>ears that <chord name="Cm/G"/>I <chord name="Eb/G"/>may hear<br/>
      <chord name="Fm/C"/>Voices <chord name="Cm"/>of <chord name="Db"/>truth Thou <chord name="Cm/G"/>sendest <chord name="Eb"/>clear;<br/>
      <chord name="Eb/G"/>and while the <chord name="Ab"/>wavenotes <chord name="Bbm"/>fall <chord name="Db/Ab"/>on my ear,<br/>
      <chord name="Db/Ab"/>Everything <chord name="Fm"/>false <chord name="Bbm/F"/>will <chord name="Eb/Bb"/>disappear.<br/>
      <chord name="Db/Ab"/>Silently <chord name="Fm"/>now I <chord name="Bbm/F"/>wait <chord name="Eb/Bb"/>for Thee,<br/>
      <chord name="Db/Ab"/>Ready, <chord name="Ab"/>my <chord name="Fm"/>God, Thy <chord name="Bbm/F"/>will <chord name="Eb/Bb"/>to see;<br/>
      <chord name="Cm/G"/>Open my ears, illumine me, Spirit Divine!
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Fm/C"/>Open <chord name="Cm"/>my <chord name="Db"/>mouth, and <chord name="Cm/G"/>let <chord name="Eb/G"/>me bear<br/>
      <chord name="Fm/C"/>Gladly <chord name="Cm"/>the warm <chord name="Db"/>truth <chord name="Cm/G"/>everywhere;<br/>
      <chord name="Eb/G"/>Open my <chord name="Ab"/>heart, and <chord name="Bbm"/>let me <chord name="Db/Ab"/>prepare<br/>
      <chord name="Db/Ab"/>Love with <chord name="Ab"/>Thy <chord name="Fm"/>children <chord name="Bbm/F"/>thus <chord name="Eb/Bb"/>to share.<br/>
      <chord name="Db/Ab"/>Silently <chord name="Fm"/>now I <chord name="Bbm/F"/>wait <chord name="Eb/Bb"/>for Thee,<br/>
      <chord name="Db/Ab"/>Ready, <chord name="Ab"/>my <chord name="Fm"/>God, Thy <chord name="Bbm/F"/>will <chord name="Eb/Bb"/>to see;<br/>
      <chord name="Cm/G"/>Open my heart, illumine me, Spirit Divine!
      </lines>
    </verse>
  </lyrics>
</song>
