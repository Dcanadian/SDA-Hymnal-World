    <verse name="v3">
      <lines>
      <chord name="C"/>Yours <chord name="Bdim"/>is <chord name="Em"/>the <chord name="Dm"/>image <chord name="G"/>stamped on <chord name="C"/>man,<br/>
      <chord name="Em"/>Though <chord name="Am"/>marred <chord name="G"/>by <chord name="C"/>man&#x27;s <chord name="F"/>own <chord name="Em"/>sin;<br/>
      <chord name="Am"/>And <chord name="F"/>Yours <chord name="C"/>the <chord name="Bdim"/>liberating <chord name="G/D"/>plan<br/>
      <chord name="G/D"/>Again <chord name="C"/>his <chord name="Am"/>soul <chord name="Bdim"/>to <chord name="G"/>win.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="C"/>Give <chord name="Bdim"/>us <chord name="Em"/>to <chord name="Dm"/>know <chord name="C"/>Your <chord name="G"/>truth; but <chord name="C"/>more,<br/>
      <chord name="Em"/>The <chord name="Am"/>strength <chord name="G"/>to <chord name="C"/>do <chord name="F"/>Your <chord name="Em"/>will;<br/>
