  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C"/>Lord <chord name="Bdim"/>of <chord name="Em"/>the <chord name="Dm"/>boundless <chord name="G"/>curves <chord name="C"/>of <chord name="Em"/>space<br/>
      <chord name="Em"/>And time&#x27;s <chord name="G"/>deep <chord name="C"/>mystery,<br/>
      <chord name="Am"/>To <chord name="F"/>Your <chord name="C"/>creative <chord name="Em"/>might <chord name="Am"/>we <chord name="G"/>trace<br/>
      <chord name="G/D"/>All nature&#x27;s <chord name="Am"/>energy.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="C"/>Your <chord name="Bdim"/>mind <chord name="Em"/>conceived <chord name="C"/>the <chord name="G"/>galaxy,<br/>
      <chord name="Em"/>Each <chord name="Am"/>atom&#x27;s <chord name="C"/>secret <chord name="Em"/>planned,<br/>
      <chord name="Am"/>And every <chord name="Bdim"/>age <chord name="Em"/>of <chord name="Am"/>history<br/>
      <chord name="G/D"/>Your purpose, <chord name="Am"/>Lord, <chord name="Bdim"/>has <chord name="G"/>spanned.
      </lines>
