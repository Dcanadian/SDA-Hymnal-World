<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>495 - Near to the Heart of God</title>
      <title>Near to the Heart of God</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="495"/>
    </songbooks>
    <key>Db</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Db"/>There is a place ofquiet <chord name="Ab7"/>rest,<br/>
      <chord name="Ab7"/>Near to the heart of <chord name="Db"/>God;<br/>
      <chord name="Db"/>A place where sin can <chord name="Ab7/Eb"/>not mo lest,<br/>
      <chord name="Ab7"/>Near to the <chord name="Db/Ab"/>heart <chord name="Ab"/>of <chord name="Db"/>God.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Db"/>O <chord name="Gb"/>Jesus, blest Redeemer,<br/>
      <chord name="Ab"/>sent from the <chord name="Ab7"/>heart of <chord name="Db"/>God,<br/>
      <chord name="Db"/>hold <chord name="Gb"/>us who wait before <chord name="Db"/>thee<br/>
      <chord name="Ab7"/>near to the heart of <chord name="Db"/>God.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Db"/>There is a place of <chord name="Ab7/Eb"/>comfort sweet,<br/>
      <chord name="Ab7"/>near to the heart of <chord name="Db"/>God;<br/>
      <chord name="Db"/>a place where we our <chord name="Ab7/Eb"/>Savior meet,<br/>
      <chord name="Ab7"/>near to the <chord name="Db/Ab"/>heart <chord name="Ab"/>of <chord name="Db"/>God.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Db"/>There is place a place of <chord name="Ab7/Eb"/>full release,<br/>
      <chord name="Ab7"/>near to the heart of <chord name="Db"/>God;<br/>
      <chord name="Db"/>a place where all is <chord name="Ab7/Eb"/>joy and peace,<br/>
      <chord name="Ab7"/>near to the <chord name="Db/Ab"/>heart <chord name="Ab"/>of <chord name="Db"/>God.
      </lines>
    </verse>
  </lyrics>
</song>
