  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>As it <chord name="G"/>fell <chord name="F#m"/>upon <chord name="A"/>a <chord name="Bm"/>night<br/>
      <chord name="D"/>In the winter <chord name="C#dim"/>weather,<br/>
      <chord name="Bm"/>Angels <chord name="A"/>bright <chord name="F#m"/>in <chord name="A"/>starry <chord name="F#m"/>height<br/>
      <chord name="D"/>Began <chord name="F#m"/>to <chord name="A"/>sing <chord name="G"/>together.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>Shepherds <chord name="G"/>sleeping <chord name="D"/>on <chord name="A"/>the <chord name="Bm"/>plain<br/>
      <chord name="D"/>Woke to see <chord name="Em"/>the <chord name="C#dim"/>glory,<br/>
      <chord name="Bm"/>All <chord name="A"/>amazed <chord name="F#m"/>they <chord name="A"/>stood <chord name="G"/>and <chord name="F#m"/>gazed<br/>
      <chord name="D"/>And <chord name="Em"/>heard <chord name="F#m"/>the <chord name="A"/>angels&#x27; <chord name="Em"/>story.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D"/>Unto <chord name="G"/>you <chord name="F#m"/>a <chord name="D"/>child <chord name="A"/>is <chord name="Bm"/>born<br/>
      <chord name="D"/>In a manger <chord name="C#dim"/>lowly,<br/>
      <chord name="Bm"/>Humble, <chord name="A"/>He, <chord name="F#m"/>yet <chord name="A"/>born <chord name="G"/>to <chord name="F#m"/>be<br/>
      <chord name="D"/>The <chord name="Em"/>King <chord name="F#m"/>of <chord name="A"/>Love <chord name="G"/>most <chord name="Em"/>holy.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="D"/>Happy <chord name="G"/>angels <chord name="D"/>from <chord name="A"/>afar,<br/>
      <chord name="D"/>Cease your singing <chord name="C#dim"/>never!<br/>
      <chord name="Bm"/>In <chord name="A"/>excelsis <chord name="G"/>gloria!<br/>
      <chord name="D"/>For <chord name="Em"/>ever <chord name="A"/>and <chord name="G"/>for <chord name="Em"/>ever.
