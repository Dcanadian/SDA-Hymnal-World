<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>052 - Now the Day Is Over</title>
      <title>Now the Day Is Over</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="52"/>
    </songbooks>
    <key>A</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Worship</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="A"/>Now the <chord name="C#m/G#"/>day <chord name="E7/G#"/>is over,<br/>
      <chord name="D/A"/>night is <chord name="C#/G#"/>drawing <chord name="D/A"/>nigh,<br/>
      <chord name="D#dim"/>Shadows <chord name="Bm"/>of <chord name="E/B"/>the <chord name="D/A"/>evening<br/>
      <chord name="A"/>steal <chord name="C#m/G#"/>across the <chord name="A"/>sky.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="A"/>Father, <chord name="C#m/G#"/>give <chord name="E7/G#"/>the weary,<br/>
      <chord name="D/A"/>calm and <chord name="C#/G#"/>sweet <chord name="Bm"/>repose;<br/>
      <chord name="D#dim"/>With Thy <chord name="Bm"/>tenderest <chord name="C#m/G#"/>blessing<br/>
      <chord name="A"/>May <chord name="C#m/G#"/>our <chord name="F#7"/>eyelids <chord name="A"/>close.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="A"/>Through the <chord name="C#m/G#"/>long <chord name="E7/G#"/>night watches,<br/>
      <chord name="D/A"/>may thine <chord name="C#/G#"/>angels <chord name="D/A"/>spread<br/>
      <chord name="D#dim"/>Their <chord name="Bm"/>white <chord name="E/B"/>wings <chord name="D/A"/>above <chord name="A"/>me,<br/>
      <chord name="A"/>watching <chord name="F#7"/>round <chord name="C#m/G#"/>my <chord name="A"/>bed.
      </lines>
    </verse>
  </lyrics>
</song>
