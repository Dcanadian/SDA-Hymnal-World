<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>052 - Now the Day Is Over</title>
      <title>Now the Day Is Over</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="52"/>
    </songbooks>
    <key>C</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Worship</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      Now the day is over,<br/>
      night is drawing nigh,<br/>
      Shadows of the evening<br/>
      steal across the sky.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      Father, give the weary,<br/>
      calm and sweet repose;<br/>
      With Thy tenderest blessing<br/>
      May our eyelids close.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      Through the long night watches,<br/>
      may thine angels spread<br/>
      Their white wings above me,<br/>
      watching round my bed.
      </lines>
    </verse>
  </lyrics>
</song>
