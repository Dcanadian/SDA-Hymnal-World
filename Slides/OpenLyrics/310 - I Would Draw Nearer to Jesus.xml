    </verse>
    <verse name="v2">
      <lines>
      <chord name="Bb"/>I <chord name="F7"/>would draw <chord name="Bb"/>nearer to <chord name="Bbdim6"/>Jesus, <chord name="F7"/>Nothing withholding <chord name="Bb"/>from Him,<br/>
      <chord name="D7"/>Knowing He <chord name="Gm"/>loves to <chord name="C"/>be gracious, <chord name="C7"/>I would <chord name="F"/>draw nearer <chord name="F7"/>to Him.<br/>
      <chord name="Bb"/>I would <chord name="D"/>draw nearer <chord name="Eb"/>to Jesus, I <chord name="C7"/>would draw <chord name="F7"/>nearer to Him;<br/>
      <chord name="Bb"/>Fully <chord name="Eb"/>surrendered each <chord name="Bb"/>moment, I <chord name="F"/>would <chord name="F7"/>draw nearer <chord name="Bb"/>to Him.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Bb"/>I would <chord name="F7"/>draw nearer <chord name="Bb"/>to Jesus, <chord name="Bbdim6"/>Seeking Hi <chord name="F7"/>strength to <chord name="Bb"/>be true,<br/>
      <chord name="D7"/>Willing to <chord name="Gm"/>tell of <chord name="C"/>His goodness, <chord name="C7"/>Gladly His <chord name="F"/>blest will <chord name="F7"/>to do.<br/>
