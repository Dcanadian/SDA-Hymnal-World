  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Bb"/>I would draw <chord name="F7"/>nearer to <chord name="Bb"/>Je<chord name="Bbdim6"/>sus,   <chord name="F7"/>In His sweet presence a<chord name="Bb"/>bide,<br/>
      <chord name="D7"/>Constantly trying to <chord name="Gm"/>serve Him, <chord name="C"/>Safe and se<chord name="C7"/>cure at His <chord name="F"/>si<chord name="F7"/>de.<br/>
