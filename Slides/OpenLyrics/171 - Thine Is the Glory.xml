    <verse name="v2">
      <lines>
      <chord name="Eb"/>Lo! <chord name="Bb"/>Jesus meets <chord name="Bb7"/>us. <chord name="Eb"/>Risen from <chord name="Bb"/>the tomb,<br/>
      <chord name="Eb"/>Lovingly <chord name="Fm"/>He <chord name="Eb"/>greets us, <chord name="Bbsus"/>Scatters <chord name="Bb7"/>fear <chord name="Eb"/>and gloom;<br/>
