    <verse name="v3">
      <lines>
      <chord name="Eb"/>No <chord name="Bb"/>more we <chord name="Bb7"/>doubt Thee, <chord name="Eb"/>Glorious Prince <chord name="Bb"/>of life!<br/>
      <chord name="Eb"/>Life <chord name="Fm"/>is nought <chord name="Eb"/>without Thee; <chord name="Bbsus"/>Aid <chord name="Bb7"/>us in <chord name="Eb"/>our strife;<br/>
      <chord name="Eb"/>Make <chord name="Bdim7"/>us <chord name="Cm"/>more <chord name="Bdim7"/>than <chord name="Cm"/>conquerors <chord name="Bdim7"/>through <chord name="Cm"/>Thy <chord name="G"/>deathless love<br/>
