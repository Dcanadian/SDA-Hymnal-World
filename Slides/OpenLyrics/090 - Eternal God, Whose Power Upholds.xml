  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C"/>Eternal <chord name="F/C"/>God, <chord name="C7/Bb"/>whose power upholds <chord name="F"/>Both <chord name="C/G"/>flower <chord name="Bb"/>and <chord name="F/C"/>flaming <chord name="Gm/D"/>star,<br/>
      <chord name="C7/Bb"/>To whom <chord name="Dm/A"/>there <chord name="C"/>is <chord name="Dm/A"/>no <chord name="Bb"/>here <chord name="F/C"/>nor <chord name="C7/Bb"/>there, No time, no <chord name="F"/>near nor <chord name="C/G"/>far,<br/>
      <chord name="F"/>No alien race, no <chord name="Gm/D"/>foreign <chord name="Dm/A"/>shore, No child <chord name="Am"/>unsought, <chord name="C7"/>unknown:<br/>
      <chord name="C7/Bb"/>Osend <chord name="Am"/>us forth, <chord name="F"/>Your prophets <chord name="C7/Bb"/>true, <chord name="F"/>To make <chord name="Gm/D"/>all <chord name="F"/>lands Your <chord name="C/E"/>own!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="C"/>O <chord name="Dm/A"/>God <chord name="Bb"/>of <chord name="F/C"/>truth, <chord name="C7/Bb"/>whom science seeks <chord name="F"/>And reverent <chord name="Bb"/>souls <chord name="F/C"/>adore,<br/>
      <chord name="C7/Bb"/>Illumine <chord name="C"/>every <chord name="Bb"/>earnest <chord name="C7/Bb"/>mind Of every <chord name="F"/>clime and <chord name="C/G"/>shore:<br/>
      <chord name="F"/>Dispel <chord name="Bb"/>the <chord name="F/C"/>gloom of <chord name="Gm/D"/>error&#x27;s <chord name="Dm/A"/>night, Of ignorance <chord name="C7"/>and fear,<br/>
      <chord name="C7/Bb"/>Until true <chord name="Am"/>wisdom <chord name="F"/>from above <chord name="C7/Bb"/>Shall <chord name="F"/>make life&#x27;s pathway <chord name="C/E"/>clear!
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="C"/>O <chord name="Dm/A"/>God <chord name="Bb"/>of <chord name="F/C"/>beauty, <chord name="C7/Bb"/>oft revealed <chord name="F"/>In <chord name="C/G"/>dreams <chord name="F"/>of <chord name="Bb"/>human <chord name="F/C"/>art,<br/>
      <chord name="C7/Bb"/>In speech <chord name="Dm/A"/>that <chord name="C"/>flows <chord name="Dm/A"/>to <chord name="Bb"/>melody, <chord name="C7/Bb"/>In holiness <chord name="F"/>of <chord name="C/G"/>heart:<br/>
      <chord name="F"/>Teach us <chord name="Bb"/>to <chord name="F/C"/>ban al <chord name="Gm/D"/>ugliness, <chord name="Dm/A"/>And all <chord name="Am"/>disharmony,<br/>
      <chord name="C7/Bb"/>Till all shall <chord name="Am"/>know the <chord name="F"/>loveliness <chord name="C7/Bb"/>Of <chord name="F"/>lives <chord name="Gm/D"/>made <chord name="F"/>fair and <chord name="C/E"/>free!
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="C"/>O <chord name="Dm/A"/>God <chord name="Bb"/>of <chord name="F/C"/>righteousness <chord name="C7"/>and <chord name="F"/>grace, Seen <chord name="C/G"/>in <chord name="F"/>the <chord name="Bb"/>Christ, <chord name="F/C"/>Your Son,<br/>
      <chord name="C7/Bb"/>Whose life <chord name="Dm/A"/>and <chord name="C"/>death <chord name="Dm/A"/>reveal <chord name="F/C"/>Your <chord name="C7/Bb"/>face, By whom Your <chord name="F"/>will was <chord name="C/G"/>done;<br/>
      <chord name="F"/>Help us <chord name="Bb"/>to <chord name="F/C"/>spread Your <chord name="Gm/D"/>gracious <chord name="Dm/A"/>reign Till greed <chord name="Am"/>and <chord name="F"/>hate <chord name="C7"/>shall cease,<br/>
      <chord name="C7/Bb"/>And kindness <chord name="Am"/>dwell <chord name="F"/>in human <chord name="C7/Bb"/>hearts, <chord name="F"/>And all <chord name="Gm/D"/>the <chord name="F"/>earth find <chord name="C/E"/>peace!
      </lines>
