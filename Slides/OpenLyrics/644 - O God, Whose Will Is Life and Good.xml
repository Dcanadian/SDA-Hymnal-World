<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>644 - O God, Whose Will Is Life and Good</title>
      <title>O God, Whose Will Is Life and Good</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="644"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C7/E"/>O God, <chord name="F"/>whose will is <chord name="C7/Bb"/>life <chord name="Bb"/>and good<br/>
      <chord name="F/C"/>For all <chord name="C7/Bb"/>of mortal <chord name="F/A"/>breath:<br/>
      <chord name="Gm"/>Unite <chord name="F"/>in bonds <chord name="Dm"/>of <chord name="C7/E"/>servanthood<br/>
      <chord name="C"/>All those who strive with death.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="C7/E"/>Make strong <chord name="F"/>their hands and <chord name="C7/Bb"/>hearts <chord name="Bb"/>and wills<br/>
      <chord name="F/C"/>To drive <chord name="C7/Bb"/>disease <chord name="F/A"/>afar,<br/>
      <chord name="Gm"/>To <chord name="F"/>strive against <chord name="Dm"/>the <chord name="C7/E"/>body&#x27;s <chord name="F/C"/>ills<br/>
      <chord name="C"/>And wage Your healing war.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="C7/E"/>By healing <chord name="F"/>of the <chord name="C7/Bb"/>sick <chord name="Bb"/>and blind,<br/>
      <chord name="F/C"/>Christ&#x27;s mercy <chord name="C7/Bb"/>they <chord name="F/A"/>proclaim,<br/>
      <chord name="Gm"/>Make <chord name="F"/>known the great <chord name="Dm"/>physician&#x27;s <chord name="F/C"/>mind,<br/>
      <chord name="C"/>Affirm the Savior&#x27;s name.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="C7/E"/>Before <chord name="F"/>them set Your <chord name="C7/Bb"/>gracious <chord name="Bb/D"/>will,<br/>
      <chord name="F/C"/>That they, <chord name="C7/Bb"/>with heart <chord name="F/A"/>and soul,<br/>
      <chord name="Gm"/>To <chord name="F"/>You may consecrate their skill<br/>
      <chord name="C"/>And make the sufferer whole.
      </lines>
    </verse>
  </lyrics>
</song>
