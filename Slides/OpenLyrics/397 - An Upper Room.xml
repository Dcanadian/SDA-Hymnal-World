  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>An <chord name="Em"/>upper room <chord name="Bm"/>did <chord name="Am/C"/>our <chord name="D"/>Lord <chord name="Em"/>prepare<br/>
      <chord name="G"/>For those <chord name="Bm"/>loved <chord name="Em"/>until <chord name="Am"/>the end:<br/>
      <chord name="Em"/>And <chord name="D"/>His <chord name="C"/>disciples <chord name="D7/F#"/>still <chord name="G"/>gather <chord name="Em"/>there,<br/>
      <chord name="D"/>To <chord name="Em"/>celebrate their <chord name="D"/>risen Friend.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>And <chord name="Em"/>after supper <chord name="Am/C"/>He <chord name="D"/>washed <chord name="Em"/>their <chord name="Am/C"/>feet,<br/>
      <chord name="G"/>For service, <chord name="Em"/>too, <chord name="C"/>is <chord name="Am"/>sacrament.<br/>
      <chord name="Em"/>In <chord name="D"/>Him <chord name="C"/>our joy <chord name="Bm"/>shall <chord name="D7/F#"/>be <chord name="G"/>made <chord name="Em"/>complete<br/>
      <chord name="D"/>Sent <chord name="Em"/>out <chord name="Am"/>to <chord name="Bm"/>serve, <chord name="Em"/>as <chord name="D"/>He was sent.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D"/>A <chord name="Em"/>lasting gift <chord name="Bm"/>Jesus <chord name="D"/>gave <chord name="Em"/>His <chord name="Am/C"/>own:<br/>
      <chord name="G"/>To share <chord name="Bm"/>His <chord name="Em"/>bread, <chord name="C"/>His <chord name="Am"/>loving cup.<br/>
      <chord name="Em"/>Whatever <chord name="C"/>burdens <chord name="D7/F#"/>may <chord name="G"/>bow <chord name="Em"/>us down,<br/>
      <chord name="D"/>He <chord name="Em"/>by <chord name="Am"/>His <chord name="Bm"/>cross <chord name="Em"/>shall <chord name="D"/>lift us up.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="D"/>No <chord name="Em"/>end there is! <chord name="Bm"/>we <chord name="Am/C"/>depart <chord name="Em"/>in <chord name="Am/C"/>peace.<br/>
      <chord name="G"/>He loves <chord name="Em"/>beyond <chord name="C"/>our <chord name="Am"/>uttermost:<br/>
      <chord name="Em"/>In <chord name="D"/>every <chord name="Bm"/>room <chord name="C/E"/>in <chord name="D7/F#"/>our <chord name="G"/>Father&#x27;s <chord name="Em"/>house,<br/>
      <chord name="D"/>He <chord name="Em"/>will <chord name="Am"/>be <chord name="Bm"/>there, <chord name="Em"/>as <chord name="D"/>Lord and host.
      </lines>
