  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Bb"/>Re<chord name="Eb"/>deemed, how I <chord name="Gm"/>love to pro<chord name="Cm"/>claim it!<br/>
      <chord name="Cm7"/>Re<chord name="Fm"/>deemed <chord name="Bb7"/>by  the <chord name="Cm7"/>blood of the <chord name="Ab2"/>Lamb<chord name="Ab"/>;<br/>
      <chord name="Ab2"/>Re<chord name="Cm"/>deemed <chord name="Cm7"/>thro&#x27; His <chord name="Gm"/>infinite <chord name="Cm"/>mercy,<br/>
      <chord name="Cm7"/>His <chord name="Ab"/>child, and for<chord name="Fm"/>ever, I <chord name="Ab"/>am.<chord name="Eb"/><br/>
      Eb Ab Fm   Bb7 Gm7 Eb<br/>
      Re-deemed, re- deemed,<br/>
      <chord name="Bb7"/>Re<chord name="Cm"/>deemed by the <chord name="F7"/>blood of the <chord name="Bb"/>Lam<chord name="Bb7"/>b;<br/>
      <chord name="Bb7"/>Re<chord name="Eb"/>deemed, <chord name="Fm7"/>how I <chord name="Gm"/>love to pro<chord name="G7"/>claim it!<br/>
      <chord name="G7"/>His <chord name="Ab"/>child and for<chord name="Fm7"/>ever I <chord name="Eb"/>am.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Bb"/><chord name="Eb"/>Redeemed, <chord name="Gm"/><chord name="Cm"/>redeemed,<br/>
      <chord name="Cm7"/>Redeemed <chord name="Fm"/>by <chord name="Bb7"/>the <chord name="Cm7"/>blood <chord name="Ab2"/>of <chord name="Ab"/>the Lamb;<br/>
      <chord name="Ab2"/>Redeemed, <chord name="Cm"/>how <chord name="Cm7"/>I love <chord name="Gm"/>to <chord name="Cm"/>proclaim it!<br/>
      <chord name="Cm7"/>His <chord name="Ab"/>child <chord name="Fm"/>and <chord name="Ab"/>forever <chord name="Eb"/>I am.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Bb"/>I <chord name="Eb"/>think of <chord name="Gm"/>my <chord name="Cm"/>blessed Redeemer,<br/>
      <chord name="Cm7"/>I <chord name="Fm"/>think <chord name="Bb7"/>of Him <chord name="Cm7"/>all <chord name="Ab2"/>the <chord name="Ab"/>day long;<br/>
      <chord name="Ab2"/>I <chord name="Cm"/>sing, <chord name="Cm7"/>for I <chord name="Gm"/>cannot <chord name="Cm"/>be silent;<br/>
      <chord name="Cm7"/>His <chord name="Ab"/>love is <chord name="Fm"/>the <chord name="Ab"/>theme of <chord name="Eb"/>my song.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Bb"/>I know <chord name="Eb"/>I shall <chord name="Gm"/>see in <chord name="Cm"/>His beauty<br/>
      <chord name="Cm7"/>The <chord name="Fm"/>King <chord name="Bb7"/>in <chord name="Cm7"/>whose <chord name="Ab2"/>law <chord name="Ab"/>I delight,<br/>
      <chord name="Ab2"/>Who <chord name="Cm"/>lovingly <chord name="Cm7"/>guardeth <chord name="Gm"/>my <chord name="Cm"/>footsteps,<br/>
      <chord name="Cm7"/>And <chord name="Ab"/>giveth <chord name="Fm"/>me songs <chord name="Ab"/>in <chord name="Eb"/>the night.
      </lines>
    </verse>
