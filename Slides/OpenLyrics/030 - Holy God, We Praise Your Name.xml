<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>030 - Holy God, We Praise Your Name</title>
      <title>Holy God, We Praise Your Name</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="30"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Worship</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Holy God, <chord name="Edim"/>we <chord name="Gm"/>praise <chord name="Am"/>Your <chord name="Gm"/>name;<br/>
      <chord name="Am"/>Lord of all, <chord name="C/G"/>we bow <chord name="Bb"/>before <chord name="Am"/>You!<br/>
      <chord name="F"/>All on earth <chord name="Edim"/>Your <chord name="Gm"/>scepter claim,<br/>
      <chord name="Am"/>All in heaven above <chord name="Bb"/>adore <chord name="Am"/>You;<br/>
      <chord name="Gm"/>Infinite <chord name="Am"/>Your <chord name="Gm"/>vast <chord name="Am"/>domain.<br/>
      <chord name="Dm"/>Everlasting <chord name="Bb"/>is <chord name="Am"/>Your <chord name="Gm"/>reign.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>Hark! the loud <chord name="Edim"/>celestial <chord name="Gm"/>hymn<br/>
      <chord name="Am"/>Angel choirs <chord name="C/G"/>above <chord name="Bb"/>are <chord name="Am"/>raising,<br/>
      <chord name="F"/>Cherubim <chord name="Edim"/>and <chord name="Gm"/>seraphim,<br/>
      <chord name="Am"/>In unceasing chorus praising;<br/>
      <chord name="Gm"/>Fill <chord name="Am"/>the <chord name="Bb"/>heavens <chord name="Gm"/>with <chord name="Am"/>sweet <chord name="Bb"/>accord:<br/>
      <chord name="Dm"/>Holy, <chord name="C"/>holy, <chord name="Bb"/>holy, <chord name="Gm"/>Lord.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>Holy Father, <chord name="Gm"/>Holy Son,<br/>
      <chord name="Am"/>Holy Spirit, <chord name="C"/>three <chord name="Bb"/>we <chord name="Am"/>name You;<br/>
      <chord name="F"/>While in <chord name="Edim"/>essence <chord name="Gm"/>only one,<br/>
      <chord name="Am"/>Undivided God <chord name="Bb"/>we <chord name="Am"/>claim You;<br/>
      <chord name="Gm"/>And <chord name="Am"/>adoring <chord name="Gm"/>bend <chord name="Am"/>the <chord name="Bb"/>knee,<br/>
      <chord name="Dm"/>While <chord name="C"/>we <chord name="Bb"/>own <chord name="Am"/>the <chord name="Bb"/>mystery.
      </lines>
    </verse>
  </lyrics>
</song>
