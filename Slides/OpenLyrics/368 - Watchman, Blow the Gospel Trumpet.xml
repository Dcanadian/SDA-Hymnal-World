  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Ab/Eb"/>Watchman, <chord name="Eb"/>blow the gospel <chord name="Cm"/>trumpet, <chord name="Ab"/>Every <chord name="Db/Ab"/>soul <chord name="Bbm"/>a warning <chord name="Fm"/>give;<br/>
      <chord name="Gdim"/>Whosoever <chord name="Ab/Eb"/>hears <chord name="Eb"/>the message May repent, <chord name="Cm"/>and, turn and live.<br/>
      <chord name="Ab/Eb"/>Blow the trumpet, <chord name="Gdim"/>trusty watchman, <chord name="Eb/G"/>Blow it loud o&#x27;er land and sea;<br/>
      <chord name="Bbm"/>God commissions, <chord name="Eb/G"/>sound <chord name="Eb7"/>the mes <chord name="Fm/C"/>sage! <chord name="Ab"/>Every captive <chord name="Fm"/>may befree.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Cm/G"/>Blow the trumpet, <chord name="Fm/Ab"/>trusty <chord name="Cm/G"/>watchman,<br/>
      <chord name="Ab"/>Blow it loud <chord name="Eb"/>o&#x27;er land <chord name="Ab"/>and sea;<br/>
      <chord name="Ab"/>God commissions, sound the message!<br/>
      <chord name="Ab"/>Every captive may be free.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Ab/Eb"/>Sound <chord name="Eb"/>it loud <chord name="Cm"/>o&#x27;r <chord name="Ab/Eb"/>every <chord name="Bbm"/>hilltop,<br/>
      <chord name="Gdim"/>Gloomy <chord name="Eb"/>shade and sunny <chord name="Cm"/>plain;<br/>
      <chord name="Ab/Eb"/>Ocean <chord name="Gdim"/>depths repeat <chord name="Eb/G"/>the message,<br/>
      <chord name="Bbm"/>Full <chord name="Eb/G"/>salvation&#x27;s <chord name="Ab"/>glad <chord name="Fm"/>refrain.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Ab/Eb"/>Sound <chord name="Eb"/>it in <chord name="Cm"/>the <chord name="Ab"/>hedge <chord name="Db/Ab"/>and <chord name="Bbm"/>highway,<br/>
      <chord name="Gdim"/>Earth&#x27;s dark <chord name="Ab/Eb"/>spots <chord name="Eb"/>where exiles <chord name="Cm"/>roam;<br/>
      <chord name="Ab/Eb"/>Let it <chord name="Gdim"/>tell all <chord name="Eb/G"/>things are ready,<br/>
      <chord name="Bbm"/>Father <chord name="Eb7"/>waits <chord name="Fm/C"/>to <chord name="Ab"/>welcome <chord name="Fm"/>home.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Ab/Eb"/>Sound <chord name="Eb"/>it for <chord name="Cm"/>the <chord name="Ab"/>heavy <chord name="Bbm"/>laden,<br/>
      <chord name="Gdim"/>Weary, <chord name="Eb"/>longing to <chord name="Cm"/>be free;<br/>
      <chord name="Ab/Eb"/>Sound a <chord name="Gdim"/>Savior&#x27;s <chord name="Eb/G"/>invitation,<br/>
      <chord name="Bbm"/>Sweetly <chord name="Eb7"/>saying, <chord name="Ab"/>&quot;Come to <chord name="Fm"/>me.&quot;
      </lines>
    </verse>
  </lyrics>
</song>
