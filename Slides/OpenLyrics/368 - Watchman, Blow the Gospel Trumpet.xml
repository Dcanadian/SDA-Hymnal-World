  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Ab"/>Watchman, blow the gospel trumpet, <chord name="Db"/>Every <chord name="Bb"/>soul a warning <chord name="Eb"/>give;<br/>
      <chord name="Ab"/>Whosoever hears the message <chord name="Eb"/>May repent, and, <chord name="Bb"/>turn and <chord name="Eb"/>live.<br/>
      <chord name="Db7"/>Blow the trumpet, trusty <chord name="Ab"/>watchman, <chord name="Fm"/>Blow it <chord name="Db"/>loud o&#x27;er land and <chord name="C"/>sea;<br/>
      <chord name="Ab"/>God commissions, sound the mes<chord name="Ab7"/> <chord name="Db"/>sage! Every captive <chord name="Ab"/>may <chord name="Eb7"/>be<chord name="Ab"/>free.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Ab"/>Blow <chord name="Db"/>the <chord name="Bb"/>trumpet, <chord name="Eb"/>trusty watchman,<br/>
      <chord name="Ab"/>Blow <chord name="Eb"/>it loud <chord name="Bb"/>o&#x27;er land <chord name="Eb"/>and sea;<br/>
      <chord name="Db7"/>God <chord name="Ab"/>commissions, <chord name="Fm"/>sound <chord name="Db"/>the <chord name="C"/>message!<br/>
      <chord name="Ab"/><chord name="Ab7"/>Every <chord name="Db"/>captive <chord name="Ab"/>may <chord name="Eb7"/>be <chord name="Ab"/>free.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Ab"/>Sound <chord name="Db"/>it loud <chord name="Bb"/>o&#x27;r <chord name="Eb"/>every hilltop,<br/>
      <chord name="Ab"/>Gloomy <chord name="Eb"/>shade <chord name="Bb"/>and <chord name="Eb"/>sunny plain;<br/>
      <chord name="Db7"/>Ocean <chord name="Ab"/>depths <chord name="Fm"/>repeat <chord name="Db"/>the <chord name="C"/>message,<br/>
      <chord name="Ab"/><chord name="Ab7"/>Full <chord name="Db"/>salvation&#x27;s <chord name="Ab"/><chord name="Eb7"/>glad <chord name="Ab"/>refrain.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Ab"/>Sound <chord name="Db"/>it in <chord name="Bb"/>the hedge <chord name="Eb"/>and highway,<br/>
      <chord name="Ab"/>Earth&#x27;s <chord name="Eb"/>dark spots <chord name="Bb"/>where <chord name="Eb"/>exiles roam;<br/>
      <chord name="Db7"/>Let <chord name="Ab"/>it <chord name="Fm"/>tell all <chord name="Db"/>things <chord name="C"/>are ready,<br/>
      <chord name="Ab"/><chord name="Ab7"/>Father <chord name="Db"/>waits <chord name="Ab"/>to <chord name="Eb7"/>welcome <chord name="Ab"/>home.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Ab"/>Sound <chord name="Db"/>it for <chord name="Bb"/>the <chord name="Eb"/>heavy laden,<br/>
      <chord name="Ab"/>Weary, <chord name="Eb"/>longing <chord name="Bb"/>to <chord name="Eb"/>be free;<br/>
      <chord name="Db7"/><chord name="Ab"/>Sound <chord name="Fm"/>a <chord name="Db"/>Savior&#x27;s <chord name="C"/>invitation,<br/>
      <chord name="Ab"/><chord name="Ab7"/>Sweetly <chord name="Db"/>saying, <chord name="Ab"/>&quot;Come <chord name="Eb7"/>to <chord name="Ab"/>me.&quot;
      </lines>
    </verse>
  </lyrics>
