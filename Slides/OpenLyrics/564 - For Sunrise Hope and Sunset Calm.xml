  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C/E"/>For <chord name="Dm"/>sunrise <chord name="C"/>hope and <chord name="Dm"/>sunset <chord name="G"/>calm,<br/>
      <chord name="C/E"/>And allthat <chord name="Dm"/>liesbetween,<br/>
      <chord name="G7"/>For all <chord name="C"/>the sweetness <chord name="G"/>and the <chord name="C"/>balm<br/>
      <chord name="C/E"/>That <chord name="Dm"/>isand <chord name="G"/>thathas <chord name="C"/>been,<br/>
      <chord name="C/E"/>For <chord name="F"/>comradeship <chord name="C/E"/>for <chord name="G/D"/>peace in <chord name="Am"/>strife,<br/>
      <chord name="Dm"/>And light <chord name="G"/>on darkened <chord name="Am"/>days;<br/>
      <chord name="Dm"/>For work <chord name="G"/>to doand <chord name="Am"/>strength <chord name="Dm"/>for <chord name="G"/>life<br/>
      <chord name="G7/D"/>We sing our <chord name="C"/>hymn of praise.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="C/E"/>But O, <chord name="Dm"/>we <chord name="G"/>press far, far <chord name="C"/>above <chord name="Dm"/>these gifts of <chord name="G"/>pure delight,<br/>
      <chord name="G7"/>And find <chord name="C"/>in Thee, and in <chord name="Dm"/>Thy love <chord name="G"/>contentment infinite.<br/>
      <chord name="Dm"/>O Lord, beloved, <chord name="G"/>in whom are found all <chord name="Am"/>joys of time and place,<br/>
      <chord name="G7/D"/>What will it be when joy is <chord name="C"/>crowned by vision of Thy face?
      </lines>
    </verse>
  </lyrics>
