<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>260 - Hover O&#x27;er Me, Holy Spirit</title>
      <title>Hover O&#x27;er Me, Holy Spirit</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="260"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Holy Spirit</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F/C"/>Hover o&#x27;er <chord name="Gm/Bb"/>me, Holy <chord name="F"/>Spirit, <chord name="Dm/F"/>Bathe my <chord name="Gm/Bb"/>trembling <chord name="F/C"/>heart <chord name="C7"/>and brow;<br/>
      <chord name="Bb"/>Fill me <chord name="C"/>with Thy <chord name="F/C"/>hallowed <chord name="C"/>presence, <chord name="F/C"/>Come, O <chord name="Gm/Bb"/>come and <chord name="Dm/A"/>fill me <chord name="F"/>now.<br/>
      <chord name="Dm/F"/>Fill me now, <chord name="Gm/Bb"/>fill <chord name="F/C"/>me now, <chord name="C7"/>Jesus, <chord name="F/C"/>come and <chord name="Gm/Bb"/>fill <chord name="Dm/A"/>me now.<br/>
      <chord name="C"/>Fill me with Thy hallowed <chord name="F/C"/>presence, Come, <chord name="Am"/>O <chord name="Bb"/>come and fill me <chord name="C"/>now.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="F/C"/>Fill me <chord name="C"/>now, <chord name="F/C"/>fill me <chord name="C"/>now,<br/>
      <chord name="F/C"/>Jesus, come <chord name="Gm/Bb"/>and fill <chord name="Dm/A"/>me <chord name="F"/>now.<br/>
      <chord name="Dm/F"/>Fill me with <chord name="Gm/Bb"/>Thy <chord name="F/C"/>hallowed <chord name="C7"/>presence,<br/>
      <chord name="F/C"/>Come, O <chord name="Gm/Bb"/>come and <chord name="Dm/A"/>fill me now.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F/C"/>Thou canst <chord name="Gm/Bb"/>fill <chord name="F"/>me, <chord name="Dm/F"/>gracious <chord name="F/C"/>Spirit,<br/>
      <chord name="Bb"/>Though <chord name="C"/>I <chord name="F/C"/>cannot tell <chord name="Gm/Bb"/>Thee <chord name="Dm/A"/>how;<br/>
      <chord name="Dm/F"/>But I <chord name="Gm/Bb"/>need <chord name="F/C"/>Thee, <chord name="C7"/>greatly <chord name="Gm/Bb"/>need <chord name="Dm/A"/>Thee;<br/>
      <chord name="C"/>Come, O come <chord name="F/C"/>and <chord name="Am"/>fill <chord name="Bb"/>me now.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F/C"/>I am <chord name="Gm/Bb"/>weakness, <chord name="Dm/F"/>full of <chord name="F/C"/>weakness;<br/>
      <chord name="Bb"/>At <chord name="C"/>Thy sacred <chord name="F/C"/>feet <chord name="Gm/Bb"/>I <chord name="Dm/A"/>bow;<br/>
      <chord name="Dm/F"/>Blest, divine, <chord name="F/C"/>eternal <chord name="Gm/Bb"/>Spirit,<br/>
      <chord name="C"/>Fill with love, <chord name="F/C"/>and <chord name="Am"/>fill <chord name="Bb"/>me now.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F/C"/>Cleanse and <chord name="Gm/Bb"/>comfort, <chord name="Dm/F"/>bless and <chord name="F/C"/>save <chord name="C7"/>me;<br/>
      <chord name="Bb"/>Bathe, <chord name="C"/>O, <chord name="F/C"/>bathe <chord name="C"/>my <chord name="F/C"/>heart <chord name="Gm/Bb"/>and <chord name="Dm/A"/>brow;<br/>
      <chord name="Dm/F"/>Thou art <chord name="Gm/Bb"/>comforting <chord name="F/C"/>and <chord name="Gm/Bb"/>saving,<br/>
      <chord name="C"/>Thou art sweetly <chord name="Am"/>filling <chord name="Bb"/>now.
      </lines>
    </verse>
  </lyrics>
</song>
