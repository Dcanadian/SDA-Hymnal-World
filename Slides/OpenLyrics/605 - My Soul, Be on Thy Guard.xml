<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>605 - My Soul, Be on Thy Guard</title>
      <title>My Soul, Be on Thy Guard</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="605"/>
    </songbooks>
    <key>Bb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Bb"/>My soul, be on they guard!<br/>
      <chord name="Bb"/>Ten <chord name="F"/>thousand foes <chord name="Eb/Bb"/>arise;<br/>
      <chord name="Bb"/>The hosts <chord name="F"/>of <chord name="Bb"/>sin are <chord name="F/C"/>pressing <chord name="Bb"/>hard<br/>
      <chord name="Adim"/>To <chord name="Bb"/>draw thee <chord name="Dm/A"/>from <chord name="F"/>the <chord name="Bb/F"/>skies.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Bb"/>O watch, and fight, and pray!<br/>
      <chord name="Bb"/>The <chord name="F"/>battle ne&#x27;er <chord name="Eb/Bb"/>give <chord name="Dm/A"/>o&#x27;er;<br/>
      <chord name="Bb"/>Renew <chord name="F"/>it <chord name="Bb"/>boldly every day,<br/>
      <chord name="Adim"/>And <chord name="Bb"/>help divine <chord name="F"/>implore.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Bb"/>Ne&#x27;er think the victory won,<br/>
      <chord name="Bb"/>Nor <chord name="F"/>lay <chord name="Bb/F"/>thine <chord name="F"/>armor <chord name="Dm/A"/>down;<br/>
      <chord name="Bb"/>Thy arduous task will <chord name="F/C"/>not <chord name="Bb"/>be done<br/>
      <chord name="Adim"/>Till <chord name="Bb"/>thou obtain <chord name="F"/>the <chord name="Bb/F"/>crown.
      </lines>
    </verse>
  </lyrics>
</song>
