<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>352 - This Is My Will</title>
      <title>This Is My Will</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="352"/>
    </songbooks>
    <key>Eb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Christian Church</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb"/>This is <chord name="Ab/Eb"/>My will, <chord name="Eb"/>My <chord name="Bb7"/>one command,<br/>
      <chord name="Eb/Bb"/>That <chord name="Bb7/Ab"/>love <chord name="Fm/Ab"/>should <chord name="Eb/G"/>dwell among <chord name="Cm"/>you <chord name="Bb"/>all.<br/>
      <chord name="Eb"/>This <chord name="Cm"/>is <chord name="Bb"/>My <chord name="Ab"/>will that you <chord name="Bb7"/>should love<br/>
      <chord name="Gm"/>As <chord name="Fm/Ab"/>I <chord name="Gm"/>have <chord name="Cm"/>shown <chord name="Gm"/>that <chord name="Fm/Ab"/>I <chord name="Bb7"/>love <chord name="Eb"/>you.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Eb"/>No greater <chord name="Ab/Eb"/>love <chord name="Eb"/>a <chord name="Bb7"/>man can <chord name="Ab/C"/>have<br/>
      <chord name="Eb/Bb"/>Than <chord name="Bb7/Ab"/>that <chord name="Fm/Ab"/>he <chord name="Eb/G"/>die to <chord name="Ddim"/>save <chord name="Cm"/>his <chord name="Bb"/>friends.<br/>
      <chord name="Eb"/>You <chord name="Cm"/>are <chord name="Bb"/>My <chord name="Ab"/>friends if you <chord name="Bb7"/>obey<br/>
      <chord name="Gm"/>What <chord name="Fm/Ab"/>I <chord name="Gm"/>command that <chord name="Fm/Ab"/>you <chord name="Bb7"/>should <chord name="Eb"/>do.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Eb"/>You chose <chord name="Ab/Eb"/>not Me, <chord name="Eb"/>but <chord name="Bb7"/>I chose <chord name="Ab/C"/>you<br/>
      <chord name="Eb/Bb"/>That <chord name="Bb7/Ab"/>you <chord name="Fm/Ab"/>should <chord name="Eb/G"/>go and <chord name="Ddim"/>bear <chord name="Cm"/>much <chord name="Bb"/>fruit.<br/>
      <chord name="Eb"/>I <chord name="Cm"/>chose <chord name="Bb"/>you <chord name="Ab"/>out that you <chord name="Bb7"/>in Me<br/>
      <chord name="Gm"/>Should <chord name="Fm/Ab"/>bear <chord name="Gm"/>much <chord name="Cm"/>fruit <chord name="Gm"/>that <chord name="Fm/Ab"/>will <chord name="Bb7"/>abide.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Eb"/>All that <chord name="Ab/Eb"/>I ask <chord name="Eb"/>My <chord name="Bb7"/>Father, <chord name="Ab/C"/>dear,<br/>
      <chord name="Eb/Bb"/>For My <chord name="Bb7/Ab"/>name&#x27;s <chord name="Eb/G"/>sake you <chord name="Ddim"/>shall <chord name="Cm"/>receive.<br/>
      <chord name="Eb"/>This <chord name="Cm"/>is <chord name="Bb"/>My <chord name="Ab"/>will, My one <chord name="Bb7"/>command,<br/>
      <chord name="Gm"/>That <chord name="Fm/Ab"/>love <chord name="Gm"/>should <chord name="Cm"/>dwell <chord name="Gm"/>in <chord name="Fm/Ab"/>each, <chord name="Bb7"/>in <chord name="Eb"/>all.
      </lines>
    </verse>
  </lyrics>
</song>
