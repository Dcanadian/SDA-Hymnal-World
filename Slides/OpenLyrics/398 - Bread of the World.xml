<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>398 - Bread of the World</title>
      <title>Bread of the World</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="398"/>
    </songbooks>
    <key>C</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2</verseOrder>
    <themes>
      <theme>Doctrines</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      Bread of the world in mercy broken,<br/>
      Wine of the soul in mercy shed,<br/>
      By whom the words of life are spoken,<br/>
      And in whose death our sins are dead;
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      Look on the heart by sorrow broken,<br/>
      Look on the tears by sinners shed;<br/>
      And be Thy feast to us the token<br/>
      That by Thy grace our souls are fed. Amen.
      </lines>
    </verse>
  </lyrics>
</song>
