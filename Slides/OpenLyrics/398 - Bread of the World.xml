<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>398 - Bread of the World</title>
      <title>Bread of the World</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="398"/>
    </songbooks>
    <key>Eb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2</verseOrder>
    <themes>
      <theme>Doctrines</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb"/>Bread of the <chord name="Ab/C"/>world <chord name="Eb/Bb"/>in <chord name="Ab"/>mercy <chord name="Bb"/>broken,<br/>
      <chord name="Cm"/>Wine of the <chord name="Gm"/>soul in <chord name="Ab"/>mercy <chord name="Eb"/>shed,<br/>
      <chord name="Eb"/>By whom the <chord name="Ab/C"/>words <chord name="Eb/Bb"/>of <chord name="Ab"/>life are <chord name="Bb"/>spoken,<br/>
      <chord name="Ab"/>And in whose <chord name="Eb/Bb"/>death our <chord name="Bb7"/>sins are dead;
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Eb"/>Look on the <chord name="Ab/C"/>heart <chord name="Eb/Bb"/>by <chord name="Ab"/>sorrow <chord name="Bb"/>broken,<br/>
      <chord name="Cm"/>Look on the <chord name="Gm"/>tears by <chord name="Ab"/>sinners <chord name="Eb"/>shed;<br/>
      <chord name="Eb"/>And be Thy <chord name="Ab/C"/>feast <chord name="Eb/Bb"/>to <chord name="Ab"/>us the <chord name="Bb"/>token<br/>
      <chord name="Ab"/>That by Thy grace <chord name="Eb/Bb"/>our souls <chord name="Bb7"/>are fed. Amen.
      </lines>
    </verse>
  </lyrics>
</song>
