  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C"/>You <chord name="Em/G"/>that <chord name="Am"/>know <chord name="C/G"/>the <chord name="F"/>Lord <chord name="G7/F"/>is <chord name="Am"/>gracious,<br/>
      <chord name="Am"/>You for <chord name="Dm"/>whom a <chord name="Em"/>cornerstone<br/>
      <chord name="Em"/>Stands, of <chord name="Am"/>God <chord name="C/G"/>elect <chord name="G7/F"/>and <chord name="Am"/>precious,<br/>
      <chord name="Am"/>Laid that <chord name="Dm"/>you may <chord name="Em"/>build <chord name="F"/>there-on,<br/>
      <chord name="A#"/>See <chord name="C/G"/>that <chord name="Dm"/>on that <chord name="A#"/>sure <chord name="G7"/>foundation<br/>
      <chord name="G"/>You <chord name="Am/E"/>a <chord name="G7/D"/>living <chord name="Bdim"/>temple <chord name="Em"/>raise.<br/>
      <chord name="C/E"/>Towers <chord name="Am"/>that <chord name="C"/>may <chord name="Dm"/>tell <chord name="C/E"/>forth <chord name="F"/>salvation,<br/>
      <chord name="C/E"/>Walls that <chord name="F"/>may <chord name="C/G"/>reech-o praise.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="C"/>Living <chord name="Am"/>stones <chord name="F"/>by <chord name="G7/F"/>God <chord name="Am"/>appointed<br/>
      <chord name="Am"/>Each to <chord name="Dm"/>his allotted <chord name="F"/>place,<br/>
      <chord name="Em"/>Kings and <chord name="Am"/>priests, <chord name="C/G"/>by <chord name="F"/>God <chord name="G7/F"/>anointed,<br/>
      <chord name="Am"/>Shall you <chord name="Dm"/>not declare <chord name="F"/>His grace?<br/>
      <chord name="A#"/>You, <chord name="C/G"/>a <chord name="Dm"/>royal generation,<br/>
      <chord name="G"/>Tell <chord name="Am/E"/>the <chord name="G7/D"/>tidings <chord name="Bdim"/>of <chord name="C"/>your <chord name="Em"/>birth,<br/>
      <chord name="C/E"/>Tidings of <chord name="Dm"/>a <chord name="C/G"/>new <chord name="Dm"/>creation<br/>
      <chord name="C/E"/>To an <chord name="F"/>old <chord name="C/G"/>and weary earth.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="C"/>Tell <chord name="Em/G"/>the <chord name="Am"/>praise <chord name="C/G"/>of <chord name="F"/>Him <chord name="G7/F"/>who <chord name="Am"/>called <chord name="F/C"/>you<br/>
      <chord name="Am"/>Out of <chord name="Dm"/>darkness <chord name="Em"/>into <chord name="F"/>light,<br/>
      <chord name="Em"/>Broke the <chord name="Am"/>fetters <chord name="F"/>that <chord name="G7/F"/>enthralled <chord name="F/C"/>you,<br/>
      <chord name="Am"/>Gave you <chord name="Dm"/>freedom, <chord name="Em"/>peace, <chord name="F"/>and sight:<br/>
      <chord name="A#"/>Tell <chord name="C/G"/>the <chord name="Dm"/>tale <chord name="A#"/>of <chord name="G7"/>sins <chord name="C"/>forgiven,<br/>
      <chord name="G"/>Strength <chord name="Am/E"/>renewed <chord name="F/C"/>and <chord name="Bdim"/>hope <chord name="C"/>restored,<br/>
      <chord name="C/E"/>Till the <chord name="Am"/>earth, <chord name="Dm"/>in <chord name="C/E"/>tune with <chord name="Dm"/>heaven,<br/>
      <chord name="C/E"/>Praise and <chord name="F"/>magnify <chord name="G7"/>the <chord name="C"/>Lord.
      </lines>
    </verse>
