    <verse name="v3">
      <lines>
      <chord name="Bb"/>Show <chord name="Gm/Bb"/>us <chord name="Bb"/>Your <chord name="Eb/Bb"/>Spirit, <chord name="Bb"/>brooding <chord name="F/A"/>o&#x27;er each <chord name="Gm"/>city,<br/>
