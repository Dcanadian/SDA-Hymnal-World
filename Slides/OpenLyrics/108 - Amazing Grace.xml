    </verse>
    <verse name="v3">
      <lines>
      <chord name="C7"/><chord name="F"/>The <chord name="F7"/><chord name="Bb"/>Lord <chord name="F"/>has <chord name="C7"/><chord name="F"/>promised <chord name="G7"/>good <chord name="C"/><chord name="F"/>to <chord name="C"/>me,<br/>
