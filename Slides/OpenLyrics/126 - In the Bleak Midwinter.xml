      <title>126 - In the Bleak Midwinter</title>
      <title>In the Bleak Midwinter</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="126"/>
    </songbooks>
    <key>Eb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Jesus Christ</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb"/>In the <chord name="Ab/Eb"/>bleak <chord name="Bb"/>midwinter <chord name="Bb7"/>Frosty <chord name="Db"/>wind <chord name="Cm"/>made <chord name="Db"/>moan;<br/>
      <chord name="Eb"/>Earth stood hard as <chord name="Ab/Eb"/>iron, <chord name="Bb"/>Water <chord name="Fm"/>like a <chord name="Gm"/>stone;<br/>
      <chord name="Ab"/>Snow had <chord name="Gm"/>fallen, <chord name="Bb7"/>snow <chord name="Eb"/>on snow, <chord name="Ab/Eb"/>Snow <chord name="Bb"/>on <chord name="Bb7"/>snow,<br/>
      <chord name="Eb"/>In the <chord name="Ab/Eb"/>bleak <chord name="Bb"/>minwinter, <chord name="Db"/>Long <chord name="Eb"/>ago.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Eb"/>Angels <chord name="Ab/Eb"/>and <chord name="Bb"/>archangels <chord name="Bb7"/>May <chord name="Eb"/>have <chord name="Db"/>gathered there,<br/>
      <chord name="Eb"/>Chrubim and <chord name="Ab/Eb"/>seraphim <chord name="Bb7"/>Thronged <chord name="Fm"/>the <chord name="Gm"/>air.<br/>
      <chord name="Ab"/>But His <chord name="Gm"/>mother <chord name="Bb7"/>only <chord name="Eb"/>In her <chord name="Ab/Eb"/>maiden <chord name="Bb7"/>bliss,<br/>
      <chord name="Eb"/>Worshiped <chord name="Bb"/>the <chord name="Fm/C"/>beloved <chord name="Db"/>With <chord name="Eb"/>a <chord name="G7/F"/>kiss.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Eb"/>What <chord name="Ab/Eb"/>can <chord name="Bb"/>I <chord name="Bb7"/>give <chord name="Eb"/>Him, <chord name="Bb7"/>Poor <chord name="Eb"/>as <chord name="Db"/>I <chord name="Cm"/>am?<br/>
      <chord name="Eb"/>If I were a <chord name="Ab/Eb"/>shepherd <chord name="Bb"/>I <chord name="Bb7"/>would <chord name="Fm"/>bring a <chord name="Gm"/>lamb;<br/>
      <chord name="Ab"/>If I <chord name="Gm"/>were <chord name="Fm"/>a <chord name="Bb7"/>wise <chord name="Eb"/>man I would <chord name="Ab/Eb"/>do <chord name="Bb"/>my <chord name="Bb7"/>part;<br/>
      <chord name="Eb"/>Yet what <chord name="Ab/Eb"/>can <chord name="Bb"/>I <chord name="Fm/C"/>give <chord name="Cm"/>Him? <chord name="Db"/>Give <chord name="Eb"/>my <chord name="G7/F"/>heart.
      </lines>
    </verse>
  </lyrics>
</song>
