    <themes>
      <theme>Christian Home</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Db"/>Heav&#x27;nly <chord name="Fm"/>Father, <chord name="Ebm"/>hear <chord name="Ab"/>our prayer<br/>
      <chord name="Fm"/>As we <chord name="Db"/>bow <chord name="Gb"/>before <chord name="Fm"/>You:<br/>
      <chord name="Gb"/>Bless them in <chord name="Bbm"/>the life <chord name="Ab"/>they share,<br/>
      <chord name="Db"/>Humble <chord name="Gb"/>we <chord name="Fm"/>implore You.<br/>
      <chord name="Ebm/Gb"/>Be their <chord name="Gdim"/>guide in <chord name="Db/Ab"/>all endeavors,<br/>
      <chord name="Ab7"/>Be their <chord name="Db"/>hope <chord name="Bbm"/>that nothing <chord name="Ebm"/>severs;<br/>
      <chord name="Ab"/>Constant source <chord name="Db"/>of love divine,<br/>
      <chord name="Gb"/>Let Your <chord name="Gm"/>love <chord name="C7"/>within <chord name="Fm"/>them <chord name="Ebm"/>shine!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Db"/>As <chord name="Bbm"/>they <chord name="Fm"/>pledge <chord name="Ebm/Gb"/>their love <chord name="Ab"/>this day<br/>
      <chord name="Fm"/>Here before <chord name="Gb"/>Your altar,<br/>
      <chord name="Gb"/>May their hearts,, <chord name="Bbm"/>upon <chord name="Ab"/>You stayed,<br/>
      <chord name="Db"/>Never <chord name="Gb"/>fail <chord name="Fm"/>or falter.<br/>
      <chord name="Ebm/Gb"/>Be their <chord name="Gdim"/>comfort <chord name="Db/Ab"/>in all <chord name="Fm/Ab"/>sorrow;<br/>
      <chord name="Ab7"/>Be their <chord name="Db"/>reason <chord name="Bbm"/>for <chord name="Ebm"/>tomorrow.<br/>
      <chord name="Ab"/>Grant them strength <chord name="Db"/>to live each hour<br/>
      <chord name="Gb"/>Trusting <chord name="Gm"/>solely <chord name="Fm"/>in Your <chord name="Ebm"/>pow&#x27;r.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Db"/>Blest <chord name="Bbm"/>Creator, <chord name="Ebm"/>Lord <chord name="Ab"/>of life,<br/>
      <chord name="Fm"/>Hear our <chord name="Db"/>glad <chord name="Gb"/>thanksgiving.<br/>
      <chord name="Gb"/>Husband You <chord name="Bbm"/>have joined <chord name="Ab"/>to wife<br/>
      <chord name="Db"/>For their <chord name="Gb"/>earthly <chord name="Fm"/>living.<br/>
      <chord name="Ebm/Gb"/>Justified <chord name="Gdim"/>by Jesus&#x27; <chord name="Db/Ab"/>merit,<br/>
      <chord name="Ab7"/>Life eternal <chord name="Bbm"/>they <chord name="Ebm"/>inherit.<br/>
      <chord name="Ab"/>When their days <chord name="Db"/>on earth have passed,<br/>
      <chord name="Gb"/>Take them <chord name="Gm"/>to <chord name="C7"/>Your <chord name="Fm"/>home at <chord name="Ebm"/>last!
      </lines>
    </verse>
  </lyrics>
</song>
