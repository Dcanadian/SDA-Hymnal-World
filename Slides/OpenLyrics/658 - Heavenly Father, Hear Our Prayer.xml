  <properties>
    <titles>
      <title>658 - Heavenly Father, Hear Our Prayer</title>
      <title>Heavenly Father, Hear Our Prayer</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="658"/>
    </songbooks>
    <key>Db</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
