    <verse name="v4">
      <lines>
      <chord name="A"/>Inspire <chord name="A7/G"/>Thy church, <chord name="D"/>mid <chord name="Em"/>earth&#x27;s <chord name="F#m"/>discordant <chord name="Em"/>voices,<br/>
