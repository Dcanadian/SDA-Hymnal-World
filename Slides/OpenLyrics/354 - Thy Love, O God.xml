    <verse name="v2">
      <lines>
      <chord name="A"/>From <chord name="Bm"/>out <chord name="A7/G"/>the darkness <chord name="D"/>of <chord name="F#m"/>our <chord name="G"/>hope&#x27;s <chord name="Em"/>frustration,<br/>
