  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Ab"/>The <chord name="Db/Ab"/>church <chord name="Ab"/>has <chord name="Gdim"/>waited <chord name="Db/F"/>long<br/>
      <chord name="Ab"/>Her <chord name="Db/Ab"/>absent <chord name="Gdim"/>Lord <chord name="Ab"/>to <chord name="Bbm"/>see;<br/>
      <chord name="Cm"/>And still <chord name="Eb/Bb"/>in <chord name="Bbm"/>loneliness <chord name="Am"/>she <chord name="Bbm"/>waits,<br/>
      <chord name="E/B"/>A <chord name="Fm/C"/>friendless <chord name="Ab"/>stranger <chord name="Cm/G"/>she.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Ab"/>How <chord name="Db/Ab"/>long, <chord name="Ab"/>O <chord name="Gdim"/>Lord <chord name="Ab"/>our <chord name="Db/F"/>God,<br/>
      <chord name="Ab"/>Holy and <chord name="Gdim"/>true <chord name="Ab"/>and <chord name="Bbm"/>good,<br/>
      <chord name="Cm"/>Wilt Thou <chord name="Eb/Bb"/>not <chord name="Bbm"/>judge Thy <chord name="Am"/>suffering <chord name="Bbm"/>church,<br/>
      <chord name="E/B"/>Her <chord name="Fm/C"/>sighs <chord name="Ab"/>and tears <chord name="Bbm/F"/>and <chord name="Cm/G"/>blood?
      </lines>
