    <verse name="v3">
      <lines>
      <chord name="Ab"/>We <chord name="Db/Ab"/>long <chord name="Ab"/>to <chord name="Gdim"/>hear <chord name="Ab"/>Thy <chord name="Db/F"/>voice,<br/>
      <chord name="Ab"/>To <chord name="Db/Ab"/>see <chord name="Ab"/>Thee <chord name="Gdim"/>face <chord name="Ab"/>to <chord name="Bbm"/>face,<br/>
      <chord name="Cm"/>To <chord name="Eb/Bb"/>share <chord name="Bbm"/>Thy crown <chord name="Am"/>and <chord name="Bbm"/>glory then,<br/>
      <chord name="E/B"/>As <chord name="Fm/C"/>now <chord name="Ab"/>we share <chord name="Bbm/F"/>Thy <chord name="Cm/G"/>grace.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Ab"/>Come, <chord name="Db/Ab"/>Lord, <chord name="Ab"/>and <chord name="Gdim"/>wipe <chord name="Ab"/>away<br/>
      <chord name="Ab"/>The <chord name="Db/Ab"/>curse, <chord name="Ab"/>the <chord name="Gdim"/>sin, <chord name="Ab"/>the <chord name="Bbm"/>stain,<br/>
      <chord name="Cm"/>And <chord name="Eb/Bb"/>make <chord name="Bbm"/>this blighted world <chord name="Am"/>of <chord name="Bbm"/>ours<br/>
      <chord name="E/B"/>Thine <chord name="Fm/C"/>own <chord name="Ab"/>fair world <chord name="Bbm/F"/>again.
