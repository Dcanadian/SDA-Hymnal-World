<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>069 - Lord, Make Us More Holy</title>
      <title>Lord, Make Us More Holy</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="69"/>
    </songbooks>
    <key>Eb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Worship</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb"/>Lord, make us more holy;<br/>
      <chord name="Ab"/>Lord, make us more <chord name="Eb"/>holy;<br/>
      <chord name="Eb"/>Lord, make us <chord name="Ab"/>more holy<br/>
      <chord name="Eb/Bb"/>Until <chord name="Bb7"/>we meet again.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Eb"/>Lord, make us more faithful;<br/>
      <chord name="Ab"/>Lord, make us more <chord name="Eb"/>faithful;<br/>
      <chord name="Eb"/>Lord, make us <chord name="Ab"/>more faithful<br/>
      <chord name="Eb/Bb"/>Until <chord name="Bb7"/>we meet again.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Eb"/>Lord, make us more humble;<br/>
      <chord name="Ab"/>Lord, make us more <chord name="Eb"/>humble;<br/>
      <chord name="Eb"/>Lord, make us <chord name="Ab"/>more humble<br/>
      <chord name="Eb/Bb"/>Until <chord name="Bb7"/>we meet again.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Eb"/>Lord, make us more loving;<br/>
      <chord name="Ab"/>Lord, make us more <chord name="Eb"/>loving;<br/>
      <chord name="Ab"/>Lord, make us more <chord name="Eb"/>loving<br/>
      <chord name="Eb"/>Until we <chord name="Ab"/>meet again.<br/>
      <chord name="Eb"/>Like Jesus, <chord name="Ab"/>the Savior,<br/>
      <chord name="Eb/Bb"/>Until <chord name="Bb7"/>we meet again.
      </lines>
    </verse>
  </lyrics>
</song>
