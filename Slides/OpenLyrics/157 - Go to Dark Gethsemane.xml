  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb"/>Go to <chord name="Bb"/>dark <chord name="Eb"/>Gethsemane,<br/>
      <chord name="Eb"/>Ye who <chord name="Cm"/>feel <chord name="Bb"/>the <chord name="Eb"/>tempter&#x27;s <chord name="Bb"/>power<br/>
      <chord name="Eb"/>Your <chord name="Cm"/>Redeemer&#x27;s <chord name="Ab"/>conflict <chord name="Eb"/>see.<br/>
      <chord name="Eb/G"/>Watch with <chord name="Bb/D"/>him <chord name="Gm"/>one <chord name="Eb"/>bitter <chord name="Bb"/>hour;<br/>
      <chord name="Eb/G"/>Turn not <chord name="Fm"/>from <chord name="Eb"/>his <chord name="Ab"/>griefs away;<br/>
      <chord name="Eb/G"/>Learn <chord name="Fm"/>from <chord name="Eb"/>Jesus Christ <chord name="Bb"/>to <chord name="Eb"/>pray.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Eb"/>See Him <chord name="Bb"/>at <chord name="Eb"/>the <chord name="Ab"/>judgment <chord name="Eb"/>hall,<br/>
      <chord name="Eb"/>Beaten, <chord name="Bb"/>bound, <chord name="Eb"/>reviled, <chord name="Bb"/>arraigned;<br/>
      <chord name="Eb"/>See <chord name="Cm"/>Him <chord name="Bb"/>meekly <chord name="Ab"/>bearing <chord name="Eb"/>all;<br/>
      <chord name="Eb/G"/>Love to <chord name="Bb/D"/>man <chord name="Gm"/>His <chord name="Eb"/>soul <chord name="Fm"/>sustained!<br/>
      <chord name="Eb/G"/>Shun not suffering, <chord name="Ab"/>shame, or <chord name="Eb"/>loss;<br/>
      <chord name="Eb/G"/>Learn <chord name="Fm"/>from <chord name="Eb"/>him <chord name="Fm/Ab"/>to <chord name="Eb/Bb"/>bear <chord name="Bb"/>the <chord name="Eb"/>cross.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Eb"/>Calvary&#x27;s <chord name="Bb"/>mournful <chord name="Ab"/>mountain <chord name="Eb"/>climb;<br/>
      <chord name="Eb"/>There, <chord name="Cm"/>adoring <chord name="Ab"/>at <chord name="Bb"/>his <chord name="Eb"/>feet,<br/>
      <chord name="Eb"/>Mark <chord name="Cm"/>that <chord name="Bb"/>miracle <chord name="Ab"/>of <chord name="Eb"/>time,<br/>
      <chord name="Eb/G"/>God&#x27;s own <chord name="Bb/D"/>sacrifice <chord name="Fm"/>complete.<br/>
      <chord name="Eb/G"/>&quot;It is <chord name="Fm"/>finished!&quot; <chord name="Ab"/>hear him <chord name="Eb"/>cry;<br/>
      <chord name="Eb/G"/>Learn <chord name="Fm"/>from <chord name="Eb"/>Jesus Christ <chord name="Bb"/>to <chord name="Eb"/>die.
      </lines>
    </verse>
