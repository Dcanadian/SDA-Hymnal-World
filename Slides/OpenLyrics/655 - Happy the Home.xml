  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>Happy the <chord name="Am/C"/>home <chord name="Bm"/>when <chord name="Am"/>God <chord name="D"/>is <chord name="G"/>there,<br/>
      <chord name="D7/A"/>And love <chord name="G"/>fills <chord name="D/F#"/>every breast;<br/>
      <chord name="Am"/>When one their wish, and <chord name="D"/>one their prayer,<br/>
      <chord name="Bm"/>And one <chord name="C"/>their heavenly <chord name="G"/>rest.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>Happy the <chord name="Am/C"/>home <chord name="Bm"/>where <chord name="Am"/>Jesus&#x27; <chord name="G"/>name<br/>
      <chord name="D7/A"/>is sweet <chord name="G"/>to <chord name="D/F#"/>every ear;<br/>
      <chord name="Am"/>where children early <chord name="D"/>speak his fame,<br/>
      <chord name="Bm"/>and <chord name="C"/>parents <chord name="G/D"/>hold <chord name="D7"/>him <chord name="G"/>dear.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>Happy the <chord name="Am/C"/>home <chord name="Bm"/>where <chord name="Am"/>prayer <chord name="D"/>is <chord name="G"/>heard,<br/>
      <chord name="D7/A"/>and <chord name="G"/>praise <chord name="D/F#"/>is <chord name="G"/>wont <chord name="Em"/>to <chord name="D"/>rise;<br/>
      <chord name="Am"/>where parents love the <chord name="D"/>sacred Word<br/>
      <chord name="Bm"/>and <chord name="C"/>all its <chord name="G/D"/>wisdom prize.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="G"/>Lord, let us in <chord name="Am/C"/>our <chord name="Bm"/>homes <chord name="D"/>agree<br/>
      <chord name="D7/A"/>this <chord name="G"/>blessed <chord name="D/F#"/>peace <chord name="G"/>to <chord name="Em"/>gain;<br/>
      <chord name="Am"/>unite our hearts in <chord name="D"/>love to thee,<br/>
      <chord name="Bm"/>and <chord name="C"/>love to <chord name="G/D"/>all <chord name="D7"/>will <chord name="G"/>reign.
      </lines>
    </verse>
  </lyrics>
