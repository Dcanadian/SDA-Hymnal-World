  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb"/>We <chord name="Ab"/>plow the <chord name="Eb"/>fields, and <chord name="Ab"/>scatter<br/>
      <chord name="Eb"/>The <chord name="Db"/>good <chord name="Ab"/>seed <chord name="Bbm"/>on<chord name="Ab"/>the <chord name="Eb"/>land,<br/>
      <chord name="Ab"/>But <chord name="Eb"/>it <chord name="Bb7"/>is<chord name="Eb"/>fed <chord name="Ab"/>and <chord name="Eb"/>wa <chord name="Bb7"/> <chord name="Cm"/>tered<br/>
      <chord name="Eb"/>By <chord name="Fm7"/>God’s <chord name="Ab"/>al<chord name="Bb7"/>mighty <chord name="Eb"/>hand.<br/>
      <chord name="Eb"/>He <chord name="Eb7"/>sends the <chord name="Ab"/>snow in <chord name="Bbm7"/>win<chord name="Eb"/>ter,<br/>
      <chord name="Eb7"/>The <chord name="Ab"/>warmth to <chord name="Eb7"/>swell <chord name="Ab"/>the <chord name="Eb"/>grain,<br/>
      The <chord name="Ab"/>breezes <chord name="Eb"/>and the <chord name="Fm"/>sunshine,<br/>
      And <chord name="Db"/>soft <chord name="Bbm7"/>re <chord name="Eb"/>fresh<chord name="Eb7"/>ing <chord name="Ab"/>rain.<br/>
      <chord name="Ab"/>All good gifts a<chord name="Eb"/>round us<br/>
      Are <chord name="Ab"/>sent from <chord name="Eb7"/>heaven <chord name="Ab"/>a<chord name="Eb"/>bove;<br/>
      Then <chord name="Ab"/>thank <chord name="Eb"/>the <chord name="Ab"/>Lord, <chord name="Eb"/>O<chord name="Fm"/>thank <chord name="C"/>the <chord name="Fm"/>Lord<br/>
      <chord name="Ab"/>For <chord name="Db"/>all<chord name="Bbm7"/><chord name="Ab"/>   <chord name="Eb"/>His <chord name="Ab"/>love.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Eb"/>All <chord name="Ab"/>good <chord name="Eb"/>gifts <chord name="Ab"/>around us<br/>
      <chord name="Eb"/><chord name="Db"/>Are <chord name="Ab"/>sent <chord name="Bbm"/>from <chord name="Ab"/>heaven <chord name="Eb"/>above;<br/>
      <chord name="Ab"/>Then <chord name="Eb"/>thank <chord name="Bb7"/>the <chord name="Eb"/>Lord, <chord name="Ab"/>O <chord name="Eb"/>thank <chord name="Bb7"/>the <chord name="Cm"/>Lord<br/>
