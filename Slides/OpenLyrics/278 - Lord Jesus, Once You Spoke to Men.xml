<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>278 - Lord Jesus, Once You Spoke to Men</title>
      <title>Lord Jesus, Once You Spoke to Men</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="278"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Holy Scriptures</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C"/>Lord <chord name="F"/>Jesus, <chord name="Am"/>once You <chord name="Gm"/>spoke <chord name="F"/>to <chord name="Dm"/>men<br/>
      <chord name="C"/>Upon <chord name="F"/>the <chord name="Am"/>mountain <chord name="C"/>and the <chord name="Am"/>plain,<br/>
      <chord name="C"/>O <chord name="F"/>help us <chord name="Am"/>listen <chord name="Gm"/>now <chord name="F"/>as <chord name="Dm"/>then<br/>
      <chord name="C"/>And wonder at Your <chord name="F/C"/>words again.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="C"/>We <chord name="F"/>all have <chord name="Am"/>secret <chord name="Gm"/>fears <chord name="F"/>to <chord name="Dm"/>face,<br/>
      <chord name="C"/>Our <chord name="F"/>minds and <chord name="Am"/>motives <chord name="C"/>to <chord name="Am"/>amend.<br/>
      <chord name="C"/>We <chord name="F"/>seek Your <chord name="Am"/>truth, we <chord name="Gm"/>need <chord name="F"/>Your <chord name="Dm"/>grace,<br/>
      <chord name="C"/>Our living Lord and <chord name="F/C"/>present <chord name="Gm"/>friend.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="C"/>The <chord name="F"/>gospel <chord name="Am"/>speaks; and <chord name="Gm"/>we <chord name="F"/>receive<br/>
      <chord name="C"/>Your <chord name="F"/>light, Your <chord name="Am"/>love, <chord name="C"/>Your own command.<br/>
      <chord name="C"/>O <chord name="F"/>help us <chord name="Am"/>live what <chord name="Gm"/>we <chord name="F"/>believe,<br/>
      <chord name="C"/>In daily word of <chord name="F/C"/>heart and <chord name="Gm"/>hand.
      </lines>
    </verse>
  </lyrics>
</song>
