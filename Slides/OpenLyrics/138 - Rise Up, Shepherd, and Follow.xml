      <chord name="D/F#"/>Rise Up, shepherd, <chord name="Em/G"/>and <chord name="G"/>follow.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>If you <chord name="D/A"/>take <chord name="Bm"/>goo <chord name="G"/>heed <chord name="Em"/>tothe <chord name="F#m"/>angel&#x27;s <chord name="G"/>words,<br/>
