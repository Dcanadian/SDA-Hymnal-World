  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>There’s <chord name="D/A"/>a star <chord name="Bm"/>in <chord name="G"/>the <chord name="Em"/>east <chord name="A/E"/>on <chord name="F#m"/>Christmas <chord name="G"/>morn.<br/>
