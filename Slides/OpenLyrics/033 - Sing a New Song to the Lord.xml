<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>033 - Sing a New Song to the Lord</title>
      <title>Sing a New Song to the Lord</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="33"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Worship</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>Sing a <chord name="G/D"/>new <chord name="Em"/>song <chord name="D"/>to the <chord name="G/D"/>Lord, He <chord name="Em"/>to <chord name="D"/>whom <chord name="G"/>wonders belong.<br/>
      <chord name="D7"/>Rejoice <chord name="Em"/>in <chord name="G"/>His triumph <chord name="D7/C"/>and tell of His power.<br/>
      <chord name="F#dim"/>Osing a new song to <chord name="G"/>the Lord.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>Now <chord name="G/D"/>to <chord name="D"/>the <chord name="G/D"/>ends <chord name="Em"/>of <chord name="G"/>the earth<br/>
      <chord name="D7"/>See <chord name="Em"/>His <chord name="G"/>salvation <chord name="D7"/>is shown.<br/>
      <chord name="D7"/>And <chord name="Em"/>still He <chord name="G"/>remembers <chord name="D7"/>His mercy and <chord name="Am"/>truth,<br/>
      <chord name="F#dim"/>Unchanging in love to <chord name="G"/>His own.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D"/>Sing <chord name="G/D"/>a <chord name="D"/>new <chord name="G/D"/>song <chord name="Em"/>and <chord name="G"/>rejoice.<br/>
      <chord name="D7"/>Publish <chord name="G"/>His praises <chord name="D7"/>abroad.<br/>
      <chord name="D7"/>Let <chord name="Em"/>voices <chord name="G"/>in chorus <chord name="D7"/>with trumpet and <chord name="Am"/>horn,<br/>
      <chord name="F#dim"/>Resound for the joy of <chord name="G"/>the Lord.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="D"/>Join <chord name="G/D"/>with <chord name="D"/>the <chord name="G/D"/>hills <chord name="Em"/>and <chord name="G"/>the sea,<br/>
      <chord name="D"/>Thunders of <chord name="G/D"/>praise <chord name="Em"/>to <chord name="G"/>prolong.<br/>
      <chord name="D7"/>In <chord name="Em"/>judgment <chord name="D7/C"/>and justice<br/>
      <chord name="F#dim"/>He comes to <chord name="G"/>the earth.<br/>
      <chord name="F#dim"/>O sing a new song to <chord name="G"/>the Lord.
      </lines>
    </verse>
  </lyrics>
</song>
