<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>569 - Pass Me Not, O Gentle Savior</title>
      <title>Pass Me Not, O Gentle Savior</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="569"/>
    </songbooks>
    <key>C</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>Pass me <chord name="C"/>not, O <chord name="G"/>gentle <chord name="Dm"/>Savior,<br/>
      <chord name="G"/>Hear my humble cry;<br/>
      <chord name="G"/>While <chord name="C"/>on others <chord name="G"/>Thou <chord name="Dm"/>art calling,<br/>
      <chord name="G"/>Do not pass me by.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Am/C"/>Savior, <chord name="C"/>Savior, <chord name="G"/>hear my humble <chord name="Dm"/>cry;<br/>
      <chord name="G"/>while on <chord name="C"/>others thou art <chord name="G"/>calling,<br/>
      <chord name="Dm"/>do not <chord name="G/D"/>pass <chord name="Dm"/>me <chord name="G"/>by.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>Let me <chord name="C"/>at thy <chord name="G"/>throne of <chord name="Dm"/>mercy<br/>
      <chord name="G"/>find a sweet relief,<br/>
      <chord name="G"/>kneeling <chord name="C"/>there in <chord name="G"/>deep contrition;<br/>
      <chord name="G"/>help my unbelief.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>Trusting <chord name="C"/>only <chord name="G"/>in thy <chord name="Dm"/>merit,<br/>
      <chord name="G"/>would I seek thy face;<br/>
      <chord name="G"/>heal my <chord name="C"/>wounded, <chord name="G"/>broken <chord name="Dm"/>spirit,<br/>
      <chord name="G"/>save me by thy grace.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="G"/>Thou the <chord name="C"/>spring of <chord name="G"/>all my <chord name="Dm"/>comfort,<br/>
      <chord name="G"/>more than life to me,<br/>
      <chord name="G"/>whom have <chord name="C"/>I on <chord name="G"/>earth beside thee?<br/>
      <chord name="G"/>Whom in heaven but thee?
      </lines>
    </verse>
  </lyrics>
</song>
