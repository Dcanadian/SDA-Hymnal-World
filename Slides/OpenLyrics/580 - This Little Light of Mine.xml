<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>580 - This Little Light of Mine</title>
      <title>This Little Light of Mine</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="580"/>
    </songbooks>
    <key>Eb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb"/>This little light of mine, I&#x27;m <chord name="Fm"/>going to let <chord name="Eb/Bb"/>it shine, <chord name="Ab"/>(shine)<br/>
      <chord name="Cm"/>This little <chord name="Gm"/>light of <chord name="Ab"/>mine, I&#x27;m going to let it shine, <chord name="Gm"/>(shine)<br/>
      <chord name="Eb"/>This little light of mine, <chord name="Gm"/>I&#x27;m going to let <chord name="Cm"/>it shine,<br/>
      <chord name="Eb/Bb"/>Let it <chord name="Bb7"/>shine, let it shine, let it shine.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Eb"/>Every where I go, I&#x27;m <chord name="Fm"/>going to let <chord name="Eb/Bb"/>it shine, <chord name="Ab"/>(shine)<br/>
      <chord name="Cm"/>Every <chord name="Gm"/>where I <chord name="Ab"/>go, I&#x27;m going to let it shine, <chord name="Gm"/>(shine)<br/>
      <chord name="Eb"/>Every where I go, <chord name="Gm"/>I&#x27;m going to let <chord name="Cm"/>it shine,<br/>
      <chord name="Eb/Bb"/>Let it <chord name="Bb7"/>shine, let it shine, let it shine.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Eb"/>All through the night, I&#x27;m going <chord name="Fm"/>to let it <chord name="Eb/Bb"/>shine, (shine)<br/>
      <chord name="Cm"/>All through the <chord name="Gm"/>night, I&#x27;m <chord name="Ab"/>going to let it shine, (shine)<br/>
      <chord name="Eb"/>All through the night, I&#x27;m <chord name="Gm"/>going to let it <chord name="Cm"/>shine,<br/>
      <chord name="Eb/Bb"/>Let it <chord name="Bb7"/>shine, let it shine, let it shine.
      </lines>
    </verse>
  </lyrics>
</song>
