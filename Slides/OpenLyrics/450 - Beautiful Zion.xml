<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>450 - Beautiful Zion</title>
      <title>Beautiful Zion</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="450"/>
    </songbooks>
    <key>D</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Early Advent</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>Beautiful Zion, <chord name="A"/>built <chord name="D/A"/>above,<br/>
      <chord name="D"/>Beautiful <chord name="Bm"/>city <chord name="A/C#"/>that <chord name="A7/C#"/>I <chord name="D"/>love,<br/>
      <chord name="D"/>Beautiful gates <chord name="F#m/C#"/>of <chord name="G/B"/>pearly white,<br/>
      <chord name="G"/>Beautiful <chord name="D"/>tem <chord name="Bm"/>ple, <chord name="D/A"/>God <chord name="A7"/>its <chord name="D"/>light.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>Beautiful trees forever <chord name="A7"/>there,<br/>
      <chord name="D"/>Beautiful <chord name="Bm"/>fruit they <chord name="A/C#"/>always <chord name="D"/>bear,<br/>
      <chord name="D"/>Beautiful rivers <chord name="F#m/C#"/>gliding <chord name="D/A"/>by,<br/>
      <chord name="G"/>Beautiful <chord name="D"/>fountains never dry.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D"/>Beautiful crowns on <chord name="A"/>every <chord name="D"/>brow,<br/>
      <chord name="D"/>Beautiful <chord name="Bm"/>palms the <chord name="A/C#"/>conquerors show,<br/>
      <chord name="D"/>Beautiful robes <chord name="F#m/C#"/>the <chord name="G/B"/>ransomed wear,<br/>
      <chord name="G"/>Beautiful <chord name="D"/>all <chord name="Bm"/>who <chord name="D/A"/>enter there.
      </lines>
    </verse>
  </lyrics>
</song>
