    </verse>
    <verse name="v3">
      <lines>
      <chord name="Dm/A"/>Alleluia! <chord name="F/C"/>bread <chord name="Gm"/>of <chord name="F/C"/>angels, <chord name="C"/>Thou <chord name="Am"/>on <chord name="Bb"/>earth <chord name="F/C"/>our food, <chord name="Dm/A"/>our <chord name="C"/>stay;<br/>
      <chord name="Dm/A"/>Alleluia! <chord name="F/C"/>here <chord name="Gm"/>the <chord name="C7"/>sinful <chord name="Dm/A"/>flee <chord name="C"/>to <chord name="Am"/>Thee <chord name="Bb"/>from day <chord name="F/C"/>to <chord name="Gm/Bb"/>day:<br/>
      <chord name="C"/>Intercessor, <chord name="Am"/>Friend <chord name="F/C"/>of <chord name="Gm"/>sinners, Earth&#x27;s Redeemer, <chord name="Dm"/>plead <chord name="C"/>for <chord name="D7"/>me,<br/>
      <chord name="Dm"/>Where <chord name="Gm"/>the <chord name="Am"/>songs <chord name="C"/>of <chord name="Gm/D"/>all <chord name="C7"/>the <chord name="F/A"/>sinless sweep across <chord name="Gbdim"/>the <chord name="Gm"/>crystal sea.
