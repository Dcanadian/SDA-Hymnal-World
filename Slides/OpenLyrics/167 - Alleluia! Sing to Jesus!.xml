    <verse name="v2">
      <lines>
      <chord name="Dm/A"/>Alleluia! <chord name="F/C"/>not <chord name="Gm"/>as <chord name="F/C"/>orphans <chord name="C"/>are <chord name="Am"/>we <chord name="Bb"/>left <chord name="F/C"/>in sorrow <chord name="C"/>now;<br/>
      <chord name="Dm/A"/>Alleluia! He <chord name="Gm"/>is <chord name="C7"/>near <chord name="F/C"/>us, <chord name="C"/>faith believes, <chord name="Bb"/>nor <chord name="F/C"/>questions <chord name="Gm/Bb"/>how;<br/>
      <chord name="C"/>Though <chord name="Dm/A"/>the <chord name="Am"/>cloud from sight <chord name="F/C"/>received <chord name="Gm"/>Him when the <chord name="Am"/>forty <chord name="Dm"/>days <chord name="C"/>were <chord name="D7"/>o&#x27;er<br/>
      <chord name="Dm"/>Shall <chord name="Gm"/>our <chord name="Am"/>hearts <chord name="C"/>forget <chord name="C7"/>His <chord name="F/A"/>promise, &quot;I am with <chord name="Gbdim"/>you <chord name="Gm"/>evermore&quot;?
