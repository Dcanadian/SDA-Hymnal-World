  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F/C"/>Jesus, <chord name="C"/>stand among <chord name="F/A"/>us<br/>
      <chord name="Dm/A"/>In Thy risen <chord name="C"/>power;<br/>
      <chord name="C"/>Let <chord name="Am"/>this <chord name="Bb"/>time <chord name="C7"/>of <chord name="F/C"/>worship<br/>
      <chord name="F/C"/>Be a <chord name="Gm/D"/>hallowed <chord name="Dm/A"/>hour.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F/C"/>Breathe the <chord name="C"/>Holy <chord name="Dm/A"/>Spirit<br/>
      <chord name="Dm/A"/>Into every <chord name="F/C"/>heart;<br/>
      <chord name="C"/>Bid <chord name="Am"/>the <chord name="Bb"/>fears <chord name="C7"/>and <chord name="F/C"/>sorrows<br/>
      <chord name="F/C"/>From each <chord name="Gm/D"/>soul <chord name="C"/>depart.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F/C"/>Thus with <chord name="C"/>quickened <chord name="Dm/A"/>footsteps<br/>
      <chord name="Dm/A"/>We pursue <chord name="C"/>our way,<br/>
      <chord name="C"/>Watching <chord name="Bb"/>for <chord name="C7"/>the <chord name="F/C"/>dawning<br/>
      <chord name="F/C"/>Of eternal <chord name="Dm/A"/>day.
      </lines>
    </verse>
  </lyrics>
