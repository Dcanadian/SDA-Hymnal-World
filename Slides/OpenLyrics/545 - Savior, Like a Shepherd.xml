<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>545 - Savior, Like a Shepherd</title>
      <title>Savior, Like a Shepherd</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="545"/>
    </songbooks>
    <key>Db</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Db"/>Savior, like a shepherd lead us,<br/>
      <chord name="Ab"/>Much we <chord name="Db/Ab"/>need <chord name="Ab7"/>Thy tenderest <chord name="Db"/>care;<br/>
      <chord name="Db"/>In Thy pleasant pastures <chord name="Ab7"/>feed us,<br/>
      <chord name="Db"/>For our use <chord name="Gb"/>Thy folds prepare.<br/>
      <chord name="Db"/>Blessed Jesus, blessed Jesus!<br/>
      <chord name="Ab"/>Thou <chord name="Ab7"/>hast bought us, <chord name="Db"/>Thine we are.<br/>
      <chord name="Gb"/>Blessed Jesus, <chord name="Db"/>blessed Jesus!<br/>
      <chord name="Db"/>Thou hast bought <chord name="Ab7"/>us, Thine we <chord name="Db"/>are.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Db"/>We are thine, thou dost befriend us,<br/>
      <chord name="Ab"/>be <chord name="Db/Ab"/>the <chord name="Ab7"/>guardian of our <chord name="Db"/>way;<br/>
      <chord name="Db"/>keep thy flock, from sin <chord name="Ab"/>defend <chord name="Ab7"/>us,<br/>
      <chord name="Db"/>seek us when <chord name="Gb"/>we go astray.<br/>
      <chord name="Db"/>Blessed Jesus, blessed Jesus!<br/>
      <chord name="Ab"/>Hear, <chord name="Ab7"/>O hear us <chord name="Db"/>when we pray.<br/>
      <chord name="Gb"/>Blessed Jesus, <chord name="Db"/>blessed Jesus!<br/>
      <chord name="Db"/>Hear, O hear <chord name="Ab7"/>us when we <chord name="Db"/>pray.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Db"/>Thou hast promised to receive us,<br/>
      <chord name="Ab"/>poor <chord name="Db/Ab"/>and <chord name="Ab7"/>sinful though we <chord name="Db"/>be;<br/>
      <chord name="Db"/>thou hast mercy to <chord name="Ab"/>relieve <chord name="Ab7"/>us,<br/>
      <chord name="Db"/>grace to cleanse and <chord name="Gb"/>power to free.<br/>
      <chord name="Db"/>Blessed Jesus, blessed Jesus!<br/>
      <chord name="Ab"/>We <chord name="Ab7"/>will early <chord name="Db"/>turn to thee.<br/>
      <chord name="Gb"/>Blessed Jesus, <chord name="Db"/>blessed Jesus!<br/>
      <chord name="Db"/>We will early <chord name="Ab7"/>turn to <chord name="Db"/>thee.
      </lines>
    </verse>
  </lyrics>
</song>
