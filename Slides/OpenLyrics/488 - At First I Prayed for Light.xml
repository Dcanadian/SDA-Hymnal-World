<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>488 - At First I Prayed for Light</title>
      <title>At First I Prayed for Light</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="488"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4 v5</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>At first I <chord name="C/G"/>prayed <chord name="G"/>for <chord name="D7"/>light: Could I but see <chord name="Em"/>the <chord name="G7/F"/>way,<br/>
      <chord name="G7/F"/>How gladly, <chord name="G/D"/>swiftly <chord name="C"/>would I <chord name="Em"/>walk To <chord name="D"/>everlasting <chord name="G"/>day!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>And next I <chord name="D7"/>prayed for <chord name="Em"/>strength:<br/>
      <chord name="G"/>That I might <chord name="D7"/>tread the <chord name="Em"/>road<br/>
      <chord name="G7/F"/>With <chord name="C/E"/>firm, <chord name="G/D"/>unfaltering <chord name="D7"/>feet, and win<br/>
      <chord name="G7/F"/>The <chord name="C/E"/>heaven&#x27;s serene <chord name="D7"/>abode.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>And then I <chord name="D7"/>asked for <chord name="Em"/>faith:<br/>
      <chord name="G"/>Could I but <chord name="D7"/>trust my <chord name="Em"/>God,<br/>
      <chord name="G7/F"/>I&#x27;d <chord name="C/E"/>live infolded <chord name="D"/>in <chord name="D7"/>His peace,<br/>
      <chord name="G7/F"/>Though <chord name="G/D"/>foes <chord name="C"/>were <chord name="Em"/>all <chord name="D7"/>abroad.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="G"/>But now I <chord name="D7"/>pray for <chord name="Em"/>love:<br/>
      <chord name="G"/>Deep love to <chord name="D7"/>God and <chord name="Em"/>man;<br/>
      <chord name="G7/F"/>A <chord name="C/E"/>living love <chord name="Em"/>that <chord name="D"/>will <chord name="D7"/>not fail,<br/>
      <chord name="G7/F"/>However <chord name="Em"/>dark <chord name="D7"/>His plan.
      </lines>
    </verse>
    <verse name="v5">
      <lines>
      <chord name="G"/>And light and <chord name="D7"/>strength and <chord name="Em"/>faith<br/>
      <chord name="G"/>Are opening <chord name="D7"/>everywhere!<br/>
      <chord name="G7/F"/>God <chord name="C/E"/>waited patiently <chord name="D7"/>until<br/>
      <chord name="G7/F"/>I <chord name="G/D"/>prayed <chord name="C"/>the <chord name="Em"/>larger <chord name="D7"/>prayer.
      </lines>
    </verse>
  </lyrics>
</song>
