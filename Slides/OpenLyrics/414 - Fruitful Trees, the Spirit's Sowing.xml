  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C"/>Fruitful trees, theSpirit&#x27;s <chord name="Dm"/>sowing, <chord name="C"/>May <chord name="G/B"/>we <chord name="Am"/>ripen <chord name="Dm/F"/>and <chord name="Am"/>increase,<br/>
      <chord name="G7/F"/>Fruit <chord name="Em"/>to <chord name="Dm"/>life <chord name="F/C"/>e <chord name="G7/B"/>ternal growing, <chord name="Am"/>Rich <chord name="C7/A#"/>in <chord name="Am"/>love <chord name="F"/>and <chord name="C/G"/>joy <chord name="G7"/>and <chord name="C"/>peace.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="C"/>Laden branches <chord name="G7"/>freely <chord name="Em/G"/>bearing<br/>
      <chord name="C"/>Gifts the Giver <chord name="G7"/>loves <chord name="Em/G"/>to <chord name="Am"/>bless;<br/>
      <chord name="G7/F"/>Here <chord name="Em"/>is <chord name="F/C"/>fruit <chord name="Am"/>that <chord name="G7"/>grows <chord name="C7/A#"/>by <chord name="F"/>sharing,<br/>
      <chord name="G7/F"/>Patience, kindness, <chord name="Am"/>gentleness.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="C"/>Rooted deep <chord name="Em"/>in <chord name="G7"/>Christ, <chord name="G/B"/>our <chord name="Em/G"/>Master,<br/>
      <chord name="C"/>Christ, our <chord name="F"/>pattern <chord name="C"/>and <chord name="Am"/>our <chord name="Dm/F"/>goal,<br/>
      <chord name="G7/F"/>Teach <chord name="Em"/>us, <chord name="F/C"/>as <chord name="Am"/>the <chord name="G7"/>years <chord name="C7/A#"/>fly <chord name="F"/>faster,<br/>
      <chord name="G7/F"/>Goodness, faith, and <chord name="Am"/>self control.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="C"/>Fruitful trees, <chord name="Em"/>the <chord name="G7"/>Spirit&#x27;s <chord name="Em/G"/>tending,<br/>
      <chord name="C"/>May we <chord name="F"/>grow <chord name="Dm"/>till <chord name="C"/>harvests <chord name="Dm/F"/>cease;<br/>
      <chord name="G7/F"/>Till <chord name="Em"/>we <chord name="F/C"/>taste, <chord name="Am"/>in <chord name="G7"/>life <chord name="C7/A#"/>unending,<br/>
      <chord name="G7/F"/>Heaven&#x27;s love and <chord name="Am"/>joy and <chord name="C/G"/>peace.
      </lines>
