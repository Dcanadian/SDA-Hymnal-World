  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>King <chord name="D/A"/>of <chord name="Bm"/>glory, <chord name="G"/>King of peace, <chord name="F#dim"/>I <chord name="G"/>will <chord name="C/G"/>love <chord name="G"/>Thee;<br/>
      <chord name="G"/>And that love <chord name="D/A"/>may <chord name="Bm"/>never <chord name="G"/>cease, I <chord name="F#dim"/>will <chord name="G"/>move <chord name="F#dim"/>Thee.<br/>
      <chord name="D/A"/>Thou hast <chord name="Em/B"/>granted <chord name="A7/G"/>my <chord name="D/F#"/>request, <chord name="G"/>Thou hast <chord name="D/A"/>heard <chord name="G"/>me;<br/>
      <chord name="G"/>Thou didst <chord name="Am/E"/>note <chord name="Bm/F#"/>my working <chord name="D/A"/>breast, <chord name="Bm"/>Thou hast <chord name="A7/G"/>spared <chord name="D/A"/>me.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>Wherefore <chord name="Bm"/>with <chord name="G"/>my utmost art <chord name="F#dim"/>I <chord name="G"/>will <chord name="C/G"/>sing <chord name="G"/>Thee,<br/>
      <chord name="G"/>And the cream <chord name="D/A"/>of <chord name="Bm"/>all my <chord name="G"/>heart I <chord name="F#dim"/>will <chord name="G"/>bring <chord name="F#dim"/>Thee.<br/>
      <chord name="D/A"/>Though my <chord name="Em/B"/>sins <chord name="Am"/>against <chord name="D/F#"/>me cried, <chord name="G"/>Thou didst <chord name="D/A"/>clear <chord name="G"/>me;<br/>
      <chord name="G"/>And alone, <chord name="Bm/F#"/>when <chord name="G"/>they <chord name="D/A"/>replied, Thou <chord name="Bm"/>didst <chord name="A7/G"/>hear <chord name="D/A"/>me.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>Seven <chord name="D/A"/>whole <chord name="Bm"/>days, <chord name="G"/>not one <chord name="F#dim"/>in <chord name="G"/>seven, I <chord name="C/G"/>will <chord name="G"/>praise <chord name="F#dim"/>Thee;<br/>
      <chord name="G"/>In my heart, <chord name="D/A"/>though <chord name="Bm"/>not in <chord name="G"/>heav&#x27;n I <chord name="F#dim"/>can <chord name="G"/>raise <chord name="F#dim"/>Thee.<br/>
      <chord name="D/A"/>Small it <chord name="Em/B"/>is, <chord name="Am"/>in <chord name="A7/G"/>this <chord name="D/F#"/>poor sort <chord name="G"/>to enroll Thee:<br/>
      <chord name="G"/>Ev&#x27;n eternity&#x27;s too <chord name="D/A"/>short <chord name="Bm"/>to extol <chord name="D/A"/>Thee.
      </lines>
    </verse>
  </lyrics>
