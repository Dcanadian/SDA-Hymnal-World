<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>381 - Holy Sabbath Day of Rest</title>
      <title>Holy Sabbath Day of Rest</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="381"/>
    </songbooks>
    <key>Eb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Doctrines</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb"/>Holy Sabbath day of rest, By our Master richly blest,<br/>
      <chord name="Bb"/>God created <chord name="Eb"/>and divine, Set aside for holy time.<br/>
      <chord name="Eb"/>Yes, the holy <chord name="Bb7/F"/>Sabbath <chord name="Ab"/>rest, By our God <chord name="Bb"/>divinely <chord name="Eb"/>blest,<br/>
      <chord name="Ab"/>It to us a sign shall be <chord name="Eb"/>Throughout all eternity.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Bb"/>Yes, the holy Sabbath rest,<br/>
      <chord name="Eb"/>By our God divinely <chord name="Ab"/>blest,<br/>
      <chord name="Gm"/>It to <chord name="Bb7/F"/>us <chord name="Ab"/>a sign <chord name="Bb"/>shall be<br/>
      <chord name="Eb"/>Throughout all eternity.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Eb"/>Seek not pleasures of this earth,<br/>
      <chord name="Bb"/>With <chord name="Eb"/>its folly, noise, and mirth,<br/>
      <chord name="Eb"/>There are <chord name="Bb7/F"/>better <chord name="Ab"/>things <chord name="Bb"/>in store,<br/>
      <chord name="Ab"/>Over on the <chord name="Eb"/>other shore.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Eb"/>As the Sabbath draweth on<br/>
      <chord name="Bb"/>Friday <chord name="Eb"/>eve at set of sun,<br/>
      <chord name="Eb"/>Christian <chord name="Bb7/F"/>household <chord name="Bb"/>then should <chord name="Eb"/>meet,<br/>
      <chord name="Ab"/>Sing and pray at <chord name="Eb"/>Jesus&#x27;feet.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Eb"/>Asking Him for saving grace,<br/>
      <chord name="Bb"/>Also <chord name="Eb"/>vict&#x27;ry in the race,<br/>
      <chord name="Eb"/>And to <chord name="Bb7/F"/>help <chord name="Ab"/>us by <chord name="Bb"/>His pow&#x27;r,<br/>
      <chord name="Ab"/>To keep holy <chord name="Eb"/>every hour.
      </lines>
    </verse>
  </lyrics>
</song>
