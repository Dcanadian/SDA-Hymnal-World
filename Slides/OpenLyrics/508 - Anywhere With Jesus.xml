<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>508 - Anywhere With Jesus</title>
      <title>Anywhere With Jesus</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="508"/>
    </songbooks>
    <key>D</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>Any<chord name="G"/>where with <chord name="D"/>Jesus I can safe<chord name="G"/>ly <chord name="D"/>go,<br/>
      <chord name="A7"/>Anywhere He leads me in this <chord name="D"/>world <chord name="A7"/>be<chord name="D"/>low;<br/>
      <chord name="D"/>Any<chord name="G"/>where with<chord name="D"/>out Him, dearest joys <chord name="G"/>would <chord name="D"/>fade;<br/>
      Anywhere with <chord name="G"/>Jesus I am <chord name="D"/>not <chord name="A7"/>a<chord name="D"/>fraid.<br/>
      <chord name="A7"/>Anywhere! <chord name="D"/>Anywhere!<br/>
      <chord name="Bm"/>Fear I <chord name="E7"/>cannot <chord name="A"/>know;<br/>
      <chord name="D"/>Anywhere with <chord name="G"/>Jesus I can <chord name="D"/>safe<chord name="A7"/>ly <chord name="D"/>go.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="D"/>Anywhere, <chord name="G"/>anywhere! <chord name="D"/>Fear <chord name="G"/>I <chord name="D"/>cannot know;<br/>
      <chord name="A7"/>Anywhere <chord name="D"/>with Jesus <chord name="A7"/>I can <chord name="D"/>safely go.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>Anywhere <chord name="G"/>with <chord name="D"/>Jesus I <chord name="G"/>am <chord name="D"/>not alone;<br/>
      <chord name="A7"/>Other friends <chord name="D"/>may fail me, <chord name="A7"/>He is <chord name="D"/>still my own;<br/>
      <chord name="D"/>Though <chord name="G"/>His hand <chord name="D"/>may lead <chord name="G"/>me over <chord name="D"/>drearest ways,<br/>
      <chord name="G"/>Anywhere with <chord name="D"/>Jesus is <chord name="A7"/>a house <chord name="D"/>of praise.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D"/>Anywhere <chord name="G"/>with Jesus <chord name="D"/>I <chord name="G"/>can go <chord name="D"/>to sleep,<br/>
      <chord name="A7"/>When the <chord name="D"/>darkening shadows <chord name="A7"/>round about <chord name="D"/>me creep,<br/>
      <chord name="D"/>Knowing <chord name="G"/>I <chord name="D"/>shall waken <chord name="G"/>nevermore <chord name="D"/>to roam;<br/>
      <chord name="G"/>Anywhere with <chord name="D"/>Jesus will <chord name="A7"/>be home, <chord name="D"/>sweet home.
      </lines>
    </verse>
  </lyrics>
</song>
