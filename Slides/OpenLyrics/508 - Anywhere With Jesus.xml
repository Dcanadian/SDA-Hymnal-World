<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>508 - Anywhere With Jesus</title>
      <title>Anywhere With Jesus</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="508"/>
    </songbooks>
    <key>D</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>Anywhere with <chord name="G/D"/>Jesus <chord name="D/F#"/>I can safely go,<br/>
      <chord name="A7"/>Anywhere He leads me in this <chord name="D"/>world <chord name="A7/C#"/>below;<br/>
      <chord name="D"/>Anywhere <chord name="G/D"/>without <chord name="D/F#"/>Him, dearest joys <chord name="A7"/>would <chord name="D"/>fade;<br/>
      <chord name="D/A"/>Anywhere with Jesus I <chord name="Bm"/>am <chord name="D/A"/>not <chord name="A7/G"/>afraid.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="A"/>Anywhere, <chord name="D/A"/>anywhere! <chord name="G/D"/>Fear I cannot <chord name="A"/>know;<br/>
      <chord name="D/A"/>Anywhere with Jesus I can <chord name="A7/C#"/>safely <chord name="D/F#"/>go.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>Anywhere <chord name="G/D"/>with <chord name="D"/>Jesus I am not <chord name="A7"/>alone;<br/>
      <chord name="A7"/>Other friends may fail me, He is <chord name="D"/>still <chord name="A7/C#"/>my <chord name="D"/>own;<br/>
      <chord name="D"/>Though His hand <chord name="G/D"/>may <chord name="D"/>lead me over drearest ways,<br/>
      <chord name="D/A"/>Anywhere with Jesus is <chord name="Bm"/>a <chord name="D/A"/>house <chord name="A7/G"/>of <chord name="D/F#"/>praise.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D"/>Anywhere <chord name="G/D"/>with <chord name="D"/>Jesus I can go <chord name="A7"/>to <chord name="D"/>sleep,<br/>
      <chord name="A7"/>When the darkening shadows round about me <chord name="D"/>creep,<br/>
      <chord name="D"/>Knowing I <chord name="G/D"/>shall <chord name="D"/>waken nevermore <chord name="A7"/>to <chord name="D"/>roam;<br/>
      <chord name="D/A"/>Anywhere with Jesus will <chord name="Bm"/>be <chord name="D/A"/>home, <chord name="A7/G"/>sweet <chord name="D/F#"/>home.
      </lines>
    </verse>
  </lyrics>
</song>
