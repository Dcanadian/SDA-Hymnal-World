<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>021 - Immortal, Invisible, God Only Wise</title>
      <title>Immortal, Invisible, God Only Wise</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="21"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Worship</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>Immortal, <chord name="Am/C"/>invisible, <chord name="G"/>God only <chord name="F#dim"/>wise,<br/>
      <chord name="G"/>In <chord name="C/G"/>light inaccessible <chord name="G"/>hid from <chord name="F#dim"/>our eyes,<br/>
      <chord name="G/B"/>Most <chord name="Em"/>blessed, most <chord name="D"/>glorious, <chord name="G"/>the Ancient of days,<br/>
      <chord name="G"/>Almighty <chord name="Am/C"/>victorious, <chord name="G"/>Thy great name <chord name="D7/C"/>we <chord name="G"/>praise.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>Unresting, <chord name="Am/C"/>unhasting, <chord name="G"/>and silent <chord name="F#dim"/>as light,<br/>
      <chord name="G"/>Nor <chord name="C/G"/>wanting, <chord name="Am/C"/>nor <chord name="D/A"/>wasting, <chord name="G"/>Thou rulest <chord name="F#dim"/>in might;<br/>
      <chord name="G/B"/>Thy <chord name="Em"/>justice, <chord name="D"/>like <chord name="G/D"/>mountains, high <chord name="Bm/F#"/>soaring <chord name="G"/>above<br/>
      <chord name="G"/>Thy <chord name="Em"/>clouds, which <chord name="Am/C"/>are <chord name="D/A"/>fountains <chord name="G"/>of goodness <chord name="D7/C"/>and <chord name="G"/>love.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>To <chord name="C/G"/>all, life <chord name="Am/C"/>Thou <chord name="D/A"/>givest, <chord name="G"/>to both great <chord name="F#dim"/>and small;<br/>
      <chord name="G"/>In <chord name="C/G"/>all life <chord name="Am/C"/>Thou <chord name="D/A"/>livest, <chord name="G"/>the true life <chord name="F#dim"/>of all;<br/>
      <chord name="G/B"/>We blossom <chord name="Em"/>and <chord name="D"/>flourish <chord name="G"/>as leaves on the tree,<br/>
      <chord name="G"/>And <chord name="Em"/>wither <chord name="Am/C"/>and <chord name="D/A"/>perish <chord name="G"/>- but naught changeth Thee.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="G"/>Great <chord name="C/G"/>Father <chord name="Am/C"/>of <chord name="D/A"/>glory, <chord name="G"/>pure Father <chord name="F#dim"/>of light,<br/>
      <chord name="G"/>Thine <chord name="C/G"/>angels <chord name="Am/C"/>adore <chord name="D/F#"/>Thee, <chord name="G"/>all veiling <chord name="F#dim"/>their sight;<br/>
      <chord name="G/B"/>All <chord name="Em"/>praise we <chord name="D"/>would <chord name="G/D"/>render; O <chord name="Bm/F#"/>help <chord name="G"/>us to see<br/>
      <chord name="G"/>&#x27;Tis <chord name="Em"/>only <chord name="Am/C"/>the <chord name="D/A"/>splendor <chord name="G"/>of light hideth Thee!
      </lines>
    </verse>
  </lyrics>
</song>
