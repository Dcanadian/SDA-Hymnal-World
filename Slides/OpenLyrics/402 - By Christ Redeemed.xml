    <themes>
      <theme>Doctrines</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb"/>By Christ redeemed, In <chord name="Bb7/D"/>Christ restored,<br/>
      <chord name="Eb/G"/>We <chord name="Ab"/>keep <chord name="Bb/D"/>the <chord name="Bb7/D"/>memory <chord name="Bb"/>adored,<br/>
      <chord name="Ab"/>And show the <chord name="Bb7/Ab"/>death <chord name="Ab"/>of <chord name="Bb7/Ab"/>our <chord name="Gm"/>dear <chord name="Eb/G"/>Lord,<br/>
      <chord name="Bb7"/>Until <chord name="Eb"/>He come.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Eb"/>His broken <chord name="Gm"/>body <chord name="Eb"/>in <chord name="Bb7/D"/>our stead Is <chord name="Gm"/>here,<br/>
      <chord name="Eb/G"/>In <chord name="Gm"/>this <chord name="Bb7/D"/>memorial <chord name="Bb"/>bread;<br/>
      <chord name="Ab"/>And so our <chord name="Bb7/Ab"/>feeble love <chord name="Gm"/>is <chord name="Eb/G"/>fed,<br/>
      <chord name="Bb7"/>Until <chord name="Eb"/>He come.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Eb"/>His fearful <chord name="Gm"/>drops <chord name="Eb"/>of <chord name="Bb7/D"/>agony,<br/>
      <chord name="Eb/G"/>His <chord name="Ab"/>life <chord name="Bb/D"/>blood <chord name="Bb7/D"/>shed <chord name="Ab"/>for <chord name="F7/A"/>us <chord name="Bb"/>we <chord name="Eb"/>see;<br/>
      <chord name="Ab"/>The wine shall <chord name="Bb7/Ab"/>tell <chord name="Ab"/>the <chord name="Bb7/Ab"/>mystery,<br/>
      <chord name="Bb7"/>Until <chord name="Eb"/>He come.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Eb"/>And thus that <chord name="Fm"/>dark <chord name="Eb"/>betrayal <chord name="Bb7/Ab"/>night,<br/>
      <chord name="Eb/G"/>With <chord name="Ab"/>the <chord name="Bb/D"/>last <chord name="Gm"/>advent <chord name="Bb"/>unite----<br/>
      <chord name="Ab"/>The shame, the <chord name="Bb7/Ab"/>glory, by <chord name="Gm"/>this <chord name="Eb/G"/>rite,<br/>
      <chord name="Bb7"/>Until <chord name="Eb"/>He come.
      </lines>
    </verse>
  </lyrics>
</song>
