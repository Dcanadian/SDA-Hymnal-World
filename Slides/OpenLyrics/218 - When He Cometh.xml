<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>218 - When He Cometh</title>
      <title>When He Cometh</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="218"/>
    </songbooks>
    <key>D</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3</verseOrder>
    <themes>
      <theme>Jesus Christ</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F#m"/>When He cometh, when He <chord name="A7/G"/>cometh To <chord name="F#m"/>make up His <chord name="G"/>jewels,<br/>
      <chord name="D/A"/>All His <chord name="Em/G"/>jewels, <chord name="D/F#"/>precious jewels, His loved and <chord name="A7/G"/>His own.<br/>
      <chord name="F#m"/>Like the stars of <chord name="G"/>the morning, <chord name="D"/>His bright crown <chord name="Em/G"/>adorning,<br/>
      <chord name="F#m"/>They shall shine <chord name="G"/>in their <chord name="Bm"/>beauty, <chord name="D"/>Bright gems <chord name="F#m"/>for His <chord name="D/F#"/>crown.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="D/F#"/>Like the <chord name="A"/>stars of <chord name="D/A"/>the morning,<br/>
      <chord name="F#m"/>His brightness <chord name="G"/>adorning,<br/>
      <chord name="D"/>They shall shine in <chord name="G"/>their beauty,<br/>
      <chord name="D/F#"/>Bright gems <chord name="Em/G"/>for His <chord name="D/F#"/>crown.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F#m"/>He will gather, <chord name="A7/G"/>He <chord name="F#m"/>will gather<br/>
      <chord name="D/A"/>The <chord name="Em/G"/>gems <chord name="D/F#"/>for His kingdom;<br/>
      <chord name="F#m"/>All the pure <chord name="G"/>ones, <chord name="D"/>all the bright <chord name="Em/G"/>ones,<br/>
      <chord name="F#m"/>His <chord name="G"/>loved <chord name="Bm"/>and <chord name="D"/>His <chord name="F#m"/>own.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F#m"/>Little children, <chord name="A7/G"/>little <chord name="F#m"/>children,<br/>
      <chord name="D/A"/>Who <chord name="Em/G"/>love <chord name="D/F#"/>their Redeemer,<br/>
      <chord name="F#m"/>Are the jewels, <chord name="D"/>precious <chord name="Em/G"/>jewels,<br/>
      <chord name="F#m"/>His <chord name="G"/>loved <chord name="Bm"/>and <chord name="D"/>His <chord name="F#m"/>own.
      </lines>
    </verse>
  </lyrics>
</song>
