<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>218 - When He Cometh</title>
      <title>When He Cometh</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="218"/>
    </songbooks>
    <key>D</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3</verseOrder>
    <themes>
      <theme>Jesus Christ</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>When He cometh, when He cometh <chord name="G"/>To <chord name="D"/>make up <chord name="A7"/>His <chord name="D"/>jewels,<br/>
      <chord name="D"/>All His jewels, precious jewels, <chord name="G"/>His <chord name="D"/>loved and <chord name="A7"/>His <chord name="D"/>own.<br/>
      <chord name="D7"/>Like the <chord name="G"/>stars of the <chord name="D"/>morning, His <chord name="Bm"/>bright crown <chord name="A"/>a<chord name="D"/>dorning,<br/>
      <chord name="D7"/>They shall <chord name="G"/>shine in their <chord name="D"/>beauty, <chord name="G"/>Bright <chord name="D"/>gems for <chord name="A7"/>His <chord name="D"/>crown.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="D"/>Like <chord name="G"/>the <chord name="D"/>stars <chord name="A7"/>of <chord name="D"/>the morning,<br/>
      <chord name="D"/><chord name="G"/>His <chord name="D"/><chord name="A7"/>brightness <chord name="D"/>adorning,<br/>
      <chord name="D7"/>They <chord name="G"/>shall <chord name="D"/>shine <chord name="Bm"/>in <chord name="A"/>their <chord name="D"/>beauty,<br/>
      <chord name="D7"/><chord name="G"/>Bright <chord name="D"/>gems <chord name="G"/><chord name="D"/>for <chord name="A7"/>His <chord name="D"/>crown.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>He <chord name="G"/>will <chord name="D"/>gather, <chord name="A7"/>He <chord name="D"/>will gather<br/>
      <chord name="D"/>The <chord name="G"/>gems <chord name="D"/>for <chord name="A7"/>His <chord name="D"/>kingdom;<br/>
      <chord name="D7"/>All <chord name="G"/>the <chord name="D"/>pure ones, <chord name="Bm"/>all <chord name="A"/>the <chord name="D"/>bright ones,<br/>
      <chord name="D7"/><chord name="G"/>His <chord name="D"/>loved <chord name="G"/><chord name="D"/>and <chord name="A7"/>His <chord name="D"/>own.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D"/><chord name="G"/>Little <chord name="D"/>children, <chord name="A7"/>little <chord name="D"/>children,<br/>
      <chord name="D"/><chord name="G"/>Who <chord name="D"/>love <chord name="A7"/>their <chord name="D"/>Redeemer,<br/>
      <chord name="D7"/><chord name="G"/>Are <chord name="D"/>the <chord name="Bm"/>jewels, <chord name="A"/>precious <chord name="D"/>jewels,<br/>
      <chord name="D7"/><chord name="G"/>His <chord name="D"/>loved <chord name="G"/><chord name="D"/>and <chord name="A7"/>His <chord name="D"/>own.
      </lines>
    </verse>
  </lyrics>
</song>
