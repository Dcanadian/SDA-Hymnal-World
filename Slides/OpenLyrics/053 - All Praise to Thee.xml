    <verse name="v4">
      <lines>
      <chord name="G"/>Praise <chord name="D"/>God, from <chord name="Em"/>whom <chord name="G/B"/>all <chord name="C"/>blessings <chord name="G"/>flow;<br/>
      <chord name="G/B"/>praise him, <chord name="Am"/>all creatures <chord name="C/G"/>here <chord name="D7/F#"/>below;<br/>
      <chord name="G/B"/>praise him <chord name="C"/>above, <chord name="G"/>ye heavenly host;<br/>
      <chord name="G/B"/>praise <chord name="C"/>Father, <chord name="Em"/>Son, <chord name="Bm"/>and <chord name="Am/C"/>Holy <chord name="G"/>Ghost.
      </lines>
