  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>All <chord name="D"/>praise to <chord name="Em"/>thee, <chord name="G/B"/>my <chord name="C"/>God, <chord name="D"/>this <chord name="G"/>night,<br/>
      <chord name="G/B"/>for <chord name="Am"/>all the <chord name="G"/>blessings <chord name="C/G"/>of <chord name="D7/F#"/>the <chord name="G"/>light!<br/>
