  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>In the <chord name="Dm"/>morning, <chord name="C/G"/>when I rise, In the <chord name="Em"/>morning, when <chord name="Dm/F"/>I <chord name="F"/>rise<br/>
      <chord name="G7/F"/>In the morning, <chord name="F"/>when <chord name="Dm"/>I <chord name="Em"/>rise, <chord name="C/G"/>Give <chord name="Em"/>me Jesus.<br/>
      <chord name="F"/>Give me <chord name="G7/F"/>Jesus, <chord name="C/E"/>Give me Jesus.<br/>
      <chord name="C/G"/>You can have all <chord name="G"/>this world, <chord name="Am/E"/>Give me <chord name="G7/F"/>Jesus.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="F"/>Give me <chord name="G7/F"/>Jesus.<br/>
      <chord name="Dm/A"/>Give me <chord name="C7/A#"/>Jesus,<br/>
      <chord name="C7/A#"/>Give <chord name="A#"/>me <chord name="Am"/>Jesus.<br/>
      <chord name="Am"/>You can <chord name="C/G"/>have <chord name="F"/>all <chord name="G7/F"/>this <chord name="C/E"/>world,<br/>
      <chord name="C/E"/>Just give me Jesus.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>Dark <chord name="Dm"/>mid-night <chord name="C/E"/>was <chord name="Em"/>my <chord name="Dm/F"/>cry,<br/>
      <chord name="G7/F"/>Dark mid-night <chord name="Em"/>was <chord name="C/G"/>my <chord name="Em"/>cry,<br/>
      <chord name="F"/>Dark midnight <chord name="C/E"/>was my cry,<br/>
      <chord name="C/G"/>Give me <chord name="G"/>Jesus.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>Just <chord name="Dm"/>about <chord name="C/E"/>the break <chord name="Em"/>of <chord name="Dm/F"/>day,<br/>
      <chord name="G7/F"/>Just about <chord name="Dm"/>the <chord name="Em"/>break of day,<br/>
      <chord name="F"/>Just about <chord name="G7/F"/>the <chord name="C/E"/>break of day,<br/>
      <chord name="C/G"/>Give me <chord name="G"/>Jesus.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F"/>Oh, <chord name="Dm"/>when <chord name="C/G"/>I come <chord name="Em"/>to <chord name="Dm/F"/>die,<br/>
      <chord name="G7/F"/>Oh, when <chord name="F"/>I <chord name="Em"/>come <chord name="C/G"/>to <chord name="Em"/>die,<br/>
      <chord name="F"/>Oh, when <chord name="G7/F"/>I <chord name="C/E"/>come to die,<br/>
      <chord name="C/G"/>Give me <chord name="G"/>Jesus.
      </lines>
    </verse>
