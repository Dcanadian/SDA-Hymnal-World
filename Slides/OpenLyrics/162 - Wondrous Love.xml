      <title>162 - Wondrous Love</title>
      <title>Wondrous Love</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="162"/>
    </songbooks>
    <key>Dm</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Jesus Christ</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Dm"/>What wondrous <chord name="C/E"/>love <chord name="Gm"/>is <chord name="A"/>this,<br/>
      <chord name="Gm"/>O <chord name="C"/>my <chord name="Dm/F"/>soul, O <chord name="F"/>my <chord name="Edim"/>soul?<br/>
      <chord name="A"/>What <chord name="Am"/>wondrous <chord name="B7"/>love <chord name="F/C"/>is <chord name="Gm"/>this, <chord name="Dm/F"/>O <chord name="Edim"/>my <chord name="E7"/>soul?<br/>
      <chord name="C"/>What wondrous love <chord name="A"/>is <chord name="Am"/>this<br/>
      <chord name="Bb"/>That <chord name="C/G"/>caused <chord name="A7/G"/>the <chord name="F"/>Lord of <chord name="C/G"/>bliss<br/>
      <chord name="Dm/A"/>To bear <chord name="F"/>the <chord name="Gm"/>dreadful <chord name="Edim"/>curse <chord name="C/G"/>for <chord name="Dm/F"/>my <chord name="C/E"/>soul, for <chord name="Bm"/>my <chord name="C/E"/>soul;<br/>
      <chord name="A"/>To <chord name="A7"/>bear <chord name="F/C"/>the <chord name="Dm"/>dreadful <chord name="C/G"/>curse <chord name="F"/>for <chord name="Edim"/>my <chord name="E"/>soul?
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Dm"/>To God and <chord name="C"/>to the Lamb <chord name="Gm"/>I will <chord name="A"/>sing,<br/>
      <chord name="A"/>I <chord name="Am"/>will sing; <chord name="B7"/>To <chord name="F/C"/>God <chord name="Gm"/>and <chord name="Dm/F"/>to <chord name="Edim"/>the <chord name="E7"/>Lamb,<br/>
      <chord name="C"/>I will sing; <chord name="F/C"/>To <chord name="C"/>God and <chord name="A"/>to <chord name="Am"/>the <chord name="Dm/A"/>Lamb<br/>
      <chord name="Bb"/>Who is <chord name="C/G"/>the great <chord name="A7/G"/>I am, <chord name="F"/>While millions <chord name="C/G"/>join the <chord name="Dm/A"/>theme,<br/>
      <chord name="A"/>I will <chord name="A7"/>sing, I <chord name="F/C"/>will sing; <chord name="Dm"/>While <chord name="Edim"/>millions <chord name="C/G"/>join <chord name="F"/>the theme, <chord name="Edim"/>I will <chord name="E"/>sing.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Dm"/>And when from death <chord name="C"/>I&#x27;m free, I&#x27;ll sing <chord name="Gm"/>on, I&#x27;ll <chord name="A"/>sing on;<br/>
      <chord name="A"/>And <chord name="Am"/>when from <chord name="B7"/>death <chord name="F/C"/>I&#x27;m <chord name="Gm"/>free, <chord name="Dm/F"/>I&#x27;ll <chord name="Edim"/>sing <chord name="E7"/>on;<br/>
      <chord name="C"/>And when <chord name="F/C"/>from <chord name="C"/>death <chord name="A"/>I&#x27;m <chord name="Am"/>free,<br/>
      <chord name="Bb"/>I&#x27;ll sing <chord name="C/G"/>and joyful <chord name="A7/G"/>be, <chord name="F"/>And through eternity<br/>
      <chord name="A"/>I&#x27;ll sing <chord name="A7"/>on, I&#x27;ll <chord name="F/C"/>sing <chord name="Dm"/>on! And <chord name="Edim"/>through eternity, I&#x27;ll sing <chord name="E"/>on
      </lines>
    </verse>
  </lyrics>
</song>
