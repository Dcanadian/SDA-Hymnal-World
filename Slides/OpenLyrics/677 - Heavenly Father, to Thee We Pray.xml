  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb"/>Heavenly <chord name="Gm"/>Father, to <chord name="Cm"/>Thee <chord name="Bb"/>we <chord name="Eb"/>pray,<br/>
      <chord name="Eb"/>On the <chord name="Gm"/>holy Sabbath <chord name="Bb"/>day;<br/>
      <chord name="Bb7"/>Through Thy Word Thy <chord name="Ab/Eb"/>will <chord name="Eb"/>make <chord name="Bb"/>known;<br/>
      <chord name="Gm"/>May <chord name="Eb"/>each <chord name="Bb/D"/>heart <chord name="Bb7/D"/>become <chord name="Eb"/>Thy throne,<br/>
      <chord name="Eb"/>Let Thy <chord name="Gm/D"/>living <chord name="Cm"/>water flow<br/>
      <chord name="Bb7"/>That we <chord name="Eb"/>Thy boundless <chord name="Cm"/>love <chord name="Eb/Bb"/>may know.<br/>
      <chord name="Bb7"/>Amen.
      </lines>
    </verse>
  </lyrics>
