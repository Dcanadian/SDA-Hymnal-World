<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>452 - What Heavenly Music</title>
      <title>What Heavenly Music</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="452"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Early Advent</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>What heavenly music <chord name="C"/>steals over the sea!<br/>
      <chord name="Gm/Bb"/>Entrancing <chord name="F"/>the senses like sweet melody!<br/>
      <chord name="C"/>Tis the voice of <chord name="Dm"/>the <chord name="Bb"/>angels <chord name="C7"/>born <chord name="C"/>soft on the air<br/>
      <chord name="F"/>For me they <chord name="Am"/>are singing; <chord name="Gm"/>their welcome <chord name="Dm"/>Ihear
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>On the banks of old Jordan, <chord name="C"/>here gazing I <chord name="Dm"/>stand,<br/>
      <chord name="Gm/Bb"/>And earnestly <chord name="F"/>longing, I stretch forth my hand;<br/>
      <chord name="C"/>Send a convoy <chord name="Dm"/>of <chord name="Bb"/>angels, <chord name="C7"/>dear <chord name="C"/>Jesus, I pray!<br/>
      <chord name="F"/>Let me join <chord name="Am"/>that sweet music; <chord name="Gm"/>come, <chord name="Dm"/>take me away.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>Though dark are the waters <chord name="C"/>and rough is the wave,<br/>
      <chord name="Gm/Bb"/>If Jesus <chord name="F"/>permit, the wild surges I&#x27;ll brave;<br/>
      <chord name="C"/>For that heavenly <chord name="Bb"/>music <chord name="C7"/>hath <chord name="C"/>ravished me so,<br/>
      <chord name="F"/>I must join <chord name="Am"/>in that chorus! <chord name="Gm"/>I&#x27;ll <chord name="Dm"/>go! let me <chord name="F/C"/>go!
      </lines>
    </verse>
  </lyrics>
</song>
