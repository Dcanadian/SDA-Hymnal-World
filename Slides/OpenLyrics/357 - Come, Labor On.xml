  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Fm"/>Come, <chord name="Cm/G"/>labor <chord name="Ab"/>on.<br/>
      <chord name="Fm"/>Who dares <chord name="Ab"/>stand <chord name="Bbm"/>idle <chord name="Ab"/>on <chord name="Db"/>the <chord name="Cm"/>harvest plain<br/>
      <chord name="Eb"/>While <chord name="Fm"/>all <chord name="Eb"/>around him <chord name="Ab"/>waves <chord name="Fm"/>the golden <chord name="Cm"/>grain?<br/>
      <chord name="Fm"/>And to <chord name="Eb"/>each <chord name="Db"/>servant <chord name="Cm"/>does <chord name="Ab"/>the Master <chord name="Fm"/>say,<br/>
      <chord name="Cm/G"/>&quot;Go <chord name="Ab"/>work <chord name="Gdim"/>today.&quot;
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Fm"/>Come, <chord name="Cm/G"/>labor <chord name="Ab"/>on.<br/>
      <chord name="Fm"/>Claim <chord name="Gdim"/>the <chord name="Ab"/>high <chord name="Bbm"/>calling <chord name="Ab"/>angels <chord name="Cm"/>cannot share;<br/>
      <chord name="Eb"/>To young <chord name="Fm"/>and <chord name="Eb"/>old the <chord name="Ab"/>gospel <chord name="Fm"/>gladness <chord name="Cm"/>bear;<br/>
      <chord name="Fm"/>Redeem <chord name="Eb"/>the <chord name="Db"/>time; <chord name="Eb"/>its <chord name="Cm"/>hours <chord name="Ab"/>too swiftly <chord name="Fm"/>fly.<br/>
      <chord name="Cm/G"/>The <chord name="Ab"/>night <chord name="Gdim"/>draws <chord name="Cm"/>nigh.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Fm"/>Come, <chord name="Cm/G"/>labor <chord name="Ab"/>on.<br/>
      <chord name="Fm"/>No <chord name="Gdim"/>time <chord name="Ab"/>for <chord name="Bbm"/>rest; <chord name="Cm"/>till <chord name="Ab"/>glows <chord name="Db"/>the <chord name="Cm"/>western sky,<br/>
      <chord name="Eb"/>Till the <chord name="Fm"/>long <chord name="Eb"/>shadows <chord name="Ab"/>o&#x27;r <chord name="Cm/G"/>our <chord name="Fm"/>pathway <chord name="Cm"/>lie,<br/>
      <chord name="Fm"/>And a glad <chord name="Eb"/>sound <chord name="Db"/>comes <chord name="Cm"/>with <chord name="Ab"/>the setting <chord name="Fm"/>sun,<br/>
      <chord name="Cm/G"/>&quot;Well <chord name="Ab"/>done, <chord name="Gdim"/>well <chord name="Cm"/>done!&quot;
      </lines>
    </verse>
