  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C"/>My <chord name="F"/>hope is built on <chord name="C"/>nothing less <chord name="F"/>than <chord name="Bb"/>Jesus&#x27; blood and <chord name="C"/>righteous<chord name="F"/>ness.<br/>
      <chord name="C"/>I <chord name="F"/>dare not trust the <chord name="C"/>sweetest frame, <chord name="F"/>but <chord name="Bb"/>wholly lean on <chord name="C"/>Jesus&#x27; <chord name="F"/>name.<br/>
      <chord name="F"/>On Christ <chord name="C7"/>the <chord name="F"/>solid <chord name="Bb"/>rock I stand; all <chord name="F"/>other ground is sinking <chord name="C"/>sand,<br/>
      All <chord name="F"/>other <chord name="Bb"/>ground <chord name="F"/>is <chord name="C"/>sinking <chord name="F"/>sand.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="C"/>On <chord name="F"/>Christ <chord name="C"/>the <chord name="F"/>solid <chord name="Bb"/>rock <chord name="C"/>I <chord name="F"/>stand;<br/>
      <chord name="C"/><chord name="F"/>all <chord name="C"/>other <chord name="F"/>ground <chord name="Bb"/>is <chord name="C"/>sinking <chord name="F"/>sand,<br/>
      <chord name="F"/>all <chord name="C7"/>other <chord name="F"/>ground <chord name="Bb"/>is <chord name="F"/>sinking <chord name="C"/>sand.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="C"/><chord name="F"/>When <chord name="C"/>Darkness <chord name="F"/>veils <chord name="Bb"/>his <chord name="C"/>lovely <chord name="F"/>face,<br/>
      <chord name="C"/><chord name="F"/>I <chord name="C"/>rest <chord name="F"/>on <chord name="Bb"/>his <chord name="C"/>unchanging <chord name="F"/>grace.<br/>
      <chord name="F"/>in <chord name="C7"/>every <chord name="F"/>high <chord name="Bb"/>and <chord name="F"/>stormy <chord name="C"/>gale,<br/>
      <chord name="F"/>my <chord name="Bb"/>anchor <chord name="F"/>holds <chord name="C"/>within <chord name="F"/>the veil.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="C"/><chord name="F"/>His <chord name="C"/>oath, <chord name="F"/>his <chord name="Bb"/>covenant, <chord name="C"/>his <chord name="F"/>blood<br/>
      <chord name="C"/><chord name="F"/>supports <chord name="C"/>me <chord name="F"/>in <chord name="Bb"/>the <chord name="C"/>whelming <chord name="F"/>flood.<br/>
      <chord name="F"/>When <chord name="C7"/>all <chord name="F"/>around <chord name="Bb"/>my <chord name="F"/>soul <chord name="C"/>gives way,<br/>
      <chord name="F"/>he <chord name="Bb"/>then is <chord name="F"/>all <chord name="C"/>my hope <chord name="F"/>and stay.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="C"/>When <chord name="F"/>He <chord name="C"/>shall <chord name="F"/>come <chord name="Bb"/>with <chord name="C"/>trumpet <chord name="F"/>sound,<br/>
      <chord name="C"/>O <chord name="F"/>may <chord name="C"/>I <chord name="F"/>then <chord name="Bb"/>in <chord name="C"/>him <chord name="F"/>be found!<br/>
      <chord name="F"/><chord name="C7"/>Dressed <chord name="F"/>in <chord name="Bb"/>his <chord name="F"/>righteousness <chord name="C"/>alone,<br/>
      <chord name="F"/>faultless <chord name="Bb"/>to <chord name="F"/>stand <chord name="C"/>before <chord name="F"/>the throne.
      </lines>
    </verse>
  </lyrics>
