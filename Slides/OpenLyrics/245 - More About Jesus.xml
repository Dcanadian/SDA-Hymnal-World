<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>245 - More About Jesus</title>
      <title>More About Jesus</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="245"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Jesus Christ</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>More about Jesus, I would know, <chord name="D"/>More of His grace to <chord name="G"/>others show;<br/>
      <chord name="G"/>More of His saving fullness see, <chord name="D7"/>More of His love who died for <chord name="G"/>me.<br/>
      <chord name="G"/>More, more about Jesus, <chord name="D"/>More, more about <chord name="G"/>Jesus;<br/>
      <chord name="G"/>More of His saving fullness see, <chord name="D7"/>More of His love who died for <chord name="G"/>me.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="G"/>More, <chord name="D"/>more <chord name="G"/>about Jesus,<br/>
      <chord name="G"/>More, <chord name="D7"/>more <chord name="G"/>about Jesus;<br/>
      <chord name="G"/>More of <chord name="D"/>His saving <chord name="G"/>fullness see,<br/>
      <chord name="G"/>More of <chord name="D7"/>His love who <chord name="G"/>died for me.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>More about <chord name="D"/>Jesus, let <chord name="G"/>me learn,<br/>
      <chord name="G"/>More of <chord name="D7"/>His holy <chord name="G"/>will discern;<br/>
      <chord name="G"/>Spirit of <chord name="D"/>God, my <chord name="G"/>teacher be,<br/>
      <chord name="G"/>Showing the <chord name="D7"/>things of <chord name="G"/>Christ to me.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>More about <chord name="D"/>Jesus, in <chord name="G"/>His word,<br/>
      <chord name="G"/>Holding <chord name="D7"/>communion with <chord name="G"/>my Lord;<br/>
      <chord name="G"/>Hearing His <chord name="D"/>voice in <chord name="G"/>every line,<br/>
      <chord name="G"/>Making <chord name="D7"/>each faithful <chord name="G"/>saying mine.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="G"/>More about <chord name="D"/>Jesus, on <chord name="G"/>His throne,<br/>
      <chord name="G"/>Riches in <chord name="D7"/>glory all <chord name="G"/>His own;<br/>
      <chord name="G"/>More of <chord name="D"/>His kingdom&#x27;s <chord name="G"/>sure increase,<br/>
      <chord name="G"/>More of <chord name="D7"/>His coming, <chord name="G"/>Prince of Peace.
      </lines>
    </verse>
  </lyrics>
</song>
