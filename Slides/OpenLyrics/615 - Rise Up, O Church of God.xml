      <title>615 - Rise Up, O Church of God</title>
      <title>Rise Up, O Church of God</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="615"/>
    </songbooks>
    <key>Bb</key>
    <tempo type="bpm">Moderato</tempo>
