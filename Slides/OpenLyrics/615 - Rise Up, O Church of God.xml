    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Rise <chord name="Bb"/>up, <chord name="F"/>O <chord name="Dm"/>men <chord name="Bb"/>of <chord name="Eb"/>God!<br/>
      <chord name="Bb"/>His <chord name="Eb"/>kingdom <chord name="Bb"/>tarries <chord name="Cm"/>long.<br/>
      <chord name="F"/>Bring <chord name="Bb"/>in <chord name="F/A"/>the day <chord name="Eb/G"/>of <chord name="Bb/F"/>brotherhood<br/>
      <chord name="Dm"/>And <chord name="Eb"/>end the <chord name="Bb/D"/>night <chord name="F"/>of <chord name="F7"/>wrong.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>Let <chord name="Bb"/>women <chord name="Dm"/>all <chord name="Bb"/>rise <chord name="Eb"/>up!<br/>
      <chord name="Bb"/>Have <chord name="Eb"/>done with <chord name="Bb"/>lesser <chord name="Cm"/>things.<br/>
      <chord name="F"/>Give <chord name="Bb"/>heart <chord name="F/A"/>and mind <chord name="Eb/G"/>and <chord name="Bb/F"/>soul <chord name="Cm/Eb"/>and <chord name="Gm"/>strength<br/>
      <chord name="Dm"/>to <chord name="Eb"/>serve the <chord name="Bb/D"/>King <chord name="F"/>of <chord name="F7"/>kings.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>Rise <chord name="Bb"/>up, <chord name="F"/>courageous <chord name="Eb"/>youth!<br/>
      <chord name="Bb"/>The <chord name="Eb"/>church for <chord name="Bb"/>you <chord name="F/C"/>doth <chord name="Cm"/>wait,<br/>
      <chord name="F"/>her <chord name="Bb"/>strength <chord name="F/A"/>unequal <chord name="Bb/F"/>to <chord name="Cm/Eb"/>her <chord name="Gm"/>task;<br/>
      <chord name="Dm"/>rise <chord name="Eb"/>up, and <chord name="Bb/D"/>make <chord name="F"/>her <chord name="F7"/>great!
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F"/>Lift <chord name="Bb"/>high <chord name="F"/>the <chord name="Dm"/>cross <chord name="Bb"/>of <chord name="Eb"/>Christ!<br/>
      <chord name="Bb"/>Tread <chord name="Eb"/>where his <chord name="Bb"/>feet <chord name="F/C"/>have <chord name="Cm"/>trod.<br/>
      <chord name="F"/>Disciples of <chord name="Eb/G"/>the <chord name="Bb/F"/>Son <chord name="Cm/Eb"/>of <chord name="Gm"/>Man,<br/>
      <chord name="Dm"/>rise <chord name="Eb"/>up, O <chord name="Bb/D"/>church <chord name="F"/>of <chord name="F7"/>God!
      </lines>
    </verse>
  </lyrics>
