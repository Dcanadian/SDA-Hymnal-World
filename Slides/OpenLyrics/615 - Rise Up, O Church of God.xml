  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F7"/>Rise <chord name="Bb"/>up, O men of <chord name="Eb"/>God!<br/>
      <chord name="Bb"/>His <chord name="Eb"/>king<chord name="Bb"/>dom <chord name="F"/>tar<chord name="C7"/>ries <chord name="F"/>long.<br/>
      Bring <chord name="Bb"/>in <chord name="F"/>the <chord name="Eb"/>day <chord name="Bb"/>of <chord name="Cm"/>bro<chord name="Gm6"/>ther<chord name="F"/>hood<br/>
      <chord name="Bb"/>And <chord name="Eb"/>end <chord name="Bb"/>the <chord name="Fsus"/>night <chord name="F7"/>of <chord name="Bb"/>wrong.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F7"/>Let <chord name="Bb"/>women all <chord name="Eb"/>rise up!<br/>
      <chord name="Bb"/><chord name="Eb"/>Have <chord name="Bb"/>done <chord name="F"/>with <chord name="C7"/>lesser <chord name="F"/>things.<br/>
      <chord name="Bb"/>Give <chord name="F"/>heart <chord name="Eb"/>and <chord name="Bb"/>mind <chord name="Cm"/>and <chord name="Gm6"/>soul <chord name="F"/>and strength<br/>
      <chord name="Bb"/>to <chord name="Eb"/>serve <chord name="Bb"/>the <chord name="Fsus"/>King <chord name="F7"/>of <chord name="Bb"/>kings.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F7"/>Rise <chord name="Bb"/>up, <chord name="Eb"/>courageous youth!<br/>
      <chord name="Bb"/>The <chord name="Eb"/>church <chord name="Bb"/>for <chord name="F"/>you <chord name="C7"/>doth <chord name="F"/>wait,<br/>
      <chord name="Bb"/><chord name="F"/>her <chord name="Eb"/>strength <chord name="Bb"/>unequal <chord name="Cm"/>to <chord name="Gm6"/>her <chord name="F"/>task;<br/>
      <chord name="Bb"/>rise <chord name="Eb"/>up, <chord name="Bb"/>and <chord name="Fsus"/>make <chord name="F7"/>her <chord name="Bb"/>great!
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F7"/>Lift high <chord name="Bb"/>the cross <chord name="Eb"/>of Christ!<br/>
      <chord name="Bb"/>Tread <chord name="Eb"/>where <chord name="Bb"/>his <chord name="F"/>feet <chord name="C7"/>have <chord name="F"/>trod.<br/>
      <chord name="Bb"/><chord name="F"/>Disciples <chord name="Eb"/>of <chord name="Bb"/>the <chord name="Cm"/>Son <chord name="Gm6"/>of <chord name="F"/>Man,<br/>
      <chord name="Bb"/>rise <chord name="Eb"/>up, <chord name="Bb"/>O <chord name="Fsus"/>church <chord name="F7"/>of <chord name="Bb"/>God!
      </lines>
    </verse>
