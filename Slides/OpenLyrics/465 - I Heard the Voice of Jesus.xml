  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Am"/>I heard <chord name="C/G"/>the voice of <chord name="D/F#"/>Jesus <chord name="G"/>say,<br/>
      <chord name="C/G"/>“Come unto <chord name="Bm/D"/>Me <chord name="C"/>and rest;<br/>
      <chord name="C/G"/>Lay <chord name="G"/>down, thou weary <chord name="Em/B"/>one, lay down<br/>
      <chord name="D/F#"/>Thy head <chord name="G"/>upon My <chord name="D7/C"/>breast.”<br/>
      <chord name="D7/F#"/>Icame <chord name="G"/>to Jesus <chord name="Em"/>as I was,<br/>
      <chord name="G"/>Weary <chord name="Bm"/>and worn <chord name="D7/C"/>and sad;<br/>
      <chord name="Em/B"/>I <chord name="D"/>found in <chord name="G"/>Him a <chord name="D7/C"/>resting <chord name="Em/B"/>place,<br/>
      <chord name="Em/G"/>And He has made <chord name="G"/>me glad.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Am"/>I heard <chord name="C/G"/>the voice of <chord name="D/F#"/>Jesus <chord name="G"/>say,<br/>
      <chord name="C/G"/>&quot;Behold, <chord name="Bm"/>I freely <chord name="C"/>give<br/>
      <chord name="C/G"/>The <chord name="G"/>living water; <chord name="Em/B"/>thirsty one,<br/>
      <chord name="D/F#"/>Stoop down <chord name="G"/>and drink and <chord name="D7/C"/>live.&quot;<br/>
      <chord name="D7/F#"/>I came <chord name="G"/>to Jesus, <chord name="Em"/>and I drank<br/>
      <chord name="G"/>Of that <chord name="Bm"/>life giving <chord name="D7/C"/>stream;<br/>
      <chord name="Em/B"/>My <chord name="D"/>thirst was <chord name="G"/>quench&#x27;d, my <chord name="D7/C"/>soul revived,<br/>
      <chord name="Em/G"/>And now I live <chord name="G"/>in Him.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Am"/>I heard <chord name="C/G"/>the voice of <chord name="D/F#"/>Jesus <chord name="G"/>say,<br/>
      <chord name="C/G"/>&quot;I am <chord name="Bm"/>this dark <chord name="C"/>world&#x27;s light;<br/>
      <chord name="C/G"/>Look <chord name="G"/>unto Me, <chord name="C/G"/>thy <chord name="Em/B"/>morn shall rise,<br/>
      <chord name="D/F#"/>And all <chord name="G"/>thy day be <chord name="D7/C"/>bright.&quot;<br/>
      <chord name="D7/F#"/>I looked <chord name="G"/>to Jesus, <chord name="Em"/>and I found<br/>
      <chord name="G"/>In Him <chord name="Bm"/>my star, <chord name="D7/C"/>my sun;<br/>
      <chord name="Em/B"/>And <chord name="D"/>in that <chord name="G"/>light of <chord name="D7/C"/>life I&#x27;ll <chord name="Em/B"/>walk,<br/>
      <chord name="Em/G"/>Till trav&#x27;ling days <chord name="G"/>are done.
      </lines>
    </verse>
