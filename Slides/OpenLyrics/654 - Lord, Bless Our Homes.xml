  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C"/>Lord, <chord name="F"/>bless <chord name="Gm"/>our <chord name="Am"/>homes <chord name="Bb"/>with <chord name="Gm"/>peace <chord name="Am"/>and <chord name="F"/>love <chord name="Dm"/>and laughter,<br/>
      <chord name="C"/>With understanding <chord name="Am"/>and <chord name="C"/>with <chord name="Am"/>loyalty.<br/>
      <chord name="Gm"/>May we together <chord name="Dm"/>follow <chord name="F"/>Christ <chord name="Gm"/>the <chord name="Am"/>Master<br/>
      <chord name="Edim"/>And <chord name="F"/>know <chord name="Gm"/>the <chord name="Am"/>blessing <chord name="C"/>of <chord name="Am"/>His <chord name="F"/>sov&#x27;reignty.
      </lines>
