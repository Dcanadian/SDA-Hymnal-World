  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G/D"/>O <chord name="Am/C"/>for <chord name="Bm"/>a <chord name="G"/>heart to praise <chord name="C/G"/>my <chord name="Em/B"/>God, <chord name="Bm"/>A <chord name="Em/B"/>heart <chord name="G"/>from <chord name="F#dim"/>sin <chord name="Am/C"/>set <chord name="Bm"/>free,<br/>
      <chord name="G"/>Aheart that <chord name="Bm/F#"/>always <chord name="F#dim"/>feels <chord name="G"/>Thy blood So <chord name="G#m"/>freely <chord name="Am"/>shed <chord name="D7/C"/>for <chord name="Em/B"/>me.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G/D"/>A <chord name="Bm"/>heart <chord name="G"/>resigned, <chord name="Em/B"/>submissive, <chord name="Am/C"/>meek,<br/>
      <chord name="G/D"/>My dear Redeemer&#x27;s <chord name="Am/C"/>throne,<br/>
      <chord name="G"/>Where only Christ is heard <chord name="Am"/>to <chord name="D7/C"/>speak,<br/>
      <chord name="G"/>Where Jesus reigns <chord name="G#m"/>alone.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G/D"/>A <chord name="Bm"/>heart <chord name="G"/>in every thought <chord name="F#dim"/>renewed<br/>
      <chord name="G/D"/>And full of <chord name="Em/B"/>love <chord name="G"/>divine,<br/>
      <chord name="G"/>Perfect <chord name="Bm/F#"/>and <chord name="G"/>right and pure <chord name="Am"/>and <chord name="D7/C"/>good,<br/>
      <chord name="G"/>A copy, Lord, <chord name="G#m"/>of <chord name="D7/C"/>Thine.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="G/D"/>Thy <chord name="Bm"/>nature, <chord name="G/D"/>gracious <chord name="Em/B"/>Lord, <chord name="Am/E"/>impart;<br/>
      <chord name="G/D"/>Come quickly <chord name="Em/B"/>from <chord name="G"/>above;<br/>
      <chord name="G"/>Write Thy <chord name="Bm/F#"/>new <chord name="G"/>name upon <chord name="Am"/>my <chord name="D7/C"/>heart,<br/>
      <chord name="G"/>Thy new, <chord name="F#dim"/>best <chord name="G"/>name <chord name="G#m"/>of <chord name="D7/C"/>Love.
      </lines>
