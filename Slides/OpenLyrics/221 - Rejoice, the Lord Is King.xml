      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="C"/>His kingdom cannot fail, <chord name="Am"/>He <chord name="G"/>rules <chord name="F"/>o&#x27;er <chord name="Em"/>earth <chord name="G7/D"/>and <chord name="C"/>heaven<br/>
