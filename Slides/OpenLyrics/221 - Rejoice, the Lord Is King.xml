    <verse name="v2">
      <lines>
      <chord name="C"/>Jesus, the <chord name="G/B"/>Savior, <chord name="Am"/>reigns, <chord name="G"/>The <chord name="F"/>God <chord name="Em"/>of <chord name="G7/D"/>truth <chord name="C"/>and <chord name="G"/>love;<br/>
