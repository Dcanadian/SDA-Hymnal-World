    <verse name="v6">
      <lines>
      <chord name="Dm/A"/>&quot;All <chord name="F/C"/>glory <chord name="Dm/A"/>be <chord name="Bb/D"/>to <chord name="F/C"/>God on <chord name="C"/>high,<br/>
      <chord name="Dm"/>And to the <chord name="C"/>earth be peace;<br/>
