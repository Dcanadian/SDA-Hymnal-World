    </verse>
    <verse name="v2">
      <lines>
      <chord name="Dm/A"/>&quot;Fear <chord name="F/C"/>nor!&quot; <chord name="C"/>said <chord name="Dm/A"/>he- <chord name="Bb/D"/>for <chord name="F/C"/>mighty <chord name="C"/>dread<br/>
      <chord name="Dm"/>Had seized their <chord name="C"/>troubled mind-<br/>
      <chord name="F/C"/>&quot;Glad <chord name="Bb"/>tidings of <chord name="F/C"/>great <chord name="C"/>joy <chord name="Dm/A"/>I <chord name="Am"/>bring,<br/>
      <chord name="Am"/>To <chord name="C"/>you <chord name="Dm/A"/>and <chord name="Bb"/>all <chord name="C/G"/>mankind.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Dm/A"/>&quot;To <chord name="F/C"/>you, <chord name="C"/>in <chord name="Dm/A"/>David&#x27;s <chord name="F/C"/>town this <chord name="C"/>day,<br/>
      <chord name="Dm"/>Is born of <chord name="C"/>David&#x27;s line,<br/>
