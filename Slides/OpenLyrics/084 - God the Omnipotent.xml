  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F#m"/>God <chord name="G"/>the Omnipotent! <chord name="D/A"/>King, <chord name="G"/>who <chord name="A"/>ordainest<br/>
      <chord name="G"/>Great <chord name="A/E"/>winds Thy <chord name="F#m"/>clarions, the lightnings <chord name="Fm"/>Thy <chord name="F#m"/>sword;<br/>
      <chord name="Em"/>Show <chord name="D/A"/>forth <chord name="A"/>Thy <chord name="D/A"/>pity <chord name="D#m/A#"/>on <chord name="Bm"/>high <chord name="G"/>where <chord name="Bm/F#"/>Thou <chord name="F#/C#"/>reignest,<br/>
      <chord name="D/A"/>Give <chord name="A"/>to <chord name="G"/>us <chord name="F#m"/>peace, O <chord name="B7"/>most <chord name="Em/B"/>merciful Lord.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F#m"/>God <chord name="G"/>the all <chord name="F#m"/>merciful! <chord name="D/A"/>earth <chord name="G"/>hath <chord name="A"/>forsaken<br/>
      <chord name="G"/>Thy <chord name="A/E"/>precepts <chord name="F#m"/>holy, and slighted <chord name="Fm"/>Thy <chord name="F#m"/>word;<br/>
      <chord name="Em"/>Bid <chord name="D/A"/>not <chord name="A"/>Thy <chord name="D/A"/>wrath in <chord name="D#m/A#"/>its <chord name="Bm"/>terrors awaken;<br/>
      <chord name="D/A"/>Give <chord name="A"/>to <chord name="G"/>us <chord name="F#m"/>peace, O <chord name="B7"/>most <chord name="Em/B"/>merciful Lord.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F#m"/>God <chord name="G"/>the all <chord name="F#m"/>righteousness <chord name="D/A"/>One! <chord name="G"/>man <chord name="A"/>hath <chord name="G"/>defied <chord name="F#m"/>Thee;<br/>
      <chord name="G"/>Yet <chord name="A/E"/>to eternity <chord name="F#m"/>standeth <chord name="Fm"/>Thy <chord name="F#m"/>word;<br/>
      <chord name="Em"/>Falsehood <chord name="D/A"/>and wrong <chord name="D#m/A#"/>shall <chord name="Bm"/>not <chord name="G"/>tarry <chord name="F#/C#"/>beside <chord name="F#m/C#"/>Thee;<br/>
      <chord name="D/A"/>Prosper <chord name="G"/>the <chord name="F#m"/>right, O <chord name="B7"/>most <chord name="Em/B"/>merciful Lord.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F#m"/>So <chord name="G"/>shall we <chord name="F#m"/>render <chord name="D/F#"/>Thee thankful <chord name="A"/>devotion,<br/>
      <chord name="G"/>For Thy <chord name="A/E"/>deliverance <chord name="F#m"/>from peril <chord name="Fm"/>and <chord name="F#m"/>sword,<br/>
      <chord name="Em"/>Singing <chord name="A"/>in <chord name="D/A"/>chorus <chord name="D#m/A#"/>from <chord name="Bm"/>ocean to <chord name="F#/C#"/>ocean,<br/>
      <chord name="D/A"/>&quot;Thine <chord name="A"/>is <chord name="G"/>the <chord name="F#m"/>power <chord name="B7"/>and <chord name="Em/B"/>the <chord name="D/A"/>glory, <chord name="Em/G"/>O <chord name="D/F#"/>Lord.&quot;
      </lines>
    </verse>
