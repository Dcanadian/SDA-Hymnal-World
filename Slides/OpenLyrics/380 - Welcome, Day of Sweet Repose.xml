  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Db"/>Welcome, day of <chord name="Gb"/>sweet <chord name="Bbm/F"/>repose!<br/>
      <chord name="Db"/>Blessed be <chord name="Gb"/>thy <chord name="Db/Ab"/>sacred <chord name="Ab7"/>hours!<br/>
      <chord name="Ab"/>We would <chord name="Bbm"/>trust <chord name="Eb7/Db"/>the <chord name="Ab/C"/>One who <chord name="Ab7/Gb"/>knows<br/>
      <chord name="Fm"/>All our weak <chord name="Ab7/Gb"/>and <chord name="Gb"/>failing <chord name="Ab7"/>powers.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Db"/>Welcome, day in <chord name="Gb"/>Eden <chord name="Ebm"/>born!<br/>
      <chord name="Db"/>Holy <chord name="Gb"/>rest for <chord name="Db/Ab"/>sinless man!<br/>
      <chord name="Ab"/>Like the <chord name="Bbm"/>dawning <chord name="Ab/C"/>of fair <chord name="Ab7/Gb"/>morn<br/>
      <chord name="Fm"/>Come thy <chord name="Ab7/Gb"/>hours <chord name="Gb"/>to <chord name="Db/Ab"/>us <chord name="Ab7"/>again.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Db"/>Welcome, day blessed <chord name="Gb"/>by <chord name="Bbm/F"/>our <chord name="Ebm"/>Lord!<br/>
      <chord name="Db"/>Toil shall <chord name="Gb"/>cease and <chord name="Db/Ab"/>anxious care.<br/>
      <chord name="Ab"/>Day commanded by His <chord name="Ab7/Gb"/>word,<br/>
      <chord name="Fm"/>Day for <chord name="Ab7/Gb"/>song <chord name="Gb"/>and <chord name="Db/Ab"/>praise <chord name="Ab7"/>and <chord name="Db"/>prayer.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Db"/>Welcome, day our <chord name="Gb"/>Savior <chord name="Ebm"/>kept!<br/>
      <chord name="Db"/>Keeping, <chord name="Gb"/>wrought our <chord name="Db/Ab"/>righteousness,<br/>
      <chord name="Ab"/>Day God <chord name="Bbm"/>bids <chord name="Eb7/Db"/>us <chord name="Ab/C"/>ne&#x27;er forget,<br/>
      <chord name="Fm"/>Day of <chord name="Ab7/Gb"/>days <chord name="Gb"/>His <chord name="Db/Ab"/>name <chord name="Ab7"/>to <chord name="Db"/>bless.
      </lines>
    </verse>
