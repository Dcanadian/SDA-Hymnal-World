<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>077 - O Love of God Most Full</title>
      <title>O Love of God Most Full</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="77"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>God the Father</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>O love <chord name="Bb/D"/>of God most <chord name="C7"/>full,<br/>
      <chord name="C"/>O <chord name="F"/>love of <chord name="Bb"/>God <chord name="Dm"/>most <chord name="C"/>free,<br/>
      <chord name="F"/>Come <chord name="Dm"/>warm my <chord name="Am"/>heart,come <chord name="Bb"/>fill <chord name="C7"/>my soul,<br/>
      <chord name="F/A"/>Come <chord name="Gm"/>lead <chord name="Dm/A"/>me <chord name="Gm/Bb"/>unto <chord name="F"/>Thee.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>Warm as <chord name="Bb/D"/>the glowing <chord name="C7"/>sun<br/>
      <chord name="C"/>So shines <chord name="F/A"/>Thy <chord name="Bb"/>love <chord name="Dm"/>on <chord name="C"/>me,<br/>
      <chord name="F"/>It <chord name="Dm"/>wraps me <chord name="Am"/>&#x27;round with <chord name="Bb"/>kindly <chord name="C7"/>care,<br/>
      <chord name="F/A"/>It <chord name="Gm"/>draws <chord name="Dm/A"/>me <chord name="Gm/Bb"/>unto <chord name="F"/>Thee.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>The wildest <chord name="Bb"/>sea is <chord name="C7"/>calm,<br/>
      <chord name="C"/>The <chord name="F"/>tempest <chord name="Bb"/>brings <chord name="Dm"/>no <chord name="C"/>fear,<br/>
      <chord name="F"/>The <chord name="Dm"/>darkest <chord name="Am"/>night is <chord name="Bb"/>full <chord name="C7"/>of light,<br/>
      <chord name="F/A"/>Because <chord name="Dm/A"/>Thy <chord name="Gm/Bb"/>love <chord name="C7"/>is <chord name="F"/>near.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F"/>O love <chord name="Bb/D"/>of God most <chord name="C7"/>full,<br/>
      <chord name="C"/>O <chord name="F"/>love of <chord name="Bb"/>God <chord name="Dm"/>most <chord name="C"/>free,<br/>
      <chord name="F"/>It <chord name="Dm"/>warms my <chord name="Am"/>heart, it <chord name="Bb"/>fills <chord name="C7"/>my soul,<br/>
      <chord name="F/A"/>With <chord name="Gm"/>might <chord name="Dm/A"/>it <chord name="Gm/Bb"/>strengthens <chord name="F"/>me.
      </lines>
    </verse>
  </lyrics>
</song>
