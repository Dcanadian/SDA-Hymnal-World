<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>143 - Silent Night, Holy Night</title>
      <title>Silent Night, Holy Night</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="143"/>
    </songbooks>
    <key>Bb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Jesus Christ</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Bb/F"/>Silent night, holy night;<br/>
      <chord name="Bb/F"/>All is calm, all <chord name="Adim"/>is <chord name="F"/>bright<br/>
      <chord name="Bb/F"/>Round yon <chord name="Eb/Bb"/>virgin <chord name="Gm"/>mother <chord name="Bb"/>and Child,<br/>
      <chord name="Eb/Bb"/>Holy <chord name="Gm"/>Infant so <chord name="Bb"/>tender and mild,<br/>
      <chord name="Adim"/>Sleep <chord name="F7"/>in <chord name="Bb/F"/>heavenly <chord name="Cm"/>peace,<br/>
      <chord name="Gm/D"/>Sleep in heavenly peace.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Bb/F"/>Silent night! holy night!<br/>
      <chord name="Bb/F"/>Shepherds quake at <chord name="Adim"/>the <chord name="F"/>sight,<br/>
      <chord name="Bb/F"/>glories <chord name="Eb/Bb"/>stream <chord name="Gm"/>from heaven <chord name="Bb"/>afar,<br/>
      <chord name="Eb/Bb"/>heavenly <chord name="Gm"/>hosts <chord name="Bb"/>sing Alleluia;<br/>
      <chord name="Adim"/>Christ, <chord name="F7"/>the <chord name="Bb/F"/>Savior is <chord name="Cm"/>born,<br/>
      <chord name="Gm/D"/>Christ, the Savior is born.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Bb/F"/>Silent night! holy night!<br/>
      <chord name="Bb/F"/>Son of God, love&#x27;s <chord name="Adim"/>pure <chord name="F"/>light,<br/>
      <chord name="Bb/F"/>Radiant <chord name="Eb/Bb"/>beams <chord name="Gm"/>from Thy holy <chord name="Bb"/>face,<br/>
      <chord name="Eb/Bb"/>with <chord name="Gm"/>the dawn of <chord name="Bb"/>redeeming grace,<br/>
      <chord name="Adim"/>Jesus, <chord name="Bb/F"/>Lord, at Thy <chord name="Cm"/>birth,<br/>
      <chord name="Gm/D"/>Jesus, Lord, at Thy birth.
      </lines>
    </verse>
  </lyrics>
</song>
