<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>498 - Still, Still With Thee</title>
      <title>Still, Still With Thee</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="498"/>
    </songbooks>
    <key>D</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D/A"/>Still, <chord name="Em/G"/>still <chord name="D/F#"/>with Thee, <chord name="G/D"/>when <chord name="D"/>purple morning <chord name="G#dim"/>breaketh,<br/>
      <chord name="A"/>When <chord name="Em/B"/>the <chord name="D/A"/>bird <chord name="Em/B"/>waketh, <chord name="G"/>and <chord name="A/E"/>the <chord name="D/A"/>shadows flee;<br/>
      <chord name="D/A"/>Fairer than morning, <chord name="Bm"/>lovelier than daylight,<br/>
      <chord name="A"/>Dawns <chord name="Em/B"/>the <chord name="D/A"/>sweet <chord name="Em/B"/>consciousness, <chord name="A7/G"/>I <chord name="G"/>am with <chord name="D/F#"/>Thee.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D/A"/>Alone with Thee, <chord name="G/D"/>amid <chord name="D"/>the mystic <chord name="G#dim"/>shadows,<br/>
      <chord name="A"/>The <chord name="Em/B"/>solemn hush of <chord name="G"/>nature <chord name="D/A"/>newly born;<br/>
      <chord name="D/A"/>Alone with Thee <chord name="F#m"/>in <chord name="Bm"/>breathless <chord name="Em/B"/>adoration,<br/>
      <chord name="A"/>In <chord name="Em/B"/>the <chord name="D/A"/>calm <chord name="Em/B"/>dew and <chord name="G"/>freshness of the <chord name="D/F#"/>morn.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D/A"/>Still, <chord name="Em/G"/>still <chord name="D/F#"/>with Thee! <chord name="G/D"/>As <chord name="D"/>to each newborn <chord name="G#dim"/>morning<br/>
      <chord name="A"/>A fresh <chord name="Em/B"/>and <chord name="D/A"/>solemn <chord name="Em/G"/>splendor <chord name="A/E"/>still <chord name="D/A"/>is <chord name="A7/G"/>given,<br/>
      <chord name="D/A"/>So <chord name="Em/G"/>does <chord name="D/F#"/>this blessed <chord name="F#m"/>consciousness, <chord name="Em/B"/>awaking,<br/>
      <chord name="A"/>Breathe each <chord name="Em/B"/>day <chord name="D/A"/>nearness <chord name="Em/G"/>unto <chord name="A7/G"/>Thee <chord name="G"/>and heaven.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="D/A"/>So <chord name="Em/G"/>shall <chord name="D/F#"/>it be <chord name="G/D"/>at <chord name="D"/>last, in that <chord name="A/E"/>bright <chord name="G#dim"/>morning,<br/>
      <chord name="A"/>When the <chord name="Em/B"/>soul <chord name="D/A"/>waketh <chord name="Em/G"/>and <chord name="G"/>life&#x27;s <chord name="D/A"/>shadows flee;<br/>
      <chord name="D/A"/>O <chord name="Em/G"/>in <chord name="D/F#"/>that hour, <chord name="F#m"/>fairer <chord name="Bm"/>than <chord name="Em/B"/>daylight <chord name="Bm"/>dawning,<br/>
      <chord name="A"/>Shall <chord name="Em/B"/>rise <chord name="D/A"/>the <chord name="Em/B"/>glorious <chord name="G"/>thought, <chord name="A7/G"/>I <chord name="G"/>am with <chord name="D/F#"/>Thee.
      </lines>
    </verse>
  </lyrics>
</song>
