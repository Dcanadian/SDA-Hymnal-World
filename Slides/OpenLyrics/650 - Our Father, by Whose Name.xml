  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Bm"/>Our <chord name="Em/B"/>Father, <chord name="D"/>by whose <chord name="G/D"/>name,<br/>
      <chord name="G/B"/>All <chord name="C"/>fatherhood <chord name="Am/C"/>is <chord name="Em/B"/>known,<br/>
      <chord name="Bm"/>Who <chord name="Em/B"/>dost in <chord name="D"/>love proclaim<br/>
      <chord name="G/B"/>Each <chord name="C"/>family <chord name="Am/C"/>Thine <chord name="Em/B"/>own,<br/>
      <chord name="D/A"/>Bless Thou <chord name="G"/>all parents, guarding well,<br/>
      <chord name="F#dim"/>With <chord name="G"/>constant love <chord name="F#dim"/>as <chord name="G"/>sentinel,<br/>
      <chord name="D/A"/>The <chord name="G"/>homes in <chord name="C/G"/>which <chord name="G"/>Thy <chord name="F#dim"/>people <chord name="G"/>dwell.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Bm"/>O <chord name="Em/B"/>Christ, Thyself <chord name="D"/>a <chord name="G/D"/>child<br/>
      <chord name="G/B"/>Within <chord name="C/E"/>an <chord name="G/D"/>earthly <chord name="Em/B"/>home,<br/>
      <chord name="Bm"/>With <chord name="Em/B"/>heart still <chord name="D"/>undefiled,<br/>
      <chord name="G/B"/>Thou <chord name="C"/>didst to <chord name="G/D"/>manhood <chord name="Em/B"/>come;<br/>
      <chord name="D/A"/>Our children <chord name="G"/>bless, in every place,<br/>
      <chord name="F#dim"/>That <chord name="G"/>they <chord name="C/G"/>may <chord name="G/D"/>all <chord name="F#dim"/>behold <chord name="D7/C"/>Thy <chord name="Em/B"/>face,<br/>
      <chord name="D/A"/>And <chord name="G"/>knowing Thee <chord name="C/G"/>may <chord name="G"/>grow <chord name="F#dim"/>in grace.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Bm"/>O <chord name="Em/B"/>Spirit, <chord name="D"/>who dost <chord name="G/D"/>bind<br/>
      <chord name="G/B"/>Our <chord name="C"/>hearts in <chord name="G/D"/>unity,<br/>
      <chord name="Bm"/>Who <chord name="Em/B"/>teaches <chord name="D"/>us to <chord name="G/D"/>find<br/>
      <chord name="G/B"/>The <chord name="C"/>love from <chord name="G/D"/>self <chord name="Am/C"/>set <chord name="Em/B"/>free,<br/>
      <chord name="D/A"/>In all <chord name="G"/>our hearts such love <chord name="C/G"/>increase,<br/>
      <chord name="F#dim"/>That <chord name="G"/>every <chord name="F#dim"/>home, <chord name="G"/>by <chord name="D7/C"/>this <chord name="Em/B"/>release,<br/>
      <chord name="D/A"/>May <chord name="G"/>be <chord name="F#dim"/>dwelling <chord name="G"/>place <chord name="F#dim"/>of peace.
      </lines>
    </verse>
