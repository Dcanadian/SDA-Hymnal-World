      <title>423 - Glorious Things of Thee Are Spoken</title>
      <title>Glorious Things of Thee Are Spoken</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="423"/>
    </songbooks>
    <key>Eb</key>
    <tempo type="bpm">Moderato</tempo>
