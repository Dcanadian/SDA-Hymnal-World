<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>680 - Holy Spirit, Hear Us</title>
      <title>Holy Spirit, Hear Us</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="680"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Sentences and Responses</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>Holy Spirit, <chord name="Em"/>hear <chord name="Bm"/>us;<br/>
      <chord name="C"/>Help us while <chord name="Bm"/>we <chord name="D"/>sing;<br/>
      <chord name="Bm"/>Breath <chord name="G/B"/>into <chord name="Em"/>the <chord name="C/E"/>music<br/>
      <chord name="G/D"/>Of <chord name="D"/>the <chord name="G/D"/>praise <chord name="D7"/>we <chord name="G"/>bring.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>Holy Spirit, <chord name="Em"/>prompt <chord name="Bm"/>us<br/>
      <chord name="C"/>When we <chord name="Am"/>kneel <chord name="Bm"/>to <chord name="D"/>pray;<br/>
      <chord name="Bm"/>Nearer <chord name="Am"/>come, <chord name="Em"/>and <chord name="C/E"/>teach us<br/>
      <chord name="G/D"/>What <chord name="D"/>we <chord name="G/D"/>ought <chord name="D7"/>to <chord name="G"/>say.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>Holy Spirit, <chord name="Em"/>shine <chord name="Bm"/>Thou<br/>
      <chord name="C"/>On the <chord name="Am"/>Book <chord name="Bm"/>we <chord name="D"/>read;<br/>
      <chord name="Bm"/>Gild <chord name="G/B"/>it&#x27;s <chord name="Am"/>holy <chord name="C/E"/>pages<br/>
      <chord name="G/D"/>With <chord name="D"/>the <chord name="G/D"/>light <chord name="D7"/>we <chord name="G"/>need.
      </lines>
    </verse>
  </lyrics>
</song>
