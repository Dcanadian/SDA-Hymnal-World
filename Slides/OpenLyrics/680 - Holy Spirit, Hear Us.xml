<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>680 - Holy Spirit, Hear Us</title>
      <title>Holy Spirit, Hear Us</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="680"/>
    </songbooks>
    <key>C</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Sentences and Responses</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      Holy Spirit, hear us;<br/>
      Help us while we sing;<br/>
      Breath into the music<br/>
      Of the praise we bring.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      Holy Spirit, prompt us<br/>
      When we kneel to pray;<br/>
      Nearer come, and teach us<br/>
      What we ought to say.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      Holy Spirit, shine Thou<br/>
      On the Book we read;<br/>
      Gild it&#x27;s holy pages<br/>
      With the light we need.
      </lines>
    </verse>
  </lyrics>
</song>
