  <properties>
    <titles>
      <title>055 - Jesus, Tender Shepherd, Hear Me</title>
      <title>Jesus, Tender Shepherd, Hear Me</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="55"/>
    </songbooks>
    <key>C</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2</verseOrder>
    <themes>
      <theme>Worship</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      Jesus, tender Shepherd, hear me,<br/>
      Bless Thy little lamb tonight;<br/>
      Through the darkness be Thou near me;<br/>
      Watch my sleep till morning light.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      All this day Thy hand has led me,<br/>
      And I thank Thee for Thy care;<br/>
      Thou hast clothed me, warmed and fed me;<br/>
      Listen to my evening prayer.
      </lines>
    </verse>
  </lyrics>
</song>
