  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Cm/G"/>Jesus, <chord name="Bb"/>tender <chord name="Bb7"/>Shepherd, hear <chord name="Eb/Bb"/>me,<br/>
      <chord name="Eb/G"/>Bless <chord name="Cm"/>Thy <chord name="Bb"/>little <chord name="Gm"/>lamb <chord name="F7/A"/>tonight;<br/>
      <chord name="Cm/G"/>Through <chord name="Eb"/>the darkness be <chord name="Bb7"/>Thou near me;<br/>
      <chord name="Cm"/>Watch <chord name="Bb7/Ab"/>my <chord name="Gm"/>sleep <chord name="Ab"/>till morning <chord name="Bb/F"/>light.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Cm/G"/>All <chord name="Eb/Bb"/>this <chord name="Bb"/>day Thy <chord name="Bb7"/>hand has led <chord name="Eb/Bb"/>me,<br/>
      <chord name="Eb/G"/>And <chord name="Cm"/>I <chord name="Bb"/>thank <chord name="Bb7/Ab"/>Thee <chord name="Gm"/>for <chord name="F7/A"/>Thy care;<br/>
      <chord name="Cm/G"/>Thou <chord name="Eb"/>hast clothed <chord name="Bb/F"/>me, <chord name="Eb"/>warmed <chord name="Bb7"/>and fed me;<br/>
      <chord name="Cm"/>Listen <chord name="Gm"/>to <chord name="Ab"/>my evening <chord name="Cm/G"/>prayer.
      </lines>
    </verse>
