  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>Praise we <chord name="A"/>the <chord name="Bm"/>Lord, <chord name="A/C#"/>who <chord name="Bm"/>made <chord name="A"/>all <chord name="G"/>beauty<br/>
      <chord name="F#m"/>For <chord name="G"/>all <chord name="Em"/>our <chord name="D"/>senses <chord name="Bm"/>to <chord name="Em/G"/>enjoy;<br/>
