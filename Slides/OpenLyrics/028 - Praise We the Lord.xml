      <chord name="D"/>That simple <chord name="A/C#"/>pleasures <chord name="D"/>never <chord name="A"/>cloy;<br/>
      <chord name="D"/>Praise we <chord name="C#dim"/>the <chord name="Bm"/>Lord, <chord name="A"/>who <chord name="D/F#"/>made all <chord name="G"/>beauty<br/>
      <chord name="F#m"/>For all <chord name="Em"/>our <chord name="Bm"/>senses <chord name="G"/>to <chord name="Em/G"/>enjoy.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>Praise Him <chord name="A"/>who <chord name="Bm"/>loves to <chord name="A"/>see <chord name="G"/>young <chord name="F#m/A"/>lovers,<br/>
      <chord name="F#m"/>Fresh <chord name="G"/>hearts <chord name="Em"/>that <chord name="D"/>swell <chord name="A/C#"/>with <chord name="Bm"/>youthful <chord name="D"/>pride;<br/>
