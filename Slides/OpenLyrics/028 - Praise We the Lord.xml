      <chord name="D"/>As bridegroom <chord name="Bm"/>fit <chord name="A"/>to <chord name="D"/>meet <chord name="G/B"/>his <chord name="A"/>bride;<br/>
      <chord name="D"/>Praise Him <chord name="C#dim"/>who <chord name="Bm"/>loves <chord name="D/F#"/>to see <chord name="G"/>young <chord name="Bm"/>lovers,<br/>
      <chord name="F#m"/>Fresh hearts <chord name="Em"/>that <chord name="Bm"/>swell <chord name="F#m"/>with <chord name="G"/>youthful <chord name="D"/>pride.
      </lines>
