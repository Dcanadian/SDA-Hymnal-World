    <verse name="v3">
      <lines>
      <chord name="D"/>Praise Him <chord name="A"/>who <chord name="Bm"/>by <chord name="A/C#"/>a <chord name="Bm"/>simple <chord name="G"/>flower<br/>
      <chord name="F#m"/>Lifts <chord name="G"/>up <chord name="Em"/>our <chord name="D"/>hearts <chord name="A/C#"/>to <chord name="Bm"/>things <chord name="Em/G"/>above;<br/>
