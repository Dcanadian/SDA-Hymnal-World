  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>God <chord name="C/G"/>is <chord name="Am"/>our <chord name="Bb"/>Song, <chord name="Am"/>and <chord name="Gm"/>every <chord name="F"/>singer <chord name="Bb"/>blest<br/>
      <chord name="Dm"/>Who <chord name="F/C"/>praising <chord name="Am"/>Him <chord name="Gm"/>finds <chord name="F"/>energy and rest.<br/>
      <chord name="C/E"/>All <chord name="F"/>who <chord name="Gm"/>praise God <chord name="Am"/>with <chord name="Gm"/>unaffected <chord name="C7/Bb"/>joy<br/>
      <chord name="Am"/>Give <chord name="C/G"/>back <chord name="Am"/>to us <chord name="C"/>the <chord name="Bm"/>widom <chord name="Am"/>we <chord name="C/G"/>destroy,<br/>
      <chord name="Am/E"/>Give back <chord name="F"/>to <chord name="Gm"/>us the <chord name="Am"/>widom <chord name="F"/>we <chord name="C/E"/>destroy.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>God <chord name="C/G"/>is <chord name="Am"/>our <chord name="Bb"/>Song, <chord name="Am"/>for <chord name="Gm"/>Jesus <chord name="C/E"/>comes <chord name="F/A"/>to <chord name="Bb"/>save;<br/>
      <chord name="Dm"/>While <chord name="F/C"/>praising <chord name="Am"/>Him <chord name="Gm"/>we <chord name="F"/>offer all we have.<br/>
      <chord name="C/E"/>New songs <chord name="F"/>we <chord name="Gm"/>sing, in <chord name="Am"/>ventures new <chord name="C"/>unite,<br/>
      <chord name="Am"/>When <chord name="C/G"/>Jesus <chord name="Am/C"/>leads <chord name="C"/>us <chord name="Bm"/>upward <chord name="Am"/>into <chord name="F"/>light,<br/>
      <chord name="Am/E"/>When Jesus <chord name="Gm"/>leads us <chord name="Am"/>upward <chord name="F"/>into light.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>This <chord name="C/G"/>is <chord name="Am"/>our <chord name="Bb"/>Song <chord name="Gm"/>no <chord name="F"/>conflict ever <chord name="Bb"/>drowns;<br/>
      <chord name="Dm"/>Who <chord name="F/C"/>praises <chord name="Am"/>God <chord name="Gm"/>our <chord name="F"/>human wrath disowns.<br/>
      <chord name="C/E"/>Love <chord name="F"/>knows <chord name="Gm"/>what rich <chord name="Am"/>complexities <chord name="C"/>of <chord name="C7/Bb"/>sound<br/>
      <chord name="Am"/>God <chord name="C/G"/>builds <chord name="Am"/>upon <chord name="C"/>a <chord name="Bm"/>simple <chord name="Am"/>common <chord name="F"/>ground,<br/>
      <chord name="Am/E"/>God builds <chord name="F"/>upon <chord name="Gm/Bb"/>a <chord name="Am"/>simple <chord name="F"/>common ground.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F"/>God <chord name="C/G"/>is <chord name="Am"/>our <chord name="Bb"/>Silence <chord name="F"/>when no songs are <chord name="Bb"/>sung,<br/>
      <chord name="Dm"/>When <chord name="F/C"/>ecstasy <chord name="Gm"/>or <chord name="F"/>sorrow stills the tongue.<br/>
      <chord name="C/E"/>Glorious <chord name="Gm"/>the faith <chord name="Am"/>which <chord name="Gm"/>silently <chord name="C"/>obeys<br/>
      <chord name="Am"/>Until we find <chord name="C"/>again the <chord name="Am"/>voice <chord name="C/G"/>of <chord name="F"/>praise,<br/>
      <chord name="Am/E"/>Until <chord name="F"/>we <chord name="Gm"/>find again <chord name="F"/>the voice <chord name="C/E"/>of <chord name="F"/>praise.
      </lines>
    </verse>
  </lyrics>
