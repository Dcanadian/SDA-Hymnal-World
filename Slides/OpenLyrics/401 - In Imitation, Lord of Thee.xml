<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>401 - In Imitation, Lord of Thee</title>
      <title>In Imitation, Lord of Thee</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="401"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Doctrines</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>In imitation, Lord, of Thee,<br/>
      <chord name="C"/>This solemn service we <chord name="F"/>repeat;<br/>
      <chord name="F"/>For Thine example full of grace,<br/>
      <chord name="Bb"/>Has made <chord name="F"/>this humble duty <chord name="C"/>sweet.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>Renew each sacred spark of love,<br/>
      <chord name="C"/>And vitalize the holy <chord name="F"/>flame;<br/>
      <chord name="F"/>May union strong our hearts unite<br/>
      <chord name="Bb"/>While <chord name="F"/>this we do in Jesus&#x27; <chord name="C"/>name.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>Our great example Thou shalt be,<br/>
      <chord name="C"/>In washing Thy disciples <chord name="F"/>feet;<br/>
      <chord name="F"/>And as we follow Thy command,<br/>
      <chord name="Bb"/>Make Thou <chord name="F"/>our fellowship complete.
      </lines>
    </verse>
  </lyrics>
</song>
