<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>272 - Give Me the Bible</title>
      <title>Give Me the Bible</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="272"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3</verseOrder>
    <themes>
      <theme>Holy Scriptures</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>Give me the Bible, star of gladness <chord name="C/G"/>gleaming,<br/>
      <chord name="F#dim"/>To cheer the wand&#x27;rer <chord name="G"/>lone <chord name="C/G"/>and tempest <chord name="G"/>tossed;<br/>
      <chord name="G"/>No storm can hide that radiance peaceful <chord name="F#dim"/>beaming,<br/>
      <chord name="G"/>Since Jesus came <chord name="C/G"/>to <chord name="F#dim"/>seek and save the <chord name="G"/>lost.<br/>
      <chord name="C/G"/>Give me the Bible, holy <chord name="G"/>message <chord name="C/G"/>shining;<br/>
      <chord name="F#dim"/>Thy light shall guide <chord name="G"/>me in the narrow way;<br/>
      <chord name="Bm"/>Precept <chord name="D7"/>and promise, <chord name="G"/>law and love combining,<br/>
      <chord name="G"/>Till night shall vanish in eternal <chord name="Bm"/>day.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="G"/>Give me <chord name="Am"/>the Bible--<br/>
      <chord name="G"/>holy message shining,<br/>
      <chord name="G"/>Thy light shall guide <chord name="C/G"/>me<br/>
      <chord name="F#dim"/>in the narrow way.<br/>
      <chord name="G"/>Precept and promise,<br/>
      <chord name="C/G"/>law and love <chord name="G"/>combining,<br/>
      <chord name="F#dim"/>&#x27;Til night shall <chord name="G"/>vanish<br/>
      <chord name="G"/>in eternal day.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>Give me the Bible<br/>
      <chord name="F#dim"/>when my heart <chord name="G"/>is <chord name="C/G"/>broken,<br/>
      <chord name="G"/>When sin and grief <chord name="F#dim"/>have<br/>
      <chord name="G"/>filled my <chord name="C/G"/>soul <chord name="F#dim"/>with fear,<br/>
      <chord name="C/G"/>Give me the <chord name="G"/>precious<br/>
      <chord name="F#dim"/>words by Jesus <chord name="G"/>spoken,<br/>
      <chord name="Bm"/>Hold <chord name="D7"/>up <chord name="G"/>faith&#x27;s lamp<br/>
      <chord name="G"/>to show my Savior <chord name="Bm"/>near.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>Give me the Bible,<br/>
      <chord name="F#dim"/>all my steps <chord name="G"/>enlighten,<br/>
      <chord name="G"/>Teach me the danger<br/>
      <chord name="G"/>of these <chord name="C/G"/>realms <chord name="F#dim"/>below,<br/>
      <chord name="C/G"/>That lamp of safety,<br/>
      <chord name="F#dim"/>o&#x27;er the gloom <chord name="G"/>shall brighten,<br/>
      <chord name="Bm"/>That <chord name="D7"/>light <chord name="G"/>alone<br/>
      <chord name="G"/>the path of peace can <chord name="Bm"/>show.
      </lines>
    </verse>
  </lyrics>
</song>
