<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>314 - Just as I Am</title>
      <title>Just as I Am</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="314"/>
    </songbooks>
    <key>D</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4 v5 v6</verseOrder>
    <themes>
      <theme>Gospel</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>Just as I am, <chord name="A"/>without <chord name="D"/>one <chord name="A"/>plea,<br/>
      <chord name="G/B"/>But that Thy <chord name="D"/>blood was shed for me,<br/>
      <chord name="D/F#"/>And that Thou <chord name="G"/>bidst me come to <chord name="D"/>Thee,<br/>
      <chord name="A/C#"/>O Lamb of <chord name="D"/>God, <chord name="A"/>I come, I <chord name="D"/>come.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>Just as I am, <chord name="A"/>and <chord name="A7/C#"/>waiting <chord name="A"/>not<br/>
      <chord name="G/B"/>to rid my <chord name="D"/>soul of one dark blot,<br/>
      <chord name="D/F#"/>to thee whose <chord name="G"/>blood can cleanse each <chord name="D"/>spot,<br/>
      <chord name="A/C#"/>O Lamb of <chord name="D"/>God, <chord name="A"/>I come, I <chord name="D"/>come.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D"/>Just as I am, <chord name="A"/>though <chord name="A7/C#"/>tossed <chord name="D"/>about<br/>
      <chord name="G/B"/>with many a <chord name="D"/>conflict, many a doubt,<br/>
      <chord name="D/F#"/>fightings and <chord name="G"/>fears within, without,<br/>
      <chord name="A/C#"/>O Lamb of <chord name="D"/>God, <chord name="A"/>I come, I <chord name="D"/>come.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="D"/>Just as I am, <chord name="A"/>poor, <chord name="D"/>wretched, <chord name="A"/>blind;<br/>
      <chord name="G/B"/>sight, riches, <chord name="D"/>healing of the mind,<br/>
      <chord name="D/F#"/>yea, all I <chord name="G"/>need in thee to <chord name="D"/>find,<br/>
      <chord name="A/C#"/>O Lamb of <chord name="D"/>God, <chord name="A"/>I come, I <chord name="D"/>come.
      </lines>
    </verse>
    <verse name="v5">
      <lines>
      <chord name="D"/>Just as I am, <chord name="A"/>thou <chord name="A7/C#"/>wilt <chord name="D"/>receive,<br/>
      <chord name="G/B"/>wilt welcome, <chord name="D"/>pardon, cleanse, relieve;<br/>
      <chord name="D/F#"/>because thy <chord name="G"/>promise I believe,<br/>
      <chord name="A/C#"/>O Lamb of <chord name="D"/>God, <chord name="A"/>I come, I <chord name="D"/>come.
      </lines>
    </verse>
    <verse name="v6">
      <lines>
      <chord name="D"/>Just as I am, <chord name="A"/>thy <chord name="A7/C#"/>love <chord name="D"/>I <chord name="A"/>own<br/>
      <chord name="G/B"/>hath broken <chord name="D"/>every barrier down;<br/>
      <chord name="D/F#"/>now, to be <chord name="G"/>thine, and thine alone,<br/>
      <chord name="A/C#"/>O Lamb of <chord name="D"/>God, <chord name="A"/>I come, I <chord name="D"/>come.
      </lines>
    </verse>
  </lyrics>
</song>
