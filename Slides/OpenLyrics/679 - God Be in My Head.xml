  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C"/>God be in <chord name="Em/B"/>my head,<br/>
      <chord name="Am"/>And <chord name="C/G"/>in <chord name="F"/>my thinking.<br/>
      <chord name="Dm"/>god be in my eyes,<br/>
      <chord name="Dm"/>And in <chord name="F/C"/>my looking.<br/>
      <chord name="G7"/>God be in <chord name="Em"/>my <chord name="G7/D"/>mouth<br/>
      <chord name="C"/>And in my speaking.<br/>
      <chord name="C"/>Oh, God be in <chord name="F"/>my <chord name="C/E"/>hear,<br/>
      <chord name="Dm/F"/>And in my <chord name="B/D#"/>understanding.
      </lines>
