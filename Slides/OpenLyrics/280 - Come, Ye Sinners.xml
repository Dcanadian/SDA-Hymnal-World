<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>280 - Come, Ye Sinners</title>
      <title>Come, Ye Sinners</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="280"/>
    </songbooks>
    <key>Ab</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Gospel</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Fm"/>Come, ye sinners poor and <chord name="Cm"/>needy,<br/>
      <chord name="Ab"/>Weak <chord name="Cm"/>and <chord name="Fm"/>wounded, sick <chord name="Db"/>and sore;<br/>
      <chord name="Ab"/>Jesus <chord name="Eb7"/>ready <chord name="Bbm/Db"/>stands <chord name="Cm"/>to <chord name="Fm"/>save you,<br/>
      <chord name="Db"/>Full <chord name="Bbm"/>of <chord name="Fm"/>pity, love, <chord name="Cm"/>and power.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Fm"/>I will arise <chord name="Cm"/>and <chord name="Fm"/>go to <chord name="Cm"/>Jesus,<br/>
      <chord name="Fm"/>He <chord name="Eb/Bb"/>will embrace <chord name="Cm/G"/>me in <chord name="Db"/>His arms;<br/>
      <chord name="Ab"/>In the <chord name="Eb7"/>arms of <chord name="Bbm/Db"/>my <chord name="Cm"/>dear <chord name="Fm"/>Savior,<br/>
      <chord name="Db"/>O <chord name="Bbm"/>there <chord name="Fm"/>are ten thousand <chord name="Cm"/>charms.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Fm"/>Come. ye thirsty, come, and <chord name="Cm"/>welcome,<br/>
      <chord name="Ab"/>God&#x27;s <chord name="Cm"/>free <chord name="Fm"/>bounty glorify;<br/>
      <chord name="Ab"/>True belief <chord name="Eb7"/>and <chord name="Bbm/Db"/>true <chord name="Cm"/>repentance,<br/>
      <chord name="Db"/>Every <chord name="Fm"/>grace that <chord name="Cm"/>brings you <chord name="Fm"/>nigh.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Fm"/>Let not conscience make you <chord name="Cm"/>linger,<br/>
      <chord name="Ab"/>Nor <chord name="Cm"/>of <chord name="Fm"/>fitness fondly <chord name="Db"/>dream;<br/>
      <chord name="Ab"/>All the <chord name="Eb7"/>fitness <chord name="Bbm/Db"/>He <chord name="Cm"/>requireth<br/>
      <chord name="Db"/>Is <chord name="Bbm"/>to <chord name="Fm"/>feel your need <chord name="Cm"/>of Him.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Fm"/>Lo! th&#x27;incarnate God, ascended,<br/>
      <chord name="Ab"/>Pleads <chord name="Cm"/>the <chord name="Fm"/>merit of <chord name="Db"/>His blood;<br/>
      <chord name="Ab"/>Venture <chord name="Eb7"/>on Him, <chord name="Bbm/Db"/>venture <chord name="Fm"/>wholly,<br/>
      <chord name="Db"/>Let <chord name="Bbm"/>no <chord name="Fm"/>other trust <chord name="Cm"/>intrude.
      </lines>
    </verse>
  </lyrics>
</song>
