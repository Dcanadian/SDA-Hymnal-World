      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>Lord, <chord name="G"/>speak <chord name="F#dim"/>to <chord name="Em"/>me, <chord name="Am"/>that <chord name="D7"/>I may speak<br/>
      <chord name="G/B"/>in <chord name="C"/>living <chord name="G/B"/>echoes <chord name="D"/>of <chord name="Am"/>thy <chord name="D"/>tone;<br/>
      <chord name="D"/>as <chord name="G"/>thou <chord name="Bm"/>has <chord name="Em"/>sought, <chord name="Am"/>so <chord name="D7"/>let me seek<br/>
      <chord name="G/B"/>thine <chord name="C"/>erring <chord name="G/B"/>children <chord name="C"/>lost <chord name="G/D"/>and <chord name="D"/>lone.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>O <chord name="G"/>lead <chord name="F#dim"/>me, <chord name="Em"/>Lord, <chord name="Am"/>that <chord name="D7"/>I may lead<br/>
      <chord name="G/B"/>the wandering and <chord name="A/C#"/>the wavering <chord name="D"/>feet;<br/>
      <chord name="D"/>O <chord name="G"/>feed <chord name="Bm"/>me, <chord name="Em"/>Lord, <chord name="Am"/>that <chord name="D7"/>I may feed<br/>
      <chord name="G/B"/>thy hungering ones <chord name="C"/>with <chord name="G/D"/>manna sweet.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D"/>O <chord name="G"/>strengthen <chord name="Em"/>me, <chord name="Am"/>that while <chord name="D7"/>I stand<br/>
      <chord name="G/B"/>firm <chord name="C"/>on <chord name="D7/A"/>the <chord name="G/B"/>rock, <chord name="A/C#"/>and <chord name="D"/>strong <chord name="Am"/>in <chord name="D"/>thee,<br/>
      <chord name="D"/>I <chord name="G"/>may <chord name="Bm"/>stretch <chord name="Em"/>out <chord name="Am"/>a <chord name="D7"/>loving land<br/>
      <chord name="G/B"/>to <chord name="C"/>wrestlers <chord name="G/B"/>with <chord name="C"/>the <chord name="G/D"/>troubled <chord name="D"/>sea.
      </lines>
    </verse>
  </lyrics>
