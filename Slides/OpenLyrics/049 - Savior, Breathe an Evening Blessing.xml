      <title>049 - Savior, Breathe an Evening Blessing</title>
      <title>Savior, Breathe an Evening Blessing</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="49"/>
    </songbooks>
    <key>Ab</key>
    <tempo type="bpm">Moderato</tempo>
