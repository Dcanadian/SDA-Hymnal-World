<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>283 - O Jesus, Thou Art Standing</title>
      <title>O Jesus, Thou Art Standing</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="283"/>
    </songbooks>
    <key>D</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Gospel</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>O Jesus, thou art standing,<br/>
      <chord name="D"/>outside the fast <chord name="G"/>closed door,<br/>
      <chord name="D"/>in lowly patience waiting<br/>
      <chord name="D"/>to <chord name="Em/G"/>pass the threshold <chord name="A7"/>o&#x27;er:<br/>
      <chord name="D"/>O <chord name="Bm"/>shame, professing <chord name="Em"/>Christians,<br/>
      <chord name="Em"/>his Name <chord name="D/F#"/>and <chord name="E7"/>sign who bear,<br/>
      <chord name="D"/>O shame, thrice shame upon us,<br/>
      <chord name="D"/>to <chord name="Em/G"/>keep <chord name="G"/>him <chord name="A"/>standing there!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>O Jesus, thou art knocking;<br/>
      <chord name="D"/>and lo, that hand <chord name="G"/>is scarred,<br/>
      <chord name="D"/>and thorns thy brow encircle,<br/>
      <chord name="D"/>and <chord name="Em/G"/>tears thy face <chord name="F#m/A"/>have <chord name="A7"/>marred:<br/>
      <chord name="D"/>O <chord name="Bm"/>love that passeth <chord name="Em"/>knowledge,<br/>
      <chord name="Em"/>so patiently <chord name="E7"/>to wait!<br/>
      <chord name="D"/>O sin that hath no equal,<br/>
      <chord name="D"/>so <chord name="Em/G"/>fast <chord name="G"/>to <chord name="A"/>bar the gate!
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D"/>O Jesus, thou art pleading<br/>
      <chord name="D"/>in accents meek <chord name="G"/>and low,<br/>
      <chord name="D"/>&quot;I died for you, my children,<br/>
      <chord name="D"/>and <chord name="Em/G"/>will you treat <chord name="F#m/A"/>me <chord name="A7"/>so?&quot;<br/>
      <chord name="D"/>O <chord name="Bm"/>Lord, with shame and <chord name="Em"/>sorrow<br/>
      <chord name="Em"/>we open <chord name="E7"/>now the door;<br/>
      <chord name="D"/>dear Savior, enter, enter,<br/>
      <chord name="D"/>and <chord name="Em/G"/>leave <chord name="G"/>us <chord name="A"/>never more.
      </lines>
    </verse>
  </lyrics>
</song>
