<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>510 - If You But Trust in God to Guide You</title>
      <title>If You But Trust in God to Guide You</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="510"/>
    </songbooks>
    <key>Bb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Gm"/>If you <chord name="Dm"/>but <chord name="Gm"/>trust <chord name="F"/>in <chord name="Eb"/>God <chord name="F7/C"/>to <chord name="Dm"/>guide you<br/>
      <chord name="Bb"/>And place <chord name="Cm"/>your <chord name="Dm"/>confidence in <chord name="Gm"/>Him,<br/>
      <chord name="Gm"/>You&#x27;ll find <chord name="Dm"/>Him <chord name="Gm"/>always <chord name="Eb"/>there <chord name="F7/C"/>beside <chord name="Dm"/>you,<br/>
      <chord name="Bb"/>To give <chord name="Cm"/>you <chord name="Dm"/>hope <chord name="Gm/Bb"/>and <chord name="Cm"/>strength <chord name="Dm"/>within.<br/>
      <chord name="Dm"/>For those <chord name="Gm"/>who <chord name="F"/>trust <chord name="Bb"/>God&#x27;s <chord name="Gm"/>changeless <chord name="Bb"/>love<br/>
      <chord name="Gm"/>Build <chord name="Dm"/>on <chord name="Eb"/>the <chord name="Dm"/>rock <chord name="Gm/Bb"/>that <chord name="Cm"/>will <chord name="Dm"/>not <chord name="Gm"/>move.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Gm"/>What gain is <chord name="Dm"/>there <chord name="Gm"/>in <chord name="F"/>futile <chord name="Dm"/>weeping,<br/>
      <chord name="Bb"/>In helpless <chord name="Dm"/>anger <chord name="Cm"/>and <chord name="Dm"/>distress?<br/>
      <chord name="Gm"/>If you <chord name="Dm"/>are <chord name="Gm"/>in <chord name="F"/>His <chord name="Eb"/>care <chord name="F7/C"/>and <chord name="Dm"/>keeping,<br/>
      <chord name="Bb"/>In sorrow <chord name="Dm"/>will <chord name="Gm/Bb"/>He <chord name="Cm"/>love <chord name="Dm"/>you <chord name="Gm"/>less?<br/>
      <chord name="Dm"/>For <chord name="Gm"/>He <chord name="F"/>who <chord name="Bb"/>took <chord name="Gm"/>for <chord name="Eb"/>you <chord name="F"/>a <chord name="Bb"/>cross<br/>
      <chord name="Gm"/>Will bring <chord name="Dm"/>you <chord name="Eb"/>safe <chord name="Dm"/>through <chord name="Gm/Bb"/>every loss.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Gm"/>In patient trust <chord name="F"/>await <chord name="F7/C"/>His <chord name="Dm"/>leisure<br/>
      <chord name="Bb"/>In cheerful <chord name="Dm"/>hope, <chord name="Gm/Bb"/>with <chord name="Cm"/>heart <chord name="Dm"/>content<br/>
      <chord name="Gm"/>To take <chord name="Dm"/>whate&#x27;er <chord name="F"/>your <chord name="Eb"/>Father&#x27;s <chord name="Dm"/>pleasure<br/>
      <chord name="Bb"/>And all <chord name="Cm"/>discerning love <chord name="Dm"/>have <chord name="Gm"/>sent;<br/>
      <chord name="Dm"/>Doubt <chord name="Gm"/>not <chord name="F"/>your <chord name="Bb"/>inmost <chord name="Eb"/>wants <chord name="F"/>are <chord name="Bb"/>known<br/>
      <chord name="Gm"/>To <chord name="Dm"/>Him <chord name="Eb"/>who <chord name="Dm"/>chose <chord name="Gm/Bb"/>you <chord name="Cm"/>for <chord name="Dm"/>His <chord name="Gm"/>own.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Gm"/>Sing, pray, <chord name="Dm"/>and <chord name="Gm"/>keep <chord name="F"/>His <chord name="Eb"/>ways <chord name="F7/C"/>unswerving,<br/>
      <chord name="Bb"/>Offer <chord name="Cm"/>your <chord name="Dm"/>service <chord name="Cm"/>faithfully,<br/>
      <chord name="Gm"/>And trust <chord name="Dm"/>His <chord name="Gm"/>word; <chord name="F"/>though <chord name="Eb"/>undeserving,<br/>
      <chord name="Bb"/>You&#x27;ll find <chord name="Cm"/>His <chord name="Dm"/>promise <chord name="Cm"/>true <chord name="Dm"/>to <chord name="Gm"/>be.<br/>
      <chord name="Dm"/>God <chord name="Gm"/>never <chord name="Bb"/>will <chord name="Gm"/>forsake <chord name="F"/>in <chord name="Bb"/>need<br/>
      <chord name="Gm"/>The <chord name="Dm"/>soul <chord name="Eb"/>that <chord name="Dm"/>trusts <chord name="Gm/Bb"/>in <chord name="Cm"/>Him <chord name="Dm"/>indeed.
      </lines>
    </verse>
  </lyrics>
</song>
