<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>389 - Light of Light, Enlighten Me</title>
      <title>Light of Light, Enlighten Me</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="389"/>
    </songbooks>
    <key>Eb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Doctrines</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Gm"/>Light of light, enlighten me,<br/>
      <chord name="Bb7"/>Now anew the day <chord name="Fm"/>is dawning;<br/>
      <chord name="Bb/F"/>Sun <chord name="Cm/G"/>of <chord name="Bb7/Ab"/>grace, the <chord name="Cm/G"/>shadows <chord name="Gm/Bb"/>flee;<br/>
      <chord name="Gb"/>Brighten Thou <chord name="Gbm"/>my <chord name="Gm"/>Sabbath <chord name="Bb"/>morning;<br/>
      <chord name="Bb/D"/>With Thy joyous <chord name="Am"/>sunshine blest,<br/>
      <chord name="Bb"/>Happy is my day of rest.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Gm"/>Let me with my heart today,<br/>
      <chord name="Bb7"/>Holy, holy, holy, <chord name="Fm"/>singing,<br/>
      <chord name="Bb/F"/>Rapt <chord name="Cm/G"/>awhile from <chord name="Gm"/>earth away,<br/>
      <chord name="Gb"/>All my soul <chord name="Gbm"/>to <chord name="Gm"/>Thee up <chord name="Bb"/>springing,<br/>
      <chord name="Bb/D"/>Have a foretaste <chord name="Am"/>inward given<br/>
      <chord name="Bb"/>How they worship Thee in heaven.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Gm"/>Hence all care, all vanity!<br/>
      <chord name="Bb7"/>For the day to God <chord name="Fm"/>is holy;<br/>
      <chord name="Bb/F"/>Come, <chord name="Cm/G"/>Thou <chord name="Bb7/Ab"/>glorious <chord name="Cm/G"/>Majesty,<br/>
      <chord name="Gb"/>Deign to fill <chord name="Gbm"/>this <chord name="Gm"/>temple <chord name="Bb"/>lowly;<br/>
      <chord name="Bb/D"/>Nought today <chord name="Am"/>my soul shall move,<br/>
      <chord name="Bb"/>Simply resting in Thy love.
      </lines>
    </verse>
  </lyrics>
</song>
