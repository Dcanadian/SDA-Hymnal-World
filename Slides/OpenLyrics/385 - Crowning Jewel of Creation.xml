  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Ab"/>Crowning jewel of creation, Blest and <chord name="Db"/>hallowed, <chord name="Ab/C"/>sanctified;<br/>
      <chord name="Ab"/>Time and changes <chord name="Db"/>all <chord name="Eb7/Db"/>transcending, Shared <chord name="Ab"/>forever, <chord name="Eb/Bb"/>glori <chord name="Fm"/>fied.<br/>
      <chord name="Db/F"/>Blessed Sabbath made <chord name="Eb7/Db"/>for <chord name="Ab/C"/>man, <chord name="Bbm"/>Gift <chord name="Eb"/>from <chord name="Ab"/>the Crea tor&#x27;s hand.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Ab"/>Blessed Sabbath <chord name="Db"/>made <chord name="Cm"/>for <chord name="Fm"/>man,<br/>
      <chord name="Eb7"/>Gift from the Creator&#x27;s <chord name="Ab"/>hand.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Ab"/>Sin and sickness, prayer and <chord name="Db"/>weeping<br/>
      <chord name="Ab"/>Cease at <chord name="Eb7/Db"/>close of <chord name="Ab"/>earthly days;<br/>
      <chord name="Ab"/>But Thy <chord name="Db"/>Sabbath <chord name="Eb7"/>is <chord name="Ab"/>eternal,<br/>
      <chord name="Db/F"/>Joyful <chord name="Eb7/Db"/>thanks <chord name="Ab/C"/>to <chord name="Eb"/>Thee <chord name="Ab"/>we raise!
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Ab"/>Teach us Lord, in storm or <chord name="Db"/>sunshine<br/>
      <chord name="Ab"/>How to <chord name="Eb7/Db"/>truly <chord name="Ab"/>rest <chord name="Cm"/>in <chord name="Ab"/>Thee,<br/>
      <chord name="Ab"/>May Thy <chord name="Db"/>Sabbath <chord name="Eb7"/>peace <chord name="Ab"/>enfold us<br/>
      <chord name="Db/F"/>And <chord name="Ab/Eb"/>our <chord name="Eb7/Db"/>shelter <chord name="Eb"/>ever <chord name="Ab"/>be.
      </lines>
    </verse>
  </lyrics>
