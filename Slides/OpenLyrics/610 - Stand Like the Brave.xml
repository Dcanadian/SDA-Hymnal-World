  <properties>
    <titles>
      <title>610 - Stand Like the Brave</title>
      <title>Stand Like the Brave</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="610"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
