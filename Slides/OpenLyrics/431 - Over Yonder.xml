<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>431 - Over Yonder</title>
      <title>Over Yonder</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="431"/>
    </songbooks>
    <key>Ab</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3</verseOrder>
    <themes>
      <theme>Doctrines</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Bbm"/>Come let us <chord name="Ab"/>sing of homeland,<br/>
      <chord name="Ab"/>Down <chord name="Bbm"/>by <chord name="Eb7"/>the crystal sea;<br/>
      <chord name="Ab"/>Wonderful <chord name="Db"/>land where <chord name="Bbm"/>Jesus<br/>
      <chord name="Eb7/Bb"/>Buildeth <chord name="Ab"/>a <chord name="Eb/Bb"/>mansion for me.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Eb"/>Over <chord name="Ab"/>yonder, down by the crystal sea,<br/>
      <chord name="Eb7"/>Over yonder, there&#x27;s <chord name="Ab"/>where I long to be,<br/>
      <chord name="Ab"/>No more sorrow, <chord name="Db/Ab"/>toil, grief, <chord name="Ab"/>nor care,<br/>
      <chord name="Cm"/>In the homeland <chord name="Fm"/>bright <chord name="Bbm/Db"/>and <chord name="Db"/>fair,<br/>
      <chord name="G7/D"/>Over, <chord name="Ab/Eb"/>over there.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Bbm"/>Water <chord name="Ab"/>of life there floweth,<br/>
      <chord name="Ab"/>Fruit <chord name="Bbm"/>in <chord name="Eb7"/>abundant store;<br/>
      <chord name="Ab"/>Citizens <chord name="Db"/>of that <chord name="Bbm"/>country<br/>
      <chord name="Eb7/Bb"/>Hunger <chord name="Ab"/>and <chord name="Eb/Bb"/>thirst never more.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Bbm"/>Come go with <chord name="Ab"/>me to homeland,<br/>
      <chord name="Ab"/>Jesus <chord name="Bbm"/>invites <chord name="Eb7"/>you there;<br/>
      <chord name="Ab"/>Help spread <chord name="Db"/>the invitation,<br/>
      <chord name="Eb7/Bb"/>Tell <chord name="Ab"/>it to <chord name="Eb/Bb"/>men everywhere.
      </lines>
    </verse>
  </lyrics>
</song>
