<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>570 - Not I, But Christ</title>
      <title>Not I, But Christ</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="570"/>
    </songbooks>
    <key>Eb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb"/>Not I, but <chord name="Bb7/F"/>Christ, be honored, loved, <chord name="Eb"/>exalted;<br/>
      <chord name="Eb"/>Not I, but Christ, be seen, be <chord name="Bb7/D"/>known, <chord name="Eb"/>be <chord name="Bb"/>heard;<br/>
      <chord name="Eb"/>Not I, but <chord name="Bb7/F"/>Christ, in every look and action,<br/>
      <chord name="Eb"/>Not I, but <chord name="Bb7/F"/>Christ, <chord name="Eb"/>in <chord name="Ab"/>every <chord name="Eb/Bb"/>thought <chord name="Bb"/>and <chord name="Eb"/>word.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Eb"/>Not I, but <chord name="Bb7/F"/>Christ, to gently soothe <chord name="Eb"/>in sorrow,<br/>
      <chord name="Eb"/>Not I, but Christ, to wipe the <chord name="Bb7/D"/>falling <chord name="Bb"/>tear;<br/>
      <chord name="Eb"/>Not I, but <chord name="Bb7/F"/>Christ, to lift the weary burden,<br/>
      <chord name="Eb"/>Not I, but <chord name="Bb7/F"/>Christ, <chord name="Eb"/>to <chord name="Ab"/>hush <chord name="Eb/Bb"/>away all <chord name="Bb"/>fear.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Eb"/>Christ, only <chord name="Bb7/F"/>Christ! No idle words <chord name="Eb"/>e&#x27;er falling,<br/>
      <chord name="Eb"/>Christ, only Christ; no needless <chord name="Bb7/D"/>bustling <chord name="Bb"/>sound;<br/>
      <chord name="Eb"/>Christ, only <chord name="Bb7/F"/>Christ, no self important bearing;<br/>
      <chord name="Eb"/>Christ, only <chord name="Bb7/F"/>Christ, <chord name="Eb"/>no <chord name="Ab"/>trace <chord name="Eb/Bb"/>of <chord name="Bb7"/>&quot;I&quot; <chord name="Eb/Bb"/>be <chord name="Bb"/>found.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Eb"/>Not I, but <chord name="Bb7/F"/>Christ, my every <chord name="Eb"/>need supplying,<br/>
      <chord name="Eb"/>Not I, but Christ, my strength and <chord name="Bb7/D"/>health <chord name="Eb"/>to <chord name="Bb"/>be;<br/>
      <chord name="Eb"/>Christ, only <chord name="Bb7/F"/>Christ, for body, soul, and spirit,<br/>
      <chord name="Eb"/>Christ, only <chord name="Bb7/F"/>Christ, <chord name="Eb"/>here <chord name="Ab"/>and <chord name="Eb/Bb"/>eternally.
      </lines>
    </verse>
  </lyrics>
</song>
