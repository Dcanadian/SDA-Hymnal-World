    <verse name="v4">
      <lines>
      <chord name="Eb"/>Not <chord name="Bb7"/>I, but <chord name="Eb"/>Christ, <chord name="Bb7"/>my every <chord name="Eb"/>need supplying,<br/>
      <chord name="Ab"/>Not I, <chord name="Eb"/>but Christ, <chord name="Bb7"/>my strength <chord name="Eb"/>and health <chord name="Bb"/>to be;<br/>
      <chord name="Eb"/>Christ, <chord name="Bb7"/>only <chord name="Cm7"/>Christ, for <chord name="Bb7"/>body, <chord name="Ab"/>soul, <chord name="Eb"/>and spirit,<br/>
      <chord name="Eb"/>Christ, <chord name="Bb7"/>only <chord name="Eb"/>Christ, <chord name="Ab"/>here <chord name="Bb7"/>and <chord name="Eb"/>eternally.
