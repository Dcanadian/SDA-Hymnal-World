  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Bb"/>I will sing of <chord name="F7"/>Jesus&#x27;<chord name="Bb"/> love, Sing of<chord name="F7"/> Him, who<chord name="Eb"/> first loved<chord name="Bb"/> me;<br/>
      <chord name="Bb"/>For He left <chord name="Bb7"/>bright <chord name="Eb"/>worlds above, And <chord name="Bb"/>died on <chord name="F7"/>Cal-va<chord name="Bb"/>ry.<br/>
      <chord name="Bb7"/>I will <chord name="Eb"/>sing of <chord name="Bb"/>Jesus&#x27; love<chord name="F"/> Endless<chord name="Bb"/> praise<chord name="Eb"/> my<chord name="F"/> heart shall give;<br/>
      <chord name="Gm"/>He has died <chord name="D"/>that I <chord name="Eb"/>might live I will <chord name="Bb"/>sing His <chord name="F7"/>love to <chord name="Bb"/>me.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Bb"/>I <chord name="F7"/>will <chord name="Bb"/>sing <chord name="F7"/>of <chord name="Eb"/>Jesus <chord name="Bb"/>love<br/>
      <chord name="Bb"/>Endless <chord name="Bb7"/>praise <chord name="Eb"/>my <chord name="Bb"/>heart <chord name="F7"/>shall <chord name="Bb"/>give;<br/>
      <chord name="Bb7"/>He <chord name="Eb"/>has <chord name="Bb"/>died <chord name="F"/>that <chord name="Bb"/>I <chord name="Eb"/>might <chord name="F"/>live<br/>
