      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Bb"/>O <chord name="F7"/>the <chord name="Bb"/>depths <chord name="F7"/>of <chord name="Eb"/>love <chord name="Bb"/>divine!<br/>
      <chord name="Bb"/>Earth <chord name="Bb7"/>or <chord name="Eb"/>heaven <chord name="Bb"/>can <chord name="F7"/>never <chord name="Bb"/>know<br/>
      <chord name="Bb7"/>How <chord name="Eb"/>that <chord name="Bb"/>sin <chord name="F"/>as <chord name="Bb"/>dark <chord name="Eb"/>as <chord name="F"/>mine<br/>
