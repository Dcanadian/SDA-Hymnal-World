      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Bb"/>Nothing <chord name="F7"/>good <chord name="Bb"/>for <chord name="F7"/>Him <chord name="Eb"/>I&#x27;ve <chord name="Bb"/>done;<br/>
      <chord name="Bb"/>How <chord name="Bb7"/>could <chord name="Eb"/>He <chord name="Bb"/>such <chord name="F7"/>love <chord name="Bb"/>bestow?<br/>
      <chord name="Bb7"/>Lord, <chord name="Eb"/>I <chord name="Bb"/>own <chord name="F"/>my <chord name="Bb"/>heart <chord name="Eb"/>is <chord name="F"/>won,<br/>
      <chord name="Gm"/>help <chord name="D"/>me <chord name="Eb"/>now <chord name="Bb"/>my <chord name="F7"/>love <chord name="Bb"/>to show.
