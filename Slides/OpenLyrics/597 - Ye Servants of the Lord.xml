  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G/B"/>Ye <chord name="C"/>servants of <chord name="G"/>the Lord,<br/>
      <chord name="G/B"/>Each <chord name="C"/>in <chord name="G7/D"/>his <chord name="C/E"/>office wait,<br/>
      <chord name="F"/>Observant of <chord name="G"/>His <chord name="G7/F"/>heavenly <chord name="G/B"/>Word,<br/>
      <chord name="G7/D"/>And <chord name="C"/>watchful at <chord name="G"/>His <chord name="G7"/>gate.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G/B"/>Let <chord name="C"/>all your lamps <chord name="G"/>be bright,<br/>
      <chord name="G/B"/>And <chord name="C"/>trim <chord name="G7/D"/>the <chord name="C/E"/>golden flame,<br/>
      <chord name="F"/>Gird <chord name="Dm"/>up <chord name="F"/>your loins <chord name="G"/>as <chord name="G7/F"/>in <chord name="C/E"/>His sight,<br/>
      <chord name="G7/D"/>His <chord name="C"/>coming thus <chord name="G"/>proclaim.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G/B"/>Watch, <chord name="C"/>&#x27;tis your Lord&#x27;s <chord name="G"/>command,<br/>
      <chord name="G/B"/>And <chord name="C"/>while we speak He&#x27;s <chord name="F"/>near;<br/>
      <chord name="F"/>Mark <chord name="Dm"/>the <chord name="F"/>first signal <chord name="G7/F"/>of <chord name="C/E"/>His hand,<br/>
      <chord name="G7/D"/>And <chord name="C"/>ready all <chord name="G"/>appear.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="G/B"/>O <chord name="C"/>happy servant, <chord name="G"/>he,<br/>
      <chord name="G/B"/>In <chord name="C"/>such <chord name="G7/D"/>a <chord name="C/E"/>posture found!<br/>
      <chord name="F"/>He <chord name="Dm"/>shall <chord name="F"/>His Lord <chord name="G"/>with <chord name="G7/F"/>rapture <chord name="C"/>see,<br/>
      <chord name="G7/D"/>And <chord name="C"/>be with honor <chord name="G7"/>crowned.
      </lines>
    </verse>
