  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Db"/>Lord, <chord name="Gb/Db"/>dismiss <chord name="Db"/>us with Thy <chord name="Gb"/>blessing; <chord name="Db"/>Fill our <chord name="Ab/C"/>hearts <chord name="Ebm"/>with <chord name="Fm"/>joy <chord name="Ab/Eb"/>and <chord name="Ebm"/>peace;<br/>
      <chord name="Db"/>Let <chord name="Gb/Db"/>us <chord name="Db"/>each, Thy love possessing, Triumph <chord name="Ab/C"/>in <chord name="Ebm"/>redeeming grace.<br/>
      <chord name="Ab"/>Orefresh <chord name="Ebm"/>us, <chord name="Ab7"/>O <chord name="Db"/>refresh us, <chord name="Ab7/Eb"/>Travelling <chord name="Db"/>through <chord name="Gb"/>this wilderness.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Db"/>Thanks we give <chord name="Gb"/>and <chord name="Db"/>adoration<br/>
      <chord name="Db"/>for thy gospel&#x27;s joyful <chord name="Ab/Eb"/>sound.<br/>
      <chord name="Db"/>May the fruits <chord name="Gb"/>of <chord name="Db"/>thy salvation<br/>
      <chord name="Db"/>in our hearts <chord name="Gb"/>and <chord name="Db"/>lives <chord name="Fm"/>abound;<br/>
      <chord name="Ab"/>ever <chord name="Ab7"/>faithful, ever <chord name="Gb"/>faithful<br/>
      <chord name="Ab"/>to <chord name="Fm"/>the <chord name="Db"/>truth may we <chord name="Gb"/>be found.
      </lines>
    </verse>
  </lyrics>
