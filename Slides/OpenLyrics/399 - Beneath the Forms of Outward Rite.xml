    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb"/>Beneath the <chord name="Bb/D"/>forms <chord name="Ab/C"/>of <chord name="Bb/D"/>outward <chord name="Eb"/>rite<br/>
      <chord name="Bb/D"/>Thy <chord name="Eb"/>supper, <chord name="Bb"/>Lord, <chord name="Ab/C"/>is <chord name="Eb"/>spread<br/>
      <chord name="Eb/G"/>In <chord name="Ab"/>every <chord name="Eb"/>quiet <chord name="Gm"/>upper room<br/>
      <chord name="Cm"/>Where fainting souls are <chord name="Eb"/>fed.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Eb"/>The <chord name="Gm"/>bread <chord name="Eb"/>is <chord name="Bb/D"/>always consecrate<br/>
      <chord name="Bb/D"/>Which <chord name="Eb"/>men <chord name="Cm"/>divide <chord name="Ab/C"/>with <chord name="Eb"/>men;<br/>
      <chord name="Eb/G"/>And every act of <chord name="Gm"/>brotherhood<br/>
      <chord name="Cm"/>Repeats <chord name="Fm/Ab"/>Thy <chord name="Cm"/>feast again.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Eb"/>The <chord name="Gm"/>blessed <chord name="Eb"/>cup is <chord name="Ab/C"/>only <chord name="Eb"/>passed<br/>
      <chord name="Bb/D"/>True <chord name="Eb"/>memory <chord name="Ab/C"/>of <chord name="Eb"/>Thee,<br/>
      <chord name="Eb/G"/>When <chord name="Ab"/>life <chord name="Bb7/F"/>anew <chord name="Eb"/>pours <chord name="Gm"/>out <chord name="Ab"/>its <chord name="Gm/Bb"/>wine<br/>
      <chord name="Cm"/>With rich <chord name="Fm/Ab"/>sufficiency.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Eb"/>O <chord name="Gm"/>Master, <chord name="Bb/D"/>through <chord name="Ab/C"/>these <chord name="Bb/D"/>symbols <chord name="Eb"/>shared,<br/>
      <chord name="Bb/D"/>Thine <chord name="Eb"/>own <chord name="Cm"/>dear <chord name="Bb"/>self <chord name="Ab/C"/>impart,<br/>
      <chord name="Eb/G"/>That <chord name="Ab"/>in <chord name="Bb7/F"/>our <chord name="Eb"/>daily <chord name="Gm"/>life <chord name="Ab"/>may <chord name="Gm/Bb"/>flame<br/>
      <chord name="Cm"/>The passion of Thy <chord name="Eb"/>heart.
      </lines>
    </verse>
  </lyrics>
