<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>104 - My Shepherd Will Supply My Need</title>
      <title>My Shepherd Will Supply My Need</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="104"/>
    </songbooks>
    <key>C</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>God the Father</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C"/>My Shepherd will supply <chord name="G"/>my <chord name="C"/>need,<br/>
      <chord name="C"/>Jehovah <chord name="Am"/>is His <chord name="Em"/>name.<br/>
      <chord name="Em"/>In pastures <chord name="Am"/>fresh He makes <chord name="G"/>me feed<br/>
      <chord name="C"/>Beside <chord name="Am"/>the living stream.<br/>
      <chord name="Am"/>He brings my <chord name="Em"/>wand&#x27;ring spirit <chord name="Am"/>back<br/>
      <chord name="C"/>When <chord name="Am"/>I forsake His ways,<br/>
      <chord name="Dm"/>And leads <chord name="C"/>me, for His <chord name="Am"/>mercy&#x27;s sake,<br/>
      <chord name="Am"/>In paths <chord name="Bdim"/>of truth <chord name="Am"/>and grace.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="C"/>When I walk through the shades <chord name="G"/>of <chord name="C"/>death,<br/>
      <chord name="C"/>Thy presence <chord name="Am"/>is my <chord name="Em"/>stay;<br/>
      <chord name="Em"/>A <chord name="G"/>word <chord name="Am"/>of Thy supporting <chord name="G"/>breath<br/>
      <chord name="C"/>Drives <chord name="G/B"/>all <chord name="Am"/>my fears away.<br/>
      <chord name="Am"/>Thy hand in <chord name="Em"/>sight <chord name="Am/E"/>of <chord name="Em"/>all <chord name="G"/>my <chord name="Am"/>foes<br/>
      <chord name="C"/>Doth <chord name="Am"/>still my table spread;<br/>
      <chord name="Dm"/>My cup <chord name="C"/>with blessings <chord name="Am"/>over flows,<br/>
      <chord name="Am"/>Thine oil <chord name="Bdim"/>anoints <chord name="Am"/>my head.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="C"/>The sure provisions of <chord name="G"/>my <chord name="C"/>God<br/>
      <chord name="C"/>Attend me <chord name="Am"/>all my <chord name="Em"/>days;<br/>
      <chord name="Em"/>O <chord name="G"/>may <chord name="Am"/>Thy house be <chord name="G/B"/>mine abode<br/>
      <chord name="C"/>And <chord name="G/B"/>all <chord name="Am"/>my work be praise.<br/>
      <chord name="Am"/>There would <chord name="Em"/>I <chord name="Am/E"/>find <chord name="Em"/>a <chord name="G"/>settled <chord name="Am"/>rest<br/>
      <chord name="C"/>While <chord name="Am"/>others go and <chord name="G"/>come;<br/>
      <chord name="Dm"/>No more <chord name="C"/>a stranger <chord name="Am"/>or a guest,<br/>
      <chord name="Am"/>But like <chord name="Bdim"/>a child <chord name="Am"/>at home.
      </lines>
    </verse>
  </lyrics>
</song>
