  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Angels we <chord name="Gm"/>have <chord name="F"/>heard on high Sweetly singing <chord name="Am"/>o&#x27;er <chord name="Dm"/>the <chord name="C7/E"/>plains,<br/>
      <chord name="Am"/>And <chord name="Dm"/>the <chord name="F"/>mountains <chord name="Dm"/>in reply <chord name="C7"/>Echoing <chord name="Bb"/>their joy-ous <chord name="C/E"/>strains.<br/>
      <chord name="F/A"/>Glo <chord name="C"/>ria <chord name="Bb"/>in <chord name="F/C"/>excelsis <chord name="Dm/F"/>Deo!
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Gm"/>Gloria, <chord name="C7/E"/>in <chord name="F"/>excelsis <chord name="Dm"/>Deo!<br/>
      <chord name="F/A"/>Gloria, in <chord name="Bb"/>excelsis <chord name="F"/>Deo!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>Shepherds, why this <chord name="C7"/>jubilee?<br/>
      <chord name="Am"/>Why <chord name="F"/>your <chord name="Dm"/>joyous <chord name="Gm"/>strains <chord name="C7/E"/>prolong?<br/>
      <chord name="Am"/>What <chord name="C/E"/>the <chord name="F"/>gladsome <chord name="C7"/>tidings <chord name="Bb/D"/>be<br/>
      <chord name="F/A"/>Which <chord name="C"/>inspire <chord name="F/C"/>your <chord name="C"/>heavenly <chord name="Dm/F"/>song?
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>Come to Bethlehem and <chord name="Dm"/>see<br/>
      <chord name="Am"/>Christ <chord name="C/E"/>Whose <chord name="F"/>birth <chord name="Dm/F"/>the <chord name="C7"/>angels <chord name="Bb/D"/>sing;<br/>
      <chord name="Am"/>Come, <chord name="C/E"/>adore <chord name="Dm/F"/>on <chord name="C7"/>bended <chord name="Bb/D"/>knee,<br/>
      <chord name="F/A"/>Christ <chord name="C"/>the <chord name="Bb"/>Lord, <chord name="F/C"/>the newborn <chord name="Dm/F"/>King.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F"/>See Him in a <chord name="C7"/>manger <chord name="Dm"/>laid,<br/>
      <chord name="Am"/>Whom <chord name="C/E"/>the <chord name="F"/>choirs <chord name="Dm/F"/>of <chord name="C7"/>angels <chord name="Bb/D"/>praise;<br/>
      <chord name="Am"/>Mary, <chord name="F"/>Joseph, <chord name="C7"/>lend <chord name="F"/>your <chord name="Bb/D"/>aid,<br/>
      <chord name="F/A"/>While our hearts <chord name="C"/>in <chord name="F"/>love <chord name="Dm"/>we raise.
      </lines>
    </verse>
  </lyrics>
