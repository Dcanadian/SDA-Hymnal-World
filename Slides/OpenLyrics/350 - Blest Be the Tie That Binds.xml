    <titles>
      <title>350 - Blest Be the Tie That Binds</title>
      <title>Blest Be the Tie That Binds</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="350"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Christian Church</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Blest be the <chord name="C"/>tie <chord name="C7"/>that <chord name="F"/>binds <chord name="Bb"/>our hearts <chord name="F"/>in Christian <chord name="C"/>love;<br/>
      <chord name="C"/>The <chord name="C7"/>fellowship <chord name="C"/>of kindred <chord name="F"/>minds is like to <chord name="Bb"/>that <chord name="F/C"/>above.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>Before <chord name="C7"/>our <chord name="Bb"/>Father&#x27;s <chord name="C"/>throne<br/>
      <chord name="F"/>we pour <chord name="C7"/>our <chord name="Bb"/>ardent <chord name="C"/>prayers;<br/>
      <chord name="C"/>our <chord name="F"/>fears, our <chord name="C"/>hopes, <chord name="Bb/F"/>our <chord name="F"/>aims are <chord name="C7"/>one,<br/>
      <chord name="C"/>our <chord name="F"/>comforts <chord name="C7"/>and <chord name="Bb/F"/>our <chord name="F"/>cares.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>We share <chord name="C7"/>each <chord name="Bb"/>other&#x27;s <chord name="C"/>woes,<br/>
      <chord name="F"/>our mutual <chord name="Bb"/>burdens <chord name="C"/>bear;<br/>
      <chord name="C"/>and <chord name="F"/>often <chord name="C"/>for <chord name="F"/>each other flows<br/>
      <chord name="C"/>the <chord name="F"/>sympathizing tear.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F"/>When we <chord name="C7"/>asunder <chord name="C"/>part,<br/>
      <chord name="F"/>it gives us <chord name="Bb"/>inward <chord name="C"/>pain;<br/>
      <chord name="C"/>but <chord name="F"/>we shall <chord name="C"/>still <chord name="F"/>be joined <chord name="Bb"/>in <chord name="F/C"/>heart,<br/>
      <chord name="C"/>and <chord name="F"/>hope <chord name="C"/>to <chord name="F"/>meet again.
      </lines>
    </verse>
  </lyrics>
