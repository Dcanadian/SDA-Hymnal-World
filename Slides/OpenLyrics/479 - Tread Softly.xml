<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>479 - Tread Softly</title>
      <title>Tread Softly</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="479"/>
    </songbooks>
    <key>Bb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Bb"/>Be silent, be silent, A whisper <chord name="F"/>is <chord name="F7"/>heard,<br/>
      <chord name="F7"/>Be silent, <chord name="Bb"/>and listen, <chord name="Eb"/>Oh, treasure <chord name="Bb"/>each word!<br/>
      <chord name="Bb"/>Tread softly, <chord name="F/C"/>tread softly, <chord name="C7"/>The Master <chord name="F"/>is here,<br/>
      <chord name="F7"/>Tread softly, <chord name="Bb"/>tread softly, <chord name="Eb"/>He bids us <chord name="F"/>draw <chord name="F7"/>near.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="F7"/>Tread softly, <chord name="Bb"/>tread softly, The <chord name="Eb"/>Master is here;<br/>
      <chord name="Eb"/>Tread softly, <chord name="Bb"/>tread softly, <chord name="F"/>He <chord name="F7"/>bids us draw <chord name="Bb"/>near.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Bb"/>Be silent, be silent,<br/>
      <chord name="F7"/>For <chord name="Bb"/>holy <chord name="Eb"/>this <chord name="Bb"/>place,<br/>
      <chord name="Bb"/>This altar <chord name="C7"/>that echoes<br/>
      <chord name="F7"/>The <chord name="Bb"/>message <chord name="Eb"/>of <chord name="F"/>grace.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Bb"/>Be silent, be silent,<br/>
      <chord name="F7"/>Breathe <chord name="Bb"/>humbly <chord name="Eb"/>our <chord name="Bb"/>prayer;<br/>
      <chord name="Bb"/>A foretaste <chord name="C7"/>of Eden<br/>
      <chord name="F7"/>This <chord name="Bb"/>moment <chord name="Eb"/>we <chord name="F"/>share.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Bb"/>Be silent, be silent,<br/>
      <chord name="F7"/>His <chord name="Bb"/>mercy <chord name="Eb"/>record;<br/>
      <chord name="Bb"/>Be silent, <chord name="C7"/>be silent,<br/>
      <chord name="F7"/>And <chord name="Bb"/>wait on <chord name="Eb"/>the <chord name="F"/>Lord.
      </lines>
    </verse>
  </lyrics>
</song>
