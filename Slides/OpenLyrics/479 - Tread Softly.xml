  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Bb"/>Be silent, be silent, A <chord name="F"/>whisper is <chord name="Bb"/>heard,<br/>
      Be <chord name="Eb"/>silent, and <chord name="Bb"/>listen, Oh, <chord name="F"/>trea<chord name="C7"/>sure each <chord name="F"/>wo<chord name="Bb"/>rd!<chord name="F7"/><br/>
      <chord name="F7"/>Tread <chord name="Bb"/>softly, tread <chord name="Eb"/>softly, The <chord name="F"/>Mas<chord name="F7"/>ter is <chord name="Bb"/>here,<br/>
      Tread <chord name="Eb"/>softly, tread <chord name="Bb"/>softly, He <chord name="F"/>bids <chord name="F7"/>us draw <chord name="Bb"/>near.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Bb"/>Tread softly, <chord name="F"/>tread softly, The <chord name="Bb"/>Master is here;<br/>
      <chord name="Eb"/>Tread <chord name="Bb"/>softly, <chord name="F"/>tread <chord name="C7"/>softly, He <chord name="F"/>bids <chord name="Bb"/>us <chord name="F7"/>draw near.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Bb"/>Be <chord name="F"/>silent, <chord name="Bb"/>be silent,<br/>
      <chord name="Eb"/><chord name="Bb"/>For <chord name="F"/><chord name="C7"/>holy <chord name="F"/><chord name="Bb"/>this <chord name="F7"/>place,<br/>
      <chord name="F7"/><chord name="Bb"/>This <chord name="Eb"/>altar <chord name="F"/><chord name="F7"/>that <chord name="Bb"/>echoes<br/>
      <chord name="Eb"/><chord name="Bb"/>The <chord name="F"/>message <chord name="F7"/>of <chord name="Bb"/>grace.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Bb"/>Be <chord name="F"/>silent, <chord name="Bb"/>be silent,<br/>
      <chord name="Eb"/><chord name="Bb"/>Breathe <chord name="F"/><chord name="C7"/>humbly <chord name="F"/><chord name="Bb"/>our <chord name="F7"/>prayer;<br/>
      <chord name="F7"/><chord name="Bb"/>A <chord name="Eb"/>foretaste <chord name="F"/><chord name="F7"/>of <chord name="Bb"/>Eden<br/>
      <chord name="Eb"/><chord name="Bb"/>This <chord name="F"/>moment <chord name="F7"/>we <chord name="Bb"/>share.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Bb"/>Be <chord name="F"/>silent, <chord name="Bb"/>be silent,<br/>
      <chord name="Eb"/><chord name="Bb"/><chord name="F"/>His <chord name="C7"/><chord name="F"/>mercy <chord name="Bb"/><chord name="F7"/>record;<br/>
      <chord name="F7"/><chord name="Bb"/>Be <chord name="Eb"/>silent, <chord name="F"/><chord name="F7"/>be <chord name="Bb"/>silent,<br/>
      <chord name="Eb"/>And <chord name="Bb"/>wait <chord name="F"/>on <chord name="F7"/>the <chord name="Bb"/>Lord.
      </lines>
