  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C"/>Good <chord name="G"/>Christian <chord name="C"/>friends, <chord name="Em"/>rejoice <chord name="F"/>and <chord name="Dm"/>sing!<br/>
      <chord name="Am"/>Now <chord name="G/B"/>is <chord name="Am/C"/>the <chord name="G"/>triumph <chord name="C"/>of our <chord name="F"/>King!<br/>
      <chord name="Dm"/>To <chord name="Em"/>all <chord name="Dm/F"/>the <chord name="C"/>world glad news <chord name="G"/>we <chord name="Am"/>bring:<br/>
      <chord name="Am"/>Alleluia! <chord name="Dm"/>Alleluia! Alleluia!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="C"/>The <chord name="G"/>Lord <chord name="Am"/>of <chord name="C"/>life <chord name="Dm"/>is <chord name="Em"/>risen <chord name="F"/>for <chord name="Dm"/>aye;<br/>
      <chord name="Am"/>Bring flowers of <chord name="G"/>song <chord name="C"/>to strew <chord name="F"/>His <chord name="Em"/>way;<br/>
      <chord name="Dm"/>Let <chord name="Em"/>all <chord name="Dm/F"/>mankind <chord name="C"/>rejoice <chord name="G"/>and <chord name="Am"/>say:<br/>
      <chord name="Am"/>Alleluia! <chord name="Dm"/>Alleluia! Alleluia!
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="C"/>Praise <chord name="G"/>we <chord name="Em"/>in <chord name="C"/>songs <chord name="Em"/>of <chord name="C"/>victory<br/>
      <chord name="Am"/>That <chord name="G/B"/>love, <chord name="Am/C"/>that <chord name="G"/>life <chord name="C"/>which cannot <chord name="Em"/>die,<br/>
      <chord name="Dm"/>And <chord name="Em"/>sing <chord name="Dm/F"/>with <chord name="C"/>hearts uplifted <chord name="Am"/>high:<br/>
      <chord name="Am"/>Alleluia! <chord name="Dm"/>Alleluia! Alleluia!
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="C"/>Thy <chord name="G"/>name <chord name="Em"/>we <chord name="C"/>bless, <chord name="Em"/>O <chord name="C"/>risen <chord name="Dm"/>Lord,<br/>
      <chord name="Am"/>And <chord name="G/B"/>sing <chord name="Am/C"/>today <chord name="C"/>with one <chord name="F"/>accord<br/>
      <chord name="Dm"/>The <chord name="Em"/>life <chord name="Dm/F"/>laid <chord name="C"/>down, the life <chord name="G"/>restored:<br/>
      <chord name="Am"/>Alleluia! <chord name="Dm"/>Alleluia! Alleluia!
      </lines>
    </verse>
  </lyrics>
