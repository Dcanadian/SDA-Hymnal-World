  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Bb"/>O Thou who hearest every <chord name="Cm"/>heartfelt <chord name="Bb"/>prayer,<br/>
      <chord name="Gm"/>With <chord name="A"/>Thy <chord name="A7/Db"/>rich <chord name="Dm"/>grace, Lord, <chord name="F/C"/>all our <chord name="Cm"/>hearts prepare;<br/>
      <chord name="F"/>Thou art our <chord name="F7"/>life, Thou art our love and light,<br/>
      <chord name="Bb"/>Olet <chord name="Cm"/>this <chord name="Bb/D"/>Sabbath <chord name="Eb"/>hour <chord name="Bb/F"/>with Thee <chord name="Gm"/>be <chord name="Bb/F"/>bright. <chord name="F7"/>Amen.
      </lines>
    </verse>
  </lyrics>
