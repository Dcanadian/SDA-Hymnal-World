  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>Don’t you see my <chord name="G"/>Jesus com<chord name="D"/>ing,<br/>
      See <chord name="Em7"/>Him <chord name="D"/>come in <chord name="G"/>yon<chord name="A7"/>der <chord name="D"/>cloud?<br/>
      <chord name="D"/>With ten thousand <chord name="G"/>angels round <chord name="D"/>Him,<br/>
      How <chord name="Em7"/>they <chord name="D"/>do my <chord name="G"/>Je<chord name="A7"/>sus <chord name="D"/>crowd!<br/>
      <chord name="A7"/>I am <chord name="D"/>bound for the <chord name="A"/>kingdom,<br/>
      <chord name="A7"/>Will you <chord name="D"/>go to glory with <chord name="A7"/>me?<br/>
      <chord name="D"/>Hal<chord name="Em7"/>le<chord name="A"/>lu<chord name="D"/>jah! O <chord name="Fm"/>praise <chord name="A7"/>ye the <chord name="D"/>Lord!
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="D"/>I am <chord name="G"/>bound for <chord name="D"/>the kingdom,<br/>
      <chord name="Em7"/>Will <chord name="D"/>you <chord name="G"/>go to <chord name="A7"/>glory <chord name="D"/>with me?<br/>
      <chord name="D"/>Hallelujah! O <chord name="G"/>praise ye <chord name="D"/>the Lord!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>Don&#x27;t you <chord name="G"/>see the <chord name="D"/>saints ascending,<br/>
      <chord name="Em7"/>Hear <chord name="D"/>them <chord name="G"/>shouting <chord name="A7"/>thro&#x27; <chord name="D"/>the air.<br/>
      <chord name="D"/>Jesus <chord name="G"/>smiling, <chord name="D"/>trumpets sounding,<br/>
      <chord name="Em7"/>Now <chord name="D"/>His <chord name="G"/>glory <chord name="A7"/>they <chord name="D"/>shall share.
      </lines>
    </verse>
