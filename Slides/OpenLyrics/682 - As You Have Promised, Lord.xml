  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="C/G"/>As You <chord name="Am"/>have <chord name="G"/>promised, <chord name="Em"/>Lord, <chord name="Dm"/>today,<br/>
      <chord name="G"/>You <chord name="Am"/>are <chord name="Em/B"/>letting Your <chord name="Am"/>servant go <chord name="G"/>away <chord name="Em"/>in <chord name="Dm"/>peace.<br/>
      <chord name="F"/>May eyes <chord name="G7"/>have <chord name="Em"/>seen You <chord name="Dm"/>in <chord name="Em"/>broad daylight<br/>
      <chord name="Am"/>before <chord name="G"/>all <chord name="Em"/>nations, planning <chord name="Am"/>salvation.<br/>
      <chord name="Em/B"/>Light <chord name="Am"/>of <chord name="G"/>revelation <chord name="Em"/>for <chord name="Dm"/>the <chord name="Em"/>nations,<br/>
      <chord name="Em"/>and glory of Your people <chord name="G"/>Israel.
      </lines>
    </verse>
  </lyrics>
