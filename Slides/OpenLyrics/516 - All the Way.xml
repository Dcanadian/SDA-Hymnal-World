<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>516 - All the Way</title>
      <title>All the Way</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="516"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>All the way <chord name="D"/>my savior <chord name="G/D"/>leads me;<br/>
      <chord name="F#dim"/>What have I to ask beside?<br/>
      <chord name="G"/>Can I <chord name="C/G"/>doubt <chord name="G"/>His tender <chord name="F#dim"/>mercy,<br/>
      <chord name="Am/E"/>Who thro’ life has been my <chord name="D/A"/>guide?<br/>
      <chord name="D/F#"/>Heav’nly <chord name="G"/>peace divinest comfort,<br/>
      <chord name="G"/>Here by faith in Him to <chord name="F#dim"/>dwell!<br/>
      <chord name="G"/>For I know whate’er <chord name="C"/>befall <chord name="G"/>me,<br/>
      <chord name="G/D"/>Jesus <chord name="D"/>doeth all <chord name="G/D"/>things well;<br/>
      <chord name="G"/>For I <chord name="Bm"/>know whate’er <chord name="C"/>befall <chord name="G"/>me,<br/>
      <chord name="G/D"/>Jesus <chord name="D7/C"/>doeth all <chord name="Em/B"/>things well;
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>All the way <chord name="D"/>my Savior <chord name="G/D"/>leads me;<br/>
      <chord name="F#dim"/>Cheers each winding path I <chord name="G"/>tread;<br/>
      <chord name="G"/>Gives <chord name="C/G"/>me <chord name="G"/>grace for every <chord name="F#dim"/>trial,<br/>
      <chord name="Am/E"/>Feeds me with the living <chord name="D/A"/>bread;<br/>
      <chord name="D/F#"/>Though my <chord name="G"/>weary steps may falter,<br/>
      <chord name="G"/>And my soul athirst may <chord name="F#dim"/>be,<br/>
      <chord name="G"/>Gushing from the Rock <chord name="C"/>before <chord name="G"/>me,<br/>
      <chord name="G/D"/>Lo, a spring <chord name="D"/>of joy <chord name="G/D"/>I see;<br/>
      <chord name="G"/>Gushing <chord name="Bm"/>from the <chord name="D7/C"/>Rock <chord name="C"/>before <chord name="G"/>me,<br/>
      <chord name="G/D"/>Lo, a spring <chord name="D7/C"/>of joy <chord name="Em/B"/>I see.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>All the way <chord name="D"/>my Savior <chord name="G/D"/>leads me;<br/>
      <chord name="F#dim"/>O the fullness of His <chord name="G"/>love!<br/>
      <chord name="G"/>Perfect <chord name="C/G"/>rest <chord name="G"/>to me is <chord name="F#dim"/>promised<br/>
      <chord name="Am/E"/>In my Father&#x27;s house above;<br/>
      <chord name="D/F#"/>When I <chord name="G"/>wake to life immortal,<br/>
      <chord name="G"/>Wing my flight to realms of <chord name="F#dim"/>day,<br/>
      <chord name="G"/>This my song through endless <chord name="C/G"/>ages,<br/>
      <chord name="G/D"/>Jesus led <chord name="D"/>me all <chord name="G/D"/>the way;<br/>
      <chord name="G"/>This my <chord name="Bm"/>song through <chord name="D7/C"/>endless <chord name="C/G"/>ages,<br/>
      <chord name="G/D"/>Jesus led <chord name="D7/C"/>me all <chord name="Em/B"/>the way.
      </lines>
    </verse>
  </lyrics>
</song>
