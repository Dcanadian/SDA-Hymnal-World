  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>Ride on! <chord name="C"/>ride <chord name="D"/>on <chord name="G/B"/>in <chord name="Am"/>majesty!<br/>
      <chord name="G"/>Hark, <chord name="D/F#"/>all <chord name="Em"/>the <chord name="D/F#"/>tribes <chord name="Em"/>hosanna <chord name="D"/>cry;<br/>
      <chord name="G7/F"/>O <chord name="C/E"/>Savior <chord name="Am"/>meek, <chord name="D"/>pursue <chord name="D7"/>Thy <chord name="Em"/>road<br/>
      <chord name="Am"/>With <chord name="Bm/D"/>palms <chord name="D7/C"/>and <chord name="Bm"/>scattered <chord name="Am/C"/>garments <chord name="D"/>strowed.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>Ride on! <chord name="C"/>ride <chord name="D"/>on <chord name="G/B"/>in <chord name="Am"/>majesty!<br/>
      <chord name="G"/>In <chord name="D/F#"/>lowly pomp <chord name="Bm"/>ride <chord name="Em"/>on <chord name="Am"/>to die;<br/>
      <chord name="G7/F"/>O <chord name="C/E"/>Christ, <chord name="G/D"/>Thy <chord name="Am"/>triumphs <chord name="D"/>now <chord name="D7"/>begin<br/>
      <chord name="Am"/>O&#x27;er <chord name="Bm/D"/>captive death <chord name="Em"/>and <chord name="Am/C"/>conquered <chord name="D"/>sin.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>Ride on! <chord name="C"/>ride <chord name="D"/>on <chord name="G/B"/>in <chord name="Am"/>majesty!<br/>
      <chord name="G"/>The <chord name="D/F#"/>winged <chord name="Em"/>squadrons of <chord name="Am"/>the sky<br/>
      <chord name="G7/F"/>Look <chord name="C/E"/>down <chord name="G/D"/>with <chord name="C"/>sad <chord name="Am"/>and <chord name="D"/>wondering <chord name="Em"/>eyes<br/>
      <chord name="Am"/>To <chord name="Bm/D"/>see <chord name="D7/C"/>the <chord name="Bm"/>approaching <chord name="D"/>sacrifice.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="G"/>Ride on! <chord name="C"/>ride <chord name="D"/>on <chord name="G/B"/>in <chord name="Am"/>majesty!<br/>
      <chord name="G"/>In <chord name="D/F#"/>lowly pomp <chord name="Bm"/>ride <chord name="Em"/>on <chord name="Am"/>to die;<br/>
      <chord name="G7/F"/>Bow <chord name="C/E"/>Thy <chord name="G/D"/>meek <chord name="C"/>head <chord name="D"/>to <chord name="G/D"/>mortal <chord name="Em"/>pain,<br/>
      <chord name="Am"/>Then <chord name="Bm/D"/>take, <chord name="D7/C"/>O <chord name="Bm"/>God, <chord name="Em"/>Thy <chord name="Am/C"/>power <chord name="D"/>and <chord name="G"/>reign.
      </lines>
    </verse>
  </lyrics>
