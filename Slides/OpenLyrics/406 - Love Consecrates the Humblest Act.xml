<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>406 - Love Consecrates the Humblest Act</title>
      <title>Love Consecrates the Humblest Act</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="406"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Doctrines</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>Love <chord name="G"/>consecrates the humblest act<br/>
      <chord name="G"/>And haloes <chord name="D"/>mercy&#x27;s <chord name="C/E"/>deeds;<br/>
      <chord name="G"/>It <chord name="C"/>sheds a <chord name="G"/>benediction <chord name="D"/>sweet<br/>
      <chord name="G"/>And hallows human needs.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>When <chord name="G"/>in the shadow of the cross<br/>
      <chord name="G"/>Christ knelt <chord name="D7/A"/>and <chord name="D"/>washed <chord name="C/E"/>the feet<br/>
      <chord name="G"/>Of <chord name="C"/>His disciples, <chord name="D"/>He <chord name="C"/>gave <chord name="D"/>us<br/>
      <chord name="G"/>A sign of love complete.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D"/>Love <chord name="G"/>serves and <chord name="C/G"/>willing, <chord name="G"/>stoops to serve;<br/>
      <chord name="G"/>What Christ <chord name="D7/A"/>in <chord name="D"/>love <chord name="C/E"/>so true<br/>
      <chord name="G"/>Has <chord name="C"/>freely <chord name="G"/>done <chord name="D"/>for one <chord name="C"/>and <chord name="D"/>all,<br/>
      <chord name="G"/>Let us now gladly do!
      </lines>
    </verse>
  </lyrics>
</song>
