<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>293 - Heavenly Father, Bless Us Now</title>
      <title>Heavenly Father, Bless Us Now</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="293"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Gospel</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Dm"/>Heavenly Father, bless <chord name="Gm/Bb"/>us <chord name="Am"/>now;<br/>
      <chord name="Dm"/>At the <chord name="C"/>cross <chord name="Am"/>of Christ <chord name="E7"/>we <chord name="Am"/>bow;<br/>
      <chord name="Dm"/>Take our <chord name="Gm"/>guilt and <chord name="C"/>grief away;<br/>
      <chord name="F"/>Hear and <chord name="C"/>heal <chord name="Dm"/>us <chord name="Am"/>now, we <chord name="Dm"/>pray.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Dm"/>Now, O Lord, <chord name="A/Db"/>this <chord name="Dm"/>very <chord name="Am"/>hour,<br/>
      <chord name="Dm"/>Send Thy grace <chord name="C"/>and <chord name="Am"/>show Thy <chord name="E7"/>power;<br/>
      <chord name="Dm"/>While we <chord name="Gm"/>rest upon <chord name="C"/>Thy <chord name="F"/>word,<br/>
      <chord name="F"/>Come, and <chord name="C"/>bless <chord name="Dm"/>us <chord name="Am"/>now, O <chord name="Dm"/>Lord!
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Dm"/>Mercy now, <chord name="A/Db"/>O <chord name="Dm"/>Lord, <chord name="Gm/Bb"/>we <chord name="Am"/>plead<br/>
      <chord name="Dm"/>In this <chord name="C"/>hour <chord name="Am"/>of utter need;<br/>
      <chord name="Dm"/>Turn us <chord name="Gm"/>not away <chord name="C"/>unblest;<br/>
      <chord name="F"/>Calm our <chord name="C"/>anguish <chord name="Am"/>into <chord name="Dm"/>rest.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Dm"/>O Thou loving, blessed <chord name="Gm/Bb"/>One,<br/>
      <chord name="Dm"/>Rising <chord name="C"/>o&#x27;er <chord name="Am"/>us like <chord name="E7"/>the <chord name="Am"/>sun,<br/>
      <chord name="Dm"/>Light and <chord name="Gm"/>life art <chord name="C"/>Thou within:<br/>
      <chord name="F"/>Savior, Thou, <chord name="C"/>from <chord name="Dm"/>every sin!
      </lines>
    </verse>
  </lyrics>
</song>
