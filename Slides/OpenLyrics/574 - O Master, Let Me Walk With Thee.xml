  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Db"/>O Master, <chord name="Gb/Db"/>let <chord name="Db"/>me <chord name="Ebm/Gb"/>walk with <chord name="Ab"/>Thee<br/>
      <chord name="Ab"/>In <chord name="Bbm"/>lowlypaths ofservice <chord name="Ebm"/>free;<br/>
      <chord name="Ab7/Gb"/>Tell <chord name="Gb"/>me <chord name="Ab7/Gb"/>thy <chord name="Db/F"/>secret; <chord name="Gb"/>help <chord name="Fm"/>me <chord name="Ebm"/>bear<br/>
      <chord name="Ab7"/>The <chord name="Bbm"/>strain <chord name="Ab7/C"/>oftoil, <chord name="Ebm/Gb"/>the fret <chord name="Ab"/>of <chord name="Db"/>care.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Db"/>Help me the <chord name="Gb/Db"/>slow <chord name="Db"/>of <chord name="Ebm/Gb"/>heart to <chord name="Ab"/>move<br/>
      <chord name="Ab"/>by <chord name="Bbm"/>some <chord name="Ab7/C"/>clear, <chord name="Db"/>winning <chord name="Eb7"/>word <chord name="Ab/Eb"/>of <chord name="Ebm"/>love;<br/>
      <chord name="Ab7/Gb"/>teach <chord name="Gb"/>me <chord name="Ab7/Gb"/>the <chord name="Db/F"/>wayward <chord name="Gb"/>feet <chord name="Fm"/>to <chord name="Ebm"/>stay,<br/>
      <chord name="Ab7"/>and guide <chord name="Bbm"/>them <chord name="Ab7/C"/>in <chord name="Db"/>the <chord name="Ebm/Gb"/>homeward <chord name="Db"/>way.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Db"/>Teach me thy <chord name="Gb/Db"/>patience; <chord name="Ebm/Gb"/>still with <chord name="Ab"/>thee<br/>
      <chord name="Ab"/>in <chord name="Bbm"/>closer, <chord name="Db"/>dearer <chord name="Eb7"/>company,<br/>
      <chord name="Ab7/Gb"/>in <chord name="Gb"/>work <chord name="Ab7/Gb"/>that <chord name="Db/F"/>keeps <chord name="Gb"/>faith sweet <chord name="Fm"/>and <chord name="Ebm"/>strong,<br/>
      <chord name="Ab7"/>in <chord name="Bbm"/>trust <chord name="Ab7/C"/>that <chord name="Db"/>triumphs <chord name="Ebm/Gb"/>over <chord name="Ab"/>wrong;
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Db"/>In hope that <chord name="Gb/Db"/>sends <chord name="Db"/>a <chord name="Ebm/Gb"/>shining <chord name="Ab"/>ray<br/>
      <chord name="Ab"/>far down <chord name="Bbm"/>the <chord name="Ab7/C"/>future&#x27;s <chord name="Eb7"/>broadening <chord name="Ab"/>way,<br/>
      <chord name="Ab7/Gb"/>in <chord name="Gb"/>peace <chord name="Ab7/Gb"/>that <chord name="Db/F"/>only <chord name="Gb"/>thou <chord name="Fm"/>canst <chord name="Ebm"/>give,<br/>
      <chord name="Ab7"/>with <chord name="Bbm"/>thee, <chord name="Ab7/C"/>O <chord name="Db"/>Master, <chord name="Ebm"/>let <chord name="Ab"/>me <chord name="Db"/>live.
      </lines>
    </verse>
