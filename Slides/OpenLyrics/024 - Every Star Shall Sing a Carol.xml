<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>024 - Every Star Shall Sing a Carol</title>
      <title>Every Star Shall Sing a Carol</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="24"/>
    </songbooks>
    <key>Gm</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3</verseOrder>
    <themes>
      <theme>Worship</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Gm"/>Every <chord name="Cm"/>star shall <chord name="F"/>sing a<chord name="Bb"/>carol;<br/>
      <chord name="Gm"/>Every creature, <chord name="Cm"/>high <chord name="Dm"/>or <chord name="Gm"/>low,<br/>
      <chord name="Bb"/>Come and <chord name="Cm"/>praise the <chord name="F"/>King of <chord name="Bb"/>heaven<br/>
      <chord name="Gm"/>By whatever <chord name="Cm"/>name <chord name="Dm"/>you <chord name="Gm"/>know.<br/>
      <chord name="Gm"/>God a<chord name="Dm7"/>bove, <chord name="Gm"/>Man <chord name="Dm7"/>below,<br/>
      <chord name="Gm"/>Holy <chord name="Cm"/>is the <chord name="Dm7"/>name I<chord name="Gm"/>know.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Gm"/>God <chord name="Cm"/>above, <chord name="F"/>Man <chord name="Bb"/>below,<br/>
      <chord name="Gm"/>Holy <chord name="Cm"/>is the <chord name="Dm"/>name <chord name="Gm"/>I know.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Gm"/>When <chord name="Cm"/>the King <chord name="F"/>of <chord name="Bb"/>all creation<br/>
      <chord name="Gm"/>Had <chord name="Cm"/>a cradle <chord name="Dm"/>on <chord name="Gm"/>the earth,<br/>
      <chord name="Bb"/>Holy <chord name="Cm"/>was <chord name="F"/>the <chord name="Bb"/>human body,<br/>
      <chord name="Gm"/>Holy <chord name="Cm"/>was <chord name="Dm"/>the <chord name="Gm"/>human birth.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Gm"/>Every <chord name="Cm"/>star <chord name="F"/>and <chord name="Bb"/>every planet,<br/>
      <chord name="Gm"/>Every <chord name="Cm"/>creature, <chord name="Dm"/>high <chord name="Gm"/>or low,<br/>
      <chord name="Bb"/>Come <chord name="Cm"/>and praise <chord name="F"/>the King <chord name="Bb"/>of heaven<br/>
      <chord name="Gm"/>By <chord name="Cm"/>whatever <chord name="Dm"/>name <chord name="Gm"/>you know.
      </lines>
    </verse>
  </lyrics>
</song>
