<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>024 - Every Star Shall Sing a Carol</title>
      <title>Every Star Shall Sing a Carol</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="24"/>
    </songbooks>
    <key>Bb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3</verseOrder>
    <themes>
      <theme>Worship</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Gm"/>Every <chord name="Adim"/>star <chord name="Cm/G"/>shall <chord name="Bb/F"/>sing <chord name="Dm"/>acarol;<br/>
      <chord name="Bb"/>Every <chord name="Gm"/>creature, <chord name="Bb/F"/>high <chord name="Cm"/>or low,<br/>
      <chord name="Dm/A"/>Come <chord name="Gm"/>and <chord name="Bb/F"/>praise the <chord name="Dm"/>King <chord name="Cm"/>of <chord name="Dm"/>heaven<br/>
      <chord name="Bb"/>By whatever <chord name="Gm"/>name you <chord name="Dm"/>know.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Gm"/>God above, Man <chord name="Dm"/>below,<br/>
      <chord name="Gm"/>Holy <chord name="Dm"/>is <chord name="Adim"/>the <chord name="Bb"/>name <chord name="F"/>I know.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Gm"/>When the <chord name="Cm"/>King of <chord name="Bb/F"/>all <chord name="Cm"/>creation<br/>
      <chord name="Bb"/>Had <chord name="F"/>a cradle on <chord name="Bb/F"/>the <chord name="Cm"/>earth,<br/>
      <chord name="Dm/A"/>Holy <chord name="Bb/F"/>was the <chord name="Dm"/>human body,<br/>
      <chord name="Bb"/>Holy <chord name="Dm/A"/>was <chord name="Gm"/>the human <chord name="Dm"/>birth.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Gm"/>Every <chord name="Cm"/>star and <chord name="Bb/F"/>every <chord name="Dm"/>planet,<br/>
      <chord name="Bb"/>Every <chord name="Gm"/>creature, <chord name="Bb/F"/>high <chord name="Cm"/>or low,<br/>
      <chord name="Dm/A"/>Come <chord name="Gm"/>and <chord name="Bb/F"/>praise the <chord name="Dm"/>King <chord name="Cm"/>of <chord name="Dm"/>heaven<br/>
      <chord name="Bb"/>By whatever <chord name="Gm"/>name you <chord name="Dm"/>know.
      </lines>
    </verse>
  </lyrics>
</song>
