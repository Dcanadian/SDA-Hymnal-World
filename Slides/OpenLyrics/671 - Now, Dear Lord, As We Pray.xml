  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Db"/>Now, Dear <chord name="Fm"/>Lord, <chord name="Db"/>as <chord name="Ab7/Eb"/>we pray,<br/>
      <chord name="Ebm"/>take our hearts <chord name="Ab"/>and <chord name="Ebm"/>minds <chord name="Ab"/>far <chord name="Cdim"/>away<br/>
      <chord name="Db"/>From the press of the world all around<br/>
      <chord name="Bbm"/>to <chord name="Db"/>your throne where <chord name="Bbm"/>grace does <chord name="Ebm"/>abound.<br/>
      <chord name="Ab"/>May our lives be transformed <chord name="Db"/>by <chord name="Fm"/>Your love,<br/>
      <chord name="Gb"/>may our <chord name="Bbm"/>souls be refreshed <chord name="Ab7/Eb"/>from above.<br/>
      <chord name="Db"/>At this <chord name="C7"/>moment, <chord name="Bbm"/>let people everywhere<br/>
      <chord name="Ab"/>join us <chord name="Ab7/C"/>now as we come <chord name="Db"/>to You in prayer.
      </lines>
    </verse>
  </lyrics>
