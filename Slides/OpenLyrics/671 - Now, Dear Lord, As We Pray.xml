      <title>Now, Dear Lord, As We Pray</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="671"/>
    </songbooks>
    <key>Db</key>
    <tempo type="bpm">Moderato</tempo>
