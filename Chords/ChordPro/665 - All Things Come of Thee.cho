{title: 665 - All Things Come of Thee}
{subtitle: SDA Hymnal #665 • ALL THINGS COME OF THEE • 7.9.2}
{lyricist: From Christ in Song}
{composer: Anon}
{key: C}
{time: 4/4}
{tempo: Moderato}
{meta: hymn_number 665}
{meta: tune ALL THINGS COME OF THEE}
