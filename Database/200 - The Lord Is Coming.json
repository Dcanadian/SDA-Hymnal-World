{
  "number": 200,
  "title": "The Lord Is Coming",
  "key": "F",
  "time": "4/4",
  "tempo": "Moderato",
  "tune": "THE SOLID ROCK (WITH PAUSES)",
  "category": "Jesus Christ",
  "subcategory": "",
  "lyricist": "Anon",
  "composer": "Wm. B. Bradbury",
  "sections": [
    {
      "name": "Verse 1",
      "type": "verse",
      "lines": [
        "[C]The Lord [F]is coming, let this be",
        "[F]The herald [C7]note of jubilee;",
        "[Am]And when [Gm]we meet and when we part",
        "[Gm/Bb]The salutation [C]from [F]the heart."
      ]
    },
    {
      "name": "Refrain",
      "type": "chorus",
      "lines": [
        "[C]The Lord [F]is coming, let this be",
        "[Gm]The herald note [Am]of jubilee,",
        "[Gm]The herald note [C7]of jubilee."
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "lines": [
        "[C]The Lord [F]is coming! sound it forth",
        "[F]From east [C7]to west, from south [Gm/Bb]to north;",
        "[Am]Speed on! [Gm]speed on the tidings glad,",
        "[Gm/Bb]That none [C]who love Him may [F]be sad."
      ]
    },
    {
      "name": "Verse 3",
      "type": "verse",
      "lines": [
        "[C]The Lord [F]is coming, swift and sure",
        "[F]And all [C7]His judgments shall [Gm/Bb]endure,",
        "[Am]And none [Gm]can hope to escape",
        "[Gm/Bb]His wrath, Who [C]walk not in the narrow [F]path."
      ]
    },
    {
      "name": "Verse 4",
      "type": "verse",
      "lines": [
        "[C]This earth, [F]with her ten thousand wrongs",
        "[F]Will soon [C7]be tuned to nobler [Gm/Bb]songs;",
        "[Am]Our praise [Gm]shall then, in realms of light,",
        "[Gm/Bb]With all [C]His universe [F]unite."
      ]
    }
  ],
  "meter": "L.M. with Refrain"
}
