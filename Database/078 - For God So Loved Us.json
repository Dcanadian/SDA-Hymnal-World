{
  "number": 78,
  "title": "For God So Loved Us",
  "key": "C",
  "time": "4/4",
  "tempo": "Moderato",
  "tune": "",
  "category": "God the Father",
  "subcategory": "",
  "lyricist": "",
  "composer": "",
  "sections": [
    {
      "name": "Verse 1",
      "type": "verse",
      "lines": [
        "For God so loved us,",
        "He sent the Savior:",
        "For God so loved us,",
        "and loves me too."
      ]
    },
    {
      "name": "Refrain",
      "type": "chorus",
      "lines": [
        "Love so unending!",
        "I'll sing His praises,",
        "God loves His children,",
        "loves even me."
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "lines": [
        "He sent the Savior,",
        "the blest Redeemer;",
        "He sent the Savior",
        "to set me free."
      ]
    },
    {
      "name": "Verse 3",
      "type": "verse",
      "lines": [
        "He bade me welcome,",
        "O word of mercy;",
        "He bade me welcome,",
        "O voice divine."
      ]
    },
    {
      "name": "Verse 4",
      "type": "verse",
      "lines": [
        "Glory and honor,",
        "O Love eternal,",
        "To Him be given",
        "while life shall last."
      ]
    }
  ]
}