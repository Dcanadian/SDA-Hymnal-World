  "sections": [
    {
      "name": "Verse 1",
      "type": "verse",
      "lines": [
        "[G]More [C/G]love [G]to Thee, O Christ,",
        "[G]More [D/F#]love [Em]to [D]Thee!",
        "[G]Hear [C/G]Thou [G]the prayer I make",
        "[D7]On [G/D]bended knee.",
        "[C/G]This is my earnest [G]plea,",
        "[D7]More love, O Christ, [C]to Thee;",
        "[G/B]More love to Thee,",
        "[Am]More [G/D]love [D]to [G]Thee!"
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "lines": [
        "[G]Once earthly [C/G]joy [G]I craved, sought peace and rest;",
        "[G]now thee [C/G]alone [G]I seek, give what is best.",
        "[D7]This all my prayer shall be: More [G]love, [C]O Christ, to thee;",
        "[Am]more love [G/D]to thee, [D]more love [G]to thee!"
      ]
    },
    {
      "name": "Verse 3",
      "type": "verse",
      "lines": [
        "[G]Let sorrow [C/G]do [G]its work, come grief and pain;",
        "[G]sweet are [C/G]thy messengers, [G/B]sweet their refrain,",
        "[D7]when they can sing with me: More [G]love, [C]O Christ, to thee;",
        "[Am]more love [G/D]to thee, [D]more love [G]to thee!"
      ]
    },
    {
      "name": "Verse 4",
      "type": "verse",
      "lines": [
        "[G]Then shall [C/G]my latest [G/B]breath whisper thy praise;",
        "[G]this be [C/G]the parting [G/B]cry my heart shall raise;",
        "[D7]this still its prayer shall be: More [G]love, [C]O Christ, to thee;",
        "[Am]more love [G/D]to thee, [D]more love [G]to thee!"
      ]
    }
  ],
  "meter": "6.4.6.4.6.6.4.4"
