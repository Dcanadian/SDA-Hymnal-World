  "sections": [
    {
      "name": "Verse 1",
      "type": "verse",
      "lines": [
        "[Eb]Loving Shepherd [Fm/Ab]of [Bb]Thy [Eb]sheep,",
        "[Eb]Keep Thy [Ab]lamb, [Cm]in safety [Eb]keep;",
        "[Eb]Nothing [Ab/C]can [Gm/Bb]Thy [Fm/Ab]power [Ab]withstand;",
        "[Gm]None can pluck [Cm]me [Fm/Ab]from [Bb]Thy [Eb]hand."
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "lines": [
        "[Eb]Loving Shepherd, [Fm/Ab]ever [Eb]near,",
        "[Eb]Teach Thy [Ab]lamb [Cm]Thy voice [Bb]to hear;",
        "[Eb]Suffer [Ab/C]not [Gm/Bb]my [Fm/Ab]steps [Ab]to stray",
        "[Gm]From the straight [Cm]and [Fm/Ab]narrow [Eb]way."
      ]
    },
    {
      "name": "Verse 3",
      "type": "verse",
      "lines": [
        "[Eb]Where Thou leadest [Fm/Ab]I [Bb]would [Eb]go,",
        "[Eb]Walking [Ab]in [Cm]Thy steps [Bb]below,",
        "[Eb]Till [Bb/D]within [Gm/Bb]the [Fm/Ab]heavenly [Gm]fold",
        "[Gm]I my Shepherd [Fm/Ab]shall [Bb]behold."
      ]
    }
  ],
  "meter": "7.8.8.7"
