{
  "number": 445,
  "title": "I'm But a Stranger Here",
  "key": "F",
  "time": "4/4",
  "tempo": "Moderato",
  "tune": "",
  "category": "Early Advent",
  "subcategory": "",
  "lyricist": "",
  "composer": "",
  "sections": [
    {
      "name": "Verse 1",
      "type": "verse",
      "lines": [
        "[F]I’m but astranger here,",
        "[Gm/Bb]Heav’n [F/C]is [C]my [F]home;",
        "[F]Earth is adesert drear,",
        "[Gm/Bb]Heav’n is [F/C]my [C]home.",
        "[F]Danger [Bb/F]and [F]sorrow stand",
        "[C7]Round me on every [F]hand;",
        "[Bb]Heav’n is [F]my Fatherland,",
        "[F]Heav’n is my home."
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "lines": [
        "[F]What though the tempest rage,",
        "[Gm/Bb]Heav'n [F/C]is [C]my [F]home;",
        "[F]Short is my pilgrimage,",
        "[Gm/Bb]Heav'n is [F/C]my [C]home;",
        "[F]And time's wild wintry blast",
        "[C7]Soon shall be over past;",
        "[Bb]I shall [F]reach home [Dm]at [Gm/Bb]last,",
        "[F]Heav'n is my home."
      ]
    },
    {
      "name": "Verse 3",
      "type": "verse",
      "lines": [
        "[F]There at my Savior's side",
        "[Gm/Bb]Heav'n [F/C]is [C]my [F]home;",
        "[F]I shall be glorified,",
        "[Gm/Bb]Heav'n is [F/C]my [C]home;",
        "[F]There are [Bb/F]the [F]good and blest,",
        "[C7]Those I love most and best;",
        "[Bb]And there [F]I, too, [Dm]shall [Gm/Bb]rest,",
        "[F]Heav'n is my home."
      ]
    }
  ]
}
