{
  "number": 150,
  "title": "Who Is He in Yonder Stall?",
  "key": "Eb",
  "time": "4/4",
  "tempo": "Moderato",
  "tune": "",
  "category": "Jesus Christ",
  "subcategory": "",
  "lyricist": "",
