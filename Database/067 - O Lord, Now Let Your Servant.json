  "sections": [
    {
      "name": "Verse 1",
      "type": "verse",
      "lines": [
        "[Eb]O Lord, [Fm]now [Eb/G]let [Cm]Your servant",
        "[Bb7/F]Depart [Eb]in [Ab]heav'nly [Eb]peace,",
        "[Fm]For I [Cm]have [Bb/D]seen [Eb]the [Bb7/Ab]glory",
        "[Cm]Of Your redeeming [Bb/D]grace:",
        "[Gm]A [Cm]light to lead [Fm]the Gentiles",
        "[Eb]Unto Your [Bb7/F]holy [Ab]hill,",
        "[Eb]The [Fm]glory [Bb]of [Gm]Your [Ab]people,",
        "[Eb]Your chosen [Bb]Israel."
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "lines": [
        "[Eb]Then grant that [Fm]I [Eb/G]may [Cm]follow [Fm]Your [Bb/D]gleam,",
        "[Bb7/F]O [Eb]glorious Light,",
        "[Fm]Till earthly [Bb/D]shadows [Bb7/Ab]scatter,",
        "[Cm]And faith is [Fm]changed to [Bb/D]sight;",
        "[Gm]Till [Cm]raptured saints [Fm]shall gather",
        "[Eb]Upon that [Bb7/F]shining [Ab]shore,",
        "[Eb]Where [Fm]Christ, the [Gm]blessed [Ab]Day [Gm]star,",
        "[Eb]Shall light them [Bb]evermore."
      ]
    }
  ]
