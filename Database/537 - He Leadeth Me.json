{
  "number": 537,
  "title": "He Leadeth Me",
  "key": "C",
  "time": "4/4",
  "tempo": "Moderato",
  "tune": "HE LEADETH ME",
  "category": "Christian Life",
  "subcategory": "",
  "lyricist": "J. H. Gilmore",
  "composer": "William B. Bradbury",
  "sections": [
    {
      "name": "Verse 1",
      "type": "verse",
      "lines": [
        "[C]He leadeth me: O blessed thought!",
        "[C]O words with heavenly comfort fraught!",
        "[C]Whate’er I do, [F]where’er I be,",
        "[F]Still ’tis God’s hand that leadeth me."
      ]
    },
    {
      "name": "Refrain",
      "type": "chorus",
      "lines": [
        "[F]He leadeth me, [C]he leadeth me,",
        "[C]by his own hand he leadeth me;",
        "[C]his faithful follower I would be,",
        "[G]for by his hand he leadeth me."
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "lines": [
        "[C]Sometimes mid scenes of deepest gloom,",
        "[C]sometimes where Eden's bowers bloom,",
        "[C]by waters still, [F]o'er troubled sea,",
        "[F]still 'tis his hand that leadeth me."
      ]
    },
    {
      "name": "Verse 3",
      "type": "verse",
      "lines": [
        "[C]Lord, I would place my hand in thine,",
        "[C]nor ever murmur nor repine;",
        "[C]content, whatever [F]lot I see,",
        "[F]since 'tis my God that leadeth me."
      ]
    },
    {
      "name": "Verse 4",
      "type": "verse",
      "lines": [
        "[C]And when my task on earth is done,",
        "[C]when by thy grace the victory's won,",
        "[C]e'en death's cold wave [F]I will not flee,",
        "[F]since God through Jordan leadeth me."
      ]
    }
  ],
  "meter": "7.9.8.8"
}
