{
  "number": 447,
  "title": "Long Upon the Mountains",
  "key": "F",
  "time": "4/4",
  "tempo": "Moderato",
  "tune": "",
  "category": "Early Advent",
  "subcategory": "",
  "lyricist": "",
  "composer": "",
  "sections": [
    {
      "name": "Verse 1",
      "type": "verse",
      "lines": [
        "[F/C]Long [C7/Bb]upon [Dm/A]the [C]mountains [C7/Bb]weary,",
        "[Am]Have the scattered flocks been torn;",
        "[Am]Dark the [C7/Bb]dessert [F/C]paths, [C7/Bb]and dreary;",
        "[C]Grievous trials [C7/Bb]have they [Dm/A]borne.",
        "[Am]Now the gathering call is [C7/Bb]sounding,",
        "[F]Solemn in its warning [Am]voice;",
        "[Bb]Union, [Gm]faith, and [F]love, abounding,",
        "[Bb]Bid the little flock [Am]rejoice."
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "lines": [
        "[F/C]Now [C7/Bb]the light [Dm/A]of [C]truth they're [C7/Bb]seeking,",
        "[Am]In its onward track pursue;",
        "[Am]All the [C7/Bb]ten commandments keeping,",
        "[C]They are holy, [C7/Bb]just, and [Dm/A]true.",
        "[Am]On the words of lire they're [C7/Bb]feeding,",
        "[F]Precious to their taste [Am]so sweet;",
        "[Bb]All their [Gm]Master's [F]percepts heeding,",
        "[Bb]Bowing humbly to [Am]His feet."
      ]
    },
    {
      "name": "Verse 3",
      "type": "verse",
      "lines": [
        "[F/C]In [C7/Bb]that light [Dm/A]of [C]light and [C7/Bb]beauty,",
        "[Am]In that golden city fair,",
        "[Am]Soon its [C7/Bb]pearly [Dm/A]gates [C7/Bb]they'll enter,",
        "[C]And of all [C7/Bb]its glories [Dm/A]share.",
        "[Am]There, divine the soul's expansions;",
        "[F]Free from sin, and death, [Am]and pain;",
        "[Bb]Tear will [Gm]never [F]dim those mansions",
        "[Bb]Where the souls immortal [Am]reign."
      ]
    },
    {
      "name": "Verse 4",
      "type": "verse",
      "lines": [
        "[F/C]Soon [C7/Bb]He comes! [Dm/A]With [C]clouds descending;",
        "[Am]All His saints, entombed arise;",
        "[Am]The redeemed, [C7/Bb]in [F/C]anthems [C7/Bb]blending,",
        "[C]Shout their vict'ry [C7/Bb]thro' the [Dm/A]skies.",
        "[Am]O, we long for Thine appearing;",
        "[F]Come, O Savior, quickly [Am]come!",
        "[Bb]Blessed hope! [Gm]Our [F]spirits cheering,",
        "[Bb]Take thy ransomed children [Am]home."
      ]
    }
  ]
}
