        "[F]All on earth [Edim]Your [Gm]scepter claim,",
        "[Am]All in heaven above [Bb]adore [Am]You;",
        "[Gm]Infinite [Am]Your [Gm]vast [Am]domain.",
        "[Dm]Everlasting [Bb]is [Am]Your [Gm]reign."
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "lines": [
        "[F]Hark! the loud [Edim]celestial [Gm]hymn",
        "[Am]Angel choirs [C/G]above [Bb]are [Am]raising,",
        "[F]Cherubim [Edim]and [Gm]seraphim,",
        "[Am]In unceasing chorus praising;",
        "[Gm]Fill [Am]the [Bb]heavens [Gm]with [Am]sweet [Bb]accord:",
        "[Dm]Holy, [C]holy, [Bb]holy, [Gm]Lord."
      ]
    },
    {
      "name": "Verse 3",
      "type": "verse",
      "lines": [
        "[F]Holy Father, [Gm]Holy Son,",
        "[Am]Holy Spirit, [C]three [Bb]we [Am]name You;",
        "[F]While in [Edim]essence [Gm]only one,",
        "[Am]Undivided God [Bb]we [Am]claim You;",
        "[Gm]And [Am]adoring [Gm]bend [Am]the [Bb]knee,",
        "[Dm]While [C]we [Bb]own [Am]the [Bb]mystery."
