  "sections": [
    {
      "name": "Verse 1",
      "type": "verse",
      "lines": [
        "[Dm/A]Rejoice, [C7/Bb]ye pure [Dm/A]in [Edim]heart! [F]Rejoice, give [Gm]thanks, and [F]sing;",
        "[G]Your festal [Am]banner [Gm]wave onhigh, [Gbm]The [Gm]cross of Christ your [Gbm]King.",
        "[D/Gb]Rejoice! [Gm](Rejoice!) [F]Rejoice! [Bb](Rejoice!) [Edim]Rejoice, [C]give thanks and sing!"
      ]
    },
    {
      "name": "Refrain",
      "type": "chorus",
      "lines": [
        "[Am]Rejoice, [Bb]rejoice, [C]rejoice,",
        "[C7/Bb]Give thanks [Dm/A]and sing."
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "lines": [
        "[Dm/A]With [C7/Bb]voice [Dm/A]as [F]full and [Gm]strong",
        "[G]As [Am]ocean's [Gm]surging praise,",
        "[G]Send [C/G]forth [Bb]the [Gm]sturdy hymns of old,",
        "[D/Gb]The [Gm]psalms [Bb/F]of [Edim]ancient [C/G]days."
      ]
    },
    {
      "name": "Verse 3",
      "type": "verse",
      "lines": [
        "[Dm/A]With [C7/Bb]all [Dm/A]the [F]angel [Gm]choirs,",
        "[G]With [Am]all [Gm]the saints of earth,",
        "[G]Pour [C/G]out [Bb]the [Gm]strains of joy and bliss,",
        "[D/Gb]True [Gm]rapture, [Edim]noblest [C/G]mirth."
      ]
    },
    {
      "name": "Verse 4",
      "type": "verse",
      "lines": [
        "[Dm/A]Yes, [C/G]on [C7/Bb]through [Edim]life's [F]long [Gm]path,",
        "[G]Still [Am]chanting [Gm]as ye go;",
        "[G]From [C/G]youth [Bb]to [Gm]age, by night and day,",
        "[D/Gb]In [Gm]gladness [Edim]and [C]in woe."
      ]
    },
    {
      "name": "Verse 5",
      "type": "verse",
      "lines": [
        "[Dm/A]Praise [C7/Bb]Him [Dm/A]who [F]reigns on [Gm]high,",
        "[G]The [Am]Lord [Gm]whom we adore,",
        "[G]The [C/G]Father, [Gm]Son and Holy Ghost,",
        "[D/Gb]One [Gm]God [Bb/F]forever [C/G]more."
      ]
