{
  "number": 680,
  "title": "Holy Spirit, Hear Us",
  "key": "C",
  "time": "4/4",
  "tempo": "Moderato",
  "tune": "",
  "category": "Sentences and Responses",
  "subcategory": "",
  "lyricist": "",
  "composer": "",
  "sections": [
    {
      "name": "Verse 1",
      "type": "verse",
      "lines": [
        "Holy Spirit, hear us;",
        "Help us while we sing;",
        "Breath into the music",
        "Of the praise we bring."
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "lines": [
        "Holy Spirit, prompt us",
        "When we kneel to pray;",
        "Nearer come, and teach us",
        "What we ought to say."
      ]
    },
    {
      "name": "Verse 3",
      "type": "verse",
      "lines": [
        "Holy Spirit, shine Thou",
        "On the Book we read;",
        "Gild it's holy pages",
        "With the light we need."
      ]
    }
  ]
}