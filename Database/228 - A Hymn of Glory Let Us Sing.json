{
  "number": 228,
  "title": "A Hymn of Glory Let Us Sing",
  "key": "Eb",
  "time": "4/4",
  "tempo": "Moderato",
  "tune": "",
  "category": "Jesus Christ",
  "subcategory": "",
  "lyricist": "",
