  "sections": [
    {
      "name": "Verse 1",
      "type": "verse",
      "lines": [
        "[Bb]Come, ye disconsolate, [Eb]where'er [F7/C]ye [Bb]languish.",
        "[Bb]come to the [Eb/G]mercy seat, [F/C]fervently kneel.",
        "[Bb]Here [Eb/Bb]bring your [Bb]wounded hearts, [Eb]here tell your [Bb]anguish;",
        "[Bb]earth has no sorrow [Eb]that heaven [F7]cannot [Bb]heal."
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "lines": [
        "[Bb]Joy of the [Eb/Bb]desolate, light [F7/C]of [Bb]the straying,",
        "[Bb]hope of the penitent, [Eb]fadeless [C7]and [F]pure!",
        "[Bb]Here [Eb/Bb]speaks the [Bb]Comforter, [Eb]tenderly [Bb]saying,",
        "[Bb]\"Earth has no sorrow [Eb]that heaven [F7]cannot [Bb]cure.\""
      ]
    },
    {
      "name": "Verse 3",
      "type": "verse",
      "lines": [
        "[Bb]Here see the [Eb/Bb]bread [Bb]of [Eb/G]life; waters [Bb]flowing",
        "[Bb]forth from the [Eb/G]throne of God, [F/C]pure [C7]from above.",
        "[Bb]Come [Eb/Bb]to the [Bb]feast of love; [Eb]come, ever [Bb]knowing",
        "[Bb]earth has no sorrow [Eb]but heaven [F7]can remove."
      ]
    }
  ]
}
