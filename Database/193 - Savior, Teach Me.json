  "sections": [
    {
      "name": "Verse 1",
      "type": "verse",
      "lines": [
        "[Eb]Savior, teach me [Cm]day by day,",
        "[Bb7]Love's [Fm/C]sweet [Bb7/D]lesson [Eb]to obey,",
        "[Gm]Sweeter [Eb]lesson [Ab]cannot [Fm]be,",
        "[Bb7]Loving Him who first [Cm]loved [Eb]me."
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "lines": [
        "[Eb]With a child's glad [Cm]heart of love,",
        "[Bb7]At [Fm/C]Thy [Bb7/D]bidding [Eb]may I move,",
        "[Gm]Prompt to [Eb]serve and [Ab]follow [Fm]Thee,",
        "[Bb7]Loving Him who first [Cm]loved [Eb]me."
      ]
    },
    {
      "name": "Verse 3",
      "type": "verse",
      "lines": [
        "[Eb]Teach me I am [Cm]not my own,",
        "[Bb7]I [Fm/C]am [Bb7/D]Thine, and [Eb]Thine alone;",
        "[Gm]Thine to [Eb]keep, to [Ab]rule, to [Fm]save",
        "[Bb7]From all sin that would [Cm]enslave."
      ]
    },
    {
      "name": "Verse 4",
      "type": "verse",
      "lines": [
        "[Eb]Love in loving [Cm]finds employ,",
        "[Bb7]In [Fm/C]obedience [Eb]all her joy;",
        "[Gm]Ever [Eb]new that [Ab]joy will [Fm]be,",
        "[Bb7]Loving Him who first [Cm]loved [Eb]me."
      ]
    },
    {
      "name": "Verse 5",
      "type": "verse",
      "lines": [
        "[Eb]Teach me thus Thy [Cm]steps to trace,",
        "[Bb7]Strong [Fm/C]to [Bb7/D]follow [Eb]in Thy grace.",
        "[Gm]Learning [Eb]how to [Ab]love from [Fm]Thee,",
        "[Bb7]Loving Him who first [Cm]loved [Eb]me."
