{
  "number": 683,
  "title": "Jesus, Stand Among Us",
  "key": "C",
  "time": "4/4",
  "tempo": "Moderato",
  "tune": "",
  "category": "Sentences and Responses",
  "subcategory": "",
  "lyricist": "",
  "composer": "",
  "sections": [
    {
      "name": "Verse 1",
      "type": "verse",
      "lines": [
        "Jesus, stand among us",
        "In Thy risen power;",
        "Let this time of worship",
        "Be a hallowed hour."
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "lines": [
        "Breathe the Holy Spirit",
        "Into every heart;",
        "Bid the fears and sorrows",
        "From each soul depart."
      ]
    },
    {
      "name": "Verse 3",
      "type": "verse",
      "lines": [
        "Thus with quickened footsteps",
        "We pursue our way,",
        "Watching for the dawning",
        "Of eternal day."
      ]
    }
  ]
}