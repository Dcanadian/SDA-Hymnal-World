  "sections": [
    {
      "name": "Verse 1",
      "type": "verse",
      "lines": [
        "[G]As pants [C/G]the [G]hart [C]for cooling [F#dim]streams",
        "[G]When [Bm]heated [G]in [F#dim]the [D/A]chase,",
        "[F#dim]So [G]longs my [C/G]soul, [G]O [F#dim]God, [G]for Thee,",
        "[C]And Thy refreshing [G]grace."
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "lines": [
        "[G]For Thee, [C/G]my [G]God, [C]the living [F#dim]God,",
        "[G]My [Bm]thirsty [G]soul [F#dim]doth [D/A]pine:",
        "[F#dim]O [G]when shall [C/G]I [G]behold Thy face,",
        "[C]Thou Majesty [F#dim]divine?"
      ]
    },
    {
      "name": "Verse 3",
      "type": "verse",
      "lines": [
        "[G]Why restless, why [C]cast down, [G]my [F#dim]soul?",
        "[G]Hope [Bm]still, and [G]thou [F#dim]shalt [D/A]sing",
        "[F#dim]The [G]praise of [C/G]Him [G]who [F#dim]is [G]thy God,",
        "[C]Thy health's eternal [G]spring."
      ]
    },
    {
      "name": "Verse 4",
      "type": "verse",
      "lines": [
        "[G]To Father, Son, [C]and Holy [F#dim]Ghost,",
        "[G]The [Bm]God whom [G]we [F#dim]adore,",
        "[F#dim]Be [G]glory, [C/G]as [G]it [F#dim]was, [G]is now,",
        "[C]And shall be [G]evermore."
      ]
    }
  ]
}
