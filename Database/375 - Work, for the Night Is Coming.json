{
  "number": 375,
  "title": "Work, for the Night Is Coming",
  "key": "Eb",
  "time": "4/4",
  "tempo": "Moderato",
  "tune": "",
  "category": "Christian Church",
  "subcategory": "",
  "lyricist": "",
  "composer": "",
  "sections": [
    {
      "name": "Verse 1",
      "type": "verse",
      "lines": [
        "[Gm]Work for the night is coming, Work [Cm/G]through the morning [Bb]hours;",
        "[Eb/Bb]Work while [Gm/Bb]the dew issparkling; Work [Cm/Eb]mid spring-ing [Gm]flow'rs.",
        "[Eb/Bb]Work when [Fm/C]the [Eb/Bb]day [Fm/Ab]grows brighter, [Bb]Work in the glowing [Eb/Bb]sun;",
        "[Ab]Work for the [Bb]night [Eb/Bb]iscoming, When [Cm]man's work isdone."
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "lines": [
        "[Gm]Work for the [Ab]night [Gm]is [Cm/G]coming,",
        "[Gm]Work thro' the sunny [Cm/G]noon;",
        "[Eb/Bb]Fill [Gm]brightest hours with [Cm/Eb]labor,",
        "[Eb/Bb]Rest [Gm]comes sure [Cm/Eb]and soon.",
        "[Eb/Bb]Give [Fm/C]every [Bb]flying minute",
        "[Eb/Bb]Something [Cm/G]to [Bb]keep in [Fm/C]store;",
        "[Ab]Work for [Bb]the [Eb/Bb]night is [Cm]coming,",
        "[Ab]When man [Eb/Bb]works no [Cm]more."
      ]
    },
    {
      "name": "Verse 3",
      "type": "verse",
      "lines": [
        "[Gm]Work for the [Ab]night [Gm]is [Cm/G]coming,",
        "[Gm]Under the sunset [Cm/G]skies;",
        "[Eb/Bb]While [Gm/Bb]their bright tints are [Cm/Eb]glowing,",
        "[Eb/Bb]Work [Gm]for daylight [Cm/Eb]flies.",
        "[Eb/Bb]Work [Fm/C]till [Eb/Bb]the [Cm/G]last [Bb]beam fadeth,",
        "[Eb/Bb]Fadeth [Fm/Ab]to [Bb]shine no [Fm/C]more;",
        "[Ab]Work while [Eb/Bb]the night is [Cm]dark'ning,",
        "[Ab]When man's [Eb/Bb]work is [Cm]o'er."
      ]
    }
  ]
}
