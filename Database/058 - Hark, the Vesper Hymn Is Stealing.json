{
  "number": 58,
  "title": "Hark, the Vesper Hymn Is Stealing",
  "key": "C",
  "time": "4/4",
  "tempo": "Moderato",
  "tune": "",
  "category": "Worship",
  "subcategory": "",
  "lyricist": "",
  "composer": "",
  "sections": [
    {
      "name": "Verse 1",
      "type": "verse",
      "lines": [
        "Hark! the vesper hymn is stealing",
        "O'er the waters soft and clear;",
        "Jubilate, Jubilate, Jubilate, Amen."
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "lines": [
        "Nearer yet, and nearer pealing,",
        "Soft it breaks upon the ear.",
        "Jubilate, Jubilate, Jubilate, Amen."
      ]
    }
  ]
}