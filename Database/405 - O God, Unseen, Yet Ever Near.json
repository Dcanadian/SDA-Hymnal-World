{
  "number": 405,
  "title": "O God, Unseen, Yet Ever Near",
  "key": "Eb",
  "time": "4/4",
  "tempo": "Moderato",
  "tune": "MEDITATION",
  "category": "Doctrines",
  "subcategory": "",
  "lyricist": "Edward Osler",
  "composer": "John H. Gower",
  "sections": [
    {
      "name": "Verse 1",
      "type": "verse",
      "lines": [
        "[Eb/Bb]O God, unseen, yet ever near,",
        "[Eb/G]Reveal [Fm/C]Thy [Eb/Bb]presence [Bb]now",
        "[Bb7/Ab]While [Gm]we in [Cm/G]love that hath [Fm/C]no [Eb/Bb]fear,",
        "[Fm/Ab]Before [Eb/G]Thy [Ab]glory [Cm/G]bow."
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "lines": [
        "[Eb/Bb]Here may Thy faithful people know",
        "[Eb/G]The [Fm]blessings [Eb/Bb]of [Bb]Thy love,",
        "[Bb7/Ab]The [Gm]streams that [Cm/G]thro' the dessert [Eb/Bb]flow,",
        "[Fm/Ab]The [Eb]manna [Ab]from [Bb7/Ab]above."
      ]
    },
    {
      "name": "Verse 3",
      "type": "verse",
      "lines": [
        "[Eb/Bb]We come, obedient to Thy Word",
        "[Eb/G]To [Fm]feast on [Eb/Bb]heav'nly [Bb]food,",
        "[Bb7/Ab]Our [Gm]meat, the [Cm/G]body of [Fm/C]our [Eb/Bb]Lord,",
        "[Fm/Ab]Our [Eb]drink, His [Ab]precious [Cm/G]blood."
      ]
    },
    {
      "name": "Verse 4",
      "type": "verse",
      "lines": [
        "[Eb/Bb]Thus may we all Thy words obey,",
        "[Eb/G]For [Fm]we, O [Eb/Bb]God, [Bb]are Thine,",
        "[Bb7/Ab]And [Gm]go rejoicing [Cm]on [Fm/C]our [Eb/Bb]way,",
        "[Fm/Ab]Renewed [Eb/G]by [Ab]strength [Bb7/Ab]divine."
      ]
    }
  ],
  "meter": "8.6.9.6"
}
