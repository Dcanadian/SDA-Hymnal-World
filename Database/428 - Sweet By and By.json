  "sections": [
    {
      "name": "Verse 1",
      "type": "verse",
      "lines": [
        "[G]There’s a land that is [C]fairer than [G]day,",
        "[G]And by faith we can see it a[D]far;",
        "[G]For the Father waits [C]over the [G]way",
        "[G]To prepare us a [C]dwell[D]ing place [G]there.",
        "[G]In the sweet by and [D]by,",
        "[D]We shall [D7]meet on that beautiful [G]shore;",
        "[G]In the sweet by and [C]by",
        "[C]We shall [G]meet on that [D7]beautiful [G]shore."
      ]
    },
    {
      "name": "Refrain",
      "type": "chorus",
      "lines": [
        "[G]In the [C]sweet in [G]the sweet",
        "[G]By and by [D]by and by,",
        "[G]We shall [C]meet on [G]that beautiful shore;",
        "[G]In [C]the sweet [D]in [G]the sweet",
        "[G]By and by [D]by and by",
        "[D]We shall [D7]meet on [G]that beautiful shore."
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "lines": [
        "[G]We shall [C]sing on [G]that beautiful shore",
        "[G]The melodious songs [D]of the blest,",
        "[G]And our [C]spirits shall [G]sorrow no more",
        "[G]Not a [C]sigh for [D]the blessing [G]of rest."
      ]
    },
    {
      "name": "Verse 3",
      "type": "verse",
      "lines": [
        "[G]To [C]our bountiful [G]father above",
        "[G]We will offer [D]our tribute of praise;",
        "[G]For the [C]glorious gift [G]of His love",
        "[G]And [C]the blessings [D]that hallow [G]our days."
      ]
    }
  ]
