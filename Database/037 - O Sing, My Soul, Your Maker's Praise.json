  "sections": [
    {
      "name": "Verse 1",
      "type": "verse",
      "lines": [
        "[C]O sing [F/A]my [G]soul, [F]your [C/E]Maker's [F]praise",
        "[C]In grateful [G]hymns [Em]ascending;",
        "[Em]Whose [C]steadfast [Em]love has [Am]crowned your days",
        "[Am]With [Em/G]heav'nly gifts [C]un [Am]ending.",
        "[Am]I sought [G]the [C/G]Lord, He [Em]heard [F]my [C]cry;",
        "[C/E]His holy [Am/C]angels [G/B]hover [Em]nigh",
        "[Am]The [Dm]tents [F]of [G]those [Am]who [Dm/F]love [C]Him."
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "lines": [
        "[C]The Lord [F/A]is [G]good [F]to [C/E]those [Em]who [F]seek",
        "[C]His [Em/B]face [F/A]in [G]time [Em]of [F]sorrow,",
        "[Em]Providing comfort [Am]to the weak",
        "[Am]And [Em/G]grace [F]for [Em]each [C]tomorrow.",
        "[Am]Though grief [G]may [C/G]tarry [Em]for [F]a [C]night,",
        "[C/E]The morn [G7/D]shall [Am/C]break in [G/B]joy [Dm]and [Em]light",
        "[Am]With [Dm]blessings [G]from [Am]His [Dm/F]presence."
      ]
    },
    {
      "name": "Verse 3",
      "type": "verse",
      "lines": [
        "[C]The Lord [F/A]will [G]turn [F]His [C/E]face [Em]in [F]peace",
        "[C]When [Em/B]troubled [F/A]souls [G]draw [Em]near [F]Him;",
        "[Em]His [C]loving [Em]kindness [Am]shall not cease",
        "[Am]To [Em/G]those [F]who [Em]trust [C]and [Am]fear [G]Him.",
        "[Am]Our God [G]will [C/G]not forsake [F]His [C]own;",
        "[C/E]Eternal [Am/C]is His [G/B]heav'nly [Em]throne;",
        "[Am]His [Dm]kingdom [G]stands [Am]forever."
      ]
    }
