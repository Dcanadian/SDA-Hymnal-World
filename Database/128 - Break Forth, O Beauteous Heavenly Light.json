{
  "number": 128,
  "title": "Break Forth, O Beauteous Heavenly Light",
  "key": "Eb",
  "time": "4/4",
  "tempo": "Moderato",
  "tune": "ERMUNTRE DICH (JOHANN SCHOP, ARR. BY J.S BACH)",
  "category": "Jesus Christ",
  "subcategory": "",
  "lyricist": "Johann Rist",
  "composer": "Johann Schop",
  "sections": [
    {
      "name": "Verse 1",
      "type": "verse",
      "lines": [
        "[Cm]Break forth, O beauteous heavenly [Bb]light,",
        "[Fm]And usher in the [Eb]morning;",
        "[Bb/F]Ye shepherds, shrink not with [F]affright,",
        "[Bb/F]But hear the angel's warning.",
        "[Cm]This child, now [Ab/Eb]weak in infancy",
        "[Gm]Our confidence and joy [Eb]shall be,",
        "[Bb]The power of Satan breaking,",
        "[Cm/G]Our peace eternal making."
      ]
    },
    {
      "name": "Verse 2",
      "type": "verse",
      "lines": [
        "[Cm]Break forth, O beauteous heavenly [Bb]light,",
        "[Fm]To herald our salvation;",
        "[Bb/F]He stoops to earth the God [F]of might,",
        "[Bb/F]Our hope and expectation.",
        "[Cm]He comes [Ab/Eb]in human [Gm]flesh to dwell,",
        "[Gm]Our God with us, Immanuel,",
        "[Bb]The night of darkness ending,",
        "[Cm/G]Our fallen race be friending."
      ]
    }
  ],
  "meter": "9.7.8.7.8.8.8.7"
}
