  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>The Savior is <chord name="D7"/>waiting to <chord name="Gm"/>enter <chord name="D7"/>your <chord name="Gm"/>heart<br/>
      <chord name="C"/>Why don&#x27;t you let Him come <chord name="F"/>in?<br/>
      <chord name="F"/>There&#x27;s nothing in <chord name="D7"/>this world to <chord name="Gm"/>keep you <chord name="D7"/>a<chord name="Gm"/>part<br/>
      <chord name="C"/>What is your <chord name="C7"/>answer to <chord name="F"/>Him?<br/>
      <chord name="Bb"/>Time after <chord name="Gm"/>time He has <chord name="Am"/>waited be<chord name="Dm"/>fore<br/>
      And <chord name="Gm"/>now <chord name="Gm7"/>He is <chord name="C"/>wait<chord name="Bb"/>ing <chord name="C7"/>a<chord name="F"/>gain<br/>
      <chord name="F7"/>To <chord name="Bb"/>see if you are <chord name="Gm"/>willing to <chord name="Am"/>open the <chord name="D7"/>door<br/>
      <chord name="Gm"/>Oh, how He <chord name="C7"/>wants to come <chord name="F"/>in.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="F"/><chord name="D7"/>Time <chord name="Gm"/><chord name="D7"/>after <chord name="Gm"/>time<br/>
      <chord name="C"/>He has <chord name="F"/>waited before<br/>
      <chord name="F"/>And <chord name="D7"/>now <chord name="Gm"/>He <chord name="D7"/>is <chord name="Gm"/>waiting again<br/>
      <chord name="C"/>To see <chord name="C7"/>if you <chord name="F"/>are willing<br/>
      <chord name="Bb"/>To <chord name="Gm"/>open <chord name="Am"/>the <chord name="Dm"/>door<br/>
      <chord name="Gm"/>Oh, <chord name="Gm7"/>how <chord name="C"/>He <chord name="Bb"/>wants <chord name="C7"/>to <chord name="F"/>come in.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>If <chord name="D7"/>you&#x27;ll <chord name="Gm"/>take <chord name="D7"/>one <chord name="Gm"/>step<br/>
      <chord name="C"/>Toward the <chord name="F"/>Savior, my friend,<br/>
      <chord name="F"/>You&#x27;ll <chord name="D7"/>find <chord name="Gm"/>His <chord name="D7"/>arms <chord name="Gm"/>open wide.<br/>
      <chord name="C"/>Receive Him, and <chord name="C7"/>all of your <chord name="F"/>darkness will end<br/>
      <chord name="Bb"/>Within <chord name="Gm"/>your <chord name="Am"/>heart <chord name="Dm"/>He&#x27;ll abide.
      </lines>
    </verse>
  </lyrics>
