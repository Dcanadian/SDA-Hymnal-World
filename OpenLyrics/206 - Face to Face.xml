    <verse name="v3">
      <lines>
      <chord name="Bb"/>What <chord name="Cm7"/>rejoicing <chord name="F7"/>in <chord name="Bb"/>His presence,<br/>
      <chord name="Bb"/><chord name="Eb"/>When <chord name="Edim7"/>are <chord name="Bb"/>banished <chord name="Dm"/>grief <chord name="F7"/>and <chord name="Bb"/>pain;<br/>
      <chord name="F7"/><chord name="Bb"/>When <chord name="F"/>the <chord name="C7"/>crooked <chord name="F"/>ways <chord name="Bb"/>are <chord name="F7"/>straightened,<br/>
      <chord name="Bb"/>And <chord name="Eb"/>the <chord name="Edim7"/>dark <chord name="Bb"/>things <chord name="Dm"/>shall <chord name="F7"/>be <chord name="Bb"/>plain!
