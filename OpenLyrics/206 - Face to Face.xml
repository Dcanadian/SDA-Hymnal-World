      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Bb"/>Only <chord name="Cm7"/>faintly now <chord name="F7"/>I <chord name="Bb"/>see Him,<br/>
      <chord name="Bb"/><chord name="Eb"/>With <chord name="Edim7"/>the <chord name="Bb"/><chord name="Dm"/>darkening <chord name="F7"/>veil <chord name="Bb"/>between,<br/>
      <chord name="F7"/><chord name="Bb"/>But <chord name="F"/>a <chord name="C7"/>blessed <chord name="F"/>day <chord name="Bb"/>is <chord name="F7"/>coming,<br/>
      <chord name="Bb"/><chord name="Eb"/>When <chord name="Edim7"/>His <chord name="Bb"/>glory <chord name="Dm"/>shall <chord name="F7"/>be <chord name="Bb"/>seen.
