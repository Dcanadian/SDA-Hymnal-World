  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D7"/>We’ll <chord name="G"/>build on the Rock, the <chord name="C"/>living <chord name="G"/>Rock,<br/>
      On Jesus, the Rock of A<chord name="D"/>ges;<br/>
      <chord name="D7"/>So <chord name="G"/>shall we abide the <chord name="C"/>fearful <chord name="G"/>shock,<br/>
      When <chord name="C"/>loud <chord name="Am"/>the <chord name="G"/>temp<chord name="D"/>est <chord name="D7"/>rag<chord name="G"/>es.<br/>
      We’ll build on <chord name="D"/>the <chord name="G"/>Rock,<br/>
      <chord name="D7"/>We’<chord name="G"/>ll <chord name="D"/>build <chord name="G"/>on <chord name="D"/>the <chord name="G"/>Rock;<br/>
      We’ll <chord name="B"/>build on the Rock, <chord name="G7"/>on the <chord name="D"/>solid Rock,<br/>
      <chord name="Am"/>On <chord name="G"/>Christ, the migh<chord name="D7"/>ty <chord name="G"/>Rock.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="D7"/>We&#x27;ll <chord name="G"/>build <chord name="C"/>on <chord name="G"/>the Rock,<br/>
      <chord name="D"/>We&#x27;ll build on the Rock;<br/>
      <chord name="D7"/>We&#x27;ll build <chord name="G"/>on the <chord name="C"/>Rock, on <chord name="G"/>the solid Rock,<br/>
      <chord name="C"/><chord name="Am"/>On <chord name="G"/>Christ, <chord name="D"/>the <chord name="D7"/>mighty <chord name="G"/>Rock.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D7"/>Some build <chord name="G"/>on the <chord name="C"/>sinking sands <chord name="G"/>of life,<br/>
      <chord name="D"/>On visions of earthly treasure;<br/>
      <chord name="D7"/>Some build <chord name="G"/>on the <chord name="C"/>waves of <chord name="G"/>sin and strife,<br/>
      <chord name="C"/><chord name="Am"/>Of <chord name="G"/>fame, <chord name="D"/>and <chord name="D7"/>worldly <chord name="G"/>pleasure.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D7"/>O build <chord name="G"/>on the <chord name="C"/>Rock, for <chord name="G"/>ever sure,<br/>
      <chord name="D"/>The firm and the true foundation;<br/>
      <chord name="D7"/>Its hope <chord name="G"/>is the <chord name="C"/>hope which <chord name="G"/>shall endure,<br/>
      <chord name="C"/><chord name="Am"/>The <chord name="G"/>hope <chord name="D"/>of <chord name="D7"/>our <chord name="G"/>salvation.
      </lines>
    </verse>
  </lyrics>
</song>
