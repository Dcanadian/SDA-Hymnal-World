      <title>531 - We&#x27;ll Build on the Rock</title>
      <title>We&#x27;ll Build on the Rock</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="531"/>
    </songbooks>
