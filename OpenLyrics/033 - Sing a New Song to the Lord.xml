  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>Sing a new <chord name="F"/>song to the <chord name="G"/>Lor<chord name="F"/>d, <chord name="G"/>He to whom <chord name="Dm"/>wonders be<chord name="G"/>lon<chord name="F"/>g.<br/>
      <chord name="F"/>Re<chord name="Em"/>joice in His <chord name="A"/>triumph and <chord name="Em"/>tell of His <chord name="F"/>pow<chord name="D7"/>er.<br/>
      <chord name="D7"/>O<chord name="G"/>sin<chord name="Dm7"/>g a new <chord name="Am7"/>song<chord name="D7"/>  to the <chord name="G"/>Lo<chord name="Am7"/>rd.<chord name="G"/><chord name="Am7"/><chord name="G"/>
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/><chord name="F"/>Now <chord name="G"/>to <chord name="F"/>the <chord name="G"/>ends <chord name="Dm"/>of <chord name="G"/>the <chord name="F"/>earth<br/>
      <chord name="F"/><chord name="Em"/>See <chord name="A"/>His <chord name="Em"/>salvation <chord name="F"/>is <chord name="D7"/>shown.<br/>
      <chord name="D7"/><chord name="G"/>And <chord name="Dm7"/>still <chord name="Am7"/>He <chord name="D7"/>remembers <chord name="G"/><chord name="Am7"/>His <chord name="G"/>mercy <chord name="Am7"/>and <chord name="G"/>truth,<br/>
      <chord name="G"/><chord name="F"/>Unchanging <chord name="G"/>in <chord name="F"/>love <chord name="G"/><chord name="Dm"/>to <chord name="G"/>His <chord name="F"/>own.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/><chord name="F"/>Sing <chord name="G"/>a <chord name="F"/>new <chord name="G"/><chord name="Dm"/>song <chord name="G"/>and <chord name="F"/>rejoice.<br/>
      <chord name="F"/><chord name="Em"/>Publish <chord name="A"/>His <chord name="Em"/><chord name="F"/>praises <chord name="D7"/>abroad.<br/>
      <chord name="D7"/><chord name="G"/>Let <chord name="Dm7"/>voices <chord name="Am7"/>in <chord name="D7"/>chorus <chord name="G"/><chord name="Am7"/>with <chord name="G"/>trumpet <chord name="Am7"/>and <chord name="G"/>horn,<br/>
      <chord name="G"/><chord name="F"/>Resound <chord name="G"/>for <chord name="F"/>the <chord name="G"/>joy <chord name="Dm"/>of <chord name="G"/>the <chord name="F"/>Lord.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="G"/><chord name="F"/>Join <chord name="G"/>with <chord name="F"/>the <chord name="G"/>hills <chord name="Dm"/>and <chord name="G"/>the <chord name="F"/>sea,<br/>
      <chord name="F"/><chord name="Em"/>Thunders <chord name="A"/>of <chord name="Em"/>praise <chord name="F"/>to <chord name="D7"/>prolong.<br/>
      <chord name="D7"/><chord name="G"/><chord name="Dm7"/>In <chord name="Am7"/><chord name="D7"/>judgment <chord name="G"/><chord name="Am7"/><chord name="G"/>and <chord name="Am7"/><chord name="G"/>justice<br/>
      <chord name="G"/><chord name="F"/>He <chord name="G"/><chord name="F"/>comes <chord name="G"/>to <chord name="Dm"/><chord name="G"/>the <chord name="F"/>earth.<br/>
      <chord name="F"/>O <chord name="Em"/>sing <chord name="A"/>a new <chord name="Em"/>song <chord name="F"/>to <chord name="D7"/>the Lord.
      </lines>
    </verse>
