  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>At first I <chord name="C"/>prayed <chord name="G"/>for <chord name="D7"/>light: Could I but see the <chord name="Em"/>way,<br/>
      <chord name="G7"/>How gladly, <chord name="C"/>swift<chord name="G"/>ly <chord name="Cmaj7"/>would I <chord name="Am"/>walk <chord name="A7"/>To <chord name="D7"/>everlasting <chord name="G"/>day!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>And <chord name="C"/>next <chord name="G"/>I <chord name="D7"/>prayed <chord name="Em"/>for strength:<br/>
      <chord name="G7"/><chord name="C"/>That <chord name="G"/>I <chord name="Cmaj7"/>might <chord name="Am"/><chord name="A7"/>tread <chord name="D7"/>the <chord name="G"/>road<br/>
      <chord name="G"/>With <chord name="C"/>firm, <chord name="G"/>unfaltering <chord name="D7"/>feet, <chord name="Em"/>and win<br/>
      <chord name="G7"/><chord name="C"/>The <chord name="G"/><chord name="Cmaj7"/>heaven&#x27;s <chord name="Am"/><chord name="A7"/>serene <chord name="D7"/><chord name="G"/>abode.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>And <chord name="C"/>then <chord name="G"/>I <chord name="D7"/>asked <chord name="Em"/>for faith:<br/>
      <chord name="G7"/><chord name="C"/>Could <chord name="G"/>I <chord name="Cmaj7"/>but <chord name="Am"/><chord name="A7"/>trust <chord name="D7"/>my <chord name="G"/>God,<br/>
      <chord name="G"/>I&#x27;d <chord name="C"/>live <chord name="G"/>infolded <chord name="D7"/>in <chord name="Em"/>His peace,<br/>
      <chord name="G7"/><chord name="C"/>Though <chord name="G"/><chord name="Cmaj7"/>foes <chord name="Am"/>were <chord name="A7"/><chord name="D7"/>all <chord name="G"/>abroad.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="G"/>But <chord name="C"/>now <chord name="G"/>I <chord name="D7"/>pray <chord name="Em"/>for love:<br/>
      <chord name="G7"/><chord name="C"/>Deep <chord name="G"/>love <chord name="Cmaj7"/>to <chord name="Am"/><chord name="A7"/>God <chord name="D7"/>and <chord name="G"/>man;<br/>
      <chord name="G"/>A <chord name="C"/>living <chord name="G"/>love that <chord name="D7"/>will <chord name="Em"/>not fail,<br/>
      <chord name="G7"/><chord name="C"/>However <chord name="G"/><chord name="Cmaj7"/>dark <chord name="Am"/><chord name="A7"/>His <chord name="D7"/><chord name="G"/>plan.
      </lines>
    </verse>
    <verse name="v5">
      <lines>
      <chord name="G"/>And <chord name="C"/>light <chord name="G"/>and <chord name="D7"/>strength <chord name="Em"/>and faith<br/>
      <chord name="G7"/><chord name="C"/><chord name="G"/>Are <chord name="Cmaj7"/><chord name="Am"/><chord name="A7"/>opening <chord name="D7"/><chord name="G"/>everywhere!<br/>
      <chord name="G"/><chord name="C"/>God <chord name="G"/>waited <chord name="D7"/>patiently <chord name="Em"/>until<br/>
      <chord name="G7"/><chord name="C"/>I <chord name="G"/><chord name="Cmaj7"/>prayed <chord name="Am"/>the <chord name="A7"/><chord name="D7"/>larger <chord name="G"/>prayer.
      </lines>
    </verse>
  </lyrics>
