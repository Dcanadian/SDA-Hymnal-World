      <title>248 - O, How I Love Jesus</title>
      <title>O, How I Love Jesus</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="248"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
