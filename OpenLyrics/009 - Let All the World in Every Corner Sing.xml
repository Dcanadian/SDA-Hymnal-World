  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Ab"/>Let all the <chord name="Db"/>world in <chord name="Eb"/>every <chord name="Ab"/>corner <chord name="Fm"/>sing,<br/>
      <chord name="Db"/>My <chord name="Eb7"/>God and <chord name="Ab"/>King!<br/>
      The <chord name="Ab"/>heavens <chord name="Eb/G"/>are <chord name="Fm"/>not too <chord name="Cm"/>high,<br/>
      <chord name="Db"/>His praise <chord name="Bb7/D"/>may thither <chord name="Eb"/>fly;<br/>
      The <chord name="Ab"/>earth is <chord name="Db"/>not too <chord name="Ab"/>low,<br/>
      His <chord name="Fm"/>praises <chord name="Bbm7"/>there <chord name="Eb7"/>may <chord name="Ab"/>grow.<br/>
      <chord name="Ab"/>Let all the <chord name="Db"/>world in <chord name="Eb"/>every <chord name="Ab"/>corner <chord name="Fm"/>sing,<br/>
      <chord name="Db"/>My <chord name="Eb7"/>God and <chord name="Ab"/>King!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Ab"/>Let all the <chord name="Db"/>world in <chord name="Eb"/>every <chord name="Ab"/>corner <chord name="Fm"/>sing,<br/>
      <chord name="Db"/>My <chord name="Eb7"/>God and <chord name="Ab"/>King!<br/>
      The <chord name="Ab"/>church with <chord name="Eb/G"/>psalms <chord name="Fm"/>must <chord name="Cm"/>shout,<br/>
      <chord name="Db"/>No door <chord name="Bb7/D"/>can keep them <chord name="Eb"/>out;<br/>
      But, <chord name="Ab"/>above <chord name="Db"/>all, the <chord name="Ab"/>heart<br/>
      Must <chord name="Fm"/>bear the <chord name="Bbm7"/>long<chord name="Eb7"/>est <chord name="Ab"/>part.<br/>
      <chord name="Ab"/>Let all the <chord name="Db"/>world in <chord name="Eb"/>every <chord name="Ab"/>corner <chord name="Fm"/>sing,<br/>
      <chord name="Db"/>My <chord name="Eb7"/>God and <chord name="Ab"/>King!
      </lines>
    </verse>
  </lyrics>
