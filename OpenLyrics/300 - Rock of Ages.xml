  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Bb"/>Rock of Ages, <chord name="Eb"/>cleft for <chord name="Bb"/>me, Let me hide my<chord name="F7"/>self in <chord name="Bb"/>Thee;<br/>
      <chord name="Bb"/>Let the <chord name="F7"/>water and the <chord name="Bb"/>blood, From Thy <chord name="F7"/>riven side which <chord name="Bb"/>flowed,<br/>
      <chord name="Bb"/>Be of sin the <chord name="Eb"/>double <chord name="Bb"/>cure, <chord name="Gm"/>Cleanse me <chord name="Bb"/>from its <chord name="F7"/>guilt and <chord name="Bb"/>power.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Bb"/>Not <chord name="Eb"/>the <chord name="Bb"/>labor <chord name="F7"/>of <chord name="Bb"/>my hands<br/>
      <chord name="Bb"/>Can <chord name="F7"/>fulfill <chord name="Bb"/>Thy <chord name="F7"/>law&#x27;s <chord name="Bb"/>demands;<br/>
      <chord name="Bb"/><chord name="Eb"/>Could <chord name="Bb"/>my <chord name="Gm"/>zeal <chord name="Bb"/>no <chord name="F7"/>respite <chord name="Bb"/>know,<br/>
      <chord name="Bb"/>Could <chord name="Eb"/>my <chord name="Bb"/>tears <chord name="F7"/>forever <chord name="Bb"/>flow,<br/>
      <chord name="Bb"/>All <chord name="F7"/>for <chord name="Bb"/>sin <chord name="F7"/>could <chord name="Bb"/>not atone;<br/>
      <chord name="Bb"/><chord name="Eb"/>Thou <chord name="Bb"/>must <chord name="Gm"/>save, <chord name="Bb"/>and <chord name="F7"/>Thou <chord name="Bb"/>alone.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Bb"/>When <chord name="Eb"/>my <chord name="Bb"/>pilgrimage <chord name="F7"/>I <chord name="Bb"/>close;<br/>
      <chord name="Bb"/>Victor <chord name="F7"/>o&#x27;er <chord name="Bb"/>the <chord name="F7"/>last <chord name="Bb"/>of foes,<br/>
      <chord name="Bb"/><chord name="Eb"/>When <chord name="Bb"/>I <chord name="Gm"/>soar <chord name="Bb"/>to <chord name="F7"/>worlds <chord name="Bb"/>unknown,<br/>
      <chord name="Bb"/>And <chord name="Eb"/>behold <chord name="Bb"/>Thee <chord name="F7"/>on <chord name="Bb"/>Thy throne,<br/>
      <chord name="Bb"/>Rock <chord name="F7"/>of <chord name="Bb"/>Ages, <chord name="F7"/>cleft <chord name="Bb"/>for me,<br/>
      <chord name="Bb"/><chord name="Eb"/>Let <chord name="Bb"/>me <chord name="Gm"/>hide <chord name="Bb"/>myself <chord name="F7"/>in <chord name="Bb"/>Thee.
      </lines>
    </verse>
  </lyrics>
