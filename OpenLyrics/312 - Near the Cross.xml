      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/><chord name="Bb"/>Near <chord name="F"/>the <chord name="C7"/>cross, <chord name="Bb"/>a <chord name="F"/>trembling <chord name="C"/>soul,<br/>
      <chord name="F"/><chord name="Bb"/>love <chord name="F"/><chord name="C7"/>and <chord name="Bb"/>mercy <chord name="F"/><chord name="C7"/>found <chord name="F"/>me;<br/>
