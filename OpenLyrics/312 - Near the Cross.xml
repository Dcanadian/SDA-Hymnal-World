      <chord name="F"/><chord name="Bb"/>sheds <chord name="F"/><chord name="A7"/>its <chord name="Bb"/>beams <chord name="F"/><chord name="C7"/>around <chord name="F"/>me.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>Near <chord name="Bb"/>the <chord name="F"/>cross! <chord name="C7"/>O <chord name="Bb"/>Lamb <chord name="F"/>of <chord name="C"/>God,<br/>
      <chord name="F"/><chord name="Bb"/>bring <chord name="F"/><chord name="C7"/>its <chord name="Bb"/>scenes <chord name="F"/><chord name="C7"/>before <chord name="F"/>me;<br/>
      <chord name="F"/>help <chord name="Bb"/>me <chord name="F"/>walk <chord name="Bb"/>from <chord name="F"/>day <chord name="C"/>to day<br/>
      <chord name="F"/><chord name="Bb"/>with <chord name="F"/><chord name="A7"/>its <chord name="Bb"/>shadow <chord name="F"/><chord name="C7"/>o&#x27;er <chord name="F"/>me.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F"/>Near <chord name="Bb"/>the <chord name="F"/>cross <chord name="C7"/>I&#x27;ll <chord name="Bb"/>watch <chord name="F"/>and <chord name="C"/>wait,<br/>
      <chord name="F"/><chord name="Bb"/><chord name="F"/>hoping, <chord name="C7"/><chord name="Bb"/><chord name="F"/>trusting <chord name="C7"/><chord name="F"/>ever,<br/>
      <chord name="F"/>till <chord name="Bb"/>I <chord name="F"/>reach <chord name="Bb"/>the <chord name="F"/>golden <chord name="C"/>strand<br/>
      <chord name="F"/><chord name="Bb"/>just <chord name="F"/><chord name="A7"/>beyond <chord name="Bb"/><chord name="F"/>the <chord name="C7"/><chord name="F"/>river.
