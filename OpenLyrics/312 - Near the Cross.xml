  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Je<chord name="Bb"/>sus, <chord name="F"/>keep <chord name="C7"/>me <chord name="Bb"/>near the cross; <chord name="F"/>there a precious foun<chord name="C"/>tain,<br/>
      <chord name="F"/>Free <chord name="Bb"/>to <chord name="F"/>all, <chord name="C7"/>a<chord name="Bb"/>healing stream, <chord name="F"/>flows from Calvary&#x27;s <chord name="C7"/>moun<chord name="F"/>tain.<br/>
      <chord name="F"/>In the cross, <chord name="Bb"/>in the cross, <chord name="F"/>be <chord name="Bb"/>my <chord name="F"/>glory ev<chord name="C"/>er,<br/>
      <chord name="F"/>Till <chord name="Bb"/>my <chord name="F"/>rap<chord name="A7"/>tured <chord name="Bb"/>soul shall <chord name="F"/>find rest beyond the <chord name="C7"/>ri<chord name="F"/>ver.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
