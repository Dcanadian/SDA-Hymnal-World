<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>326 - Open My Eyes That I May See</title>
      <title>Open My Eyes That I May See</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="326"/>
    </songbooks>
    <key>Ab</key>
    <tempo type="bpm">Moderato</tempo>
