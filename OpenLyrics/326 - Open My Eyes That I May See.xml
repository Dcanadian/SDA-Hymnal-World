    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Gospel</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Ab"/>Open my eyes, that <chord name="Eb7"/>I may see Glimpses of truth Thou <chord name="Ab"/>hast for me;<br/>
      <chord name="C7"/>Place in my <chord name="Fm"/>hands the <chord name="C7"/>wonderful <chord name="Fm"/>key <chord name="Bb"/>That shall unclasp and <chord name="Bb7"/>set me <chord name="Eb"/>free.<br/>
      <chord name="Ab"/>Silently now I <chord name="Eb7"/>wait for Thee, Ready, my God, Thy <chord name="Ab"/>will to see;<br/>
      <chord name="Ab"/>Open my <chord name="Ab7"/>eyes, il<chord name="Db"/>lumine me, <chord name="Eb7"/>Spirit Di<chord name="Ab"/>vine!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Ab"/>Open my <chord name="Eb7"/>ears that <chord name="Ab"/>I may hear<br/>
      <chord name="C7"/><chord name="Fm"/>Voices <chord name="C7"/>of <chord name="Fm"/>truth <chord name="Bb"/>Thou <chord name="Bb7"/>sendest <chord name="Eb"/>clear;<br/>
      <chord name="Ab"/>and while <chord name="Eb7"/>the wavenotes fall <chord name="Ab"/>on my ear,<br/>
      <chord name="Ab"/><chord name="Ab7"/>Everything <chord name="Db"/>false <chord name="Eb7"/>will <chord name="Ab"/>disappear.<br/>
      <chord name="Ab"/>Silently now <chord name="Eb7"/>I wait <chord name="Ab"/>for Thee,<br/>
      <chord name="C7"/>Ready, <chord name="Fm"/>my <chord name="C7"/>God, <chord name="Fm"/>Thy <chord name="Bb"/>will <chord name="Bb7"/>to <chord name="Eb"/>see;<br/>
      <chord name="Ab"/>Open my <chord name="Eb7"/>ears, illumine <chord name="Ab"/>me, Spirit Divine!
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Ab"/>Open my <chord name="Eb7"/>mouth, and <chord name="Ab"/>let me bear<br/>
      <chord name="C7"/><chord name="Fm"/>Gladly <chord name="C7"/>the <chord name="Fm"/><chord name="Bb"/>warm <chord name="Bb7"/>truth <chord name="Eb"/>everywhere;<br/>
      <chord name="Ab"/>Open my <chord name="Eb7"/>heart, and <chord name="Ab"/>let me prepare<br/>
      <chord name="Ab"/>Love <chord name="Ab7"/>with <chord name="Db"/>Thy children <chord name="Eb7"/>thus <chord name="Ab"/>to share.<br/>
      <chord name="Ab"/>Silently now <chord name="Eb7"/>I wait <chord name="Ab"/>for Thee,<br/>
      <chord name="C7"/>Ready, <chord name="Fm"/>my <chord name="C7"/>God, <chord name="Fm"/>Thy <chord name="Bb"/>will <chord name="Bb7"/>to <chord name="Eb"/>see;<br/>
      <chord name="Ab"/>Open my <chord name="Eb7"/>heart, illumine <chord name="Ab"/>me, Spirit Divine!
      </lines>
    </verse>
  </lyrics>
</song>
