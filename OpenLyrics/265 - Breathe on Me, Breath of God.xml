  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Db"/>Breathe on me, <chord name="Dbdim"/>breath <chord name="Db"/>of God,<br/>
      <chord name="Gb"/>Fill <chord name="Ab7"/>me<chord name="Db"/>with <chord name="Eb7"/>life a<chord name="Ab"/>new,<br/>
      <chord name="Ab"/>That I may <chord name="Ab7"/>love <chord name="Gb"/>what <chord name="Ab7"/>Thou <chord name="Adim7"/>dost<chord name="Bbm"/>love,<br/>
      <chord name="Bbm7"/>And<chord name="Ebm7"/>do what <chord name="Fm"/>Thou <chord name="Ab7"/>wouldst <chord name="Db"/>do.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Db"/>Breathe on <chord name="Dbdim"/>me, breath <chord name="Db"/>of God,<br/>
      <chord name="Gb"/>Until <chord name="Ab7"/>my <chord name="Db"/>heart <chord name="Eb7"/>is <chord name="Ab"/>pure,<br/>
      <chord name="Ab"/>Until <chord name="Ab7"/>with <chord name="Gb"/>Thee <chord name="Ab7"/>I <chord name="Adim7"/>will <chord name="Bbm"/>one will,<br/>
      <chord name="Bbm7"/>To <chord name="Ebm7"/>do <chord name="Fm"/>and <chord name="Ab7"/>to <chord name="Db"/>endure.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Db"/>Breathe on <chord name="Dbdim"/>me, breath <chord name="Db"/>of God,<br/>
      <chord name="Gb"/>Till <chord name="Ab7"/>I <chord name="Db"/>am <chord name="Eb7"/>wholly <chord name="Ab"/>Thine,<br/>
      <chord name="Ab"/>Until <chord name="Ab7"/>this <chord name="Gb"/>earthly <chord name="Ab7"/>part <chord name="Adim7"/>of <chord name="Bbm"/>me<br/>
      <chord name="Bbm7"/>Glows <chord name="Ebm7"/>with <chord name="Fm"/>Thy <chord name="Ab7"/>fire <chord name="Db"/>divine.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Db"/>Breathe on <chord name="Dbdim"/>me, breath <chord name="Db"/>of God,<br/>
      <chord name="Gb"/>So <chord name="Ab7"/>shall <chord name="Db"/>I <chord name="Eb7"/>constant <chord name="Ab"/>be,<br/>
      <chord name="Ab"/>And <chord name="Ab7"/>live <chord name="Gb"/>with <chord name="Ab7"/>Thee <chord name="Adim7"/>the <chord name="Bbm"/>perfect life<br/>
      <chord name="Bbm7"/><chord name="Ebm7"/>Of <chord name="Fm"/><chord name="Ab7"/>Thine <chord name="Db"/>eternity.
      </lines>
