  <lyrics>
    <verse name="v1">
      <lines>
      Cause me to hear Thy loving kindness in the morning,<br/>
      for in Thee do I trust.<br/>
      Cause me to know they way where-in I shall walk<br/>
      for I lift up my soul to Thee.<br/>
      Amen
      </lines>
    </verse>
