<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>337 - Redeemed!</title>
      <title>Redeemed!</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="337"/>
    </songbooks>
    <key>A</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3</verseOrder>
    <themes>
      <theme>Gospel</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="A"/>Redeemed, how I love to proclaim it! Re<chord name="E"/>deemed by the blood of the <chord name="A"/>Lamb;<br/>
      <chord name="A"/>Redeemed through His infinite mercy, His <chord name="E7"/>child and forever I <chord name="A"/>am.<br/>
      <chord name="A"/>Re<chord name="D"/>deemed, re<chord name="A"/>deemed, Re<chord name="E"/>deemed by the blood of the <chord name="A"/>Lamb;<br/>
      <chord name="A"/>Re<chord name="D"/>deemed, re<chord name="A"/>deemed, His <chord name="E7"/>child and forever I <chord name="A"/>am.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="A"/><chord name="E"/>Redeemed, <chord name="A"/>redeemed,<br/>
      <chord name="A"/>Redeemed by <chord name="E7"/>the blood <chord name="A"/>of the Lamb;<br/>
      <chord name="A"/><chord name="D"/><chord name="A"/>Redeemed, <chord name="E"/><chord name="A"/>redeemed,<br/>
      <chord name="A"/>His <chord name="D"/>child <chord name="A"/>and <chord name="E7"/>forever <chord name="A"/>I am.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="A"/>Redeemed, and <chord name="E"/>so happy <chord name="A"/>in Jesus,<br/>
      <chord name="A"/>No language <chord name="E7"/>my rapture <chord name="A"/>can tell;<br/>
      <chord name="A"/>I <chord name="D"/>know that <chord name="A"/>the <chord name="E"/>light of <chord name="A"/>His presence<br/>
      <chord name="A"/>With <chord name="D"/>me <chord name="A"/>doth <chord name="E7"/>continually <chord name="A"/>dwell.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="A"/>I know <chord name="E"/>there&#x27;s a crown <chord name="A"/>that is waiting<br/>
      <chord name="A"/>In yonder <chord name="E7"/>bright mansion <chord name="A"/>for me;<br/>
      <chord name="A"/>And <chord name="D"/>soon, <chord name="A"/>with the <chord name="E"/>spirit <chord name="A"/>made perfect,<br/>
      <chord name="A"/>At <chord name="D"/>home with <chord name="A"/>the <chord name="E7"/>Lord I <chord name="A"/>shall be.
      </lines>
    </verse>
  </lyrics>
</song>
