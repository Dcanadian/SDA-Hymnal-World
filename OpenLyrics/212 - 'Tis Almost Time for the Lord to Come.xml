<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>212 - &#x27;Tis Almost Time for the Lord to Come</title>
      <title>&#x27;Tis Almost Time for the Lord to Come</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="212"/>
    </songbooks>
    <key>Db</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
