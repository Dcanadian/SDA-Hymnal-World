    </verse>
    <verse name="c1">
      <lines>
      <chord name="F"/>Burdens are <chord name="C7"/>lifted at Calvary,<br/>
      <chord name="F"/>Calvary, Calvary,<br/>
      <chord name="Bb"/>Burdens are <chord name="F"/>lifted at Calvary,<br/>
      <chord name="C7"/>Jesus <chord name="F"/>is <chord name="F7"/>very near.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>Cast your care <chord name="C7"/>on Jesus today,<br/>
      <chord name="F"/>Leave your worry and fear;<br/>
      <chord name="Bb"/>Burdens are <chord name="F"/>lifted at Calvary,<br/>
      <chord name="C7"/>Jesus <chord name="F"/>is <chord name="F7"/>very near.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>Troubled soul, the <chord name="C7"/>Saviour can see,<br/>
      <chord name="F"/>Ev&#x27;ry heartache and tear;<br/>
      <chord name="Bb"/>Burdens are <chord name="F"/>lifted at Calvary<br/>
      <chord name="C7"/>Jesus <chord name="F"/>is <chord name="F7"/>very near.
      </lines>
    </verse>
