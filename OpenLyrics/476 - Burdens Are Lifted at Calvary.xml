  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Days are filled with sor-row and <chord name="C7"/>care,<br/>
      Hearts are lonely and <chord name="F"/>drear;<br/>
      <chord name="Bb"/>Burdens are lifted at <chord name="F"/>Calvary,<br/>
      <chord name="C7"/>Jesus is very <chord name="F"/>ne<chord name="F7"/>ar.<br/>
      <chord name="Bb"/>Burdens are lifted at <chord name="F"/>Calvary,<br/>
      <chord name="C7"/>Calvary, <chord name="F"/>Calvary;<br/>
