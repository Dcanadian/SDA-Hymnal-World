  <properties>
    <titles>
      <title>321 - My Jesus, I Love Thee</title>
      <title>My Jesus, I Love Thee</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="321"/>
    </songbooks>
    <key>F</key>
    <tempo type="bpm">Moderato</tempo>
