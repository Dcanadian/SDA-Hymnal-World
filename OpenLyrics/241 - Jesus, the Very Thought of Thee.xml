      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>No <chord name="Am"/>voice <chord name="E"/>can sing, <chord name="Am"/>no <chord name="D"/>heart <chord name="G"/>can frame,<br/>
      <chord name="D7"/><chord name="G"/>Nor <chord name="D7"/>can <chord name="G"/>the <chord name="A7"/>memory <chord name="D"/>find<br/>
