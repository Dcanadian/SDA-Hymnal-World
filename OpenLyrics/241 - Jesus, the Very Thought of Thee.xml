      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>O <chord name="Am"/>hope <chord name="E"/>of <chord name="Am"/>every <chord name="D"/>contrite <chord name="G"/>heart!<br/>
      <chord name="D7"/>O <chord name="G"/>joy <chord name="D7"/>of <chord name="G"/>all <chord name="A7"/>the <chord name="D"/>meek,<br/>
