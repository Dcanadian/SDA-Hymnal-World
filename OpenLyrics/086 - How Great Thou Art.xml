  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Bb"/>O Lord my God! when I in <chord name="Eb"/>awesome wonder<br/>
      <chord name="Eb"/>Consider <chord name="Bb"/>all the <chord name="F"/>works Thy <chord name="F7"/>hands have <chord name="Bb"/>made,<br/>
      <chord name="Bb"/>I see the stars, I hear the <chord name="Eb"/>mighty thunder,<br/>
      <chord name="Eb"/>Thy pow&#x27;r thro&#x27;<chord name="Bb"/>out the <chord name="F"/>uni<chord name="F7"/>verse dis<chord name="Bb"/>played.<br/>
      <chord name="Bb"/>Then sings my soul, my <chord name="Eb"/>Saviour God to <chord name="Bb"/>Thee;<br/>
      <chord name="Bb"/>How great Thou <chord name="F"/>art, how <chord name="F7"/>great Thou <chord name="Bb"/>art!<br/>
      <chord name="Bb"/>Then sings my soul, my <chord name="Eb"/>Saviour God to <chord name="Bb"/>Thee;<br/>
      <chord name="Bb"/>How great Thou <chord name="F7"/>art, How great Thou <chord name="Bb"/>art!
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Bb"/>Then sings <chord name="Eb"/>my soul<br/>
      <chord name="Eb"/>My <chord name="Bb"/>Saviour <chord name="F"/>God <chord name="F7"/>to <chord name="Bb"/>Thee<br/>
      <chord name="Bb"/>How great <chord name="Eb"/>Thou art<br/>
      <chord name="Eb"/><chord name="Bb"/>How <chord name="F"/>great <chord name="F7"/>Thou <chord name="Bb"/>art<br/>
      <chord name="Bb"/>Then <chord name="Eb"/>sings <chord name="Bb"/>my soul<br/>
      <chord name="Bb"/>My <chord name="F"/>Saviour <chord name="F7"/>God <chord name="Bb"/>to Thee<br/>
      <chord name="Bb"/>How <chord name="Eb"/>great <chord name="Bb"/>Thou art<br/>
      <chord name="Bb"/>How <chord name="F7"/>great <chord name="Bb"/>Thou art
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Bb"/>When through <chord name="Eb"/>the woods<br/>
      <chord name="Eb"/>And <chord name="Bb"/>forest <chord name="F"/>glades <chord name="F7"/>I <chord name="Bb"/>wander<br/>
      <chord name="Bb"/>And hear the birds <chord name="Eb"/>sing sweetly in the trees<br/>
      <chord name="Eb"/><chord name="Bb"/>When <chord name="F"/>I <chord name="F7"/>look <chord name="Bb"/>down<br/>
      <chord name="Bb"/>From <chord name="Eb"/>lofty <chord name="Bb"/>mountain grandeur<br/>
      <chord name="Bb"/>And see <chord name="F"/>the brook <chord name="F7"/>and feel <chord name="Bb"/>the gentle breeze
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Bb"/>And when <chord name="Eb"/>I think<br/>
      <chord name="Eb"/>That <chord name="Bb"/>God <chord name="F"/>His <chord name="F7"/>Son <chord name="Bb"/>not sparing<br/>
      <chord name="Bb"/>Sent Him to die I <chord name="Eb"/>scarce can take it in<br/>
      <chord name="Eb"/><chord name="Bb"/>That <chord name="F"/>on <chord name="F7"/>the <chord name="Bb"/>Cross<br/>
      <chord name="Bb"/>My <chord name="Eb"/>burden <chord name="Bb"/>gladly bearing<br/>
      <chord name="Bb"/>He bled <chord name="F"/>and died <chord name="F7"/>to take <chord name="Bb"/>away my sin.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Bb"/>When Christ <chord name="Eb"/>shall come<br/>
      <chord name="Eb"/><chord name="Bb"/>With <chord name="F"/>shouts <chord name="F7"/>of <chord name="Bb"/>acclamation<br/>
      <chord name="Bb"/>And take <chord name="Eb"/>me home<br/>
      <chord name="Eb"/>What <chord name="Bb"/>joy <chord name="F"/>shall <chord name="F7"/>fill <chord name="Bb"/>my heart<br/>
      <chord name="Bb"/>Then <chord name="Eb"/>I <chord name="Bb"/>shall bow<br/>
      <chord name="Bb"/><chord name="F"/>In <chord name="F7"/>humble <chord name="Bb"/>adoration<br/>
      <chord name="Bb"/>And <chord name="Eb"/>then <chord name="Bb"/>proclaim<br/>
      <chord name="Bb"/>&quot;My God, <chord name="F7"/>how great <chord name="Bb"/>Thou art!&quot;
      </lines>
    </verse>
  </lyrics>
</song>
