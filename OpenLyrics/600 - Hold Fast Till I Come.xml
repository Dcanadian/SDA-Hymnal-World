      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Sweet promise <chord name="C7"/>is <chord name="F"/>given to <chord name="Bb"/>all <chord name="F"/>who be<chord name="C"/>lieve—<br/>
      <chord name="F"/>“Be<chord name="C7"/>hold I come <chord name="F"/>quickly, Mine <chord name="C"/>own <chord name="C7"/>to <chord name="F"/>re<chord name="C"/>ceive;<br/>
      <chord name="C7"/>Hold <chord name="F"/>fast till <chord name="C7"/>I<chord name="F"/>come; the <chord name="Bb"/>dan<chord name="F"/>ger is <chord name="C"/>great;<br/>
      <chord name="F"/>Sleep <chord name="C7"/>not as do <chord name="Gm"/>oth<chord name="Dm"/>ers; <chord name="Bb"/>be <chord name="C"/>watchful, <chord name="C7"/>and <chord name="F"/>wait.”<br/>
      “Hold fast till I come,” sweet <chord name="Bb"/>pro<chord name="F"/>mise of <chord name="C7"/>heaven—<br/>
      <chord name="F"/>“The <chord name="C7"/>kingdom restored, to you <chord name="F"/>shall <chord name="C7"/>be <chord name="F"/>given.”<br/>
      <chord name="C7"/>“Come, <chord name="F"/>enter <chord name="C"/>My <chord name="F"/>joy, sit <chord name="Bb"/>down <chord name="F"/>on the <chord name="C"/>throne;<br/>
      <chord name="F"/>Bright <chord name="C7"/>crowns are in <chord name="Gm"/>wait<chord name="Dm"/>ing; <chord name="Bb"/>hold <chord name="C"/>fast till <chord name="C7"/>I<chord name="F"/>come.”
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="F"/>&quot;Hold <chord name="C7"/>fast till <chord name="F"/>I <chord name="Bb"/>come,&quot; sweet <chord name="F"/>promise <chord name="C"/>of heaven--<br/>
      <chord name="F"/>&quot;The <chord name="C7"/>kingdom <chord name="F"/>restored, <chord name="C"/>to <chord name="C7"/>you <chord name="F"/>shall <chord name="C"/>be given.&quot;<br/>
      <chord name="C7"/>&quot;Come, <chord name="F"/>enter <chord name="C7"/>My <chord name="F"/>joy, sit <chord name="Bb"/>down <chord name="F"/>on <chord name="C"/>the throne;<br/>
      <chord name="F"/>Bright <chord name="C7"/>crowns <chord name="Gm"/>are <chord name="Dm"/>in waiting; <chord name="Bb"/>hold <chord name="C"/>fast <chord name="C7"/>till <chord name="F"/>I come.&quot;
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>We&#x27;ll <chord name="C7"/>&quot;watch <chord name="F"/>unto prayer&quot; <chord name="Bb"/>with <chord name="F"/>lamps <chord name="C"/>burning bright;<br/>
      <chord name="F"/>He <chord name="C7"/>comes <chord name="F"/>to all <chord name="C"/>others <chord name="C7"/>a &quot;thief <chord name="F"/>in <chord name="C"/>the night.&quot;<br/>
      <chord name="C7"/>We <chord name="F"/>know <chord name="C7"/>He is <chord name="F"/>near, <chord name="Bb"/>but know <chord name="F"/>not <chord name="C"/>the day--<br/>
      <chord name="F"/>As <chord name="C7"/>spring <chord name="Gm"/>shows <chord name="Dm"/>that <chord name="Bb"/>summer <chord name="C"/>is <chord name="C7"/>not <chord name="F"/>far away.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>Yes! <chord name="C7"/>this is <chord name="F"/>our hope, <chord name="Bb"/>&#x27;tis <chord name="F"/>built on <chord name="C"/>His word--<br/>
      <chord name="F"/>The <chord name="C7"/>glorious <chord name="F"/>appearing <chord name="C"/>of <chord name="C7"/>Jesus, <chord name="F"/>our <chord name="C"/>Lord;<br/>
      <chord name="C7"/>Of <chord name="F"/>promises <chord name="C7"/>all, <chord name="F"/>it <chord name="Bb"/>stands <chord name="F"/>as <chord name="C"/>the sum:<br/>
      <chord name="F"/>&quot;Behold <chord name="C7"/>I <chord name="Gm"/>come <chord name="Dm"/>quickly; <chord name="Bb"/>hold <chord name="C"/>fast <chord name="C7"/>till <chord name="F"/>I come.&quot;
      </lines>
    </verse>
  </lyrics>
</song>
