  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Near<chord name="C7"/>er, <chord name="Dm"/>my <chord name="Bb"/>God, to Thee, <chord name="F"/>Nearer to <chord name="C"/>Thee!<br/>
      <chord name="F"/>E’en <chord name="C7"/>though <chord name="Dm"/>it <chord name="Bb"/>be a cross <chord name="F"/>That <chord name="C"/>rais<chord name="C7"/>eth <chord name="F"/>me,<br/>
      Still <chord name="Bb"/>all <chord name="F"/>my song shall be,<br/>
      Near<chord name="Bb"/>er, <chord name="F"/>my <chord name="C"/>God, <chord name="F"/>to <chord name="C"/>Thee;<br/>
      <chord name="F"/>Near<chord name="C7"/>er, <chord name="Dm"/>my <chord name="Bb"/>God, to Thee, <chord name="F"/>Near<chord name="C"/>er <chord name="C7"/>to <chord name="F"/>Thee!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>Though <chord name="C7"/>like <chord name="Dm"/>the wanderer, <chord name="Bb"/>the <chord name="F"/>sun <chord name="C"/>gone down,<br/>
      <chord name="F"/>darkness <chord name="C7"/>be <chord name="Dm"/>over <chord name="Bb"/>me, <chord name="F"/>my <chord name="C"/>rest <chord name="C7"/>a <chord name="F"/>stone;<br/>
      <chord name="Bb"/>yet in my <chord name="F"/>dreams I&#x27;d be<br/>
      <chord name="Bb"/>nearer, <chord name="F"/>my <chord name="C"/>God, <chord name="F"/>to <chord name="C"/>thee;<br/>
      <chord name="F"/>nearer, <chord name="C7"/>my <chord name="Dm"/>God, <chord name="Bb"/>to <chord name="F"/>thee, <chord name="C"/>nearer <chord name="C7"/>to <chord name="F"/>thee!
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>There <chord name="C7"/>let <chord name="Dm"/>the way <chord name="Bb"/>appear, <chord name="F"/>steps <chord name="C"/>unto heaven;<br/>
      <chord name="F"/>all <chord name="C7"/>that <chord name="Dm"/>thou <chord name="Bb"/>sendest <chord name="F"/>me, <chord name="C"/>in <chord name="C7"/>mercy <chord name="F"/>given;<br/>
      <chord name="Bb"/>angels to <chord name="F"/>beckon me<br/>
      <chord name="Bb"/>nearer, <chord name="F"/>my <chord name="C"/>God, <chord name="F"/>to <chord name="C"/>thee;<br/>
      <chord name="F"/>nearer, <chord name="C7"/>my <chord name="Dm"/>God, <chord name="Bb"/>to <chord name="F"/>thee, <chord name="C"/>nearer <chord name="C7"/>to <chord name="F"/>thee!
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F"/>Then, <chord name="C7"/>with my <chord name="Dm"/>waking <chord name="Bb"/>thoughts bright <chord name="F"/>with <chord name="C"/>thy praise,<br/>
      <chord name="F"/>out <chord name="C7"/>of <chord name="Dm"/>my <chord name="Bb"/>stony <chord name="F"/>griefs <chord name="C"/>Bethel <chord name="C7"/>I&#x27;ll <chord name="F"/>raise;<br/>
      <chord name="Bb"/>so by my <chord name="F"/>woes to be<br/>
      <chord name="Bb"/>nearer, <chord name="F"/>my <chord name="C"/>God, <chord name="F"/>to <chord name="C"/>thee;<br/>
      <chord name="F"/>nearer, <chord name="C7"/>my <chord name="Dm"/>God, <chord name="Bb"/>to <chord name="F"/>thee, <chord name="C"/>nearer <chord name="C7"/>to <chord name="F"/>thee!
      </lines>
    </verse>
    <verse name="v5">
      <lines>
      <chord name="F"/>Or <chord name="C7"/>if, <chord name="Dm"/>on joyful <chord name="Bb"/>wing <chord name="F"/>cleaving <chord name="C"/>the sky,<br/>
      <chord name="F"/>sun, <chord name="C7"/>moon, <chord name="Dm"/>and <chord name="Bb"/>stars <chord name="F"/>forgot, <chord name="C"/>upward <chord name="C7"/>I <chord name="F"/>fly,<br/>
      <chord name="Bb"/>still all my <chord name="F"/>song shall be,<br/>
      <chord name="Bb"/>nearer, <chord name="F"/>my <chord name="C"/>God, <chord name="F"/>to <chord name="C"/>thee;<br/>
      <chord name="F"/>nearer, <chord name="C7"/>my <chord name="Dm"/>God, <chord name="Bb"/>to <chord name="F"/>thee, <chord name="C"/>nearer <chord name="C7"/>to <chord name="F"/>thee!
      </lines>
    </verse>
  </lyrics>
</song>
