  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb"/>Give of your <chord name="Bb7"/>best to the <chord name="Eb"/>Mas<chord name="Bb7"/>ter,<br/>
      <chord name="Eb"/>Give of <chord name="Bb7"/>the <chord name="Eb"/>strength of your <chord name="F7"/>you<chord name="Bb"/>th;<br/>
      <chord name="Eb"/>Throw your soul’s <chord name="Bb7"/>fresh, glowing <chord name="Eb"/>ar<chord name="Edim6"/>dor<br/>
      <chord name="Fm"/>Into the <chord name="Bb"/>battle <chord name="Bb7"/>for <chord name="Eb"/>truth.<br/>
      <chord name="Cm"/>Jesus has set the example—<br/>
      <chord name="G"/>Dauntless was <chord name="G7"/>He, young and <chord name="Cm"/>brave;<br/>
      Give Him your <chord name="Fm"/>loyal de<chord name="Cm"/>votion,<br/>
      <chord name="Bb"/>Give Him the <chord name="F"/>best that <chord name="F7"/>you <chord name="Bb"/>hav<chord name="F7"/>e.<chord name="Bb7"/>
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Eb"/>Give <chord name="Bb7"/>of your <chord name="Eb"/>best to <chord name="Bb7"/>the master,<br/>
      <chord name="Eb"/>Give <chord name="Bb7"/>of <chord name="Eb"/>the strength <chord name="F7"/>of <chord name="Bb"/>your youth;<br/>
      <chord name="Eb"/>Clad <chord name="Bb7"/>in <chord name="Eb"/>salvation&#x27;s <chord name="Edim6"/>full armor,<br/>
      <chord name="Fm"/>Join <chord name="Bb"/>in the <chord name="Bb7"/>battle <chord name="Eb"/>for truth.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Eb"/>Give <chord name="Bb7"/>of your <chord name="Eb"/>best to <chord name="Bb7"/>the Master,<br/>
      <chord name="Eb"/>Give <chord name="Bb7"/>Him <chord name="Eb"/>first place <chord name="F7"/>in <chord name="Bb"/>your heart;<br/>
      <chord name="Eb"/>Give <chord name="Bb7"/>Him first <chord name="Eb"/>place in <chord name="Edim6"/>your service,<br/>
