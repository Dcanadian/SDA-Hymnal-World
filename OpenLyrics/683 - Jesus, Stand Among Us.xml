<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>683 - Jesus, Stand Among Us</title>
      <title>Jesus, Stand Among Us</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="683"/>
    </songbooks>
    <key>C</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Sentences and Responses</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      Jesus, stand among us<br/>
      In Thy risen power;<br/>
      Let this time of worship<br/>
      Be a hallowed hour.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      Breathe the Holy Spirit<br/>
      Into every heart;<br/>
      Bid the fears and sorrows<br/>
      From each soul depart.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      Thus with quickened footsteps<br/>
      We pursue our way,<br/>
      Watching for the dawning<br/>
      Of eternal day.
      </lines>
    </verse>
  </lyrics>
</song>
