<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>314 - Just as I Am</title>
      <title>Just as I Am</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="314"/>
    </songbooks>
    <key>D</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4 v5 v6</verseOrder>
    <themes>
      <theme>Gospel</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="D"/>Just as I am, with<chord name="A"/>out <chord name="A7"/>one <chord name="D"/>plea,<br/>
      <chord name="D"/>But <chord name="A"/>that <chord name="D"/>Thy <chord name="A7"/>blood was <chord name="G"/>shed <chord name="D"/>for me,<br/>
      <chord name="D"/>And that Thou bidst me <chord name="G"/>come to Thee,<br/>
      <chord name="G"/>O <chord name="D"/>Lamb of God, I <chord name="A"/>come, I <chord name="D"/>come.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="D"/>Just <chord name="A"/>as I <chord name="A7"/>am, and <chord name="D"/>waiting not<br/>
      <chord name="D"/>to <chord name="A"/>rid <chord name="D"/>my soul <chord name="A7"/>of <chord name="G"/>one <chord name="D"/>dark blot,<br/>
      <chord name="D"/>to thee whose blood <chord name="G"/>can cleanse each spot,<br/>
      <chord name="G"/>O Lamb <chord name="D"/>of God, <chord name="A"/>I come, <chord name="D"/>I come.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="D"/>Just <chord name="A"/>as I <chord name="A7"/>am, though <chord name="D"/>tossed about<br/>
      <chord name="D"/>with <chord name="A"/>many <chord name="D"/>a <chord name="A7"/>conflict, <chord name="G"/>many <chord name="D"/>a doubt,<br/>
      <chord name="D"/>fightings and <chord name="G"/>fears within, without,<br/>
      <chord name="G"/>O Lamb <chord name="D"/>of God, <chord name="A"/>I come, <chord name="D"/>I come.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="D"/>Just <chord name="A"/>as I <chord name="A7"/>am, poor, <chord name="D"/>wretched, blind;<br/>
      <chord name="D"/>sight, <chord name="A"/>riches, <chord name="D"/>healing <chord name="A7"/>of <chord name="G"/>the <chord name="D"/>mind,<br/>
      <chord name="D"/>yea, all I need <chord name="G"/>in thee to find,<br/>
      <chord name="G"/>O Lamb <chord name="D"/>of God, <chord name="A"/>I come, <chord name="D"/>I come.
      </lines>
    </verse>
    <verse name="v5">
      <lines>
      <chord name="D"/>Just <chord name="A"/>as I <chord name="A7"/>am, thou <chord name="D"/>wilt receive,<br/>
      <chord name="D"/><chord name="A"/>wilt <chord name="D"/>welcome, <chord name="A7"/>pardon, <chord name="G"/>cleanse, <chord name="D"/>relieve;<br/>
      <chord name="D"/>because thy <chord name="G"/>promise I believe,<br/>
      <chord name="G"/>O Lamb <chord name="D"/>of God, <chord name="A"/>I come, <chord name="D"/>I come.
      </lines>
    </verse>
    <verse name="v6">
      <lines>
      <chord name="D"/>Just as <chord name="A"/>I am, <chord name="A7"/>thy love <chord name="D"/>I own<br/>
      <chord name="D"/><chord name="A"/>hath <chord name="D"/>broken <chord name="A7"/>every <chord name="G"/>barrier <chord name="D"/>down;<br/>
      <chord name="D"/>now, to be <chord name="G"/>thine, and thine alone,<br/>
      <chord name="G"/>O Lamb <chord name="D"/>of God, <chord name="A"/>I come, <chord name="D"/>I come.
      </lines>
    </verse>
  </lyrics>
</song>
