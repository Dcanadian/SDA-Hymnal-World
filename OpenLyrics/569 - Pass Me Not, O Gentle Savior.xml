<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>569 - Pass Me Not, O Gentle Savior</title>
      <title>Pass Me Not, O Gentle Savior</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="569"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>Pass me <chord name="C"/>not, O gentle <chord name="G"/>Savior,<br/>
      <chord name="D7"/>Hear my <chord name="G"/>hum<chord name="D7"/>ble <chord name="G"/>cry;<br/>
      <chord name="G"/>While on <chord name="C"/>others Thou art <chord name="G"/>calling,<br/>
      <chord name="D7"/>Do not <chord name="G"/>pass <chord name="D7"/>me <chord name="G"/>by.<br/>
      <chord name="G"/>Savior, <chord name="C"/>Savior, <chord name="G"/>hear my humble <chord name="D"/>cry;<br/>
      <chord name="G"/>While on <chord name="C"/>others Thou art <chord name="G"/>calling,<br/>
      <chord name="D7"/>Do not <chord name="G"/>pass <chord name="D7"/>me <chord name="G"/>by.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="G"/>Savior, Savior, <chord name="C"/>hear my <chord name="G"/>humble cry;<br/>
      <chord name="D7"/>while <chord name="G"/>on others <chord name="D7"/>thou <chord name="G"/>art calling,<br/>
      <chord name="G"/>do <chord name="C"/>not pass <chord name="G"/>me by.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>Let me <chord name="C"/>at thy <chord name="G"/>throne of mercy<br/>
      <chord name="D7"/>find <chord name="G"/>a <chord name="D7"/>sweet <chord name="G"/>relief,<br/>
      <chord name="G"/>kneeling <chord name="C"/>there in <chord name="G"/>deep contrition;<br/>
      <chord name="D7"/><chord name="G"/>help <chord name="D7"/>my <chord name="G"/>unbelief.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>Trusting <chord name="C"/>only in <chord name="G"/>thy merit,<br/>
      <chord name="D7"/>would <chord name="G"/>I <chord name="D7"/>seek <chord name="G"/>thy face;<br/>
      <chord name="G"/>heal <chord name="C"/>my wounded, <chord name="G"/>broken spirit,<br/>
      <chord name="D7"/>save <chord name="G"/>me <chord name="D7"/>by <chord name="G"/>thy grace.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="G"/>Thou the <chord name="C"/>spring of <chord name="G"/>all my comfort,<br/>
      <chord name="D7"/>more <chord name="G"/>than <chord name="D7"/>life <chord name="G"/>to me,<br/>
      <chord name="G"/>whom have <chord name="C"/>I on <chord name="G"/>earth beside thee?<br/>
      <chord name="D7"/>Whom <chord name="G"/>in <chord name="D7"/>heaven <chord name="G"/>but thee?
      </lines>
    </verse>
  </lyrics>
</song>
