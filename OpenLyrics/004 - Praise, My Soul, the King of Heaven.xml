    <verse name="v3">
      <lines>
      <chord name="D"/>Tender<chord name="A7"/>ly <chord name="D"/>He <chord name="G"/>shields <chord name="F#m"/>and <chord name="G"/>spares <chord name="Em"/> <chord name="D"/>us;<br/>
