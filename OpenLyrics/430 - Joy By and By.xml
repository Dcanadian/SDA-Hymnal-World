<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>430 - Joy By and By</title>
      <title>Joy By and By</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="430"/>
    </songbooks>
    <key>Bb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3</verseOrder>
    <themes>
      <theme>Doctrines</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Bb"/>O there&#x27;ll be joy when the <chord name="F"/>work is done,<br/>
      <chord name="F"/>Joy when the reapers <chord name="Bb"/>gather home,<br/>
      <chord name="Bb"/>Bringing the sheaves at <chord name="Eb"/>set of sun<br/>
      To the <chord name="Bb"/>New Je<chord name="G"/>ru<chord name="C7"/>sa<chord name="F"/>lem.<br/>
      <chord name="Bb"/>Joy, joy, joy, there&#x27;ll be <chord name="F"/>joy by and by,<br/>
      <chord name="F7"/>Joy, joy, joy, where the <chord name="Bb"/>joys <chord name="F"/>never <chord name="Bb"/>die;<br/>
      <chord name="Bb"/>Joy, <chord name="D"/>joy, <chord name="Gm"/>joy, <chord name="Bb7"/>for the <chord name="Eb"/>day draweth nigh<br/>
      When the <chord name="Bb"/>workers <chord name="F7"/>gather <chord name="Bb"/>home.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="Bb"/>Joy, joy, joy, there&#x27;ll <chord name="F"/>be joy by and by,<br/>
      <chord name="F"/>Joy, joy, joy, where <chord name="Bb"/>the joys never die;<br/>
      <chord name="Bb"/>Joy, joy, joy, for <chord name="Eb"/>the day draweth nigh<br/>
      <chord name="Bb"/>When <chord name="G"/>the <chord name="C7"/>workers <chord name="F"/>gather home.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Bb"/>Sweet are the songs <chord name="F"/>that we hope to sing,<br/>
      <chord name="F"/>Grateful the thanks <chord name="Bb"/>our hearts shall bring,<br/>
      <chord name="Bb"/>Praising forever <chord name="Eb"/>Christ our King<br/>
      <chord name="Bb"/>In <chord name="G"/>the <chord name="C7"/>New <chord name="F"/>Jerusalem.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Bb"/>Pure are the joys <chord name="F"/>that await us there,<br/>
      <chord name="F"/>Many the <chord name="Bb"/>golden mansions fair;<br/>
      <chord name="Bb"/>Jesus Himself <chord name="Eb"/>doth them prepare,<br/>
      <chord name="Bb"/>In <chord name="G"/>the <chord name="C7"/>New <chord name="F"/>Jerusalem.
      </lines>
    </verse>
  </lyrics>
</song>
