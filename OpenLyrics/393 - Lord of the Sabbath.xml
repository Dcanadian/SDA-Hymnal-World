      <chord name="F"/>The solace of my <chord name="Bb"/>care<chord name="C"/>worn <chord name="F"/>breast.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>O <chord name="Bb"/>sacred <chord name="C"/>day <chord name="F"/>of <chord name="C"/>peace <chord name="G7"/>and <chord name="C"/>joy,<br/>
