  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Lord of the Sabbath <chord name="Bb"/>and <chord name="C"/>its <chord name="F"/>light, I hail Thy hallowed <chord name="C"/>day <chord name="G7"/>of <chord name="C"/>rest;<br/>
