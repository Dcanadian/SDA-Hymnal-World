    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/><chord name="Bb"/>How <chord name="C"/>sweetly <chord name="F"/>now <chord name="C"/>they <chord name="G7"/>glide <chord name="C"/>along!<br/>
      <chord name="C"/><chord name="F"/>How <chord name="C7"/>hallowed <chord name="F"/>is <chord name="D7"/><chord name="Gm"/>the <chord name="Gm7"/>calm <chord name="C7"/>they <chord name="F"/>yield!<br/>
      <chord name="F"/>Transporting <chord name="Bb"/>is <chord name="C"/>their <chord name="F"/>rapturous song,<br/>
      <chord name="F"/><chord name="Bb"/>And <chord name="C"/>heavenly <chord name="F"/><chord name="C"/>visions <chord name="G7"/>seem <chord name="C"/>revealed,<br/>
      <chord name="C"/><chord name="F"/>And <chord name="C7"/><chord name="F"/>heavenly <chord name="D7"/><chord name="Gm"/>visions <chord name="Gm7"/><chord name="C7"/>seem <chord name="F"/>revealed.
