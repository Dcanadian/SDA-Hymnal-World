    <verse name="v4">
      <lines>
      <chord name="F"/><chord name="Bb"/>O <chord name="C"/>Jesus, <chord name="F"/>let <chord name="C"/>me <chord name="G7"/>ever <chord name="C"/>hail<br/>
      <chord name="C"/><chord name="F"/>Thy <chord name="C7"/>presence <chord name="F"/>with <chord name="D7"/><chord name="Gm"/>the <chord name="Gm7"/>day <chord name="C7"/>of <chord name="F"/>rest;<br/>
