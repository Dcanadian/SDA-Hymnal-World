      <chord name="F"/>Ne&#x27;er <chord name="Bb"/>may a <chord name="C"/>sinful <chord name="F"/>thought destroy<br/>
      <chord name="F"/>The <chord name="Bb"/>holy <chord name="C"/>calm <chord name="F"/>I <chord name="C"/>find <chord name="G7"/>in <chord name="C"/>thee,<br/>
      <chord name="C"/><chord name="F"/>The <chord name="C7"/>holy <chord name="F"/>calm <chord name="D7"/><chord name="Gm"/>I <chord name="Gm7"/>find <chord name="C7"/>in <chord name="F"/>thee.
