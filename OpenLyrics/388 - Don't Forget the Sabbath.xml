    <verse name="v2">
      <lines>
      <chord name="Bb"/>Keep <chord name="F"/>the <chord name="Eb"/>Sabbath <chord name="Bb"/>holy,<br/>
      <chord name="Bb"/>And <chord name="F"/>worship <chord name="C"/>Him <chord name="F"/>today,<br/>
      <chord name="F"/>Who <chord name="Bb"/>said <chord name="F"/>to <chord name="Bb"/>His disciples,<br/>
      <chord name="Bb"/><chord name="F7"/>&quot;I <chord name="Gm"/>am <chord name="Eb"/><chord name="Bb"/>the <chord name="F"/>living <chord name="Bb"/>way;&quot;<br/>
      <chord name="Bb"/><chord name="Eb7"/>And <chord name="Gm"/><chord name="Eb"/>if <chord name="Bb"/>we <chord name="F"/><chord name="Eb"/>meekly <chord name="Bb"/>follow<br/>
      <chord name="Bb"/><chord name="Eb7"/>Our <chord name="Gm"/><chord name="Eb"/>Savior <chord name="Bb"/><chord name="F7"/>here <chord name="Bb"/>below,<br/>
      <chord name="Bb"/>He&#x27;ll <chord name="F"/>give us <chord name="Eb"/>of <chord name="Bb"/>the fountain<br/>
      <chord name="Bb"/>Whose <chord name="F"/>streams <chord name="C"/>eternal <chord name="F"/>flow.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Bb"/>Day <chord name="F"/>of <chord name="Eb"/>sacred <chord name="Bb"/>pleasure!<br/>
      <chord name="Bb"/>Its <chord name="F"/>golden <chord name="C"/>hours <chord name="F"/>we&#x27;ll spend<br/>
      <chord name="F"/>In <chord name="Bb"/>thankful <chord name="F"/>hymns <chord name="Bb"/>to Jesus,<br/>
