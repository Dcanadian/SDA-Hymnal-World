<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>489 - Jesus, Lover of My Soul</title>
      <title>Jesus, Lover of My Soul</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="489"/>
    </songbooks>
    <key>Eb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3 v4</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Eb"/>Jesus, lover <chord name="Bb"/>of my soul,<br/>
      <chord name="Eb"/>Let me to thy <chord name="Bb"/>bosom <chord name="Eb"/>fly,<br/>
      While the billows <chord name="Bb"/>near me roll,<br/>
      <chord name="Eb"/>While the tempest <chord name="Bb"/>still is <chord name="Eb"/>high;<br/>
      <chord name="Eb"/>Hide me, O my <chord name="Ab"/>Savior, <chord name="Eb"/>hide!<br/>
      Till the storm of <chord name="Ab"/>life is <chord name="Eb"/>past;<br/>
      Safe into the <chord name="Bb"/>haven guide,<br/>
      <chord name="Eb"/>O receive my <chord name="Bb"/>soul at <chord name="Eb"/>last!
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Eb"/>Other refuge <chord name="Bb"/>has I none,<br/>
      <chord name="Eb"/>Hangs my <chord name="Bb"/>helpless soul <chord name="Eb"/>on thee;<br/>
      <chord name="Bb"/>Leave O leave me not alone!<br/>
      <chord name="Eb"/>Still <chord name="Bb"/>support and <chord name="Eb"/>comfort me;<br/>
      <chord name="Eb"/>All my <chord name="Ab"/>trust on <chord name="Eb"/>Thee is stayed,<br/>
      <chord name="Ab"/>All my help <chord name="Eb"/>from Thee I bring;<br/>
      <chord name="Bb"/>Cover my defenseless head<br/>
      <chord name="Eb"/>With the <chord name="Bb"/>shadow of <chord name="Eb"/>Thy wing.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Eb"/>Thou, O Christ, <chord name="Bb"/>all I want,<br/>
      <chord name="Eb"/>More than <chord name="Bb"/>all in <chord name="Eb"/>Thee I find;<br/>
      <chord name="Bb"/>Raise the fallen, cheer the faint,<br/>
      <chord name="Eb"/>Heal the <chord name="Bb"/>sick, and <chord name="Eb"/>lead the blind.<br/>
      <chord name="Eb"/>Just and <chord name="Ab"/>holy is <chord name="Eb"/>Thy name,<br/>
      <chord name="Ab"/>I am <chord name="Eb"/>all unrighteousness;<br/>
      <chord name="Bb"/>Vile and full of sin I am;<br/>
      <chord name="Eb"/>Thou art <chord name="Bb"/>full of <chord name="Eb"/>truth and grace.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="Eb"/>Plenteous grace with <chord name="Bb"/>Thee is found-<br/>
      <chord name="Eb"/>Grace to <chord name="Bb"/>pardon all <chord name="Eb"/>my sin;<br/>
      <chord name="Bb"/>Let the healing streams abound,<br/>
      <chord name="Eb"/>Make and <chord name="Bb"/>keep me <chord name="Eb"/>pure within;<br/>
      <chord name="Eb"/>Thou of <chord name="Ab"/>life the <chord name="Eb"/>Fountain art,<br/>
      <chord name="Ab"/>Freely let me <chord name="Eb"/>take of Thee;<br/>
      <chord name="Bb"/>Spring Thou up within my heart,<br/>
      <chord name="Eb"/>Rise <chord name="Bb"/>to <chord name="Eb"/>all eternity.
      </lines>
    </verse>
  </lyrics>
</song>
