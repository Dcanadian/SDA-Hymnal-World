  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Dm"/>What <chord name="C"/>wondrous love is <chord name="Am"/>this,<br/>
      <chord name="G"/>O <chord name="C"/>my <chord name="Dm"/>soul, O my <chord name="Am"/>soul?<br/>
      What wondrous <chord name="G"/>love is <chord name="Am"/>this, <chord name="G"/>O <chord name="C"/>my <chord name="Dm"/>sou<chord name="Em"/>l?<chord name="Dm"/><br/>
      <chord name="C"/>What <chord name="F"/>wondrous <chord name="Am7"/>love is <chord name="Dm"/>this<br/>
      <chord name="Bb"/>That <chord name="Am7"/>caused the <chord name="Dm"/>Lord <chord name="C"/>of <chord name="Dm"/>bli<chord name="G"/>ss<br/>
      <chord name="Dm"/>To <chord name="Em7"/><chord name="Dm"/>bear the <chord name="C"/>dreadful <chord name="Am"/>cur<chord name="Dm"/>se <chord name="C"/>for my <chord name="Dm"/>soul, <chord name="Am"/>for my <chord name="Em"/>soul;<br/>
      <chord name="Am"/>To bear the <chord name="Bm7"/>dreadful <chord name="Am"/>curse <chord name="C"/>for <chord name="Em"/>my <chord name="Dm"/>sou<chord name="Em"/>l?<chord name="Dm"/>
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Dm"/>To God and <chord name="C"/>to the Lamb <chord name="Am"/>I will sing,<br/>
      <chord name="G"/>I will <chord name="C"/>sing; To <chord name="Dm"/>God and <chord name="Am"/>to the Lamb,<br/>
      <chord name="G"/>I <chord name="Am"/>will <chord name="G"/>sing; <chord name="C"/>To God <chord name="Dm"/>and <chord name="Em"/>to <chord name="Dm"/>the Lamb<br/>
      <chord name="C"/>Who is <chord name="F"/>the great I <chord name="Am7"/>am, While millions <chord name="Dm"/>join the theme,<br/>
      <chord name="Bb"/>I will <chord name="Am7"/>sing, I <chord name="Dm"/>will sing; While <chord name="C"/>millions join <chord name="Dm"/>the theme, <chord name="G"/>I will sing.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Dm"/>And when from death <chord name="C"/>I&#x27;m free, I&#x27;ll sing <chord name="Am"/>on, I&#x27;ll sing on;<br/>
      <chord name="G"/>And when <chord name="C"/>from death <chord name="Dm"/>I&#x27;m free, <chord name="Am"/>I&#x27;ll sing on;<br/>
      <chord name="G"/><chord name="Am"/>And <chord name="G"/>when <chord name="C"/>from <chord name="Dm"/>death <chord name="Em"/>I&#x27;m <chord name="Dm"/>free,<br/>
      <chord name="C"/>I&#x27;ll sing <chord name="F"/>and joyful <chord name="Am7"/>be, And <chord name="Dm"/>through eternity<br/>
      <chord name="Bb"/>I&#x27;ll sing <chord name="Am7"/>on, I&#x27;ll <chord name="Dm"/>sing on! <chord name="C"/>And through <chord name="Dm"/>eternity, I&#x27;ll <chord name="G"/>sing on
      </lines>
    </verse>
