  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Rise, <chord name="C"/>my <chord name="Dm"/>soul, <chord name="C"/>and <chord name="F"/>stretch <chord name="C"/>thy <chord name="F"/>wings,<br/>
      Thy <chord name="Bb"/>bet<chord name="F"/>ter <chord name="Gm"/>por<chord name="F"/>tion <chord name="C"/>trace;<br/>
      <chord name="F"/>Rise <chord name="C"/>from <chord name="Dm"/>tran<chord name="C"/>si<chord name="F"/>to<chord name="C"/>ry <chord name="F"/>things<br/>
      Toward <chord name="Bb"/>heaven, <chord name="F"/>thy <chord name="Gm"/>na<chord name="F"/>tive <chord name="C"/>place;<br/>
      <chord name="F"/>Sun, <chord name="Bb"/>and <chord name="F"/>moon, <chord name="Bb"/>and <chord name="F"/>stars de<chord name="C"/>cay;<br/>
      <chord name="F"/>Time shall <chord name="C7"/>soon <chord name="F"/>this <chord name="C"/>earth remove;<chord name="C7"/><br/>
      <chord name="F"/>Rise, <chord name="C"/>my <chord name="Dm"/>soul, <chord name="C"/>and <chord name="F"/>haste <chord name="C"/>a<chord name="F"/>way<br/>
      To <chord name="Bb"/>seats <chord name="Gm"/>pre<chord name="F"/>pared <chord name="C7"/>a<chord name="F"/>bove.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>Rivers <chord name="C"/>to the <chord name="Dm"/>ocean <chord name="C"/>run, nor <chord name="F"/>stay <chord name="C"/>in all <chord name="F"/>their course;<br/>
      <chord name="Bb"/>Fire ascending <chord name="F"/>seeks the <chord name="Gm"/>sun; both <chord name="F"/>speed them <chord name="C"/>to their source;<br/>
      <chord name="F"/>So <chord name="C"/>a soul <chord name="Dm"/>that&#x27;s born <chord name="C"/>of God, <chord name="F"/>longs to <chord name="C"/>view His <chord name="F"/>glorious face,<br/>
      <chord name="Bb"/>Forward tends <chord name="F"/>to His <chord name="Gm"/>abode to <chord name="F"/>rest in <chord name="C"/>His embrace.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>Cease, <chord name="C"/>ye pilgrims, <chord name="Dm"/>cease <chord name="C"/>to mourn; <chord name="F"/>press <chord name="C"/>onward to <chord name="F"/>the prize;<br/>
      <chord name="Bb"/>Soon <chord name="F"/>our Savior <chord name="Gm"/>will return, <chord name="F"/>triumphant in <chord name="C"/>the skies;<br/>
      <chord name="F"/>Yet <chord name="C"/>a season, <chord name="Dm"/>and <chord name="C"/>you know <chord name="F"/>happy <chord name="C"/>entrance will <chord name="F"/>be given,<br/>
      <chord name="Bb"/>All our <chord name="F"/>sorrows left <chord name="Gm"/>below, and <chord name="F"/>earth exhcanged <chord name="C"/>for heaven.
      </lines>
    </verse>
