<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>143 - Silent Night, Holy Night</title>
      <title>Silent Night, Holy Night</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="143"/>
    </songbooks>
    <key>Bb</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Jesus Christ</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Bb"/>Silent night, holy night;<br/>
      <chord name="F7"/>All is calm, <chord name="Bb"/>all is bright<br/>
      <chord name="Eb"/>Round yon virgin <chord name="Bb"/>mother and Child,<br/>
      <chord name="Eb"/>Holy Infant so <chord name="Bb"/>tender and mild,<br/>
      <chord name="F7"/>Sleep in heavenly <chord name="Bb"/>peace,<br/>
      Sleep in <chord name="F7"/>heavenly <chord name="Bb"/>peace.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Bb"/>Silent night! holy night!<br/>
      <chord name="F7"/>Shepherds quake <chord name="Bb"/>at the sight,<br/>
      <chord name="Eb"/>glories stream <chord name="Bb"/>from heaven afar,<br/>
      <chord name="Eb"/>heavenly hosts <chord name="Bb"/>sing Alleluia;<br/>
      <chord name="F7"/>Christ, the <chord name="Bb"/>Savior is born,<br/>
      <chord name="F7"/>Christ, the <chord name="Bb"/>Savior is born.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Bb"/>Silent night! holy night!<br/>
      <chord name="F7"/>Son of God, <chord name="Bb"/>love&#x27;s pure light,<br/>
      <chord name="Eb"/>Radiant beams from <chord name="Bb"/>Thy holy face,<br/>
      <chord name="Eb"/>with the dawn <chord name="Bb"/>of redeeming grace,<br/>
      <chord name="F7"/>Jesus, Lord, <chord name="Bb"/>at Thy birth,<br/>
      <chord name="F7"/>Jesus, Lord, <chord name="Bb"/>at Thy birth.
      </lines>
    </verse>
  </lyrics>
</song>
