<?xml version='1.0' encoding='UTF-8'?>
<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>272 - Give Me the Bible</title>
      <title>Give Me the Bible</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="272"/>
    </songbooks>
    <key>G</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 c1 v2 v3</verseOrder>
    <themes>
      <theme>Holy Scriptures</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>Give me the Bible, <chord name="D"/>star of gladness <chord name="G"/>gleaming,<br/>
      <chord name="C"/>To cheer the wand&#x27;rer <chord name="G"/>lone and tempest <chord name="D"/>tossed;<br/>
      <chord name="G"/>No storm can hide that radiance <chord name="D"/>peaceful <chord name="G"/>beaming,<br/>
      <chord name="C"/>Since Jesus came to <chord name="D"/>seek and save the <chord name="G"/>lost.<br/>
      <chord name="G"/>Give me the Bible, holy message <chord name="C"/>shining;<br/>
      <chord name="G"/>Thy light shall guide me in the <chord name="A"/>narrow <chord name="D"/>way;<br/>
      <chord name="G"/>Precept and promise, <chord name="D"/>law and love com<chord name="G"/>bining,<br/>
      <chord name="C"/>Till night shall vanish <chord name="D"/>in eternal <chord name="G"/>day.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="G"/>Give <chord name="D"/>me <chord name="G"/>the Bible--<br/>
      <chord name="C"/>holy <chord name="G"/>message <chord name="D"/>shining,<br/>
      <chord name="G"/>Thy <chord name="D"/>light shall <chord name="G"/>guide me<br/>
      <chord name="C"/>in <chord name="D"/>the <chord name="G"/>narrow way.<br/>
      <chord name="G"/>Precept <chord name="C"/>and promise,<br/>
      <chord name="G"/>law <chord name="A"/>and <chord name="D"/>love combining,<br/>
      <chord name="G"/>&#x27;Til <chord name="D"/>night <chord name="G"/>shall vanish<br/>
      <chord name="C"/>in <chord name="D"/>eternal <chord name="G"/>day.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/>Give <chord name="D"/>me <chord name="G"/>the Bible<br/>
      <chord name="C"/>when <chord name="G"/>my heart <chord name="D"/>is broken,<br/>
      <chord name="G"/>When <chord name="D"/>sin and <chord name="G"/>grief have<br/>
      <chord name="C"/>filled <chord name="D"/>my soul <chord name="G"/>with fear,<br/>
      <chord name="G"/>Give me <chord name="C"/>the precious<br/>
      <chord name="G"/>words <chord name="A"/>by <chord name="D"/>Jesus spoken,<br/>
      <chord name="G"/>Hold <chord name="D"/>up <chord name="G"/>faith&#x27;s lamp<br/>
      <chord name="C"/>to <chord name="D"/>show my <chord name="G"/>Savior near.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/>Give <chord name="D"/>me <chord name="G"/>the Bible,<br/>
      <chord name="C"/>all <chord name="G"/>my <chord name="D"/>steps enlighten,<br/>
      <chord name="G"/>Teach <chord name="D"/>me <chord name="G"/>the danger<br/>
      <chord name="C"/>of <chord name="D"/>these <chord name="G"/>realms below,<br/>
      <chord name="G"/>That lamp <chord name="C"/>of safety,<br/>
      <chord name="G"/>o&#x27;er <chord name="A"/>the gloom <chord name="D"/>shall brighten,<br/>
      <chord name="G"/>That <chord name="D"/>light <chord name="G"/>alone<br/>
      <chord name="C"/>the path <chord name="D"/>of peace <chord name="G"/>can show.
      </lines>
    </verse>
  </lyrics>
</song>
