  <lyrics>
    <verse name="v1">
      <lines>
      Heavenly Father, to Thee we pray,<br/>
      On the holy Sabbath day;<br/>
      Through Thy Word Thy will make known;<br/>
      May each heart become Thy throne,<br/>
      Let Thy living water flow<br/>
      That we Thy boundless love may know.<br/>
      Amen.
      </lines>
    </verse>
  </lyrics>
