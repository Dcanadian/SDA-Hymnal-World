      <title>677 - Heavenly Father, to Thee We Pray</title>
      <title>Heavenly Father, to Thee We Pray</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="677"/>
    </songbooks>
