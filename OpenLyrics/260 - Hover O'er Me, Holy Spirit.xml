  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>Hover <chord name="C7"/>o&#x27;er me, <chord name="F"/>Holy Spirit, Bathe my trembling heart and <chord name="C"/>brow;<br/>
      <chord name="F"/>Fill me <chord name="C7"/>with Thy <chord name="F"/>hallowed presence, Come, O come and <chord name="C7"/>fill me <chord name="F"/>now.<br/>
      <chord name="C"/>Fill me now, <chord name="F"/>fill me now, <chord name="Bb"/>Jesus, <chord name="F"/>come and fill me <chord name="C"/>now.<br/>
      <chord name="F"/>Fill me <chord name="C7"/>with Thy <chord name="F"/>hallowed presence, Come, O come and <chord name="C7"/>fill me <chord name="F"/>now.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="F"/>Fill <chord name="C7"/>me now, <chord name="F"/>fill <chord name="C"/>me now,<br/>
      <chord name="F"/>Jesus, <chord name="C7"/>come <chord name="F"/>and <chord name="C7"/>fill <chord name="F"/>me now.<br/>
      <chord name="C"/>Fill <chord name="F"/>me <chord name="Bb"/>with <chord name="F"/>Thy <chord name="C"/>hallowed presence,<br/>
      <chord name="F"/>Come, <chord name="C7"/>O <chord name="F"/>come and <chord name="C7"/>fill <chord name="F"/>me now.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>Thou <chord name="C7"/>canst fill <chord name="F"/>me, <chord name="C"/>gracious Spirit,<br/>
      <chord name="F"/>Though <chord name="C7"/>I <chord name="F"/>cannot <chord name="C7"/>tell <chord name="F"/>Thee how;<br/>
      <chord name="C"/>But <chord name="F"/>I <chord name="Bb"/>need Thee, <chord name="F"/>greatly <chord name="C"/>need Thee;<br/>
      <chord name="F"/>Come, <chord name="C7"/>O <chord name="F"/>come and <chord name="C7"/>fill <chord name="F"/>me now.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>I <chord name="C7"/>am weakness, <chord name="F"/>full <chord name="C"/>of weakness;<br/>
      <chord name="F"/>At <chord name="C7"/>Thy <chord name="F"/>sacred <chord name="C7"/>feet <chord name="F"/>I bow;<br/>
      <chord name="C"/><chord name="F"/>Blest, <chord name="Bb"/>divine, <chord name="F"/>eternal <chord name="C"/>Spirit,<br/>
      <chord name="F"/>Fill <chord name="C7"/>with <chord name="F"/>love, and <chord name="C7"/>fill <chord name="F"/>me now.
      </lines>
    </verse>
    <verse name="v4">
      <lines>
      <chord name="F"/>Cleanse <chord name="C7"/>and comfort, <chord name="F"/>bless and <chord name="C"/>save me;<br/>
      <chord name="F"/>Bathe, <chord name="C7"/>O, <chord name="F"/>bathe my <chord name="C7"/>heart <chord name="F"/>and brow;<br/>
      <chord name="C"/>Thou <chord name="F"/>art <chord name="Bb"/>comforting <chord name="F"/>and <chord name="C"/>saving,<br/>
      <chord name="F"/>Thou <chord name="C7"/>art <chord name="F"/>sweetly <chord name="C7"/>filling <chord name="F"/>now.
      </lines>
    </verse>
  </lyrics>
