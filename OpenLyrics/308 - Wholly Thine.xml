      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="G"/><chord name="D7"/>What <chord name="G"/>is <chord name="D"/>worldly <chord name="Em"/><chord name="D7"/>pleasure, <chord name="Em7"/>wealth <chord name="D7"/>or <chord name="G"/>fame,<br/>
      <chord name="G"/><chord name="D7"/>Without <chord name="G"/><chord name="D7"/>Thee, <chord name="Em"/><chord name="G"/>without <chord name="D7"/><chord name="G"/>Thee?<br/>
