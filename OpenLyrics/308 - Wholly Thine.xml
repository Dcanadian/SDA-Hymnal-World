      <chord name="G"/><chord name="D7"/>This <chord name="Em"/>my <chord name="G"/>wealth <chord name="D7"/>shall <chord name="G"/>be.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="G"/><chord name="D7"/>As <chord name="G"/>I <chord name="D"/>cast <chord name="Em"/><chord name="D7"/>earth&#x27;s <chord name="Em7"/>transient <chord name="D7"/>joys <chord name="G"/>behind,<br/>
      <chord name="G"/><chord name="D7"/>Come <chord name="G"/>Thou <chord name="D7"/>near, <chord name="Em"/><chord name="G"/>come <chord name="D7"/>Thou <chord name="G"/>near;<br/>
      <chord name="G"/>In <chord name="D7"/>Thy presence <chord name="G"/>all <chord name="D"/>in all <chord name="G"/>I find,<br/>
      <chord name="G"/><chord name="D7"/>&#x27;Tis <chord name="Em"/>my <chord name="G"/><chord name="D7"/>comfort <chord name="G"/>here.
