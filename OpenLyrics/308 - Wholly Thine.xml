  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="G"/>I would be, dear Savior, whol<chord name="D7"/>ly <chord name="G"/>Thine; <chord name="D"/>Teach <chord name="Em"/>me <chord name="D7"/>how, <chord name="Em7"/>teach <chord name="D7"/>me <chord name="G"/>how;<br/>
      <chord name="G"/>I would do Thy will, O Lord, <chord name="D7"/>not <chord name="G"/>mine; <chord name="D7"/>Help <chord name="Em"/>me, <chord name="G"/>help <chord name="D7"/>me <chord name="G"/>now.<br/>
      <chord name="G"/>Wholly Thine, wholly Thine, Wholly <chord name="D7"/>Thine, this <chord name="G"/>is <chord name="D"/>my <chord name="G"/>vow;<br/>
      <chord name="G"/>Wholly Thine, wholly Thine, Wholly <chord name="D7"/>Thine, <chord name="Em"/>O<chord name="G"/>Lord, <chord name="D7"/>just <chord name="G"/>now.
      </lines>
    </verse>
    <verse name="c1">
      <lines>
      <chord name="G"/><chord name="D7"/><chord name="G"/>Wholly <chord name="D"/><chord name="Em"/>Thine, <chord name="D7"/><chord name="Em7"/>wholly <chord name="D7"/><chord name="G"/>Thine,<br/>
      <chord name="G"/><chord name="D7"/>Wholly <chord name="G"/>Thine, <chord name="D7"/>this <chord name="Em"/><chord name="G"/>is <chord name="D7"/>my <chord name="G"/>vow;<br/>
