  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="A"/>Come, Christians, <chord name="D"/>join <chord name="E7"/>to <chord name="A"/>sing, <chord name="D"/>Alle<chord name="A/E"/>lu<chord name="E7"/>ia! <chord name="A"/>A<chord name="D"/>men! <chord name="A"/><br/>
      <chord name="A"/>Loud praise to <chord name="D"/>Christ <chord name="E7"/>our <chord name="A"/>King; <chord name="D"/>Alle<chord name="A/E"/>lu<chord name="E7"/>ia! <chord name="A"/>A<chord name="D"/>men! <chord name="A"/><br/>
      <chord name="A"/>Let all, with <chord name="E"/>heart and <chord name="F#m"/>voice, <chord name="D"/>Before His <chord name="Bm7"/>throne re<chord name="E"/>joice;<br/>
      <chord name="A"/>Praise is His <chord name="D"/>gra<chord name="E7"/>cious <chord name="A"/>choice; <chord name="D"/>Alle<chord name="A/E"/>lu<chord name="E7"/>ia! <chord name="A"/>A<chord name="D"/>men! <chord name="A"/>
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="A"/>Come, lift your <chord name="D"/>hearts <chord name="E7"/>on <chord name="A"/>high; <chord name="D"/>Alle<chord name="A/E"/>lu<chord name="E7"/>ia! <chord name="A"/>A<chord name="D"/>men! <chord name="A"/><br/>
      <chord name="A"/>Let praises <chord name="D"/>fill <chord name="E7"/>the <chord name="A"/>sky; <chord name="D"/>Alle<chord name="A/E"/>lu<chord name="E7"/>ia! <chord name="A"/>A<chord name="D"/>men! <chord name="A"/><br/>
      <chord name="A"/>He is our <chord name="E"/>Guide and <chord name="F#m"/>Friend; <chord name="D"/>To us He&#x27;ll <chord name="Bm7"/>conde<chord name="E"/>scend;<br/>
      <chord name="A"/>His love shall <chord name="D"/>nev<chord name="E7"/>er <chord name="A"/>end; <chord name="D"/>Alle<chord name="A/E"/>lu<chord name="E7"/>ia! <chord name="A"/>A<chord name="D"/>men! <chord name="A"/>
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="A"/>Praise yet our <chord name="D"/>Christ <chord name="E7"/>a<chord name="A"/>gain; <chord name="D"/>Alle<chord name="A/E"/>lu<chord name="E7"/>ia! <chord name="A"/>A<chord name="D"/>men! <chord name="A"/><br/>
      <chord name="A"/>Life shall not <chord name="D"/>end <chord name="E7"/>the <chord name="A"/>strain; <chord name="D"/>Alle<chord name="A/E"/>lu<chord name="E7"/>ia! <chord name="A"/>A<chord name="D"/>men! <chord name="A"/><br/>
      <chord name="A"/>On heaven&#x27;s <chord name="E"/>blissful <chord name="F#m"/>shore <chord name="D"/>His goodness <chord name="Bm7"/>we&#x27;ll a<chord name="E"/>dore,<br/>
      <chord name="A"/>Singing for<chord name="D"/>ev<chord name="E7"/>er<chord name="A"/>more, <chord name="D"/>Alle<chord name="A/E"/>lu<chord name="E7"/>ia! <chord name="A"/>A<chord name="D"/>men! <chord name="A"/>
      </lines>
