      <chord name="A"/><chord name="E"/><chord name="A"/>On <chord name="D"/><chord name="A"/>heaven&#x27;s <chord name="D"/><chord name="A"/>blissful <chord name="E7"/><chord name="A"/>shore<br/>
      <chord name="A"/><chord name="E"/><chord name="A"/>His <chord name="D"/><chord name="A"/>goodness <chord name="D"/><chord name="A"/>we&#x27;ll <chord name="E7"/><chord name="A"/>adore,<br/>
      <chord name="A"/><chord name="E7"/><chord name="A"/><chord name="D"/><chord name="A"/><chord name="E"/>Singing <chord name="A"/><chord name="E"/><chord name="A"/><chord name="Bm"/><chord name="A"/><chord name="E"/>forevermore,<br/>
