      <theme>Early Advent</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="F"/>What heavenly <chord name="C"/>music steals <chord name="Dm"/>o<chord name="Gm"/>ver <chord name="C"/>the <chord name="F"/>sea!<br/>
      <chord name="F"/>Entrancing the <chord name="C"/>senses like <chord name="Dm"/>sweet <chord name="Gm"/>mel<chord name="C7"/>o<chord name="F"/>dy!<br/>
      Tis the v<chord name="C"/>oice of the a<chord name="F"/>ngels b<chord name="D"/>orn s<chord name="Gm"/>oft on t<chord name="G7"/>he a<chord name="F"/>ir<chord name="C"/><br/>
      <chord name="C7"/>For <chord name="F"/>me they are <chord name="C"/>singing; their <chord name="Dm"/>wel<chord name="Gm"/>come <chord name="C7"/>I<chord name="F"/>hear
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="F"/>On <chord name="C"/>the banks <chord name="Dm"/>of old <chord name="Gm"/>Jordan, <chord name="C"/>here gazing <chord name="F"/>I stand,<br/>
      <chord name="F"/>And <chord name="C"/>earnestly <chord name="Dm"/>longing, I <chord name="Gm"/>stretch <chord name="C7"/>forth <chord name="F"/>my hand;<br/>
      <chord name="C"/>Send <chord name="F"/>a <chord name="D"/>convoy <chord name="Gm"/>of angels, <chord name="G7"/>dear <chord name="F"/>Jesus, <chord name="C"/>I pray!<br/>
      <chord name="C7"/>Let <chord name="F"/>me <chord name="C"/>join that <chord name="Dm"/>sweet <chord name="Gm"/>music; come, <chord name="C7"/>take <chord name="F"/>me away.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="F"/>Though <chord name="C"/>dark are <chord name="Dm"/>the waters <chord name="Gm"/>and <chord name="C"/>rough is <chord name="F"/>the wave,<br/>
      <chord name="F"/>If <chord name="C"/>Jesus <chord name="Dm"/>permit, the <chord name="Gm"/>wild <chord name="C7"/>surges <chord name="F"/>I&#x27;ll brave;<br/>
      <chord name="C"/>For <chord name="F"/>that <chord name="D"/>heavenly <chord name="Gm"/>music <chord name="G7"/>hath <chord name="F"/>ravished <chord name="C"/>me so,<br/>
      <chord name="C7"/>I <chord name="F"/>must join <chord name="C"/>in <chord name="Dm"/>that chorus! <chord name="Gm"/>I&#x27;ll <chord name="C7"/>go! let <chord name="F"/>me go!
      </lines>
    </verse>
  </lyrics>
