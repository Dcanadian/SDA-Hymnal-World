<song xmlns="http://openlyrics.info/namespace/2009/song" version="0.9">
  <properties>
    <titles>
      <title>545 - Savior, Like a Shepherd</title>
      <title>Savior, Like a Shepherd</title>
    </titles>
    <authors>
      <author type="words"></author>
      <author type="music"></author>
    </authors>
    <songbooks>
      <songbook name="Seventh-day Adventist Hymnal" entry="545"/>
    </songbooks>
    <key>Db</key>
    <tempo type="bpm">Moderato</tempo>
    <timeSignature>4/4</timeSignature>
    <verseOrder>v1 v2 v3</verseOrder>
    <themes>
      <theme>Christian Life</theme>
      <theme></theme>
    </themes>
  </properties>
  <lyrics>
    <verse name="v1">
      <lines>
      <chord name="Db"/>Savior, <chord name="Ab7"/>like a shepherd <chord name="Db"/>lead us,<br/>
      <chord name="Ab"/>Much we <chord name="Ab7"/>need Thy tenderest <chord name="Db"/>care;<br/>
      <chord name="Db"/>In Thy <chord name="Ab7"/>pleasant pastures <chord name="Db"/>feed us,<br/>
      <chord name="Ab"/>For our <chord name="Ab7"/>use Thy folds pre<chord name="Db"/>pare.<br/>
      Blessed <chord name="Gb"/>Jesus, blessed <chord name="Db"/>Jesus!<br/>
      Thou hast <chord name="Ab"/>bought us, Thine we <chord name="Db"/>are.<br/>
      Blessed <chord name="Gb"/>Jesus, blessed <chord name="Db"/>Jesus!<br/>
      Thou hast bought us, <chord name="Ab7"/>Thine we <chord name="Db"/>are.
      </lines>
    </verse>
    <verse name="v2">
      <lines>
      <chord name="Db"/>We are <chord name="Ab7"/>thine, thou <chord name="Db"/>dost befriend us,<br/>
      <chord name="Ab"/>be the <chord name="Ab7"/>guardian of <chord name="Db"/>our way;<br/>
      <chord name="Db"/>keep thy <chord name="Ab7"/>flock, from <chord name="Db"/>sin defend us,<br/>
      <chord name="Ab"/>seek us <chord name="Ab7"/>when we <chord name="Db"/>go astray.<br/>
      <chord name="Gb"/>Blessed Jesus, <chord name="Db"/>blessed Jesus!<br/>
      <chord name="Ab"/>Hear, O hear <chord name="Db"/>us when we pray.<br/>
      <chord name="Gb"/>Blessed Jesus, <chord name="Db"/>blessed Jesus!<br/>
      <chord name="Ab7"/>Hear, O hear <chord name="Db"/>us when we pray.
      </lines>
    </verse>
    <verse name="v3">
      <lines>
      <chord name="Db"/>Thou hast <chord name="Ab7"/>promised to <chord name="Db"/>receive us,<br/>
      <chord name="Ab"/>poor and <chord name="Ab7"/>sinful though <chord name="Db"/>we be;<br/>
      <chord name="Db"/>thou hast <chord name="Ab7"/>mercy to <chord name="Db"/>relieve us,<br/>
      <chord name="Ab"/>grace to <chord name="Ab7"/>cleanse and <chord name="Db"/>power to free.<br/>
      <chord name="Gb"/>Blessed Jesus, <chord name="Db"/>blessed Jesus!<br/>
      <chord name="Ab"/>We will early <chord name="Db"/>turn to thee.<br/>
      <chord name="Gb"/>Blessed Jesus, <chord name="Db"/>blessed Jesus!<br/>
      <chord name="Ab7"/>We will early <chord name="Db"/>turn to thee.
      </lines>
    </verse>
  </lyrics>
</song>
