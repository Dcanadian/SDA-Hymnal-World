  },
  "slides": {
    "slide_0": {
      "group": "Verse 1",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Praise, my soul, the King of heaven;",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "To His feet thy tribute bring;",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Ransomed, healed, restored, forgiven,",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Who like thee His praise should sing?",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Praise Him, praise Him, alleluia,",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Praise the everlasting King.",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_1": {
      "group": "Verse 2",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Praise Him for His grace and favor",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "To our fathers in distress;",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Praise Him, still the same forever,",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Slow to chide and swift to bless;",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Praise Him, praise Him, alleluia,",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Glorious in His faithfulness.",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_2": {
      "group": "Verse 3",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Tenderly He shields and spares us;",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Well our feeble frame He knows;",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "In His hands He gently bears us,",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Rescues us from all our foes:",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Praise Him, praise Him, alleluia,",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Widely as His mercy flows.",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    },
    "slide_3": {
      "group": "Verse 4",
      "color": "#2563eb",
      "settings": {
        "color": "",
        "resolution": {
          "width": 1920,
          "height": 1080
        }
      },
      "children": [],
      "notes": "",
      "items": [
        {
          "type": "text",
          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Angels, help us to adore Him:",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Ye behold Him face to face;",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Sun and moon bow down before Him:",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Dwellers all in time and space,",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Praise Him, praise Him, alleluia,",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Praise with us the God of grace.",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            }
          ],
          "style": "top:100px;left:100px;height:880px;width:1720px;",
          "align": "align-items:center;"
        }
      ]
    }
  },
