  "meta": {
    "number": "004",
    "title": "Praise, My Soul, the King of Heaven",
    "artist": "",
    "author": "Henry Francis Lyte",
    "composer": "John Goss",
    "publisher": "Review and Herald Publishing Association",
    "copyright": "Public Domain",
    "CCLI": "",
