          "lines": [
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Just when I need Him, He is my all,",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Answering when upon Him I call;",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
                }
              ]
            },
            {
              "align": "text-align:center;",
              "text": [
                {
                  "value": "Tenderly watching lest I should fall,",
                  "style": "font-size:52px;font-family:sans-serif;font-weight:600;line-height:1.4;"
