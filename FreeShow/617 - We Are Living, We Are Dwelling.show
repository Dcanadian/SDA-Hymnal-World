  "meta": {
    "number": "617",
    "title": "We Are Living, We Are Dwelling",
    "artist": "",
    "author": "",
    "composer": "",
    "publisher": "Review and Herald Publishing Association",
    "copyright": "Seventh-day Adventist Hymnal",
    "CCLI": "",
